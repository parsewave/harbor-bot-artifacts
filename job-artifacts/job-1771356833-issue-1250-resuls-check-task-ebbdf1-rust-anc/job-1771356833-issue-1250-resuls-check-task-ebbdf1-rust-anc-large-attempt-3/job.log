Sending keys: ['cat > src/tonic/src/service/metadata_validator.rs <<\'EOF\'\n//! Metadata validation middleware.\n\nuse crate::metadata::{KeyAndValueRef, MetadataMap};\nuse crate::Status;\nuse pin_project::pin_project;\nuse std::future::Future;\nuse std::pin::Pin;\nuse std::sync::Arc;\nuse std::task::{Context, Poll};\nuse tower_layer::Layer;\nuse tower_service::Service;\n\n/// Validates incoming request metadata.\npub trait MetadataValidator {\n    /// Validate `metadata`.\n    fn validate(&self, metadata: &MetadataMap) -> Result<(), Status>;\n}\n\n#[derive(Debug)]\nenum Rule {\n    RequireHeader(&\'static str),\n    MaxHeaderSize(usize),\n    HeaderPrefix {\n        name: &\'static str,\n        prefix: &\'static str,\n    },\n    MaxTotalHeaders(usize),\n}\n\n/// Fluent builder for composing metadata validation rules.\n#[derive(Debug, Default)]\npub struct ValidatorBuilder {\n    rules: Vec<Rule>,\n}\n\nimpl ValidatorBuilder {\n    /// Create an empty validator.\n    pub fn new() -> Self {\n        Self { rules: Vec::new() }\n    }\n\n    /// Require the header `name` to be present.\n    ///\n    /// Missing headers return a `failed_precondition` status.\n    pub fn require_header(mut self, name: &\'static str) -> Self {\n        self.rules.push(Rule::RequireHeader(name));\n        self\n    }\n\n    /// Set a max size, in bytes, for any single header value.\n    ///\n    /// Violations return an `invalid_argument` status.\n    pub fn max_header_size(mut self, limit: usize) -> Self {\n        self.rules.push(Rule::MaxHeaderSize(limit));\n        self\n    }\n\n    /// Require header `name` to have a value starting with `prefix`.\n    ///\n    /// Violations return an `invalid_argument` status.\n    pub fn header_prefix(mut self, name: &\'static str, prefix: &\'static str) -> Self {\n        self.rules.push(Rule::HeaderPrefix { name, prefix });\n        self\n    }\n\n    /// Limit the total number of header values.\n    ///\n    /// Violations return a `resource_exhausted` status.\n    pub fn max_total_headers(mut self, limit: usize) -> Self {\n        self.rules.push(Rule::MaxTotalHeaders(limit));\n        self\n    }\n}\n\nimpl MetadataValidator for ValidatorBuilder {\n    fn validate(&self, metadata: &MetadataMap) -> Result<(), Status> {\n        let mut i = 0usize;\n\n        while i < self.rules.len() {\n            match &self.rules[i] {\n                Rule::RequireHeader(name) => {\n                    if !header_present(metadata, name) {\n                        return Err(Status::failed_precondition(\n                            "missing required metadata header",\n                        ));\n                    }\n                }\n                Rule::MaxHeaderSize(limit) => {\n                    let mut iter = metadata.iter();\n\n                    loop {\n                        match iter.next() {\n                            Some(KeyAndValueRef::Ascii(_, value)) => {\n                                if value.as_bytes().len() > *limit {\n                                    return Err(Status::invalid_argument(\n                                        "metadata header value too large",\n                                    ));\n                                }\n                            }\n                            Some(KeyAndValueRef::Binary(_, value)) => {\n                                if value.as_bytes().len() > *limit {\n                                    return Err(Status::invalid_argument(\n                                        "metadata header value too large",\n                                    ));\n                                }\n                            }\n                            None => {\n                                break;\n                            }\n                        }\n                    }\n                }\n                Rule::HeaderPrefix { name, prefix } => {\n                    match metadata.get(*name) {\n                        Some(value) => match value.to_str() {\n                            Ok(text) => {\n                                if !text.starts_with(prefix) {\n                                    return Err(Status::invalid_argument(\n                                        "metadata header has invalid prefix",\n                                    ));\n                                }\n                            }\n                            Err(_) => {\n                                return Err(Status::invalid_argument(\n                                    "metadata header value is not valid UTF-8",\n                                ));\n                            }\n                        },\n                        None => {\n                            return Err(Status::invalid_argument(\n                                "missing metadata header for prefix check",\n                            ));\n                        }\n                    }\n                }\n                Rule::MaxTotalHeaders(limit) => {\n                    if metadata.len() > *limit {\n                        return Err(Status::resource_exhausted(\n                            "too many metadata headers",\n                        ));\n                    }\n                }\n            }\n\n            i += 1;\n        }\n\n        Ok(())\n    }\n}\n\nfn header_present(metadata: &MetadataMap, name: &str) -> bool {\n    if name.ends_with("-bin") {\n        match metadata.get_bin(name) {\n            Some(_) => true,\n            None => false,\n        }\n    } else {\n        metadata.contains_key(name)\n    }\n}\n\n/// A Tower layer that validates request metadata.\n#[derive(Debug)]\npub struct MetadataValidatorLayer<V> {\n    validator: Arc<V>,\n}\n\nimpl<V> MetadataValidatorLayer<V> {\n    /// Create a new layer.\n    pub fn new(validator: V) -> Self {\n        Self {\n            validator: Arc::new(validator),\n        }\n    }\n}\n\nimpl<V> Clone for MetadataValidatorLayer<V> {\n    fn clone(&self) -> Self {\n        Self {\n            validator: Arc::clone(&self.validator),\n        }\n    }\n}\n\nimpl<S, V> Layer<S> for MetadataValidatorLayer<V>\nwhere\n    V: MetadataValidator,\n{\n    type Service = MetadataValidatedService<S, V>;\n\n    fn layer(&self, inner: S) -> Self::Service {\n        MetadataValidatedService {\n            inner,\n            validator: Arc::clone(&self.validator),\n        }\n    }\n}\n\n/// Service produced by [`MetadataValidatorLayer`].\n#[derive(Debug)]\npub struct MetadataValidatedService<S, V> {\n    inner: S,\n    validator: Arc<V>,\n}\n\nimpl<S, V> Clone for MetadataValidatedService<S, V>\nwhere\n    S: Clone,\n{\n    fn clone(&self) -> Self {\n        Self {\n            inner: self.inner.clone(),\n            validator: Arc::clone(&self.validator),\n        }\n    }\n}\n\nimpl<S, V, ReqBody, ResBody> Service<http::Request<ReqBody>>\n    for MetadataValidatedService<S, V>\nwhere\n    S: Service<http::Request<ReqBody>, Response = http::Response<ResBody>>,\n    V: MetadataValidator,\n    ResBody: http_body::Body,\n{\n    type Response = http::Response<ResponseBody<ResBody>>;\n    type Error = S::Error;\n    type Future = MetadataValidatedFuture<S::Future, ResBody>;\n\n    fn poll_ready(&mut self, cx: &mut Context<\'_>) -> Poll<Result<(), Self::Error>> {\n        self.inner.poll_ready(cx)\n    }\n\n    fn call(&mut self, req: http::Request<ReqBody>) -> Self::Future {\n        let req = crate::Request::from_http(req);\n\n        match self.validator.validate(req.metadata()) {\n            Ok(()) => {\n                let http_req = req.into_http();\n                MetadataValidatedFuture::new(Kind::Future {\n                    future: self.inner.call(http_req),\n                })\n            }\n            Err(status) => MetadataValidatedFuture::new(Kind::Status {\n                status: Some(status),\n            }),\n        }\n    }\n}\n\n#[pin_project]\n#[derive(Debug)]\npub struct MetadataValidatedFuture<F, B> {\n    #[pin]\n    kind: Kind<F>,\n    _body: std::marker::PhantomData<B>,\n}\n\n#[pin_project(project = KindProj)]\n#[derive(Debug)]\nenum Kind<F> {\n    Future {\n        #[pin]\n        future: F,\n    },\n    Status {\n        status: Option<Status>,\n    },\n}\n\nimpl<F, B> MetadataValidatedFuture<F, B> {\n    fn new(kind: Kind<F>) -> Self {\n        Self {\n            kind,\n            _body: std::marker::PhantomData,\n        }\n    }\n}\n\nimpl<F, E, B> Future for MetadataValidatedFuture<F, B>\nwhere\n    F: Future<Output = Result<http::Response<B>, E>>,\n    B: http_body::Body,\n{\n    type Output = Result<http::Response<ResponseBody<B>>, E>;\n\n    fn poll(self: Pin<&mut Self>, cx: &mut Context<\'_>) -> Poll<Self::Output> {\n        match self.project().kind.project() {\n            KindProj::Future { future } => match future.poll(cx) {\n                Poll::Ready(Ok(res)) => Poll::Ready(Ok(res.map(ResponseBody::wrap))),\n                Poll::Ready(Err(err)) => Poll::Ready(Err(err)),\n                Poll::Pending => Poll::Pending,\n            },\n            KindProj::Status { status } => {\n                let status = match status.take() {\n                    Some(status) => status,\n                    None => Status::internal(\n                        "metadata validator future polled after completion",\n                    ),\n                };\n\n                let (parts, ()) = status.into_http::<()>().into_parts();\n                let response = http::Response::from_parts(parts, ResponseBody::<B>::empty());\n                Poll::Ready(Ok(response))\n            }\n        }\n    }\n}\n\n/// Response body for [`MetadataValidatedService`].\n#[pin_project]\n#[derive(Debug)]\npub struct ResponseBody<B> {\n    #[pin]\n    kind: ResponseBodyKind<B>,\n}\n\n#[pin_project(project = ResponseBodyKindProj)]\n#[derive(Debug)]\nenum ResponseBodyKind<B> {\n    Empty,\n    Wrap(#[pin] B),\n}\n\nimpl<B> ResponseBody<B> {\n    fn new(kind: ResponseBodyKind<B>) -> Self {\n        Self { kind }\n    }\n\n    fn empty() -> Self {\n        Self::new(ResponseBodyKind::Empty)\n    }\n\n    fn wrap(body: B) -> Self {\n        Self::new(ResponseBodyKind::Wrap(body))\n    }\n}\n\nimpl<B: http_body::Body> http_body::Body for ResponseBody<B> {\n    type Data = B::Data;\n    type Error = B::Error;\n\n    fn poll_frame(\n        self: Pin<&mut Self>,\n        cx: &mut Context<\'_>,\n    ) -> Poll<Option<Result<http_body::Frame<Self::Data>, Self::Error>>> {\n        match self.project().kind.project() {\n            ResponseBodyKindProj::Empty => Poll::Ready(None),\n            ResponseBodyKindProj::Wrap(body) => body.poll_frame(cx),\n        }\n    }\n\n    fn size_hint(&self) -> http_body::SizeHint {\n        match &self.kind {\n            ResponseBodyKind::Empty => http_body::SizeHint::with_exact(0),\n            ResponseBodyKind::Wrap(body) => body.size_hint(),\n        }\n    }\n\n    fn is_end_stream(&self) -> bool {\n        match &self.kind {\n            ResponseBodyKind::Empty => true,\n            ResponseBodyKind::Wrap(body) => body.is_end_stream(),\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
