[25.578465, "o", "drwxr-xr-x 2 root root  4096 Feb 17 20:09 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 8 root root  4096 Feb 17 20:09 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root  6794 Feb 17 20:09 encoding.rs\r\n-rw-r--r-- 1 root root  9150 Feb 17 20:09 key.rs\r\n-rw-r--r-- 1 root root 88156 Feb 17 20:09 map.rs\r\n-rw-r--r-- 1 root root  1457 Feb 17 20:09 mod.rs\r\n-rw-r--r-- 1 root root 28372 Feb 17 20:09 value.rs\r\n"]
