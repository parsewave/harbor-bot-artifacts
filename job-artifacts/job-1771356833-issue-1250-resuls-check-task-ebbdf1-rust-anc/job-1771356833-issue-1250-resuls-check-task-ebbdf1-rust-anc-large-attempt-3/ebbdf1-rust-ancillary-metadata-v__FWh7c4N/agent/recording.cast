[693.375704, "o", "pub struct ValidatorBuilder {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.375949, "o", "    rules: Vec<Rule>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.376247, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r(\u001b[?2004h> "]
[693.376343, "o", "impl ValidatorBuilder {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.376539, "o", "    /// Create an empty validator.\r\n\u001b[?2004l\r"]
