[693.431906, "o", "impl<S, V, ReqBody, ResBody> Service<http::Request<ReqBody>>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.432077, "o", "    for MetadataValidatedService<S, V>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.432239, "o", "where\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.432633, "o", "    S: Service<http::Request<ReqBody>, Response = http::Response<ResBody>>,\r\n\u001b[?2004l\r\u001b[?2004h"]
[693.432945, "o", ">     V: MetadataValidator,\r\n\u001b[?2004l\r\u001b[?2004h"]
[693.433065, "o", "> "]
[693.498558, "o", "    ResBody: http_body::Body,\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.498984, "o", "    type Response = http::Response<ResponseBody<ResBody>>;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.499273, "o", "    type Error = S::Error;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.499537, "o", "    type Future = MetadataValidatedFuture<S::Future, ResBody>;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.499803, "o", "    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.500021, "o", "        self.inner.poll_ready(cx)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.500279, "o", "    fn call(&mut self, req: http::Request<ReqBody>) -> Self::Future {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.500497, "o", "        let req = crate::Request::from_http(req);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.500727, "o", "        match self.validator.validate(req.metadata()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.50083, "o", "            Ok(()) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.501159, "o", "                let http_req = req.into_http();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.50136, "o", "                MetadataValidatedFuture::new(Kind::Future {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.501587, "o", "                    future: self.inner.call(http_req),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.501775, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.501899, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.502213, "o", "            Err(status) => MetadataValidatedFuture::new(Kind::Status {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.502299, "o", "                status: Some(status),\r\n\u001b[?2004l\r\u001b[?2004h>             }),"]
[693.502354, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[693.502401, "o", "> "]
[693.502878, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.503043, "o", "#[pin_project]\r\n\u001b[?2004l\r\u001b[?2004h> #[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.503144, "o", "pub struct MetadataValidatedFuture<F, B> {\r\n\u001b[?2004l\r\u001b[?2004h>     #[pin]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.503429, "o", "    kind: Kind<F>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.503677, "o", "    _body: std::marker::PhantomData<B>,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.503824, "o", "#[pin_project(project = KindProj)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.504088, "o", "#[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> enum Kind<F> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.504216, "o", "    Future {\r\n\u001b[?2004l\r\u001b[?2004h>         #[pin]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.504476, "o", "        future: F,\r\n\u001b[?2004l\r"]
[693.504558, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     Status {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.504848, "o", "        status: Option<Status>,\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[693.50498, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.505401, "o", "impl<F, B> MetadataValidatedFuture<F, B> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.505517, "o", "    fn new(kind: Kind<F>) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h>         Self {\r\n\u001b[?2004l\r"]
[693.505634, "o", "\u001b[?2004h>             kind,\r\n\u001b[?2004l\r\u001b[?2004h"]
[693.505792, "o", "> "]
[693.506208, "o", "            _body: std::marker::PhantomData,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[693.506426, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.506522, "o", "impl<F, E, B> Future for MetadataValidatedFuture<F, B>\r\n\u001b[?2004l\r\u001b[?2004h> where\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.506826, "o", "    F: Future<Output = Result<http::Response<B>, E>>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.506945, "o", "    B: http_body::Body,\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.5073, "o", "    type Output = Result<http::Response<ResponseBody<B>>, E>;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.507843, "o", "    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.508025, "o", "        match self.project().kind.project() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.508157, "o", "            KindProj::Future { future } => match future.poll(cx) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.508519, "o", "                Poll::Ready(Ok(res)) => Poll::Ready(Ok(res.map(ResponseBody::wrap))),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.508786, "o", "                Poll::Ready(Err(err)) => Poll::Ready(Err(err)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.509062, "o", "                Poll::Pending => Poll::Pending,\r\n\u001b[?2004l\r\u001b[?2004h"]
[693.50922, "o", ">             },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.509654, "o", "            KindProj::Status { status } => {\r\n\u001b[?2004l\r\u001b[?2004h>                 let status = match status.take() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.509916, "o", "                    Some(status) => status,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.510259, "o", "                    None => Status::internal(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.510446, "o", "                        \"metadata validator future polled after completion\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.510577, "o", "                    ),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.510896, "o", "                };\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.511298, "o", "                let (parts, ()) = status.into_http::<()>().into_parts();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.51159, "o", "                let response = http::Response::from_parts(parts, ResponseBody::<B>::empty());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.511894, "o", "                Poll::Ready(Ok(response))\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.512127, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[693.51238, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.512537, "o", "/// Response body for [`MetadataValidatedService`].\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.512727, "o", "#[pin_project]\r\n\u001b[?2004l\r\u001b[?2004h> #[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.513011, "o", "pub struct ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h>     #[pin]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.513069, "o", "    kind: ResponseBodyKind<B>,\r\n\u001b[?2004l\r"]
[693.513146, "o", "\u001b[?2004h> "]
[693.513466, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[693.513579, "o", "\u001b[?2004l\r\u001b[?2004h> #[pin_project(project = ResponseBodyKindProj)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.51383, "o", "#[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> enum ResponseBodyKind<B> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.513935, "o", "    Empty,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.514188, "o", "    Wrap(#[pin] B),\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[693.51437, "o", "\u001b[?2004h> impl<B> ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.514537, "o", "    fn new(kind: ResponseBodyKind<B>) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.514706, "o", "        Self { kind }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[693.514934, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.515138, "o", "    fn empty() -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.515203, "o", "        Self::new(ResponseBodyKind::Empty)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.515499, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.515639, "o", "    fn wrap(body: B) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.515823, "o", "        Self::new(ResponseBodyKind::Wrap(body))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[693.515909, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.516137, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.516519, "o", "impl<B: http_body::Body> http_body::Body for ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h>     type Data = B::Data;\r\n\u001b[?2004l\r\u001b[?2004h>     type Error = B::Error;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[693.516622, "o", "\u001b[?2004h>     fn poll_frame(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.516954, "o", "        self: Pin<&mut Self>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.517241, "o", "        cx: &mut Context<'_>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.51739, "o", "    ) -> Poll<Option<Result<http_body::Frame<Self::Data>, Self::Error>>> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.517554, "o", "        match self.project().kind.project() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.517913, "o", "            ResponseBodyKindProj::Empty => Poll::Ready(None),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.518247, "o", "            ResponseBodyKindProj::Wrap(body) => body.poll_frame(cx),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.518464, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.518704, "o", "    fn size_hint(&self) -> http_body::SizeHint {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.519033, "o", "        match &self.kind {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.519336, "o", "            ResponseBodyKind::Empty => http_body::SizeHint::with_exact(0),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.51952, "o", "            ResponseBodyKind::Wrap(body) => body.size_hint(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.519705, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.519879, "o", "    fn is_end_stream(&self) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.520021, "o", "        match &self.kind {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.520339, "o", "            ResponseBodyKind::Empty => true,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.520958, "o", "            ResponseBodyKind::Wrap(body) => body.is_end_stream(),\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[693.521296, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
