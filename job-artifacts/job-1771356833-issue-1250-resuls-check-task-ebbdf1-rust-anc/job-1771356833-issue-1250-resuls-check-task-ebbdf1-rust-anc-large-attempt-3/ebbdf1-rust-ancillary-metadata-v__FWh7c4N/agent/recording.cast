[693.372645, "o", "#[derive(Debug)]\r\n\u001b[?2004l\r  \u001b[?2004h> enum Rule {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.373047, "o", "    RequireHeader(&'static str),\r\n\u001b[?2004l\r\u001b[?2004h> "]
