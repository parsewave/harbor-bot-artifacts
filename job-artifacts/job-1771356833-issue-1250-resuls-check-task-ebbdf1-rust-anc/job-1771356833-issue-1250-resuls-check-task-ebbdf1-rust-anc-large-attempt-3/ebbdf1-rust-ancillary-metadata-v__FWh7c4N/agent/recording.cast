[693.377091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.377382, "o", "    /// Require the header `name` to be present.\r\n\u001b[?2004l\r \u001b[?2004h>     ///\r\n\u001b[?2004l\r"]
[693.377563, "o", "\u001b[?2004h> "]
[693.377908, "o", "    /// Missing headers return a `failed_precondition` status.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.378195, "o", "    pub fn require_header(mut self, name: &'static str) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.378593, "o", "        self.rules.push(Rule::RequireHeader(name));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.378838, "o", "        self\r\n\u001b[?2004l\r =>\u001b[?2004h> "]
[693.39805, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.398392, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.398958, "o", "    /// Set a max size, in bytes, for any single header value.\r\n\u001b[?2004l\r\u001b[?2004h>     ///\r\n\u001b[?2004l\r\r\n//\u001b[?2004h> "]
[693.399165, "o", "    /// Violations return an `invalid_argument` status.\r\n\u001b[?2004l\rta.\r\n#[deriv\u001b[?2004h> "]
[693.399498, "o", "    pub fn max_header_size(mut self, limit: usize) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.399817, "o", "        self.rules.push(Rule::MaxHeaderSize(limit));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.399942, "o", "        self\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\rw l\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[693.400552, "o", "    /// Require header `name` to have a value starting with `prefix`.\r\n\u001b[?2004l\r\u001b[?2004h>     ///\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.400886, "o", "    /// Violations return an `invalid_argument` status.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.401459, "o", "    pub fn header_prefix(mut self, name: &'static str, prefix: &'static str) -> Self {\r\n\u001b[?2004l\r       \u001b[?2004h> "]
[693.401796, "o", "        self.rules.push(Rule::HeaderPrefix { name, prefix });\r\n\u001b[?2004l\r"]
[693.401922, "o", "\u001b[?2004h>         self\r\n\u001b[?2004l\r L\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rayer<S>\u001b[?2004h"]
[693.402254, "o", ">     /// Limit the total number of header values.\r\n\u001b[?2004l\r\u001b[?2004h>     ///\r\n\u001b[?2004l\r"]
[693.402438, "o", "\u001b[?2004h> "]
[693.402647, "o", "    /// Violations return a `resource_exhausted` status.\r\n\u001b[?2004l\r"]
[693.402747, "o", "\u001b[?2004h> "]
[693.403027, "o", "    pub fn max_total_headers(mut self, limit: usize) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.403208, "o", "        self.rules.push(Rule::MaxTotalHeaders(limit));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.403481, "o", "        self\r\n\u001b[?2004l\rr"]
[693.403579, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\rne\u001b[?2004h> \r\n\u001b[?2004l\r("]
[693.403802, "o", "\u001b[?2004h> "]
[693.404009, "o", "impl MetadataValidator for ValidatorBuilder {\r\n\u001b[?2004l\rServi\u001b[?2004h> "]
[693.404342, "o", "    fn validate(&self, metadata: &MetadataMap) -> Result<(), Status> {\r\n\u001b[?2004l\rstruct \u001b[?2004h> "]
[693.404578, "o", "        let mut i = 0usize;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.40482, "o", "        while i < self.rules.len() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.405071, "o", "            match &self.rules[i] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.405363, "o", "                Rule::RequireHeader(name) => {\r\n\u001b[?2004l\r "]
[693.40545, "o", "\u001b[?2004h> "]
[693.405817, "o", "                    if !header_present(metadata, name) {\r\n\u001b[?2004l\r  i\u001b[?2004h> "]
[693.406366, "o", "                        return Err(Status::failed_precondition(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.406604, "o", "                            \"missing required metadata header\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.406889, "o", "                        ));\r\n\u001b[?2004l\r>\u001b[?2004h> "]
[693.407062, "o", "                    }\r\n\u001b[?2004l\rli\u001b[?2004h> "]
[693.407184, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.407443, "o", "                Rule::MaxHeaderSize(limit) => {\r\n\u001b[?2004l\re\u001b[?2004h> "]
[693.407751, "o", "                    let mut iter = metadata.iter();\r\n\u001b[?2004l\rVa\u001b[?2004h> "]
[693.407964, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.408052, "o", "                    loop {\r\n\u001b[?2004l\r_b\u001b[?2004h> "]
[693.40836, "o", "                        match iter.next() {\r\n\u001b[?2004l\respo\u001b[?2004h> "]
[693.408563, "o", "                            Some(KeyAndValueRef::Ascii(_, value)) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.408825, "o", "                                if value.as_bytes().len() > *limit {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.40917, "o", "                                    return Err(Status::invalid_argument(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.409436, "o", "                                        \"metadata header value too large\",\r\n\u001b[?2004l\r::Request<\u001b[?2004h> "]
[693.409612, "o", "                                    ));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.409714, "o", "                                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.409893, "o", "                            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.410175, "o", "                            Some(KeyAndValueRef::Binary(_, value)) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.410482, "o", "                                if value.as_bytes().len() > *limit {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.410727, "o", "                                    return Err(Status::invalid_argument(\r\n\u001b[?2004l\rtp_re\u001b[?2004h> "]
[693.411039, "o", "                                        \"metadata header value too large\",\r\n\u001b[?2004l\rtadataVal\u001b[?2004h> "]
[693.41124, "o", "                                    ));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.411433, "o", "                                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.411626, "o", "                            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.41199, "o", "                            None => {\r\n\u001b[?2004l\rb \u001b[?2004h> "]
[693.412178, "o", "                                break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.412287, "o", "                            }\r\n\u001b[?2004l\r"]
[693.412368, "o", "\u001b[?2004h>                         }"]
[693.41245, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.412714, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.412924, "o", "                Rule::HeaderPrefix { name, prefix } => {\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[693.413042, "o", "                    match metadata.get(*name) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.413442, "o", "                        Some(value) => match value.to_str() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.414066, "o", "                            Ok(text) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.414268, "o", "                                if !text.starts_with(prefix) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.414956, "o", "                                    return Err(Status::invalid_argument(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.415347, "o", "                                        \"metadata header has invalid prefix\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.415597, "o", "                                    ));\r\n\u001b[?2004l\ry::B\u001b[?2004h> "]
[693.415744, "o", "                                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.416085, "o", "                            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.416485, "o", "                            Err(_) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.416678, "o", "                                return Err(Status::invalid_argument(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.41715, "o", "                                    \"metadata header value is not valid UTF-8\",\r\n\u001b[?2004l\r\u001b[?2004h>                                 ));\r\n\u001b[?2004l\rd\u001b[?2004h> "]
[693.417404, "o", "                            }\r\n\u001b[?2004l\rk(r\u001b[?2004h> "]
[693.417501, "o", "                        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.418039, "o", "                        None => {\r\n\u001b[?2004l\rl::Ready(Err\u001b[?2004h>                             return Err(Status::invalid_argument(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.418203, "o", "                                \"missing metadata header for prefix check\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.418294, "o", "                            ));\r\n\u001b[?2004l\r"]
[693.418366, "o", "\u001b[?2004h> "]
[693.418445, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.418864, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.418983, "o", "                Rule::MaxTotalHeaders(limit) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.419238, "o", "                    if metadata.len() > *limit {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.419579, "o", "                        return Err(Status::resource_exhausted(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.419997, "o", "                            \"too many metadata headers\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.420074, "o", "                        ));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.420346, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r"]
[693.420415, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[693.420454, "o", "\u001b[?2004h> "]
[693.420721, "o", "            i += 1;\r\n\u001b[?2004l\rm\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[693.420869, "o", ">         Ok(())\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[693.421132, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\rad\u001b[?2004h> \r\n\u001b[?2004l\ry\u001b[?2004h> "]
[693.42144, "o", "fn header_present(metadata: &MetadataMap, name: &str) -> bool {\r\n\u001b[?2004l\rbod\u001b[?2004h> "]
[693.421559, "o", "    if name.ends_with(\"-bin\") {\r\n\u001b[?2004l\ratedService\u001b[?2004h> "]
[693.421809, "o", "        match metadata.get_bin(name) {\r\n\u001b[?2004l\rub\u001b[?2004h> "]
[693.421971, "o", "            Some(_) => true,\r\n\u001b[?2004l\r"]
[693.42208, "o", "\u001b[?2004h> "]
[693.422388, "o", "            None => false,\r\n\u001b[?2004l\rseB\u001b[?2004h> "]
[693.422498, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[693.422913, "o", "        metadata.contains_key(name)\r\n\u001b[?2004l\rj\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[693.422988, "o", "> }\r\n\u001b[?2004l\rer\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[693.423657, "o", "/// A Tower layer that validates request metadata.\r\n\u001b[?2004l\r\r\n  \u001b[?2004h> #[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> pub struct MetadataValidatorLayer<V> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
