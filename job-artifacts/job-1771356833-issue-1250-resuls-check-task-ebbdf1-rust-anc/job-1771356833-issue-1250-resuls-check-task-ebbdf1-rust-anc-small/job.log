Sending keys: ['cat > src/tonic/src/service/metadata_validator.rs <<\'EOF\'\n//! Middleware for validating gRPC request metadata.\n+//!\n+//! This module provides a `MetadataValidator` trait, a builder for composing\n+//! validation rules, and a Tower `Layer` that applies the validator to each\n+//! incoming request before it reaches the service handler.\n+\n+use crate::{metadata::MetadataMap, Status, Code};\n+use futures::future::BoxFuture;\n+use futures::FutureExt;\n+use std::task::{Context, Poll};\n+use tower_layer::Layer;\n+use tower_service::Service;\n+\n+/// Trait for validating request metadata.\n+pub trait MetadataValidator {\n+    /// Validate the supplied metadata.\n+    ///\n+    /// Returns `Ok(())` when validation succeeds, otherwise a gRPC `Status`\n+    /// describing the failure.\n+    fn validate(&self, md: &MetadataMap) -> Result<(), Status>;\n+}\n+\n+/// Simple validator that stores configuration for a set of rules.\n+#[derive(Clone)]\n+struct SimpleValidator {\n+    required: Vec<String>,\n+    max_size: Option<usize>,\n+    prefixes: Vec<(String, String)>,\n+    max_total: Option<usize>,\n+}\n+\n+impl MetadataValidator for SimpleValidator {\n+    fn validate(&self, md: &MetadataMap) -> Result<(), Status> {\n+        // Required headers\n+        for name in &self.required {\n+            if !md.contains_key(name) {\n+                return Err(Status::new(\n+                    Code::FailedPrecondition,\n+                    format!("missing required header {}", name),\n+                ));\n+            }\n+        }\n+\n+        // Max header size (name + value)\n+        if let Some(limit) = self.max_size {\n+            for (name, value) in md.as_ref().iter() {\n+                let size = name.as_str().len() + value.as_bytes().len();\n+                if size > limit {\n+                    return Err(Status::new(\n+                        Code::InvalidArgument,\n+                        format!("header {} exceeds size limit", name),\n+                    ));\n+                }\n+            }\n+        }\n+\n+        // Header prefix checks\n+        for (name, prefix) in &self.prefixes {\n+            match md.get(name) {\n+                Some(v) => match v.to_str() {\n+                    Ok(s) => {\n+                        if !s.starts_with(prefix) {\n+                            return Err(Status::new(\n+                                Code::InvalidArgument,\n+                                format!("header {} does not start with {}", name, prefix),\n+                            ));\n+                        }\n+                    }\n+                    Err(_) => {\n+                        return Err(Status::new(\n+                            Code::InvalidArgument,\n+                            format!("header {} is not valid ascii", name),\n+                        ));\n+                    }\n+                },\n+                None => {}\n+            }\n+        }\n+\n+        // Max total header count\n+        if let Some(limit) = self.max_total {\n+            let count = md.as_ref().len();\n+            if count > limit {\n+                return Err(Status::new(\n+                    Code::ResourceExhausted,\n+                    format!("header count {} exceeds limit {}", count, limit),\n+                ));\n+            }\n+        }\n+        Ok(())\n+    }\n+}\n+\n+/// Builder for composing a `MetadataValidator`.\n+#[derive(Default)]\n+pub struct ValidatorBuilder {\n+    required: Vec<String>,\n+    max_size: Option<usize>,\n+    prefixes: Vec<(String, String)>,\n+    max_total: Option<usize>,\n+}\n+\n+impl ValidatorBuilder {\n+    /// Create a new builder.\n+    pub fn new() -> Self {\n+        Self::default()\n+    }\n+\n+    /// Require that a header with the given name is present.\n+    pub fn require_header(mut self, name: impl Into<String>) -> Self {\n+        self.required.push(name.into());\n+        self\n+    }\n+\n+    /// Set a maximum size (in bytes) for any single header (name + value).\n+    pub fn max_header_size(mut self, limit: usize) -> Self {\n+        self.max_size = Some(limit);\n+        self\n+    }\n+\n+    /// Require that a header\'s value starts with the given prefix.\n+    pub fn header_prefix(\n+        mut self,\n+        name: impl Into<String>,\n+        prefix: impl Into<String>,\n+    ) -> Self {\n+        self.prefixes.push((name.into(), prefix.into()));\n+        self\n+    }\n+\n+    /// Set a maximum total number of headers allowed.\n+    pub fn max_total_headers(mut self, limit: usize) -> Self {\n+        self.max_total = Some(limit);\n+        self\n+    }\n+\n+    /// Build the validator.\n+    pub fn build(self) -> SimpleValidator {\n+        SimpleValidator {\n+            required: self.required,\n+            max_size: self.max_size,\n+            prefixes: self.prefixes,\n+            max_total: self.max_total,\n+        }\n+    }\n+}\n+\n+/// Tower `Layer` that validates request metadata before forwarding.\n+#[derive(Clone)]\n+pub struct MetadataValidatorLayer<V> {\n+    validator: V,\n+}\n+\n+impl<V> MetadataValidatorLayer<V> {\n+    /// Create a new layer with the supplied validator.\n+    pub fn new(validator: V) -> Self {\n+        Self { validator }\n+    }\n+}\n+\n+impl<S, V> Layer<S> for MetadataValidatorLayer<V>\n+where\n+    V: MetadataValidator + Clone,\n+    S: Service<crate::Request<tonic::transport::Body>, Error = Status>,\n+{\n+    type Service = MetadataValidatorService<S, V>;\n+\n+    fn layer(&self, inner: S) -> Self::Service {\n+        MetadataValidatorService {\n+            inner,\n+            validator: self.validator.clone(),\n+        }\n+    }\n+}\n+\n+/// Service wrapper that performs validation.\n+#[derive(Clone)]\n+pub struct MetadataValidatorService<S, V> {\n+    inner: S,\n+    validator: V,\n+}\n+\n+impl<S, V, ReqBody> Service<crate::Request<ReqBody>> for MetadataValidatorService<S, V>\n+where\n+    V: MetadataValidator,\n+    S: Service<crate::Request<ReqBody>>,\n+    S::Error: From<Status>,\n+{\n+    type Response = S::Response;\n+    type Error = S::Error;\n+    type Future = BoxFuture<\'static, Result<Self::Response, Self::Error>>;\n+\n+    fn poll_ready(&mut self, cx: &mut Context<\'_>) -> Poll<Result<(), Self::Error>> {\n+        self.inner.poll_ready(cx)\n+    }\n+\n+    fn call(&mut self, req: crate::Request<ReqBody>) -> Self::Future {\n+        let md = req.metadata().clone();\n+        match self.validator.validate(&md) {\n+            Ok(()) => {\n+                let fut = self.inner.call(req);\n+                async move { fut.await }.boxed()\n+            }\n+            Err(e) => async move { Err(e.into()) }.boxed(),\n+        }\n+    }\n+}\n+EOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
