[235.120006, "o", "+        for (name, prefix) in &self.prefixes {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.120271, "o", "+            match md.get(name) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.120591, "o", "+                Some(v) => match v.to_str() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.120792, "o", "+                    Ok(s) => {\r\n\u001b[?2004l\rk(()) =\u001b[?2004h> "]
[235.12117, "o", "+                        if !s.starts_with(prefix) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.121324, "o", "> "]
[235.12156, "o", "+                            return Err(Status::new(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.121883, "o", "+                                Code::InvalidArgument,\r\n\u001b[?2004l\r"]
[235.122131, "o", "\u001b[?2004h> "]
[235.122524, "o", "+                                format!(\"header {} does not start with {}\", name, prefix),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.122638, "o", "+                            ));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.122853, "o", "+                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.123102, "o", "+                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.123271, "o", "+                    Err(_) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.123496, "o", "+                        return Err(Status::new(\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.123632, "o", "> "]
[235.123778, "o", "+                            Code::InvalidArgument,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.124199, "o", "+                            format!(\"header {} is not valid ascii\", name),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.124373, "o", "+                        ));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.124554, "o", "+                    }\r\n\u001b[?2004l\r"]
[235.124616, "o", "\u001b[?2004h> "]
[235.124795, "o", "+                },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.124958, "o", "+                None => {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.125165, "o", "+            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.125304, "o", "+        }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.125435, "o", "+        // Max total header count\r\n\u001b[?2004l\r"]
[235.125587, "o", "\u001b[?2004h> "]
[235.125708, "o", "+        if let Some(limit) = self.max_total {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.125994, "o", "+            let count = md.as_ref().len();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.126195, "o", "+            if count > limit {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.126487, "o", "+                return Err(Status::new(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.126705, "o", "+                    Code::ResourceExhausted,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.127155, "o", "+                    format!(\"header count {} exceeds limit {}\", count, limit),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.127318, "o", "+                ));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.127499, "o", "+            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.127604, "o", "> +        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.127766, "o", "+        Ok(())\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r"]
[235.127942, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.128215, "o", "+/// Builder for composing a `MetadataValidator`.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.128313, "o", "+#[derive(Default)]\r\n\u001b[?2004l\r"]
[235.128403, "o", "\u001b[?2004h> "]
[235.169149, "o", "+pub struct ValidatorBuilder {\r\n\u001b[?2004l\r\u001b[?2004h> +    required: Vec<String>,\r\n\u001b[?2004l\r\u001b[?2004h> +    max_size: Option<usize>,\r\n\u001b[?2004l\r\u001b[?2004h> +    prefixes: Vec<(String, String)>,\r\n\u001b[?2004l\r\u001b[?2004h> +    max_total: Option<usize>,\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +impl ValidatorBuilder {\r\n\u001b[?2004l\r\u001b[?2004h> +    /// Create a new builder.\r\n\u001b[?2004l\r\u001b[?2004h> +    pub fn new() -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> +        Self::default()\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +    /// Require that a header with the given name is present.\r\n\u001b[?2004l\r\u001b[?2004h> +    pub fn require_header(mut self, name: impl Into<String>) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> +        self.required.push(name.into());\r\n\u001b[?2004l\r\u001b[?2004h> +        self\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +    /// Set a maximum size (in bytes) for any single header (name + value).\r\n\u001b[?2004l\r\u001b[?2004h> +    pub fn max_header_size(mut self, limit: usize) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> +        self.max_size = Some(limit);\r\n\u001b[?2004l\r\u001b[?2004h> +        self\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.1693, "o", "+    /// Require that a header's value starts with the given prefix.\r\n\u001b[?2004l\r\u001b[?2004h> +    pub fn header_prefix(\r\n\u001b[?2004l\r"]
[235.172444, "o", "\u001b[?2004h> +        mut self,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.172655, "o", "+        name: impl Into<String>,\r\n\u001b[?2004l\r\u001b[?2004h> +        prefix: impl Into<String>,\r\n\u001b[?2004l\r\u001b[?2004h> +    ) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> +        self.prefixes.push((name.into(), prefix.into()));\r\n\u001b[?2004l\r\u001b[?2004h> +        self\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +    /// Set a maximum total number of headers allowed.\r\n\u001b[?2004l\r\u001b[?2004h> +    pub fn max_total_headers(mut self, limit: usize) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> +        self.max_total = Some(limit);\r\n\u001b[?2004l\r\u001b[?2004h> +        self\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +    /// Build the validator.\r\n\u001b[?2004l\r\u001b[?2004h> +    pub fn build(self) -> SimpleValidator {\r\n\u001b[?2004l\r\u001b[?2004h> +        SimpleValidator {\r\n\u001b[?2004l\r\u001b[?2004h> +            required: self.required,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.174108, "o", "+            max_size: self.max_size,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.175446, "o", "+            prefixes: self.prefixes,\r\n\u001b[?2004l\r\u001b[?2004h> +            max_total: self.max_total,\r\n\u001b[?2004l\r\u001b[?2004h> +        }\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +/// Tower `Layer` that validates request metadata before forwarding.\r\n\u001b[?2004l\r\u001b[?2004h> +#[derive(Clone)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.175709, "o", "+pub struct MetadataValidatorLayer<V> {\r\n\u001b[?2004l\r\u001b[?2004h> +    validator: V,\r\n\u001b[?2004l\r\u001b[?2004h> +}"]
[235.175803, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.176098, "o", "+impl<V> MetadataValidatorLayer<V> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.176376, "o", "+    /// Create a new layer with the supplied validator.\r\n\u001b[?2004l\r"]
[235.176496, "o", "\u001b[?2004h> "]
[235.176947, "o", "+    pub fn new(validator: V) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> +        Self { validator }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.17721, "o", "+    }\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.177324, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.177625, "o", "+impl<S, V> Layer<S> for MetadataValidatorLayer<V>\r\n\u001b[?2004l\r\u001b[?2004h> +where\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.17777, "o", "+    V: MetadataValidator + Clone,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.178239, "o", "+    S: Service<crate::Request<tonic::transport::Body>, Error = Status>,\r\n\u001b[?2004l\r\u001b[?2004h> +{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.178469, "o", "+    type Service = MetadataValidatorService<S, V>;\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.178712, "o", "+    fn layer(&self, inner: S) -> Self::Service {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.179148, "o", "+        MetadataValidatorService {\r\n\u001b[?2004l\r\u001b[?2004h> +            inner,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.179344, "o", "+            validator: self.validator.clone(),\r\n\u001b[?2004l\r\u001b[?2004h> +        }\r\n\u001b[?2004l\r"]
[235.179452, "o", "\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r"]
[235.179709, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.17998, "o", "+/// Service wrapper that performs validation.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.180197, "o", "+#[derive(Clone)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.180663, "o", "+pub struct MetadataValidatorService<S, V> {\r\n\u001b[?2004l\r\u001b[?2004h> +    inner: S,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.180821, "o", "+    validator: V,\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r"]
[235.181638, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +impl<S, V, ReqBody> Service<crate::Request<ReqBody>> for MetadataValidatorService<S, V>\r\n\u001b[?2004l\r\u001b[?2004h> +where\r\n\u001b[?2004l\r\u001b[?2004h> +    V: MetadataValidator,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.182064, "o", "+    S: Service<crate::Request<ReqBody>>,\r\n\u001b[?2004l\r\u001b[?2004h> +    S::Error: From<Status>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.182198, "o", "+{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.182606, "o", "+    type Response = S::Response;\r\n\u001b[?2004l\r\u001b[?2004h> +    type Error = S::Error;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.183227, "o", "+    type Future = BoxFuture<'static, Result<Self::Response, Self::Error>>;\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.183339, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.183927, "o", "+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\r\n\u001b[?2004l\r\u001b[?2004h> +        self.inner.poll_ready(cx)"]
[235.184517, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r"]
[235.184625, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.184872, "o", "> "]
[235.185156, "o", "+    fn call(&mut self, req: crate::Request<ReqBody>) -> Self::Future {\r\n\u001b[?2004l\r"]
[235.185268, "o", "\u001b[?2004h> "]
[235.185344, "o", "+        let md = req.metadata().clone();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.185858, "o", "+        match self.validator.validate(&md) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.186149, "o", "+            Ok(()) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.189766, "o", "+                let fut = self.inner.call(req);\r\n\u001b[?2004l\r\u001b[?2004h> +                async move { fut.await }.boxed()\r\n\u001b[?2004l\r\u001b[?2004h> +            }\r\n\u001b[?2004l\r\u001b[?2004h> +            Err(e) => async move { Err(e.into()) }.boxed(),\r\n\u001b[?2004l\r\u001b[?2004h> +        }\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r\u001b[?2004h> +EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
