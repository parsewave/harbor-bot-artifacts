[107.275932, "o", "> "]
[107.276162, "o", "+                async move { fut.await }.boxed()\r\n\u001b[?2004l\r"]
[107.276338, "o", "\u001b[?2004h> +            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.276634, "o", "+            Err(e) => async move { Err(e.into()) }.boxed(),\r\n\u001b[?2004l\r\u001b[?2004h> +        }\r\n\u001b[?2004l\r"]
[107.276875, "o", "\u001b[?2004h> +    }\r\n\u001b[?2004l\r"]
[107.2771, "o", "\u001b[?2004h> +}\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
