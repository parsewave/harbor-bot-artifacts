[107.269559, "o", "+{\r\n\u001b[?2004l\r\u001b[?2004h> +    type Service = MetadataValidatorService<S, V>;\r\n\u001b[?2004l\r\u001b[?2004h> +"]
[107.269848, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.270118, "o", "+    fn layer(&self, inner: S) -> Self::Service {\r\n\u001b[?2004l\r\u001b[?2004h> +        MetadataValidatorService {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.270218, "o", "+            inner,\r\n\u001b[?2004l\r\u001b[?2004h> "]
