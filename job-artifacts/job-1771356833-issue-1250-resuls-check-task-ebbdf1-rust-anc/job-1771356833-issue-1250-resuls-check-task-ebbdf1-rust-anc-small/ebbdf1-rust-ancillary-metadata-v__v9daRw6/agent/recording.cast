[107.269219, "o", "\u001b[?2004h> +/// Tower `Layer` that validates request metadata before forwarding.\r\n\u001b[?2004l\r\u001b[?2004h> +#[derive(Clone)]\r\n\u001b[?2004l\r\u001b[?2004h> +pub struct MetadataValidatorLayer<V> {\r\n\u001b[?2004l\r\u001b[?2004h> +    validator: V,\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +impl<V> MetadataValidatorLayer<V> {\r\n\u001b[?2004l\r\u001b[?2004h> +    /// Create a new layer with the supplied validator.\r\n\u001b[?2004l\r\u001b[?2004h> +    pub fn new(validator: V) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> +        Self { validator }\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +impl<S, V> Layer<S> for MetadataValidatorLayer<V>\r\n\u001b[?2004l\r\u001b[?2004h> +where\r\n\u001b[?2004l\r\u001b[?2004h> "]
