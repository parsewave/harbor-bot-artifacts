[107.27333, "o", "+    type Response = S::Response;\r\n\u001b[?2004l\r\u001b[?2004h> +    type Error = S::Error;"]
[107.273414, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.273622, "o", "+    type Future = BoxFuture<'static, Result<Self::Response, Self::Error>>;\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.274058, "o", "+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.274307, "o", "+        self.inner.poll_ready(cx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.274416, "o", "+    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.274687, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
