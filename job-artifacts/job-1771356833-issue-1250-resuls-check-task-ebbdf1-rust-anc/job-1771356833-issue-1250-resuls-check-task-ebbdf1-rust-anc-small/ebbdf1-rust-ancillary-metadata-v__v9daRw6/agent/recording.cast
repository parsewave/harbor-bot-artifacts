[107.271435, "o", "+pub struct MetadataValidatorService<S, V> {\r\n\u001b[?2004l\r\u001b[?2004h> +    inner: S,\r\n\u001b[?2004l\r"]
[107.271614, "o", "\u001b[?2004h> +    validator: V,\r\n\u001b[?2004l\r"]
[107.271801, "o", "\u001b[?2004h> "]
