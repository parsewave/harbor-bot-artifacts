[76.976551, "o", "+/// Trait for validating request metadata.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.976735, "o", "+pub trait MetadataValidator {\r\n\u001b[?2004l\r \u001b[?2004h> "]
[76.97713, "o", "+    /// Validate the supplied metadata.\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[76.977253, "o", "+    ///\r\n\u001b[?2004l\r\u001b[?2004h> "]
