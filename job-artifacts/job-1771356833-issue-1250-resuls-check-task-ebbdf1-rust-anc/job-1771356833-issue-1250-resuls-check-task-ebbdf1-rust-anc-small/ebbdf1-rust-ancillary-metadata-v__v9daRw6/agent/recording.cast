[76.972773, "o", "\u001b[?2004h> "]
[76.973056, "o", "+//! Middleware for validating gRPC request metadata.\r\n\u001b[?2004l\r\u001b[?2004h> +//!\r\n\u001b[?2004l\r ) ->\u001b[?2004h> "]
[76.973427, "o", "+//! This module provides a `MetadataValidator` trait, a builder for composing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.973987, "o", "+//! validation rules, and a Tower `Layer` that applies the validator to each\r\n\u001b[?2004l\rn\u001b[?2004h> "]
