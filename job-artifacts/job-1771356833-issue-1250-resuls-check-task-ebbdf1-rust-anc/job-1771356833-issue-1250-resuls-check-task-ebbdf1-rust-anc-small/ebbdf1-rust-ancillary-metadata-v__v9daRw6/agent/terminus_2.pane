[?2004l[?2004h> +        Self::default()
[?2004l[?2004h> +    }
[?2004l[?2004h> +
[?2004l[?2004h> +    /// Require that a header with the given name is present.
[?2004l[?2004h> +    pub fn require_header(mut self, name: impl Into<String>) -> Self {
[?2004l[?2004h> +        self.required.push(name.into());
[?2004l[?2004h> +        self
[?2004l[?2004h> +    }
[?2004l[?2004h> +
[?2004l[?2004h> +    /// Set a maximum size (in bytes) for any single header (name + value).
[?2004l[?2004h> +    pub fn max_header_size(mut self, limit: usize) -> Self {
[?2004l[?2004h> +        self.max_size = Some(limit);
[?2004l[?2004h> +        self
[?2004l[?2004h> +    }
[?2004l[?2004h> +
[?2004l[?2004h> +    /// Require that a header's value starts with the given prefix.
[?2004l[?2004h> +    pub fn header_prefix(
[?2004l[?2004h> +        mut self,
[?2004l[?2004h> +        name: impl Into<String>,
[?2004l[?2004h> +        prefix: impl Into<String>,
[?2004l[?2004h> +    ) -> Self {
[?2004l[?2004h> +        self.prefixes.push((name.into(), prefix.into()));
[?2004l[?2004h> +        self
[?2004l[?2004h> +    }
[?2004l[?2004h> +
[?2004l[?2004h> +    /// Set a maximum total number of headers allowed.
[?2004l[?2004h> +    pub fn max_total_headers(mut self, limit: usize) -> Self {
