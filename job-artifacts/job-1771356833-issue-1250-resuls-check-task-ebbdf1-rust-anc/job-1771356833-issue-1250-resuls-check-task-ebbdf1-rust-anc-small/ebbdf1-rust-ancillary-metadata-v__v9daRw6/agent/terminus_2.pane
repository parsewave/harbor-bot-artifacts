[?2004l[?2004h> +            required: self.required,
[?2004l[?2004h> +            max_size: self.max_size,
[?2004l[?2004h> +            prefixes: self.prefixes,
[?2004l[?2004h> +            max_total: self.max_total,
[?2004l[?2004h> +        }
[?2004l[?2004h> +    }
[?2004l[?2004h> +}
