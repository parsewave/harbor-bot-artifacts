[?2004l[?2004h> +            inner,
[?2004l[?2004h> +            validator: self.validator.clone(),
[?2004l[?2004h> +        }
[?2004l[?2004h> +    }
[?2004l[?2004h> +}
[?2004l[?2004h> +
[?2004l[?2004h> +/// Service wrapper that performs validation.
[?2004l[?2004h> +#[derive(Clone)]
[?2004l[?2004h> +pub struct MetadataValidatorService<S, V> {
[?2004l[?2004h> +    inner: S,
[?2004l[?2004h> +    validator: V,
[?2004l[?2004h> +}
[?2004l[?2004h> +
[?2004l[?2004h> +impl<S, V, ReqBody> Service<crate::Request<ReqBody>> for MetadataValidatorService<S, V>
[?2004l[?2004h> +where
[?2004l[?2004h> +    V: MetadataValidator,
[?2004l[?2004h> +    S: Service<crate::Request<ReqBody>>,
[?2004l[?2004h> +    S::Error: From<Status>,
[?2004l[?2004h> +{
[?2004l[?2004h> +    type Response = S::Response;
[?2004l[?2004h> +    type Error = S::Error;
[?2004l[?2004h> +    type Future = BoxFuture<'static, Result<Self::Response, Self::Error>>;
[?2004l[?2004h> +
[?2004l[?2004h> +    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
[?2004l[?2004h> +        self.inner.poll_ready(cx)
[?2004l[?2004h> +    }
[?2004l[?2004h> +
[?2004l[?2004h> +    fn call(&mut self, req: crate::Request<ReqBody>) -> Self::Future {
[?2004l[?2004h> +        let md = req.metadata().clone();
[?2004l[?2004h> +        match self.validator.validate(&md) {
[?2004l[?2004h> +            Ok(()) => {
[?2004l[?2004h> +                let fut = self.inner.call(req);
[?2004l[?2004h> +                async move { fut.await }.boxed()
[?2004l[?2004h> +            }
[?2004l[?2004h> +            Err(e) => async move { Err(e.into()) }.boxed(),
[?2004l[?2004h> +        }
[?2004l[?2004h> +    }
[?2004l[?2004h> +}
