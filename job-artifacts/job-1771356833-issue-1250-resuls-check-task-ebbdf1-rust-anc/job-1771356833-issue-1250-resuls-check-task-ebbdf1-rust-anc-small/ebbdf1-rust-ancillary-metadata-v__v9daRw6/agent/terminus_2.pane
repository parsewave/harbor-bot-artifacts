[?2004l[?2004h> +/// Tower `Layer` that validates request metadata before forwarding.
[?2004l[?2004h> +#[derive(Clone)]
[?2004l[?2004h> +pub struct MetadataValidatorLayer<V> {
[?2004l[?2004h> +    validator: V,
[?2004l[?2004h> +}
[?2004l[?2004h> +
[?2004l[?2004h> +impl<V> MetadataValidatorLayer<V> {
[?2004l[?2004h> +    /// Create a new layer with the supplied validator.
[?2004l[?2004h> +    pub fn new(validator: V) -> Self {
[?2004l[?2004h> +        Self { validator }
[?2004l[?2004h> +    }
[?2004l[?2004h> +}
[?2004l[?2004h> +
[?2004l[?2004h> +impl<S, V> Layer<S> for MetadataValidatorLayer<V>
[?2004l[?2004h> +where
[?2004l[?2004h> +    V: MetadataValidator + Clone,
[?2004l[?2004h> +    S: Service<crate::Request<tonic::transport::Body>, Error = Status>,
[?2004l[?2004h> +{
[?2004l[?2004h> +    type Service = MetadataValidatorService<S, V>;
[?2004l[?2004h> +
[?2004l[?2004h> +    fn layer(&self, inner: S) -> Self::Service {
