[461.890475, "o", "sed -n '120,220p' src/tonic/src/service/interceptor.rs\r\n\u001b[?2004l\r"]
[461.892644, "o", "    type Response = http::Response<ResponseBody<ResBody>>;\r\n    type Error = S::Error;\r\n    type Future = ResponseFuture<S::Future>;\r\n\r\n    #[inline]\r\n    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\r\n        self.inner.poll_ready(cx)\r\n    }\r\n\r\n    fn call(&mut self, req: http::Request<ReqBody>) -> Self::Future {\r\n        // It is bad practice to modify the body (i.e. Message) of the request via an interceptor.\r\n        // To avoid exposing the body of the request to the interceptor function, we first remove it\r\n        // here, allow the interceptor to modify the metadata and extensions, and then recreate the\r\n        // HTTP request with the body. Tonic requests do not preserve the URI, HTTP version, and\r\n        // HTTP method of the HTTP request, so we extract them here and then add them back in below.\r\n        let uri = req.uri().clone();\r\n        let method = req.method().clone();\r\n        let version = req.version();\r\n        let req = crate::Request::from_http(req);\r\n        let (metadata, extensions, msg) = req.into_parts();\r\n\r\n        match self\r\n            .interceptor\r\n            .call(crate::Request::from_parts(metadata, extensions, ()))\r\n        {\r\n            Ok(req) => {\r\n                let (metadata, extensions, _) = req.into_parts();\r\n                let req = crate::Request::from_parts(metadata, extensions, msg);\r\n                let req = req.into_http(uri, method, version, SanitizeHeaders::No);\r\n                ResponseFuture::future(self.inner.call(req))\r\n            }\r\n            Err(status) => ResponseFuture::status(status),\r\n        }\r\n    }\r\n}\r\n\r\n// required to use `InterceptedService` with `Router`\r\nimpl<S, I> crate::server::NamedService for InterceptedService<S, I>\r\nwhere\r\n    S: crate::server::NamedService,\r\n{\r\n    const NAME: &'static str = S::NAME;\r\n}\r\n\r\n"]
[461.892757, "o", "/// Response future for [`InterceptedService`].\r\n#[pin_project]\r\n#[derive(Debug)]\r\npub struct ResponseFuture<F> {\r\n    #[pin]\r\n    kind: Kind<F>,\r\n}\r\n\r\nimpl<F> ResponseFuture<F> {\r\n    fn future(future: F) -> Self {\r\n        Self {\r\n            kind: Kind::Future(future),\r\n        }\r\n    }\r\n\r\n    fn status(status: Status) -> Self {\r\n        Self {\r\n            kind: Kind::Status(Some(status)),\r\n        }\r\n    }\r\n}\r\n\r\n#[pin_project(project = KindProj)]\r\n#[derive(Debug)]\r\nenum Kind<F> {\r\n    Future(#[pin] F),\r\n    Status(Option<Status>),\r\n}\r\n\r\nimpl<F, E, B> Future for ResponseFuture<F>\r\nwhere\r\n    F: Future<Output = Result<http::Response<B>, E>>,\r\n{\r\n    type Output = Result<http::Response<ResponseBody<B>>, E>;\r\n\r\n    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {\r\n        match self.project().kind.project() {\r\n            KindProj::Future(future) => future.poll(cx).map_ok(|res| res.map(ResponseBody::wrap)),\r\n            KindProj::Status(status) => {\r\n"]
[461.892994, "o", "                let (parts, ()) = status.take().unwrap().into_http::<()>().into_parts();\r\n                let response = http::Response::from_parts(parts, ResponseBody::<B>::empty());\r\n                Poll::Ready(Ok(response))\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n/// Response body for [`InterceptedService`].\r\n#[pin_project]\r\n#[derive(Debug)]\r\npub struct ResponseBody<B> {\r\n    #[pin]\r\n    kind: ResponseBodyKind<B>,\r\n}\r\n\r\n#[pin_project(project = ResponseBodyKindProj)]\r\n#[derive(Debug)]\r\n"]
[461.893431, "o", "\u001b[?2004hroot@b1aac3828518:/app# "]
[577.599047, "i", "cat <<'EOF' > src/tonic/src/service/metadata_validator.rs\n//! Metadata validation middleware.\n//!\n//! This module provides a small rule engine to validate incoming gRPC request\n//! metadata before it reaches a handler.\n\nuse crate::metadata::MetadataMap;\nuse crate::Status;\nuse pin_project::pin_project;\nuse std::fmt;\nuse std::future::Future;\nuse std::pin::Pin;\nuse std::task::{Context, Poll};\nuse tower_layer::Layer;\nuse tower_service::Service;\n\n/// Validate incoming metadata.\npub trait MetadataValidator {\n    /// Validate metadata. Returns `Ok(())` when constraints are satisfied.\n    fn validate(&self, metadata: &MetadataMap) -> Result<(), Status>;\n}\n\n#[derive(Debug)]\nenum Rule {\n    RequireHeader(String),\n    MaxHeaderSize(usize),\n    HeaderPrefix(String, String),\n    MaxTotalHeaders(usize),\n}\n\n/// A fluent builder for composing metadata validation rules.\n#[derive(Debug, Default)]\npub struct ValidatorBuilder {\n    rules: Vec<Rule>,\n}\n\nimpl ValidatorBuilder {\n    /// Create an empty builder.\n    pub fn new() -> Self {\n        Self { rules: Vec::new() }\n    }\n\n    /// Require a header to exist.\n    ///\n    /// Failures use the `failed_precondition` status code.\n    pub fn require_header(mut self, name: impl Into<String>) -> Self {\n        self.rules.push(Rule::RequireHeader(name.into()));\n        self\n    }\n\n    /// Limit the size in bytes of any single header entry.\n    ///\n    /// Failures use the `invalid_argument` status code.\n    pub fn max_header_size(mut self, bytes: usize) -> Self {\n        self.rules.push(Rule::MaxHeaderSize(bytes));\n        self\n    }\n\n    /// Require a header value to start with the given prefix.\n    ///\n    /// Uses `starts_with` for matching and returns `invalid_argument` on failure.\n    pub fn header_prefix(mut self, name: impl Into<String>, prefix: impl Into<String>) -> Self {\n        self.rules.push(Rule::HeaderPrefix(name.into(), prefix.into()));\n        self\n    }\n\n    /// Limit the total number of header entries.\n    ///\n    /// Failures use the `resource_exhausted` status code.\n    pub fn max_total_headers(mut self, limit: usize) -> Self {\n        self.rules.push(Rule::MaxTotalHeaders(limit));\n        self\n    }\n\n    /// Build a validator from the configured rules.\n    pub fn build(self) -> RulesValidator {\n        RulesValidator { rules: self.rules }\n    }\n}\n\n/// A validator composed of rules created by [`ValidatorBuilder`].\n#[derive(Debug)]\npub struct RulesValidator {\n    rules: Vec<Rule>,\n}\n\nimpl MetadataValidator for RulesValidator {\n    fn validate(&self, metadata: &MetadataMap) -> Result<(), Status> {\n        for rule in &self.rules {\n            match rule {\n                Rule::RequireHeader(name) => {\n                    if !metadata.contains_key(name.as_str()) {\n                        let msg = \"required metadata header is missing\";\n                        return Err(Status::failed_precondition(msg));\n                    }\n                }\n                Rule::MaxHeaderSize(limit) => {\n                    if header_exceeds_limit(metadata, *limit) {\n                        let msg = \"metadata header entry exceeds size limit\";\n                        return Err(Status::invalid_argument(msg));\n                    }\n                }\n                Rule::HeaderPrefix(name, prefix) => {\n                    match metadata.get(name.as_str()) {\n                        Some(value) => match value.to_str() {\n                            Ok(s) => {\n                                if !s.starts_with(prefix.as_str()) {\n                                    let msg = \"metadata header does not match required prefix\";\n                                    return Err(Status::invalid_argument(msg));\n                                }\n                            }\n                            Err(_) => {\n                                let msg = \"metadata header is not valid ascii\";\n                                return Err(Status::invalid_argument(msg));\n                            }\n                        },\n                        None => {\n                            let msg = \"metadata header "]
[577.59945, "i", "is missing for prefix validation\";\n                            return Err(Status::invalid_argument(msg));\n                        }\n                    }\n                }\n                Rule::MaxTotalHeaders(limit) => {\n                    if metadata.len() > *limit {\n                        let msg = \"metadata header count exceeded\";\n                        return Err(Status::resource_exhausted(msg));\n                    }\n                }\n            }\n        }\n        Ok(())\n    }\n}\n\nfn header_exceeds_limit(metadata: &MetadataMap, limit: usize) -> bool {\n    let headers = metadata.as_ref();\n    for (name, value) in headers.iter() {\n        let n = name.as_str().len();\n        let v = value.as_bytes().len();\n        if n.saturating_add(v) > limit {\n            return true;\n        }\n    }\n    false\n}\n\n/// A tower [`Layer`] applying a [`MetadataValidator`] to incoming requests.\n#[derive(Debug, Copy, Clone)]\npub struct MetadataValidatorLayer<'a, V> {\n    validator: &'a V,\n}\n\nimpl<'a, V> MetadataValidatorLayer<'a, V> {\n    /// Create a new layer from a validator reference.\n    pub fn new(validator: &'a V) -> Self {\n        Self { validator }\n    }\n}\n\nimpl<'a, S, V> Layer<S> for MetadataValidatorLayer<'a, V> {\n    type Service = MetadataValidatorService<S, &'a V>;\n\n    fn layer(&self, inner: S) -> Self::Service {\n        MetadataValidatorService::new(inner, self.validator)\n    }\n}\n\n/// A tower [`Service`] that validates metadata before calling an inner service.\n#[derive(Debug)]\npub struct MetadataValidatorService<S, V> {\n    inner: S,\n    validator: V,\n}\n\nimpl<S, V> MetadataValidatorService<S, V> {\n    fn new(inner: S, validator: V) -> Self {\n        Self { inner, validator }\n    }\n}\n\nimpl<S, V, ReqBody, ResBody> Service<http::Request<ReqBody>>\n    for MetadataValidatorService<S, V>\nwhere\n    S: Service<http::Request<ReqBody>, Response = http::Response<ResBody>>,\n    V: MetadataValidator,\n{\n    type Response = http::Response<ResponseBody<ResBody>>;\n    type Error = S::Error;\n    type Future = ResponseFuture<S::Future, ResBody, S::Error>;\n\n    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\n        self.inner.poll_ready(cx)\n    }\n\n    fn call(&mut self, req: http::Request<ReqBody>) -> Self::Future {\n        let (mut parts, body) = req.into_parts();\n        let headers = std::mem::take(&mut parts.headers);\n        let metadata = MetadataMap::from_headers(headers);\n\n        match self.validator.validate(&metadata) {\n            Ok(()) => {\n                parts.headers = metadata.into_headers();\n                let req2 = http::Request::from_parts(parts, body);\n                ResponseFuture::future(self.inner.call(req2))\n            }\n            Err(status) => {\n                let response = status_response::<ResBody>(status);\n                ResponseFuture::response(response)\n            }\n        }\n    }\n}\n\nfn status_response<B>(status: Status) -> http::Response<ResponseBody<B>> {\n    let (parts, ()) = status.into_http::<()>().into_parts();\n    http::Response::from_parts(parts, ResponseBody::<B>::empty())\n}\n\n#[pin_project]\n#[derive(Debug)]\npub struct ResponseFuture<F, B, E> {\n    #[pin]\n    kind: Kind<F, B>,\n    phantom: std::marker::PhantomData<E>,\n}\n\n#[pin_project(project = KindProj)]\n#[derive(Debug)]\nenum Kind<F, B> {\n    Future(#[pin] F),\n    Response(Option<http::Response<ResponseBody<B>>>),\n}\n\nimpl<F, B, E> ResponseFuture<F, B, E> {\n    fn future(future: F) -> Self {\n        Self {\n            kind: Kind::Future(future),\n            phantom: std::marker::PhantomData,\n        }\n    }\n\n    fn response(response: http::Response<ResponseBody<B>>) -> Self {\n        Self {\n            kind: Kind::Response(Some(response)),\n            phantom: std::marker::PhantomData,\n        }\n    }\n}\n\nimpl<F, E, B, ResBody> Future for ResponseFuture<F, ResBody, E>\nwhere\n    F: Future<Output = Result<http::Response<ResBody>, E>>,\n{\n    type Output = Result<http::Response<ResponseBody<ResBody>>, E>;\n\n    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {\n        match self.pr"]
[577.599919, "i", "oject().kind.project() {\n            KindProj::Future(future) => match future.poll(cx) {\n                Poll::Ready(Ok(res)) => {\n                    let (parts, body) = res.into_parts();\n                    let response = http::Response::from_parts(parts, ResponseBody::wrap(body));\n                    Poll::Ready(Ok(response))\n                }\n                Poll::Ready(Err(err)) => Poll::Ready(Err(err)),\n                Poll::Pending => Poll::Pending,\n            },\n            KindProj::Response(response) => match response.take() {\n                Some(res) => Poll::Ready(Ok(res)),\n                None => {\n                    let status = Status::internal(\"polled after completion\");\n                    let res = status_response::<ResBody>(status);\n                    Poll::Ready(Ok(res))\n                }\n            },\n        }\n    }\n}\n\n/// Response body for [`MetadataValidatorService`].\n#[pin_project]\n#[derive(Debug)]\npub struct ResponseBody<B> {\n    #[pin]\n    kind: ResponseBodyKind<B>,\n}\n\n#[pin_project(project = ResponseBodyKindProj)]\n#[derive(Debug)]\nenum ResponseBodyKind<B> {\n    Empty,\n    Wrap(#[pin] B),\n}\n\nimpl<B> ResponseBody<B> {\n    fn new(kind: ResponseBodyKind<B>) -> Self {\n        Self { kind }\n    }\n\n    fn empty() -> Self {\n        Self::new(ResponseBodyKind::Empty)\n    }\n\n    fn wrap(body: B) -> Self {\n        Self::new(ResponseBodyKind::Wrap(body))\n    }\n}\n\nimpl<B: http_body::Body> http_body::Body for ResponseBody<B> {\n    type Data = B::Data;\n    type Error = B::Error;\n\n    fn poll_frame(\n        self: Pin<&mut Self>,\n        cx: &mut Context<'_>,\n    ) -> Poll<Option<Result<http_body::Frame<Self::Data>, Self::Error>>> {\n        match self.project().kind.project() {\n            ResponseBodyKindProj::Empty => Poll::Ready(None),\n            ResponseBodyKindProj::Wrap(body) => body.poll_frame(cx),\n        }\n    }\n\n    fn size_hint(&self) -> http_body::SizeHint {\n        match &self.kind {\n            ResponseBodyKind::Empty => http_body::SizeHint::with_exact(0),\n            ResponseBodyKind::Wrap(body) => body.size_hint(),\n        }\n    }\n\n    fn is_end_stream(&self) -> bool {\n        match &self.kind {\n            ResponseBodyKind::Empty => true,\n            ResponseBodyKind::Wrap(body) => body.is_end_stream(),\n        }\n    }\n}\n\nimpl<B> fmt::Display for ResponseBody<B> {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.write_str(\"metadata validator response body\")\n    }\n}\nEOF\n"]
