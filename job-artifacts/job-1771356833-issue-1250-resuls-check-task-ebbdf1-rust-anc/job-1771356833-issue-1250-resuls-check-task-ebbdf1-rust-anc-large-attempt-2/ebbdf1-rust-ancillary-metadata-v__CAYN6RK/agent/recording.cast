[577.600577, "o", "//! Metadata validation middleware.\r\n\u001b[?2004l\r\u001b[?2004h> //!\r\n\u001b[?2004l\rment"]
[577.600993, "o", "\u001b[?2004h> "]
[577.601114, "o", "//! This module provides a small rule engine to validate incoming gRPC request\r\n\u001b[?2004l\r\u001b[?2004h> //! metadata before it reaches a handler.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rt) => \u001b[?2004h"]
[577.601168, "o", "> "]
[577.601483, "o", "use crate::metadata::MetadataMap;\r\n\u001b[?2004l\r\u001b[?2004h> use crate::Status;\r\n\u001b[?2004l\rit {\r\n  "]
[577.601558, "o", "\u001b[?2004h> "]
[577.601834, "o", "use pin_project::pin_project;\r\n\u001b[?2004l\r\u001b[?2004h> use std::fmt;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.602125, "o", "use std::future::Future;\r\n\u001b[?2004l\r\u001b[?2004h> use std::pin::Pin;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.602372, "o", "use std::task::{Context, Poll};\r\n\u001b[?2004l\r\u001b[?2004h> use tower_layer::Layer;\r\n\u001b[?2004l\r\u001b[?2004h> use tower_service::Service;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[577.602484, "o", "> "]
[577.602711, "o", "/// Validate incoming metadata.\r\n\u001b[?2004l\r"]
[577.602832, "o", "\u001b[?2004h> pub trait MetadataValidator {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.603205, "o", "    /// Validate metadata. Returns `Ok(())` when constraints are satisfied.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.603387, "o", "    fn validate(&self, metadata: &MetadataMap) -> Result<(), Status>;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.603632, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.603834, "o", "enum Rule {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.604025, "o", "    RequireHeader(String),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.604214, "o", "    MaxHeaderSize(usize),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.60447, "o", "    HeaderPrefix(String, String),\r\n\u001b[?2004l\r\u001b[?2004h>     MaxTotalHeaders(usize),\r\n\u001b[?2004l\r }\r\n \u001b[?2004h> }\r\n\u001b[?2004l\r  \u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[577.604889, "o", "/// A fluent builder for composing metadata validation rules.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.605048, "o", "#[derive(Debug, Default)]\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[577.605324, "o", "pub struct ValidatorBuilder {\r\n\u001b[?2004l\r\u001b[?2004h>     rules: Vec<Rule>,"]
[577.605456, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.605632, "o", "impl ValidatorBuilder {\r\n\u001b[?2004l\r\u001b[?2004h>     /// Create an empty builder.\r\n\u001b[?2004l\r, V"]
[577.605965, "o", "\u001b[?2004h>     pub fn new() -> Self {\r\n\u001b[?2004l\r\u001b[?2004h>         Self { rules: Vec::new() }\r\n\u001b[?2004l\reate a new layer f"]
[577.606363, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.606667, "o", "    /// Require a header to exist.\r\n\u001b[?2004l\r\u001b[?2004h>     ///\r\n\u001b[?2004l\r\u001b[?2004h>     /// Failures use the `failed_precondition` status code.\r\n\u001b[?2004l\r"]
[577.606902, "o", "\u001b[?2004h> "]
[577.607028, "o", "    pub fn require_header(mut self, name: impl Into<String>) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.60735, "o", "        self.rules.push(Rule::RequireHeader(name.into()));\r\n\u001b[?2004l\relf\u001b[?2004h> "]
[577.607563, "o", "        self\r\n\u001b[?2004l\r"]
[577.607695, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r:\u001b[?2004h> "]
[577.608091, "o", "    /// Limit the size in bytes of any single header entry.\r\n\u001b[?2004l\rf\u001b[?2004h>     ///\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.608221, "o", "> "]
[577.608479, "o", "    /// Failures use the `invalid_argument` status code.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.608952, "o", "    pub fn max_header_size(mut self, bytes: usize) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.60907, "o", "> "]
[577.609328, "o", "        self.rules.push(Rule::MaxHeaderSize(bytes));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.609592, "o", "        self\r\n\u001b[?2004l\r"]
[577.609683, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.610271, "o", "    /// Require a header value to start with the given prefix.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.610354, "o", "    ///\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.610612, "o", "> "]
[577.611039, "o", "    /// Uses `starts_with` for matching and returns `invalid_argument` on failure.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.611567, "o", "    pub fn header_prefix(mut self, name: impl Into<String>, prefix: impl Into<String>) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.611712, "o", "> "]
[577.611977, "o", "        self.rules.push(Rule::HeaderPrefix(name.into(), prefix.into()));\r\n\u001b[?2004l\rta"]
[577.612105, "o", "\u001b[?2004h>         self\r\n\u001b[?2004l\r"]
[577.612287, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[577.612411, "o", " \u001b[?2004h> "]
[577.612585, "o", "    /// Limit the total number of header entries.\r\n\u001b[?2004l\r"]
[577.612713, "o", "\u001b[?2004h>     ///\r\n\u001b[?2004l\rdy>>;\r\n  \u001b[?2004h> "]
[577.613089, "o", "    /// Failures use the `resource_exhausted` status code.\r\n\u001b[?2004l\r"]
[577.613328, "o", "\u001b[?2004h> "]
[577.613433, "o", "    pub fn max_total_headers(mut self, limit: usize) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.613686, "o", "        self.rules.push(Rule::MaxTotalHeaders(limit));\r\n\u001b[?2004l\r"]
[577.613846, "o", "\u001b[?2004h>         self\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.614021, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[577.614122, "o", "> "]
[577.614289, "o", "    /// Build a validator from the configured rules.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.614526, "o", "    pub fn build(self) -> RulesValidator {\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.614765, "o", "> "]
[577.615087, "o", "        RulesValidator { rules: self.rules }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r      \u001b[?2004h> }\r\n\u001b[?2004l\r l\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.615456, "o", "/// A validator composed of rules created by [`ValidatorBuilder`].\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.615615, "o", "#[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.61572, "o", "pub struct RulesValidator {\r\n\u001b[?2004l\r"]
[577.615894, "o", "\u001b[?2004h>     rules: Vec<Rule>,\r\n\u001b[?2004l\r"]
[577.615995, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.616055, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.616333, "o", "impl MetadataValidator for RulesValidator {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.616769, "o", "    fn validate(&self, metadata: &MetadataMap) -> Result<(), Status> {\r\n\u001b[?2004l\r \u001b[?2004h> "]
[577.616846, "o", "        for rule in &self.rules {\r\n\u001b[?2004l\r"]
[577.617021, "o", "\u001b[?2004h> "]
[577.617228, "o", "            match rule {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.617418, "o", "                Rule::RequireHeader(name) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.617754, "o", "                    if !metadata.contains_key(name.as_str()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.618129, "o", "                        let msg = \"required metadata header is missing\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.61857, "o", "                        return Err(Status::failed_precondition(msg));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.618751, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r-> \u001b[?2004h> "]
[577.618817, "o", "                Rule::MaxHeaderSize(limit) => {\r\n\u001b[?2004l\r"]
[577.619074, "o", "\u001b[?2004h> "]
[577.619163, "o", "                    if header_exceeds_limit(metadata, *limit) {\r\n\u001b[?2004l\rspons"]
[577.61931, "o", "\u001b[?2004h> "]
[577.619582, "o", "                        let msg = \"metadata header entry exceeds size limit\";\r\n\u001b[?2004l\rDe\u001b[?2004h> "]
[577.619887, "o", "                        return Err(Status::invalid_argument(msg));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.620043, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.620197, "o", "                }\r\n\u001b[?2004l\r"]
[577.620334, "o", "\u001b[?2004h> "]
[577.620452, "o", "                Rule::HeaderPrefix(name, prefix) => {\r\n\u001b[?2004l\r)]\r\n#[der\u001b[?2004h> "]
[577.620714, "o", "                    match metadata.get(name.as_str()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.620982, "o", "                        Some(value) => match value.to_str() {\r\n\u001b[?2004l\r>),\r\n}\r\n\r\nimpl<F, \u001b[?2004h"]
[577.621064, "o", "> "]
[577.62124, "o", "                            Ok(s) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.621583, "o", "                                if !s.starts_with(prefix.as_str()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.622057, "o", "                                    let msg = \"metadata header does not match required prefix\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.622258, "o", "                                    return Err(Status::invalid_argument(msg));\r\n\u001b[?2004l\rk\u001b[?2004h> "]
[577.622482, "o", "                                }\r\n\u001b[?2004l\r"]
[577.622653, "o", "\u001b[?2004h>                             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.622904, "o", "                            Err(_) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.623154, "o", "                                let msg = \"metadata header is not valid ascii\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.623602, "o", "                                return Err(Status::invalid_argument(msg));\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.623689, "o", "> "]
[577.623833, "o", "                            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.623984, "o", "                        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.624103, "o", "                        None => {\r\n\u001b[?2004l\r"]
[577.624218, "o", "\u001b[?2004h> "]
[577.624695, "o", "                            let msg = \"metadata header is missing for prefix validation\";\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.624839, "o", "> "]
[577.625313, "o", "                            return Err(Status::invalid_argument(msg));\r\n\u001b[?2004l\r    P\u001b[?2004h> "]
[577.625583, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.625786, "o", "                    }\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[577.625988, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.626183, "o", "> "]
[577.626288, "o", "                Rule::MaxTotalHeaders(limit) => {\r\n\u001b[?2004l\r"]
[577.626591, "o", "\u001b[?2004h> "]
[577.62682, "o", "                    if metadata.len() > *limit {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.627413, "o", "                        let msg = \"metadata header count exceeded\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.627739, "o", "                        return Err(Status::resource_exhausted(msg));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.627845, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.628134, "o", "                }\r\n\u001b[?2004l\r=> Po\u001b[?2004h> "]
[577.628341, "o", "            }\r\n\u001b[?2004l\rg,\r\n \u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(())\r\n\u001b[?2004l\r      \u001b[?2004h> "]
[577.62847, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.628943, "o", "fn header_exceeds_limit(metadata: &MetadataMap, limit: usize) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.629049, "o", "    let headers = metadata.as_ref();\r\n\u001b[?2004l\r"]
[577.629239, "o", "\u001b[?2004h> "]
[577.62943, "o", "    for (name, value) in headers.iter() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.62968, "o", "        let n = name.as_str().len();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.629899, "o", "        let v = value.as_bytes().len();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.63012, "o", "        if n.saturating_add(v) > limit {\r\n\u001b[?2004l\r);\r\n\u001b[?2004h> "]
[577.630303, "o", "            return true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.630469, "o", "        }\r\n\u001b[?2004l\rOk(\u001b[?2004h>     }\r\n\u001b[?2004l\r)\r\n\u001b[?2004h>     false\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[577.630646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[577.631069, "o", "/// A tower [`Layer`] applying a [`MetadataValidator`] to incoming requests.\r\n\u001b[?2004l\rda\u001b[?2004h> "]
[577.631405, "o", "#[derive(Debug, Copy, Clone)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.631845, "o", "pub struct MetadataValidatorLayer<'a, V> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.632115, "o", "    validator: &'a V,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r R"]
[577.632302, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[577.63249, "o", "impl<'a, V> MetadataValidatorLayer<'a, V> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.632948, "o", "    /// Create a new layer from a validator reference.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.633363, "o", "    pub fn new(validator: &'a V) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.633621, "o", "        Self { validator }\r\n\u001b[?2004l\rB\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r  \u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[577.633719, "o", "> "]
[577.633997, "o", "impl<'a, S, V> Layer<S> for MetadataValidatorLayer<'a, V> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.634392, "o", "    type Service = MetadataValidatorService<S, &'a V>;\r\n\u001b[?2004l\r"]
[577.63461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.634787, "o", "    fn layer(&self, inner: S) -> Self::Service {\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.690734, "o", "> "]
[577.691083, "o", "        MetadataValidatorService::new(inner, self.validator)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /// A tower [`Service`] that validates metadata before calling an inner service.\r\n\u001b[?2004l\r\u001b[?2004h> #[derive(Debug)]\r\n\u001b[?2004l\rE\u001b[?2004h> pub struct MetadataValidatorService<S, V> {\r\n\u001b[?2004l\r\u001b[?2004h>     inner: S,\r\n\u001b[?2004l\ru\u001b[?2004h>     validator: V,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> impl<S, V> MetadataValidatorService<S, V> {\r\n\u001b[?2004l\rul\u001b[?2004h>     fn new(inner: S, validator: V) -> Self {\r\n\u001b[?2004l\r>\u001b[?2004h> "]
[577.691308, "o", "        Self { inner, validator }\r\n\u001b[?2004l\r"]
[577.691591, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\rind.pr\u001b[?2004h> }\r\n\u001b[?2004l\roj\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[577.691973, "o", "impl<S, V, ReqBody, ResBody> Service<http::Request<ReqBody>>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.692154, "o", "    for MetadataValidatorService<S, V>\r\n\u001b[?2004l\r"]
[577.69223, "o", "\u001b[?2004h> where\r\n\u001b[?2004l\rj::Wra\u001b[?2004h> "]
[577.69275, "o", "    S: Service<http::Request<ReqBody>, Response = http::Response<ResBody>>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.693026, "o", "    V: MetadataValidator,\r\n\u001b[?2004l\r"]
[577.693173, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.693403, "o", "    type Response = http::Response<ResponseBody<ResBody>>;\r\n\u001b[?2004l\rEmpty =>\u001b[?2004h> "]
[577.693661, "o", "    type Error = S::Error;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.694078, "o", "    type Future = ResponseFuture<S::Future, ResBody, S::Error>;\r\n\u001b[?2004l\rize_\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[577.694151, "o", "> "]
[577.694602, "o", "    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.694657, "o", "> "]
[577.694993, "o", "        self.inner.poll_ready(cx)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[577.695268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.695549, "o", "    fn call(&mut self, req: http::Request<ReqBody>) -> Self::Future {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.695783, "o", "        let (mut parts, body) = req.into_parts();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.696289, "o", "        let headers = std::mem::take(&mut parts.headers);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.69678, "o", "        let metadata = MetadataMap::from_headers(headers);\r\n\u001b[?2004l\r"]
[577.696995, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.697187, "o", "        match self.validator.validate(&metadata) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.697322, "o", "            Ok(()) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.697477, "o", "                parts.headers = metadata.into_headers();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.697691, "o", "                let req2 = http::Request::from_parts(parts, body);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.697893, "o", "                ResponseFuture::future(self.inner.call(req2))\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.698004, "o", "            Err(status) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.698339, "o", "                let response = status_response::<ResBody>(status);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.698435, "o", "                ResponseFuture::response(response)\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.698504, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n"]
[577.698887, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn status_response<B>(status: Status) -> http::Response<ResponseBody<B>> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.699107, "o", "    let (parts, ()) = status.into_http::<()>().into_parts();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.699314, "o", "    http::Response::from_parts(parts, ResponseBody::<B>::empty())\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[577.699401, "o", "\u001b[?2004h> "]
[577.699484, "o", "#[pin_project]\r\n\u001b[?2004l\r\u001b[?2004h> #[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.699807, "o", "pub struct ResponseFuture<F, B, E> {\r\n\u001b[?2004l\r\u001b[?2004h>     #[pin]\r\n\u001b[?2004l\r\u001b[?2004h>     kind: Kind<F, B>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.700054, "o", "    phantom: std::marker::PhantomData<E>,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.700179, "o", "#[pin_project(project = KindProj)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.700294, "o", "#[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.700363, "o", "enum Kind<F, B> {\r\n\u001b[?2004l\r\u001b[?2004h>     Future(#[pin] F),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.700623, "o", "    Response(Option<http::Response<ResponseBody<B>>>),\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.700833, "o", "impl<F, B, E> ResponseFuture<F, B, E> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.701011, "o", "    fn future(future: F) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.701149, "o", "        Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.701304, "o", "            kind: Kind::Future(future),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.701451, "o", "            phantom: std::marker::PhantomData,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.701678, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[577.701889, "o", "\u001b[?2004h>     fn response(response: http::Response<ResponseBody<B>>) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h>         Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.702065, "o", "            kind: Kind::Response(Some(response)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.702204, "o", "            phantom: std::marker::PhantomData,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.702265, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[577.702479, "o", "\u001b[?2004h> "]
[577.702627, "o", "impl<F, E, B, ResBody> Future for ResponseFuture<F, ResBody, E>\r\n\u001b[?2004l\r\u001b[?2004h> where\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.702823, "o", "    F: Future<Output = Result<http::Response<ResBody>, E>>,\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.702924, "o", "> "]
[577.703185, "o", "    type Output = Result<http::Response<ResponseBody<ResBody>>, E>;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.7035, "o", "    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.703794, "o", "        match self.project().kind.project() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.7039, "o", "            KindProj::Future(future) => match future.poll(cx) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.704067, "o", "                Poll::Ready(Ok(res)) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.70424, "o", "                    let (parts, body) = res.into_parts();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.704415, "o", "                    let response = http::Response::from_parts(parts, ResponseBody::wrap(body));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.704659, "o", "                    Poll::Ready(Ok(response))\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.704885, "o", "                Poll::Ready(Err(err)) => Poll::Ready(Err(err)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.705124, "o", "                Poll::Pending => Poll::Pending,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.705307, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.705593, "o", "            KindProj::Response(response) => match response.take() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.705808, "o", "                Some(res) => Poll::Ready(Ok(res)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.705992, "o", "                None => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.706287, "o", "                    let status = Status::internal(\"polled after completion\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.706575, "o", "                    let res = status_response::<ResBody>(status);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.706773, "o", "                    Poll::Ready(Ok(res))\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.706887, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[577.706941, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.707231, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.707298, "o", "/// Response body for [`MetadataValidatorService`].\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.707549, "o", "#[pin_project]\r\n\u001b[?2004l\r\u001b[?2004h> #[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.707731, "o", "pub struct ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.707973, "o", "    #[pin]\r\n\u001b[?2004l\r\u001b[?2004h>     kind: ResponseBodyKind<B>,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[577.708158, "o", "\u001b[?2004h> "]
[577.708269, "o", "#[pin_project(project = ResponseBodyKindProj)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.708422, "o", "#[derive(Debug)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.708577, "o", "enum ResponseBodyKind<B> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.708716, "o", "    Empty,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.708802, "o", "    Wrap(#[pin] B),\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[577.708876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[577.70909, "o", "\u001b[?2004h> impl<B> ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.709375, "o", "    fn new(kind: ResponseBodyKind<B>) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.70945, "o", "        Self { kind }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.709722, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[577.709836, "o", "\u001b[?2004h>     fn empty() -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.710037, "o", "        Self::new(ResponseBodyKind::Empty)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[577.710241, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.710408, "o", "    fn wrap(body: B) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.710487, "o", "        Self::new(ResponseBodyKind::Wrap(body))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.710716, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.710802, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.71109, "o", "impl<B: http_body::Body> http_body::Body for ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.711265, "o", "    type Data = B::Data;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.711399, "o", "    type Error = B::Error;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[577.711464, "o", "\u001b[?2004h> "]
[577.711723, "o", "    fn poll_frame(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.711817, "o", "        self: Pin<&mut Self>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.711954, "o", "        cx: &mut Context<'_>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.712417, "o", "    ) -> Poll<Option<Result<http_body::Frame<Self::Data>, Self::Error>>> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.712612, "o", "        match self.project().kind.project() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.712943, "o", "            ResponseBodyKindProj::Empty => Poll::Ready(None),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.713198, "o", "            ResponseBodyKindProj::Wrap(body) => body.poll_frame(cx),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.713376, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[577.713455, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.713747, "o", "    fn size_hint(&self) -> http_body::SizeHint {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.713983, "o", "        match &self.kind {"]
[577.714196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.714298, "o", "            ResponseBodyKind::Empty => http_body::SizeHint::with_exact(0),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.714657, "o", "            ResponseBodyKind::Wrap(body) => body.size_hint(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.714783, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[577.714892, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.715189, "o", "    fn is_end_stream(&self) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h>         match &self.kind {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.715404, "o", "            ResponseBodyKind::Empty => true,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.715549, "o", "            ResponseBodyKind::Wrap(body) => body.is_end_stream(),\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.715768, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.71599, "o", "impl<B> fmt::Display for ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.716182, "o", "    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\r\n\u001b[?2004l\r\u001b[?2004h>         f.write_str(\"metadata validator response body\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[577.716353, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[577.727506, "o", "\u001b[?2004hroot@b1aac3828518:/app# "]
