[170.483235, "o", "grep -n \"from_headers\" -n src/tonic/src/metadata/map.rs | head -n 50\r\n\u001b[?2004l\r"]
[170.486093, "o", "244:    pub fn from_headers(headers: http::HeaderMap) -> Self {\r\n2502:    fn test_from_headers_takes_http_headers() {\r\n2506:        let map = MetadataMap::from_headers(http_map);\r\n"]
