[13.704259, "o", "//! Utilities for using Tower services with Tonic.\r\n\r\npub mod interceptor;\r\npub(crate) mod layered;\r\n#[cfg(feature = \"router\")]\r\npub(crate) mod router;\r\n\r\n#[doc(inline)]\r\npub use self::interceptor::{Interceptor, InterceptorLayer};\r\npub use self::layered::{LayerExt, Layered};\r\n#[doc(inline)]\r\n#[cfg(feature = \"router\")]"]
