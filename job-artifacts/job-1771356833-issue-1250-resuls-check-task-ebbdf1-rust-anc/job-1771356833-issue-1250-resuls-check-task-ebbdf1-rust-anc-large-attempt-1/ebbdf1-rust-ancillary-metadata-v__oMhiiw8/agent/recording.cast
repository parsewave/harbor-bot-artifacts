[310.781024, "o", "    /// Build the validator.\r\n\u001b[?2004l\r"]
[310.7811, "o", "\u001b[?2004h> "]
[310.781293, "o", "    pub fn build(self) -> impl MetadataValidator {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.781458, "o", "        Validator { rules: self.rules }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n"]
[310.781617, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.781706, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[310.781991, "o", "/// A layer which validates request metadata before forwarding the request.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.782179, "o", "#[derive(Debug, Clone, Copy)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.7824, "o", "pub struct MetadataValidatorLayer<'a, V> {\r\n\u001b[?2004l\r"]
[310.782491, "o", "\u001b[?2004h> "]
[310.782637, "o", "    validator: &'a V,\r\n\u001b[?2004l\r \u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[310.782774, "o", "\u001b[?2004h> "]
[310.782989, "o", "impl<'a, V> MetadataValidatorLayer<'a, V> {\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[310.78322, "o", "    /// Create a new `MetadataValidatorLayer`.\r\n\u001b[?2004l\r)\u001b[?2004h> "]
[310.783715, "o", "    pub const fn new(validator: &'a V) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h>         Self { validator }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.783796, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rF\u001b[?2004h> "]
[310.78412, "o", "impl<'a, S, V> Layer<S> for MetadataValidatorLayer<'a, V>\r\n\u001b[?2004l\r\u001b[?2004h> where\r\n\u001b[?2004l\r\u001b[?2004h>     V: MetadataValidator,\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.784214, "o", "> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.784496, "o", "    type Service = MetadataValidatedService<'a, S, V>;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[310.78465, "o", "> "]
[310.784812, "o", "    fn layer(&self, inner: S) -> Self::Service {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.784981, "o", "        MetadataValidatedService {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.7852, "o", "            inner,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.785397, "o", "            validator: self.validator,\r\n\u001b[?2004l\rh\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\rp"]
[310.785581, "o", "o\u001b[?2004h> }\r\n\u001b[?2004l\rll\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.785749, "o", "/// A service which validates request metadata.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.785983, "o", "#[derive(Clone, Copy)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.786189, "o", "pub struct MetadataValidatedService<'a, S, V> {\r\n\u001b[?2004l\r\u001b[?2004h>     inner: S,\r\n\u001b[?2004l\r"]
[310.786336, "o", "\u001b[?2004h> "]
[310.786502, "o", "    validator: &'a V,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.786674, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[310.786808, "o", "impl<'a, S, V> fmt::Debug for MetadataValidatedService<'a, S, V>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.786932, "o", "where\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[310.78708, "o", "    S: fmt::Debug,\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.787262, "o", "    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.787525, "o", "        f.debug_struct(\"MetadataValidatedService\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.787724, "o", "            .field(\"inner\", &self.inner)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.787985, "o", "            .field(\"validator\", &format_args!(\"{}\", std::any::type_name::<V>()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.788132, "o", "            .finish()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.788223, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.788475, "o", "impl<'a, S, V, ReqBody, ResBody> Service<http::Request<ReqBody>>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.788666, "o", "    for MetadataValidatedService<'a, S, V>\r\n\u001b[?2004l\r\u001b[?2004h> where\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.788951, "o", "    S: Service<http::Request<ReqBody>, Response = http::Response<ResBody>>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.789103, "o", "    V: MetadataValidator,\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.789381, "o", ">     type Response = http::Response<ResponseBody<ResBody>>;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.789617, "o", "    type Error = S::Error;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.78978, "o", "    type Future = ResponseFuture<S::Future, S::Error, ResBody>;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.790064, "o", "    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.790311, "o", "        self.inner.poll_ready(cx)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.790501, "o", "    fn call(&mut self, req: http::Request<ReqBody>) -> Self::Future {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.79072, "o", "        let (mut parts, body) = req.into_parts();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.790907, "o", "        let headers = std::mem::take(&mut parts.headers);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.791131, "o", "        let metadata = MetadataMap::from_headers(headers);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[310.791242, "o", "\u001b[?2004h> "]
[310.791501, "o", "        match self.validator.validate(&metadata) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.791631, "o", "            Ok(()) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.791766, "o", "                parts.headers = metadata.into_headers();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.791958, "o", "                let req = http::Request::from_parts(parts, body);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.792164, "o", "                ResponseFuture::Inner {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.792304, "o", "                    inner: self.inner.call(req),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.792446, "o", "                }\r\n\u001b[?2004l\r"]
[310.792702, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.792908, "o", ">             Err(status) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.793009, "o", "                let (parts, ()) = status.into_http::<()>().into_parts();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.79324, "o", "                let res = http::Response::from_parts(parts, ResponseBody::empty());\r\n\u001b[?2004l\r"]
[310.79337, "o", "\u001b[?2004h> "]
[310.79355, "o", "                ResponseFuture::Ready {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.793718, "o", "                    inner: std::future::ready(Ok(res)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.793878, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.794058, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.794299, "o", "/// Response body used by the metadata validator middleware.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.794367, "o", "#[pin_project]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.794552, "o", "pub struct ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h>     #[pin]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.794677, "o", "    inner: Option<B>,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[310.794742, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[310.794989, "o", "> "]
[310.795177, "o", "impl<B> ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h>     fn full(inner: B) -> Self {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.795259, "o", "        Self { inner: Some(inner) }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[310.795349, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.795628, "o", "    const fn empty() -> Self {\r\n\u001b[?2004l\r\u001b[?2004h>         Self { inner: None }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[310.795714, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[310.795978, "o", "> impl<B> fmt::Debug for ResponseBody<B> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.796286, "o", "    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.796364, "o", "        f.debug_struct(\"ResponseBody\").finish()\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[310.796429, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[310.796659, "o", "\u001b[?2004h> "]
[310.796875, "o", "impl<B> http_body::Body for ResponseBody<B>\r\n\u001b[?2004l\r\u001b[?2004h> where\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.796983, "o", "    B: http_body::Body,\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h>     type Data = B::Data;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.797115, "o", "    type Error = B::Error;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[310.797272, "o", ">     fn poll_frame(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.797346, "o", "        self: Pin<&mut Self>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.79747, "o", "        cx: &mut Context<'_>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.797758, "o", "    ) -> Poll<Option<Result<http_body::Frame<Self::Data>, Self::Error>>> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.797975, "o", "        match self.project().inner.as_pin_mut() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.798188, "o", "            Some(b) => b.poll_frame(cx),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.798326, "o", "            None => Poll::Ready(None),\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.798416, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.798571, "o", "    fn is_end_stream(&self) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.798815, "o", "        match &self.inner {\r\n\u001b[?2004l\r\u001b[?2004h>             Some(b) => b.is_end_stream(),\r\n\u001b[?2004l\r"]
[310.798897, "o", "\u001b[?2004h> "]
[310.862907, "o", "            None => true,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     fn size_hint(&self) -> http_body::SizeHint {\r\n\u001b[?2004l\r\u001b[?2004h>         match &self.inner {\r\n\u001b[?2004l\r\u001b[?2004h>             Some(b) => b.size_hint(),\r\n\u001b[?2004l\r\u001b[?2004h>             None => http_body::SizeHint::with_exact(0),\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /// Response future for [`MetadataValidatedService`].\r\n\u001b[?2004l\r\u001b[?2004h> #[pin_project(project = ResponseFutureProj)]\r\n\u001b[?2004l\r\u001b[?2004h> pub enum ResponseFuture<F, E, B> {\r\n\u001b[?2004l\r\u001b[?2004h>     /// The wrapped service's response future.\r\n\u001b[?2004l\r\u001b[?2004h>     Inner {\r\n\u001b[?2004l\r\u001b[?2004h>         #[pin]\r\n\u001b[?2004l\r\u001b[?2004h>         inner: F,\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     /// An immediate response future.\r\n\u001b[?2004l\r\u001b[?2004h>     Ready {\r\n\u001b[?2004l\r\u001b[?2004h>         #[pin]\r\n\u001b[?2004l\r\u001b[?2004h>         inner: std::future::Ready<Result<http::Response<ResponseBody<B>>, E>>,\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> impl<F, E, B> fmt::Debug for ResponseFuture<F, E, B> {\r\n\u001b[?2004l\r\u001b[?2004h>     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\r\n\u001b[?2004l\r\u001b[?2004h>         f.debug_struct(\"ResponseFuture\").finish()\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> impl<F, E, ResBody> Future for ResponseFuture<F, E, ResBody>\r\n\u001b[?2004l\r\u001b[?2004h> where\r\n\u001b[?2004l\r\u001b[?2004h>     F: Future<Output = Result<http::Response<ResBody>, E>>,\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.863212, "o", "    type Output = Result<http::Response<ResponseBody<ResBody>>, E>;\r\n\u001b[?2004l\r"]
[310.863375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[310.863532, "o", "> "]
[310.863661, "o", "    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {\r\n\u001b[?2004l\r\u001b[?2004h>         match self.project() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.863905, "o", "            ResponseFutureProj::Inner { inner } => match ready!(inner.poll(cx)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.864126, "o", "                Ok(res) => Poll::Ready(Ok(res.map(ResponseBody::full))),\r\n\u001b[?2004l\r"]
[310.864198, "o", "\u001b[?2004h> "]
[310.864395, "o", "                Err(err) => Poll::Ready(Err(err)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.864577, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.864745, "o", "            ResponseFutureProj::Ready { inner } => inner.poll(cx),\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[310.864872, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.864977, "o", "EOF\r\n\u001b[?2004l\r"]
[310.875319, "o", "\u001b[?2004hroot@830ef13b33a0:/app# "]
