Sending keys: ['cat > /app/src/ContractSpec.java <<\'EOF\'\npublic class ContractSpec {\n    private final String contractCode;\n    private final int multiplier;\n    private final String expiryMonth;\n    private final String underlying;\n\n    public ContractSpec(String contractCode, int multiplier, String expiryMonth, String underlying) {\n        this.contractCode = contractCode;\n        this.multiplier = multiplier;\n        this.expiryMonth = expiryMonth;\n        this.underlying = underlying;\n    }\n\n    public String getContractCode() {\n        return contractCode;\n    }\n\n    public int getMultiplier() {\n        return multiplier;\n    }\n\n    public String getExpiryMonth() {\n        return expiryMonth;\n    }\n\n    public String getUnderlying() {\n        return underlying;\n    }\n\n    public static ContractSpec parseCsv(String line) {\n        // contract_code,multiplier,expiry_month,underlying\n        String[] parts = splitCsv(line);\n        String code = parts[0];\n        int mult = Integer.parseInt(parts[1]);\n        String expiry = parts[2];\n        String und = parts[3];\n        return new ContractSpec(code, mult, expiry, und);\n    }\n\n    private static String[] splitCsv(String line) {\n        String[] raw = line.split(",", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class PositionAggregator {\n\n    public static class UnderlyingNet {\n        private long netDelta; // sum(position_qty * multiplier)\n        private String representativeContractCode; // contract with highest OI equivalent in this account+underlying\n        private long representativeOiEquivalent;\n\n        public UnderlyingNet() {\n            this.netDelta = 0L;\n            this.representativeContractCode = null;\n            this.representativeOiEquivalent = -1L;\n        }\n\n        public void addPosition(Position p, ContractSpec spec) {\n            long deltaEq = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());\n            netDelta += deltaEq;\n\n            long oiEq = ((long) Math.abs(p.getPositionQty())) * ((long) spec.getMultiplier());\n            if (oiEq > representativeOiEquivalent) {\n                representativeOiEquivalent = oiEq;\n                representativeContractCode = p.getContractCode();\n            }\n        }\n\n        public long getNetDelta() {\n            return netDelta;\n        }\n\n        public String getRepresentativeContractCode() {\n            return representativeContractCode;\n        }\n    }\n\n    private final Map<String, List<Position>> positionsByAccount;\n    private final Map<String, Map<String, UnderlyingNet>> netsByAccountUnderlying;\n\n    public PositionAggregator(List<Position> positions, Map<String, ContractSpec> specsByContract) {\n        positionsByAccount = new HashMap<String, List<Position>>();\n        netsByAccountUnderlying = new HashMap<String, Map<String, UnderlyingNet>>();\n\n        for (Position p : positions) {\n            ContractSpec spec = specsByContract.get(p.getContractCode());\n            if (spec == null) {\n                continue;\n            }\n\n            List<Position> acctPositions = positionsByAccount.get(p.getAccountId());\n            if (acctPositions == null) {\n                acctPositions = new ArrayList<Position>();\n                positionsByAccount.put(p.getAccountId(), acctPositions);\n            }\n            acctPositions.add(p);\n\n            String underlying = spec.getUnderlying();\n            Map<String, UnderlyingNet> byUnd = netsByAccountUnderlying.get(p.getAccountId());\n            if (byUnd == null) {\n                byUnd = new HashMap<String, UnderlyingNet>();\n                netsByAccountUnderlying.put(p.getAccountId(), byUnd);\n            }\n            UnderlyingNet net = byUnd.get(underlying);\n            if (net == null) {\n                net = new UnderlyingNet();\n                byUnd.put(underlying, net);\n            }\n            net.addPosition(p, spec);\n        }\n    }\n\n    public Map<String, List<Position>> getPositionsByAccount() {\n        return positionsByAccount;\n    }\n\n    public Map<String, Map<String, UnderlyingNet>> getNetsByAccountUnderlying() {\n        return netsByAccountUnderlying;\n    }\n}\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/AccountMargin.java <<'EOF'\npublic class AccountMargin {\n    private final String accountId;\n    private final long netDeltaExposure;\n    private final long scanningRisk;\n    private final long spreadCharge;\n    private final long initialMargin;\n    private final long unrealizedPnl;\n    private final String marginStatus;\n\n    public AccountMargin(String accountId,\n                         long netDeltaExposure,\n                         long scanningRisk,\n                         long spreadCharge,\n                         long initialMargin,\n                         long unrealizedPnl,\n                         String marginStatus) {\n        this.accountId = accountId;\n        this.netDeltaExposure = netDeltaExposure;\n        this.scanningRisk = scanningRisk;\n        this.spreadCharge = spreadCharge;\n        this.initialMargin = initialMargin;\n        this.unrealizedPnl = unrealizedPnl;\n        this.marginStatus = marginStatus;\n    }\n\n    public String getAccountId() {\n        return accountId;\n    }\n\n    public String toCsvRow() {\n        StringBuilder sb = new StringBuilder();\n        sb.append(accountId).append(',');\n        sb.append(netDeltaExposure).append(',');\n        sb.append(scanningRisk).append(',');\n        sb.append(spreadCharge).append(',');\n        sb.append(initialMargin).append(',');\n        sb.append(unrealizedPnl).append(',');\n        sb.append(marginStatus);\n        return sb.toString();\n    }\n}\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/src/MarginCalculator.java <<\'EOF\'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class MarginCalculator {\n\n    private final Map<String, MarketData> marketByContract;\n    private final Map<String, ContractSpec> specByContract;\n    private final Map<String, BigDecimal> maxScanRangeFractionByUnderlying;\n\n    public MarginCalculator(Map<String, MarketData> marketByContract,\n                            Map<String, ContractSpec> specByContract) {\n        this.marketByContract = marketByContract;\n        this.specByContract = specByContract;\n        this.maxScanRangeFractionByUnderlying = computeMaxScanRangeFractionByUnderlying(marketByContract, specByContract);\n    }\n\n    public List<AccountMargin> calculate(PositionAggregator aggregator) {\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        Map<String, List<Position>> positionsByAccount = aggregator.getPositionsByAccount();\n        Map<String, Map<String, PositionAggregator.UnderlyingNet>> nets = aggregator.getNetsByAccountUnderlying();\n\n        for (Map.Entry<String, List<Position>> acctEntry : positionsByAccount.entrySet()) {\n            String accountId = acctEntry.getKey();\n            List<Position> positions = acctEntry.getValue();\n\n            Map<String, PositionAggregator.UnderlyingNet> byUnd = nets.get(accountId);\n            if (byUnd == null) {\n                byUnd = new HashMap<String, PositionAggregator.UnderlyingNet>();\n            }\n\n            long netDeltaExposureAbsSum = 0L;\n            long scanningRiskSum = 0L;\n\n            for (Map.Entry<String, PositionAggregator.UnderlyingNet> undEntry : byUnd.entrySet()) {\n                String underlying = undEntry.getKey();\n                PositionAggregator.UnderlyingNet net = undEntry.getValue();\n\n                long netDelta = net.getNetDelta();\n                netDeltaExposureAbsSum += Math.abs(netDelta);\n\n                BigDecimal scanRangeFrac = maxScanRangeFractionByUnderlying.get(underlying);\n                if (scanRangeFrac == null) {\n                    scanRangeFrac = BigDecimal.ZERO;\n                }\n\n                BigDecimal repSettle = BigDecimal.ZERO;\n                String repContract = net.getRepresentativeContractCode();\n                if (repContract != null) {\n                    MarketData md = marketByContract.get(repContract);\n                    if (md != null) {\n                        repSettle = md.getSettlementPrice();\n                    }\n                }\n\n                BigDecimal absDelta = new BigDecimal(String.valueOf(Math.abs(netDelta)));\n                BigDecimal risk = absDelta.multiply(scanRangeFrac).multiply(repSettle);\n                long riskTrunc = truncToLong(risk);\n                scanningRiskSum += riskTrunc;\n            }\n\n            BigDecimal spreadCharge = BigDecimal.ZERO;\n            BigDecimal unrealizedPnl = BigDecimal.ZERO;\n\n            for (Position p : positions) {\n                ContractSpec spec = specByContract.get(p.getContractCode());\n                MarketData md = marketByContract.get(p.getContractCode());\n                if (spec == null || md == null) {\n                    continue;\n                }\n\n                int qty = p.getPositionQty();\n                int mult = spec.getMultiplier();\n\n                BigDecimal absQty = new BigDecimal(String.valueOf(Math.abs(qty)));\n                spreadCharge = spreadCharge.add(absQty.multiply(md.getIntraSpreadCharge()));\n\n                BigDecimal qtyBd = new BigDecimal(String.valueOf(qty));\n                BigDecimal multBd = new BigDecimal(String.valueOf(mult));\n                BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());\n                unrealizedPnl = unrealizedPnl.add(qtyBd.multiply(multBd).multiply(priceDiff));\n            }\n\n            long spreadChargeTrunc = truncToLong(spreadCharge);\n            long initialMargin = scanningRiskSum + spreadChargeTrunc;\n            long unrealizedPnlTrunc = truncToLong(unrealizedPnl);\n\n            String status = (unrealizedPnlTrunc >= initialMargin) ? "ADEQUATE" : "CALL";\n\n            results.add(new AccountMargin(accountId,\n                    netDeltaExposureAbsSum,\n                    scanningRiskSum,\n                    spreadChargeTrunc,\n                    initialMargin,\n                    unrealizedPnlTrunc,\n                    status));\n        }\n\n        Collections.sort(results, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a, AccountMargin b) {\n                return a.getAccountId().compareTo(b.getAccountId());\n            }\n        });\n\n        return results;\n    }\n\n    private static Map<String, BigDecimal> computeMaxScanRangeFractionByUnderlying(\n            Map<String, MarketData> marketByContract,\n            Map<String, ContractSpec> specByContract) {\n        Map<String, BigDecimal> maxByUnd = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, MarketData> e : marketByContract.entrySet()) {\n            String contract = e.getKey();\n            MarketData md = e.getValue();\n            ContractSpec spec = specByContract.get(contract);\n            if (spec == null) {\n                continue;\n            }\n            String underlying = spec.getUnderlying();\n            BigDecimal frac = md.getScanningRangePct().divide(new BigDecimal("100"));\n            BigDecimal cur = maxByUnd.get(underlying);\n            if (cur == null || frac.compareTo(cur) > 0) {\n                maxByUnd.put(underlying, frac);\n            }\n        }\n        return maxByUnd;\n    }\n\n    private static long truncToLong(BigDecimal value) {\n        // truncation toward zero\n        return value.setScale(0, RoundingMode.DOWN).longValue();\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/src/Main.java <<\'EOF\'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.nio.charset.Charset;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class Main {\n\n    public static void main(String[] args) {\n        if (args == null || args.length != 4) {\n            // No stderr output per requirements\n            System.exit(1);\n            return;\n        }\n\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        try {\n            List<Position> positions = loadPositions(positionsPath);\n            Map<String, MarketData> market = loadMarketData(marketDataPath);\n            Map<String, ContractSpec> specs = loadContractSpecs(contractSpecsPath);\n\n            PositionAggregator aggregator = new PositionAggregator(positions, specs);\n            MarginCalculator calculator = new MarginCalculator(market, specs);\n            List<AccountMargin> margins = calculator.calculate(aggregator);\n\n            writeOutput(outputPath, margins);\n        } catch (Exception ex) {\n            // No stderr output; just non-zero exit\n            System.exit(2);\n        }\n    }\n\n    private static List<Position> loadPositions(String path) throws Exception {\n        List<Position> out = new ArrayList<Position>();\n        BufferedReader br = reader(path);\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                out.add(Position.parseCsv(line));\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws Exception {\n        Map<String, MarketData> out = new HashMap<String, MarketData>();\n        BufferedReader br = reader(path);\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                MarketData md = MarketData.parseCsv(line);\n                out.put(md.getContractCode(), md);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws Exception {\n        Map<String, ContractSpec> out = new HashMap<String, ContractSpec>();\n        BufferedReader br = reader(path);\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                ContractSpec spec = ContractSpec.parseCsv(line);\n                out.put(spec.getContractCode(), spec);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static void writeOutput(String outputPath, List<AccountMargin> margins) throws Exception {\n        BufferedWriter bw = writer(outputPath);\n        try {\n            bw.write("account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status");\n            bw.newLine();\n            for (AccountMargin m : margins) {\n                bw.write(m.toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            bw.close();\n        }\n    }\n\n    private static BufferedReader reader(String path) throws Exception {\n        return new BufferedReader(new InputStreamReader(new FileInputStream(path), Charset.forName("UTF-8")));\n    }\n\n    private static BufferedWriter writer(String path) throws Exception {\n        return new BufferedWriter(new OutputStreamWriter(new FileOutputStream(path), Charset.forName("UTF-8")));\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
