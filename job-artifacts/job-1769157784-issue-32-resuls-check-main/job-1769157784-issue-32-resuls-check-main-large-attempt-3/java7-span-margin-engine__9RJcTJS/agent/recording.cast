[105.74061, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class PositionAggregator {\n\n    public static class UnderlyingNet {\n        private long netDelta; // sum(position_qty * multiplier)\n        private String representativeContractCode; // contract with highest OI equivalent in this account+underlying\n        private long representativeOiEquivalent;\n\n        public UnderlyingNet() {\n            this.netDelta = 0L;\n            this.representativeContractCode = null;\n            this.representativeOiEquivalent = -1L;\n        }\n\n        public void addPosition(Position p, ContractSpec spec) {\n            long deltaEq = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());\n            netDelta += deltaEq;\n\n            long oiEq = ((long) Math.abs(p.getPositionQty())) * ((long) spec.getMultiplier());\n            if (oiEq > representativeOiEquivalent) {\n                representativeOiEquivalent = oiEq;\n                representativeContractCode = p.getContractCode();\n            }\n        }\n\n        public long getNetDelta() {\n            return netDelta;\n        }\n\n        public String getRepresentativeContractCode() {\n            return representativeContractCode;\n        }\n    }\n\n    private final Map<String, List<Position>> positionsByAccount;\n    private final Map<String, Map<String, UnderlyingNet>> netsByAccountUnderlying;\n\n    public PositionAggregator(List<Position> positions, Map<String, ContractSpec> specsByContract) {\n        positionsByAccount = new HashMap<String, List<Position>>();\n        netsByAccountUnderlying = new HashMap<String, Map<String, UnderlyingNet>>();\n\n        for (Position p : positions) {\n            ContractSpec spec = specsByContract.get(p.getContractCode());\n            if (spec == null) {\n                continue;\n            }\n\n            List<Position> acctPositions = positionsByAccount.get(p.getAccountId());\n            if (acctPositions == null) {\n                acctPositions = new ArrayList<Position>();\n                positionsByAccount.put(p.getAccountId(), acctPositions);\n            }\n            acctPositions.add(p);\n\n            String underlying = spec.getUnderlying();\n            Map<String, UnderlyingNet> byUnd = netsByAccountUnderlying.get(p.getAccountId());\n            if (byUnd == null) {\n                byUnd = new HashMap<String, UnderlyingNet>();\n                netsByAccountUnderlying.put(p.getAccountId(), byUnd);\n            }\n            UnderlyingNet net = byUnd.get(underlying);\n            if (net == null) {\n                net = new UnderlyingNet();\n                byUnd.put(underlying, net);\n            }\n            net.addPosition(p, spec);\n        }\n    }\n\n    public Map<String, List<Position>> getPositionsByAccount() {\n        return positionsByAccount;\n    }\n\n    public Map<String, Map<String, UnderlyingNet>> getNetsByAccountUnderlying() {\n        return netsByAccountUnderlying;\n    }\n}\nEOF\n"]
