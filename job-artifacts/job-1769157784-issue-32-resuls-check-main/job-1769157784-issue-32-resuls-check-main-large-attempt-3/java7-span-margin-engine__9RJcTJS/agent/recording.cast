[105.385724, "i", "cat > /app/src/MarketData.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic class MarketData {\n    private final String contractCode;\n    private final BigDecimal settlementPrice;\n    private final BigDecimal scanningRangePct;\n    private final BigDecimal intraSpreadCharge;\n\n    public MarketData(String contractCode,\n                      BigDecimal settlementPrice,\n                      BigDecimal scanningRangePct,\n                      BigDecimal intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRangePct = scanningRangePct;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public String getContractCode() {\n        return contractCode;\n    }\n\n    public BigDecimal getSettlementPrice() {\n        return settlementPrice;\n    }\n\n    public BigDecimal getScanningRangePct() {\n        return scanningRangePct;\n    }\n\n    public BigDecimal getIntraSpreadCharge() {\n        return intraSpreadCharge;\n    }\n\n    public static MarketData parseCsv(String line) {\n        // contract_code,settlement_price,scanning_range,intra_spread_charge\n        String[] parts = splitCsv(line);\n        String code = parts[0];\n        BigDecimal settle = new BigDecimal(parts[1]);\n        BigDecimal scanPct = new BigDecimal(parts[2]);\n        BigDecimal charge = new BigDecimal(parts[3]);\n        return new MarketData(code, settle, scanPct, charge);\n    }\n\n    private static String[] splitCsv(String line) {\n        String[] raw = line.split(\",\", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n"]
