[105.563603, "i", "cat > /app/src/ContractSpec.java <<'EOF'\npublic class ContractSpec {\n    private final String contractCode;\n    private final int multiplier;\n    private final String expiryMonth;\n    private final String underlying;\n\n    public ContractSpec(String contractCode, int multiplier, String expiryMonth, String underlying) {\n        this.contractCode = contractCode;\n        this.multiplier = multiplier;\n        this.expiryMonth = expiryMonth;\n        this.underlying = underlying;\n    }\n\n    public String getContractCode() {\n        return contractCode;\n    }\n\n    public int getMultiplier() {\n        return multiplier;\n    }\n\n    public String getExpiryMonth() {\n        return expiryMonth;\n    }\n\n    public String getUnderlying() {\n        return underlying;\n    }\n\n    public static ContractSpec parseCsv(String line) {\n        // contract_code,multiplier,expiry_month,underlying\n        String[] parts = splitCsv(line);\n        String code = parts[0];\n        int mult = Integer.parseInt(parts[1]);\n        String expiry = parts[2];\n        String und = parts[3];\n        return new ContractSpec(code, mult, expiry, und);\n    }\n\n    private static String[] splitCsv(String line) {\n        String[] raw = line.split(\",\", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n"]
