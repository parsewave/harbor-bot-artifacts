[170.943618, "o", "    private static Map<String, BigDecimal> computeMaxScanRangeFractionByUnderlying(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.943766, "o", "            Map<String, MarketData> marketByContract,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.943894, "o", "            Map<String, ContractSpec> specByContract) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.944116, "o", "        Map<String, BigDecimal> maxByUnd = new HashMap<String, BigDecimal>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.944327, "o", "        for (Map.Entry<String, MarketData> e : marketByContract.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.944456, "o", "            String contract = e.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.944661, "o", "            MarketData md = e.getValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.944869, "o", "            ContractSpec spec = specByContract.get(contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.944956, "o", "            if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.94513, "o", "                continue;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.945241, "o", "            String underlying = spec.getUnderlying();\r\n\u001b[?2004l\r"]
[170.94544, "o", "\u001b[?2004h> "]
[170.945604, "o", "            BigDecimal frac = md.getScanningRangePct().divide(new BigDecimal(\"100\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.945748, "o", "            BigDecimal cur = maxByUnd.get(underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.945886, "o", "            if (cur == null || frac.compareTo(cur) > 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.946021, "o", "                maxByUnd.put(underlying, frac);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[170.946163, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.946334, "o", "        return maxByUnd;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.94647, "o", "    private static long truncToLong(BigDecimal value) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.946651, "o", "        // truncation toward zero\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.946861, "o", "        return value.setScale(0, RoundingMode.DOWN).longValue();\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[170.946991, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
