[106.241617, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.nio.charset.Charset;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class Main {\n\n    public static void main(String[] args) {\n        if (args == null || args.length != 4) {\n            // No stderr output per requirements\n            System.exit(1);\n            return;\n        }\n\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        try {\n            List<Position> positions = loadPositions(positionsPath);\n            Map<String, MarketData> market = loadMarketData(marketDataPath);\n            Map<String, ContractSpec> specs = loadContractSpecs(contractSpecsPath);\n\n            PositionAggregator aggregator = new PositionAggregator(positions, specs);\n            MarginCalculator calculator = new MarginCalculator(market, specs);\n            List<AccountMargin> margins = calculator.calculate(aggregator);\n\n            writeOutput(outputPath, margins);\n        } catch (Exception ex) {\n            // No stderr output; just non-zero exit\n            System.exit(2);\n        }\n    }\n\n    private static List<Position> loadPositions(String path) throws Exception {\n        List<Position> out = new ArrayList<Position>();\n        BufferedReader br = reader(path);\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                out.add(Position.parseCsv(line));\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws Exception {\n        Map<String, MarketData> out = new HashMap<String, MarketData>();\n        BufferedReader br = reader(path);\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                MarketData md = MarketData.parseCsv(line);\n                out.put(md.getContractCode(), md);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws Exception {\n        Map<String, ContractSpec> out = new HashMap<String, ContractSpec>();\n        BufferedReader br = reader(path);\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                ContractSpec spec = ContractSpec.parseCsv(line);\n                out.put(spec.getContractCode(), spec);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static void writeOutput(String outputPath, List<AccountMargin> margins) throws Exception {\n        BufferedWriter bw = writer(outputPath);\n        try {\n            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\n            bw.newLine();\n            for (AccountMargin m : margins) {\n                bw.write(m.toCsvRow());\n                bw.newLine("]
[106.241745, "i", ");\n            }\n        } finally {\n            bw.close();\n        }\n    }\n\n    private static BufferedReader reader(String path) throws Exception {\n        return new BufferedReader(new InputStreamReader(new FileInputStream(path), Charset.forName(\"UTF-8\")));\n    }\n\n    private static BufferedWriter writer(String path) throws Exception {\n        return new BufferedWriter(new OutputStreamWriter(new FileOutputStream(path), Charset.forName(\"UTF-8\")));\n    }\n}\nEOF\n"]
