[170.91742, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class MarginCalculator {\n\n    private final Map<String, MarketData> marketByContract;\n    private final Map<String, ContractSpec> specByContract;\n    private final Map<String, BigDecimal> maxScanRangeFractionByUnderlying;\n\n    public MarginCalculator(Map<String, MarketData> marketByContract,\n                            Map<String, ContractSpec> specByContract) {\n        this.marketByContract = marketByContract;\n        this.specByContract = specByContract;\n        this.maxScanRangeFractionByUnderlying = computeMaxScanRangeFractionByUnderlying(marketByContract, specByContract);\n    }\n\n    public List<AccountMargin> calculate(PositionAggregator aggregator) {\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        Map<String, List<Position>> positionsByAccount = aggregator.getPositionsByAccount();\n        Map<String, Map<String, PositionAggregator.UnderlyingNet>> nets = aggregator.getNetsByAccountUnderlying();\n\n        for (Map.Entry<String, List<Position>> acctEntry : positionsByAccount.entrySet()) {\n            String accountId = acctEntry.getKey();\n            List<Position> positions = acctEntry.getValue();\n\n            Map<String, PositionAggregator.UnderlyingNet> byUnd = nets.get(accountId);\n            if (byUnd == null) {\n                byUnd = new HashMap<String, PositionAggregator.UnderlyingNet>();\n            }\n\n            long netDeltaExposureAbsSum = 0L;\n            long scanningRiskSum = 0L;\n\n            for (Map.Entry<String, PositionAggregator.UnderlyingNet> undEntry : byUnd.entrySet()) {\n                String underlying = undEntry.getKey();\n                PositionAggregator.UnderlyingNet net = undEntry.getValue();\n\n                long netDelta = net.getNetDelta();\n                netDeltaExposureAbsSum += Math.abs(netDelta);\n\n                BigDecimal scanRangeFrac = maxScanRangeFractionByUnderlying.get(underlying);\n                if (scanRangeFrac == null) {\n                    scanRangeFrac = BigDecimal.ZERO;\n                }\n\n                BigDecimal repSettle = BigDecimal.ZERO;\n                String repContract = net.getRepresentativeContractCode();\n                if (repContract != null) {\n                    MarketData md = marketByContract.get(repContract);\n                    if (md != null) {\n                        repSettle = md.getSettlementPrice();\n                    }\n                }\n\n                BigDecimal absDelta = new BigDecimal(String.valueOf(Math.abs(netDelta)));\n                BigDecimal risk = absDelta.multiply(scanRangeFrac).multiply(repSettle);\n                long riskTrunc = truncToLong(risk);\n                scanningRiskSum += riskTrunc;\n            }\n\n            // Spread charge is computed per contract where account holds a position:\n            // abs(net_position_qty_in_contract) * intra_spread_charge\n            Map<String, Integer> netQtyByContract = new HashMap<String, Integer>();\n            for (Position p : positions) {\n                Integer cur = netQtyByContract.get(p.getContractCode());\n                if (cur == null) {\n                    cur = Integer.valueOf(0);\n                }\n                netQtyByContract.put(p.getContractCode(), Integer.valueOf(cur.intValue() + p.getPositionQty()));\n            }\n\n            BigDecimal spreadCharge = BigDecimal.ZERO;\n            for (Map.Entry<String, Integer> e : netQtyByContract.entrySet()) {\n                int netQty = e.getValue().intValue();\n                if (netQty == 0) {\n                    continue;\n                }\n                MarketData md = marketByContract.get(e.getKey());\n                if (md == null) {\n                    continue;\n                }\n                BigDecimal absQty = new BigDecimal(String.valueOf(Math.abs(netQty)));\n                spreadCharge = spreadCharge.add(absQ"]
[170.91783, "i", "ty.multiply(md.getIntraSpreadCharge()));\n            }\n\n            // Unrealized PnL is per position row as specified (entry price can differ)\n            BigDecimal unrealizedPnl = BigDecimal.ZERO;\n            for (Position p : positions) {\n                ContractSpec spec = specByContract.get(p.getContractCode());\n                MarketData md = marketByContract.get(p.getContractCode());\n                if (spec == null || md == null) {\n                    continue;\n                }\n\n                int qty = p.getPositionQty();\n                int mult = spec.getMultiplier();\n\n                BigDecimal qtyBd = new BigDecimal(String.valueOf(qty));\n                BigDecimal multBd = new BigDecimal(String.valueOf(mult));\n                BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());\n                unrealizedPnl = unrealizedPnl.add(qtyBd.multiply(multBd).multiply(priceDiff));\n            }\n\n            long spreadChargeTrunc = truncToLong(spreadCharge);\n            long initialMargin = scanningRiskSum + spreadChargeTrunc;\n            long unrealizedPnlTrunc = truncToLong(unrealizedPnl);\n\n            String status = (unrealizedPnlTrunc >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\n\n            results.add(new AccountMargin(accountId,\n                    netDeltaExposureAbsSum,\n                    scanningRiskSum,\n                    spreadChargeTrunc,\n                    initialMargin,\n                    unrealizedPnlTrunc,\n                    status));\n        }\n\n        Collections.sort(results, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a, AccountMargin b) {\n                return a.getAccountId().compareTo(b.getAccountId());\n            }\n        });\n\n        return results;\n    }\n\n    private static Map<String, BigDecimal> computeMaxScanRangeFractionByUnderlying(\n            Map<String, MarketData> marketByContract,\n            Map<String, ContractSpec> specByContract) {\n        Map<String, BigDecimal> maxByUnd = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, MarketData> e : marketByContract.entrySet()) {\n            String contract = e.getKey();\n            MarketData md = e.getValue();\n            ContractSpec spec = specByContract.get(contract);\n            if (spec == null) {\n                continue;\n            }\n            String underlying = spec.getUnderlying();\n            BigDecimal frac = md.getScanningRangePct().divide(new BigDecimal(\"100\"));\n            BigDecimal cur = maxByUnd.get(underlying);\n            if (cur == null || frac.compareTo(cur) > 0) {\n                maxByUnd.put(underlying, frac);\n            }\n        }\n        return maxByUnd;\n    }\n\n    private static long truncToLong(BigDecimal value) {\n        // truncation toward zero\n        return value.setScale(0, RoundingMode.DOWN).longValue();\n    }\n}\nEOF\n"]
