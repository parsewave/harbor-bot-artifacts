[?2004l[?2004h> 
[?2004l.[?2004h>                 BigDecimal scanRangeFrac = maxScanRangeFractionByUnderlying.get(underlying);
[?2004l.[?2004h>                 if (scanRangeFrac == null) {
[?2004l[?2004h>                     scanRangeFrac = BigDecimal.ZERO;
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l [?2004h>                 BigDecimal repSettle = BigDecimal.ZERO;
[?2004l[?2004h>                 String repContract = net.getRepresentativeContractCode();
[?2004l[?2004h>                 if (repContract != null) {
[?2004l[?2004h>                     MarketData md = marketByContract.get(repContract);
[?2004l[?2004h>                     if (md != null) {
[?2004lcu[?2004h>                         repSettle = md.getSettlementPrice();
[?2004l[?2004h>                     }
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l
[?2004h>                 BigDecimal absDelta = new BigDecimal(String.valueOf(Math.abs(netDelta)));
[?2004l[?2004h>                 BigDecimal risk = absDelta.multiply(scanRangeFrac).multiply(repSettle);
[?2004l[?2004h>                 long riskTrunc = truncToLong(risk);
[?2004l[?2004h>                 scanningRiskSum += riskTrunc;
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             // Spread charge is computed per contract where account holds a position:
[?2004l[?2004h>             // abs(net_position_qty_in_contract) * intra_spread_charge
[?2004l[?2004h>             Map<String, Integer> netQtyByContract = new HashMap<String, Integer>();
[?2004l[?2004h>             for (Position p : positions) {
[?2004l[?2004h>                 Integer cur = netQtyByContract.get(p.getContractCode());
[?2004l[?2004h>                 if (cur == null) {
[?2004l[?2004h>                     cur = Integer.valueOf(0);
[?2004l[?2004h>                 }
[?2004l[?2004h>                 netQtyByContract.put(p.getContractCode(), Integer.valueOf(cur.intValue() + p.getPositionQty()));
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal spreadCharge = BigDecimal.ZERO;
[?2004l[?2004h>             for (Map.Entry<String, Integer> e : netQtyByContract.entrySet()) {
[?2004l[?2004h>                 int netQty = e.getValue().intValue();
[?2004l[?2004h>                 if (netQty == 0) {
[?2004l[?2004h>                     continue;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 MarketData md = marketByContract.get(e.getKey());
[?2004l[?2004h>                 if (md == null) {
[?2004l[?2004h>                     continue;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 BigDecimal absQty = new BigDecimal(String.valueOf(Math.abs(netQty)));
[?2004l[?2004h>                 spreadCharge = spreadCharge.add(absQty.multiply(md.getIntraSpreadCharge()));
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             // Unrealized PnL is per position row as specified (entry price can differ)
[?2004l[?2004h>             BigDecimal unrealizedPnl = BigDecimal.ZERO;
[?2004l[?2004h>             for (Position p : positions) {
[?2004l[?2004h>                 ContractSpec spec = specByContract.get(p.getContractCode());
[?2004l[?2004h>                 MarketData md = marketByContract.get(p.getContractCode());
[?2004l[?2004h>                 if (spec == null || md == null) {
[?2004l[?2004h>                     continue;
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 int qty = p.getPositionQty();
[?2004l[?2004h>                 int mult = spec.getMultiplier();
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal qtyBd = new BigDecimal(String.valueOf(qty));
[?2004l[?2004h>                 BigDecimal multBd = new BigDecimal(String.valueOf(mult));
[?2004l[?2004h>                 BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());
[?2004l[?2004h>                 unrealizedPnl = unrealizedPnl.add(qtyBd.multiply(multBd).multiply(priceDiff));
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             long spreadChargeTrunc = truncToLong(spreadCharge);
[?2004l[?2004h>             long initialMargin = scanningRiskSum + spreadChargeTrunc;
[?2004l[?2004h>             long unrealizedPnlTrunc = truncToLong(unrealizedPnl);
[?2004l[?2004h> 
[?2004l[?2004h>             String status = (unrealizedPnlTrunc >= initialMargin) ? "ADEQUATE" : "CALL";
[?2004l[?2004h> 
[?2004l[?2004h>             results.add(new AccountMargin(accountId,
[?2004l[?2004h>                     netDeltaExposureAbsSum,
[?2004l[?2004h>                     scanningRiskSum,
[?2004l[?2004h>                     spreadChargeTrunc,
[?2004l[?2004h>                     initialMargin,
[?2004l[?2004h>                     unrealizedPnlTrunc,
[?2004l[?2004h>                     status));
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         Collections.sort(results, new Comparator<AccountMargin>() {
[?2004l[?2004h>             public int compare(AccountMargin a, AccountMargin b) {
[?2004l[?2004h>                 return a.getAccountId().compareTo(b.getAccountId());
[?2004l[?2004h>             }
[?2004l[?2004h>         });
[?2004l[?2004h> 
[?2004l[?2004h>         return results;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private static Map<String, BigDecimal> computeMaxScanRangeFractionByUnderlying(
[?2004l[?2004h>             Map<String, MarketData> marketByContract,
[?2004l[?2004h>             Map<String, ContractSpec> specByContract) {
[?2004l[?2004h>         Map<String, BigDecimal> maxByUnd = new HashMap<String, BigDecimal>();
[?2004l[?2004h>         for (Map.Entry<String, MarketData> e : marketByContract.entrySet()) {
[?2004l[?2004h>             String contract = e.getKey();
[?2004l[?2004h>             MarketData md = e.getValue();
[?2004l[?2004h>             ContractSpec spec = specByContract.get(contract);
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             String underlying = spec.getUnderlying();
[?2004l[?2004h>             BigDecimal frac = md.getScanningRangePct().divide(new BigDecimal("100"));
[?2004l[?2004h>             BigDecimal cur = maxByUnd.get(underlying);
[?2004l[?2004h>             if (cur == null || frac.compareTo(cur) > 0) {
[?2004l[?2004h>                 maxByUnd.put(underlying, frac);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         return maxByUnd;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private static long truncToLong(BigDecimal value) {
[?2004l[?2004h>         // truncation toward zero
[?2004l[?2004h>         return value.setScale(0, RoundingMode.DOWN).longValue();
[?2004l[?2004h>     }
[?2004l[?2004h> }
