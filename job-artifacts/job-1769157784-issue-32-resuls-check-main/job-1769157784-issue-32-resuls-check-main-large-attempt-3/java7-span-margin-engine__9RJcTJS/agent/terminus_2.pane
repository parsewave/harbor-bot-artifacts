[?2004l[?2004h> 
[?2004l[?2004h> public class PositionAggregator {
[?2004l[?2004h> 
[?2004l[?2004h>     public static class UnderlyingNet {
[?2004l[?2004h>         private long netDelta; // sum(position_qty * multiplier)
[?2004l[?2004h>         private String representativeContractCode; // contract with highest OI equivalent in this account+underlying
[?2004l[?2004h>         private long representativeOiEquivalent;
[?2004l[?2004h> 
[?2004l[?2004h>         public UnderlyingNet() {
[?2004l[?2004h>             this.netDelta = 0L;
[?2004l[?2004h>             this.representativeContractCode = null;
[?2004l[?2004h>             this.representativeOiEquivalent = -1L;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public void addPosition(Position p, ContractSpec spec) {
[?2004l[?2004h>             long deltaEq = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());
[?2004l[?2004h>             netDelta += deltaEq;
[?2004l[?2004h> 
[?2004l[?2004h>             long oiEq = ((long) Math.abs(p.getPositionQty())) * ((long) spec.getMultiplier());
[?2004l[?2004h>             if (oiEq > representativeOiEquivalent) {
[?2004l[?2004h>                 representativeOiEquivalent = oiEq;
[?2004l[?2004h>                 representativeContractCode = p.getContractCode();
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public long getNetDelta() {
[?2004l[?2004h>             return netDelta;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public String getRepresentativeContractCode() {
[?2004l[?2004h>             return representativeContractCode;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private final Map<String, List<Position>> positionsByAccount;
[?2004l[?2004h>     private final Map<String, Map<String, UnderlyingNet>> netsByAccountUnderlying;
[?2004l[?2004h> 
[?2004l[?2004h>     public PositionAggregator(List<Position> positions, Map<String, ContractSpec> specsByContract) {
[?2004l[?2004h>         positionsByAccount = new HashMap<String, List<Position>>();
[?2004l[?2004h>         netsByAccountUnderlying = new HashMap<String, Map<String, UnderlyingNet>>();
[?2004l[?2004h> 
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             ContractSpec spec = specsByContract.get(p.getContractCode());
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             List<Position> acctPositions = positionsByAccount.get(p.getAccountId());
[?2004l[?2004h>             if (acctPositions == null) {
[?2004l[?2004h>                 acctPositions = new ArrayList<Position>();
[?2004l[?2004h>                 positionsByAccount.put(p.getAccountId(), acctPositions);
[?2004l[?2004h>             }
[?2004l[?2004h>             acctPositions.add(p);
[?2004l[?2004h> 
[?2004l[?2004h>             String underlying = spec.getUnderlying();
[?2004l[?2004h>             Map<String, UnderlyingNet> byUnd = netsByAccountUnderlying.get(p.getAccountId());
[?2004l[?2004h>             if (byUnd == null) {
[?2004l[?2004h>                 byUnd = new HashMap<String, UnderlyingNet>();
[?2004l[?2004h>                 netsByAccountUnderlying.put(p.getAccountId(), byUnd);
[?2004l[?2004h>             }
[?2004l[?2004h>             UnderlyingNet net = byUnd.get(underlying);
[?2004l[?2004h>             if (net == null) {
[?2004l[?2004h>                 net = new UnderlyingNet();
[?2004l[?2004h>                 byUnd.put(underlying, net);
[?2004l[?2004h>             }
[?2004l[?2004h>             net.addPosition(p, spec);
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public Map<String, List<Position>> getPositionsByAccount() {
