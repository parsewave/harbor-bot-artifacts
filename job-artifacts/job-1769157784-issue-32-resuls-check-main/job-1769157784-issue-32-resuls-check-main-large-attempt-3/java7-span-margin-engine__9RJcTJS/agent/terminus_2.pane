[?2004l[?2004h> import java.util.Map;
[?2004l[?2004h> 
[?2004lu[?2004h> public class MarginCalculator {
[?2004l[?2004h> 
[?2004la[?2004h>     private final Map<String, MarketData> marketByContract;
[?2004l[?2004h>     private final Map<String, ContractSpec> specByContract;
[?2004l[?2004h>     private final Map<String, BigDecimal> maxScanRangeFractionByUnderlying;
[?2004l[?2004h> 
[?2004ls[?2004h>     public MarginCalculator(Map<String, MarketData> marketByContract,
[?2004l[?2004h>                             Map<String, ContractSpec> specByContract) {
[?2004l[?2004h>         this.marketByContract = marketByContract;
[?2004l[?2004h>         this.specByContract = specByContract;
[?2004l[?2004h>         this.maxScanRangeFractionByUnderlying = computeMaxScanRangeFractionByUnderlying(marketByContract, specByContract);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004la[?2004h>     public List<AccountMargin> calculate(PositionAggregator aggregator) {
[?2004l[?2004h>         List<AccountMargin> results = new ArrayList<AccountMargin>();
[?2004l[?2004h> 
[?2004l [?2004h>         Map<String, List<Position>> positionsByAccount = aggregator.getPositionsByAccount();
[?2004l[?2004h>         Map<String, Map<String, PositionAggregator.UnderlyingNet>> nets = aggregator.getNetsByAccountUnderlying();
[?2004l[?2004h> 
[?2004l[?2004h>         for (Map.Entry<String, List<Position>> acctEntry : positionsByAccount.entrySet()) {
[?2004l[?2004h>             String accountId = acctEntry.getKey();
[?2004l[?2004h>             List<Position> positions = acctEntry.getValue();
[?2004l[?2004h> 
[?2004le[?2004h>             Map<String, PositionAggregator.UnderlyingNet> byUnd = nets.get(accountId);
[?2004l[?2004h>             if (byUnd == null) {
[?2004l[?2004h>                 byUnd = new HashMap<String, PositionAggregator.UnderlyingNet>();
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             long netDeltaExposureAbsSum = 0L;
[?2004l[?2004h>             long scanningRiskSum = 0L;
[?2004l[?2004h> 
[?2004l[?2004h>             for (Map.Entry<String, PositionAggregator.UnderlyingNet> undEntry : byUnd.entrySet()) {
[?2004l[?2004h>                 String underlying = undEntry.getKey();
[?2004l[?2004h>                 PositionAggregator.UnderlyingNet net = undEntry.getValue();
[?2004l[?2004h> 
[?2004l[?2004h>                 long netDelta = net.getNetDelta();
[?2004l[?2004h>                 netDeltaExposureAbsSum += Math.abs(netDelta);
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal scanRangeFrac = maxScanRangeFractionByUnderlying.get(underlying);
[?2004l[?2004h>                 if (scanRangeFrac == null) {
[?2004l[?2004h>                     scanRangeFrac = BigDecimal.ZERO;
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal repSettle = BigDecimal.ZERO;
[?2004l[?2004h>                 String repContract = net.getRepresentativeContractCode();
[?2004l[?2004h>                 if (repContract != null) {
[?2004l[?2004h>                     MarketData md = marketByContract.get(repContract);
[?2004l[?2004h>                     if (md != null) {
[?2004l[?2004h>                         repSettle = md.getSettlementPrice();
[?2004l[?2004h>                     }
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal absDelta = new BigDecimal(String.valueOf(Math.abs(netDelta)));
[?2004l[?2004h>                 BigDecimal risk = absDelta.multiply(scanRangeFrac).multiply(repSettle);
[?2004l[?2004h>                 long riskTrunc = truncToLong(risk);
[?2004l[?2004h>                 scanningRiskSum += riskTrunc;
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal spreadCharge = BigDecimal.ZERO;
[?2004l[?2004h>             BigDecimal unrealizedPnl = BigDecimal.ZERO;
[?2004l[?2004h> 
[?2004l[?2004h>             for (Position p : positions) {
[?2004l[?2004h>                 ContractSpec spec = specByContract.get(p.getContractCode());
[?2004l[?2004h>                 MarketData md = marketByContract.get(p.getContractCode());
[?2004l[?2004h>                 if (spec == null || md == null) {
[?2004l[?2004h>                     continue;
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 int qty = p.getPositionQty();
[?2004l[?2004h>                 int mult = spec.getMultiplier();
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal absQty = new BigDecimal(String.valueOf(Math.abs(qty)));
[?2004l[?2004h>                 spreadCharge = spreadCharge.add(absQty.multiply(md.getIntraSpreadCharge()));
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal qtyBd = new BigDecimal(String.valueOf(qty));
[?2004l[?2004h>                 BigDecimal multBd = new BigDecimal(String.valueOf(mult));
[?2004l[?2004h>                 BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());
[?2004l[?2004h>                 unrealizedPnl = unrealizedPnl.add(qtyBd.multiply(multBd).multiply(priceDiff));
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             long spreadChargeTrunc = truncToLong(spreadCharge);
[?2004l[?2004h>             long initialMargin = scanningRiskSum + spreadChargeTrunc;
[?2004l[?2004h>             long unrealizedPnlTrunc = truncToLong(unrealizedPnl);
[?2004l[?2004h> 
