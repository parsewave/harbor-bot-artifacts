Sending keys: ["cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class PositionAggregator {\n\n    public static final class UnderlyingAggregation {\n        public long netDeltaExposure; // qty * multiplier summed; can be negative\n        public String representativeContract;\n        public long representativeOpenInterestEquivalent;\n\n        public UnderlyingAggregation() {\n            this.netDeltaExposure = 0L;\n            this.representativeContract = null;\n            this.representativeOpenInterestEquivalent = Long.MIN_VALUE;\n        }\n\n        public void considerRepresentative(String contractCode, long openInterestEquivalent) {\n            if (openInterestEquivalent > representativeOpenInterestEquivalent) {\n                representativeOpenInterestEquivalent = openInterestEquivalent;\n                representativeContract = contractCode;\n            }\n        }\n    }\n\n    public static final class AccountAggregation {\n        public final String accountId;\n        public final Map<String, UnderlyingAggregation> byUnderlying;\n\n        public AccountAggregation(String accountId) {\n            this.accountId = accountId;\n            this.byUnderlying = new HashMap<String, UnderlyingAggregation>();\n        }\n\n        public UnderlyingAggregation getOrCreate(String underlying) {\n            UnderlyingAggregation ua = byUnderlying.get(underlying);\n            if (ua == null) {\n                ua = new UnderlyingAggregation();\n                byUnderlying.put(underlying, ua);\n            }\n            return ua;\n        }\n    }\n\n    public Map<String, AccountAggregation> aggregate(List<Position> positions,\n                                                     Map<String, ContractSpec> contractSpecs) {\n        Map<String, AccountAggregation> byAccount = new HashMap<String, AccountAggregation>();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position pos = positions.get(i);\n            ContractSpec spec = contractSpecs.get(pos.contractCode);\n            if (spec == null) {\n                continue;\n            }\n\n            AccountAggregation acc = byAccount.get(pos.accountId);\n            if (acc == null) {\n                acc = new AccountAggregation(pos.accountId);\n                byAccount.put(pos.accountId, acc);\n            }\n\n            UnderlyingAggregation ua = acc.getOrCreate(spec.underlying);\n\n            long deltaEq = (long) pos.positionQty * (long) spec.multiplier;\n            ua.netDeltaExposure += deltaEq;\n\n            long oiEq = Math.abs((long) pos.positionQty) * (long) spec.multiplier;\n            ua.considerRepresentative(pos.contractCode, oiEq);\n        }\n\n        return byAccount;\n    }\n}\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/src/MarginCalculator.java <<\'EOF\'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class MarginCalculator {\n\n    private static long truncToLong(BigDecimal x) {\n        if (x == null) {\n            return 0L;\n        }\n        return x.setScale(0, RoundingMode.DOWN).longValue();\n    }\n\n    public List<AccountMargin> calculate(List<Position> positions,\n                                         Map<String, MarketData> marketData,\n                                         Map<String, ContractSpec> contractSpecs) {\n\n        // Precompute max scanning range fraction per underlying\n        Map<String, BigDecimal> maxScanRangeByUnderlying = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, ContractSpec> e : contractSpecs.entrySet()) {\n            ContractSpec spec = e.getValue();\n            MarketData md = marketData.get(spec.contractCode);\n            if (md == null) {\n                continue;\n            }\n            BigDecimal frac = md.scanningRangeFraction();\n            BigDecimal current = maxScanRangeByUnderlying.get(spec.underlying);\n            if (current == null || frac.compareTo(current) > 0) {\n                maxScanRangeByUnderlying.put(spec.underlying, frac);\n            }\n        }\n\n        // Aggregate net delta exposures and representative settlement price selection\n        PositionAggregator aggregator = new PositionAggregator();\n        Map<String, PositionAggregator.AccountAggregation> agg = aggregator.aggregate(positions, contractSpecs);\n\n        // Compute spread charge and unrealized PnL per account by iterating positions\n        Map<String, BigDecimal> spreadChargeByAccount = new HashMap<String, BigDecimal>();\n        Map<String, BigDecimal> unrealizedPnlByAccount = new HashMap<String, BigDecimal>();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position pos = positions.get(i);\n            ContractSpec spec = contractSpecs.get(pos.contractCode);\n            MarketData md = marketData.get(pos.contractCode);\n            if (spec == null || md == null) {\n                continue;\n            }\n\n            BigDecimal qty = new BigDecimal(pos.positionQty);\n            BigDecimal mult = new BigDecimal(spec.multiplier);\n\n            // Spread charge: intra_spread_charge * abs(position_qty)\n            BigDecimal spread = md.intraSpreadCharge.multiply(new BigDecimal(Math.abs(pos.positionQty)));\n            BigDecimal sc = spreadChargeByAccount.get(pos.accountId);\n            spreadChargeByAccount.put(pos.accountId, (sc == null) ? spread : sc.add(spread));\n\n            // Unrealized PnL: qty * multiplier * (settlement - entry)\n            BigDecimal diff = md.settlementPrice.subtract(pos.entryPrice);\n            BigDecimal pnl = qty.multiply(mult).multiply(diff);\n            BigDecimal up = unrealizedPnlByAccount.get(pos.accountId);\n            unrealizedPnlByAccount.put(pos.accountId, (up == null) ? pnl : up.add(pnl));\n        }\n\n        // Build AccountMargin results\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        for (Map.Entry<String, PositionAggregator.AccountAggregation> e : agg.entrySet()) {\n            String accountId = e.getKey();\n            PositionAggregator.AccountAggregation accountAgg = e.getValue();\n\n            long netDeltaExposureSumAbs = 0L;\n            long scanningRiskTotal = 0L;\n\n            for (Map.Entry<String, PositionAggregator.UnderlyingAggregation> ue : accountAgg.byUnderlying.entrySet()) {\n                String underlying = ue.getKey();\n                PositionAggregator.UnderlyingAggregation ua = ue.getValue();\n\n                long netDelta = ua.netDeltaExposure;\n                netDeltaExposureSumAbs += Math.abs(netDelta);\n\n                BigDecimal scanFrac = maxScanRangeByUnderlying.get(underlying);\n                if (scanFrac == null) {\n                    scanFrac = BigDecimal.ZERO;\n                }\n\n                BigDecimal settle = BigDecimal.ZERO;\n                if (ua.representativeContract != null) {\n                    MarketData md = marketData.get(ua.representativeContract);\n                    if (md != null) {\n                        settle = md.settlementPrice;\n                    }\n                }\n\n                // scanning risk = abs(net delta exposure) * scanRangeFraction * settlementPrice; truncate toward zero\n                BigDecimal risk = new BigDecimal(Math.abs(netDelta)).multiply(scanFrac).multiply(settle);\n                long riskInt = truncToLong(risk);\n                scanningRiskTotal += riskInt;\n            }\n\n            long spreadChargeInt = truncToLong(spreadChargeByAccount.get(accountId));\n            long initialMargin = truncToLong(new BigDecimal(scanningRiskTotal).add(new BigDecimal(spreadChargeInt)));\n            long unrealizedPnlInt = truncToLong(unrealizedPnlByAccount.get(accountId));\n            String status = (unrealizedPnlInt >= initialMargin) ? "ADEQUATE" : "CALL";\n\n            AccountMargin am = new AccountMargin(accountId,\n                    netDeltaExposureSumAbs,\n                    scanningRiskTotal,\n                    spreadChargeInt,\n                    initialMargin,\n                    unrealizedPnlInt,\n                    status);\n            results.add(am);\n        }\n\n        Collections.sort(results, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a, AccountMargin b) {\n                return a.accountId.compareTo(b.accountId);\n            }\n        });\n\n        return results;\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/src/Main.java <<\'EOF\'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class Main {\n\n    private static List<String> readLines(String path) throws IOException {\n        List<String> lines = new ArrayList<String>();\n        BufferedReader br = null;\n        try {\n            br = new BufferedReader(new InputStreamReader(new FileInputStream(path), "UTF-8"));\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                lines.add(line);\n            }\n        } finally {\n            if (br != null) {\n                br.close();\n            }\n        }\n        return lines;\n    }\n\n    private static List<Position> loadPositions(String path) throws IOException {\n        List<String> lines = readLines(path);\n        List<Position> positions = new ArrayList<Position>();\n        for (int i = 0; i < lines.size(); i++) {\n            String line = lines.get(i);\n            if (i == 0 && line.toLowerCase().startsWith("account_id")) {\n                continue;\n            }\n            positions.add(Position.fromCsv(line));\n        }\n        return positions;\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws IOException {\n        List<String> lines = readLines(path);\n        Map<String, MarketData> map = new HashMap<String, MarketData>();\n        for (int i = 0; i < lines.size(); i++) {\n            String line = lines.get(i);\n            if (i == 0 && line.toLowerCase().startsWith("contract_code")) {\n                continue;\n            }\n            MarketData md = MarketData.fromCsv(line);\n            map.put(md.contractCode, md);\n        }\n        return map;\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws IOException {\n        List<String> lines = readLines(path);\n        Map<String, ContractSpec> map = new HashMap<String, ContractSpec>();\n        for (int i = 0; i < lines.size(); i++) {\n            String line = lines.get(i);\n            if (i == 0 && line.toLowerCase().startsWith("contract_code")) {\n                continue;\n            }\n            ContractSpec cs = ContractSpec.fromCsv(line);\n            map.put(cs.contractCode, cs);\n        }\n        return map;\n    }\n\n    private static void writeReport(String outputPath, List<AccountMargin> margins) throws IOException {\n        BufferedWriter bw = null;\n        try {\n            bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(outputPath), "UTF-8"));\n            bw.write("account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status");\n            bw.newLine();\n            for (int i = 0; i < margins.size(); i++) {\n                AccountMargin am = margins.get(i);\n                bw.write(am.accountId);\n                bw.write(\',\');\n                bw.write(Long.toString(am.netDeltaExposure));\n                bw.write(\',\');\n                bw.write(Long.toString(am.scanningRisk));\n                bw.write(\',\');\n                bw.write(Long.toString(am.spreadCharge));\n                bw.write(\',\');\n                bw.write(Long.toString(am.initialMargin));\n                bw.write(\',\');\n                bw.write(Long.toString(am.unrealizedPnl));\n                bw.write(\',\');\n                bw.write(am.marginStatus);\n                bw.newLine();\n            }\n        } finally {\n            if (bw != null) {\n                bw.close();\n            }\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        if (args == null || args.length != 4) {\n            throw new IllegalArgumentException("Usage: Main positions_path market_data_path contract_specs_path output_path");\n        }\n\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> marketData = loadMarketData(marketDataPath);\n        Map<String, ContractSpec> contractSpecs = loadContractSpecs(contractSpecsPath);\n\n        MarginCalculator calc = new MarginCalculator();\n        List<AccountMargin> margins = calc.calculate(positions, marketData, contractSpecs);\n        writeReport(outputPath, margins);\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
