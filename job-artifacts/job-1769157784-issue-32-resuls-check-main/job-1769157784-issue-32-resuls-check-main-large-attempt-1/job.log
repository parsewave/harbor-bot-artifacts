Sending keys: ['cat > /app/src/MarketData.java <<\'EOF\'\nimport java.math.BigDecimal;\n\npublic final class MarketData {\n    public final String contractCode;\n    public final BigDecimal settlementPrice;\n    public final BigDecimal scanningRangePct;\n    public final BigDecimal intraSpreadCharge;\n\n    public MarketData(String contractCode, BigDecimal settlementPrice, BigDecimal scanningRangePct, BigDecimal intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRangePct = scanningRangePct;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public BigDecimal scanningRangeFraction() {\n        return scanningRangePct.divide(new BigDecimal("100"), 10, java.math.RoundingMode.HALF_UP);\n    }\n\n    public static MarketData fromCsv(String line) {\n        String[] p = CsvUtil.split(line);\n        if (p.length < 4) {\n            throw new IllegalArgumentException("Bad market_data row: " + line);\n        }\n        String contractCode = p[0];\n        BigDecimal settlement = new BigDecimal(p[1]);\n        BigDecimal scanPct = new BigDecimal(p[2]);\n        BigDecimal spread = new BigDecimal(p[3]);\n        return new MarketData(contractCode, settlement, scanPct, spread);\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
