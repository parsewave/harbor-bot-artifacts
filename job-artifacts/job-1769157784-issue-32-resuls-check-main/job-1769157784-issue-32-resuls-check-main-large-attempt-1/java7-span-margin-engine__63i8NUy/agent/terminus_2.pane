[?2004l[?2004h> import java.util.HashMap;
[?2004l[?2004h> import java.util.List;
[?2004l[?2004h> import java.util.Map;
[?2004l[?2004h> 
[?2004l[?2004h> public final class PositionAggregator {
[?2004l[?2004h> 
[?2004l[?2004h>     public static final class UnderlyingAggregation {
[?2004l[?2004h>         public long netDeltaExposure; // qty * multiplier summed; can be negative
[?2004l[?2004h>         public String representativeContract;
[?2004l[?2004h>         public long representativeOpenInterestEquivalent;
[?2004l[?2004h> 
[?2004l[?2004h>         public UnderlyingAggregation() {
[?2004l[?2004h>             this.netDeltaExposure = 0L;
[?2004l[?2004h>             this.representativeContract = null;
[?2004l[?2004h>             this.representativeOpenInterestEquivalent = Long.MIN_VALUE;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public void considerRepresentative(String contractCode, long openInterestEquivalent) {
[?2004l[?2004h>             if (openInterestEquivalent > representativeOpenInterestEquivalent) {
[?2004l[?2004h>                 representativeOpenInterestEquivalent = openInterestEquivalent;
[?2004l[?2004h>                 representativeContract = contractCode;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public static final class AccountAggregation {
[?2004l[?2004h>         public final String accountId;
[?2004l[?2004h>         public final Map<String, UnderlyingAggregation> byUnderlying;
[?2004l[?2004h> 
[?2004l[?2004h>         public AccountAggregation(String accountId) {
[?2004l[?2004h>             this.accountId = accountId;
[?2004l[?2004h>             this.byUnderlying = new HashMap<String, UnderlyingAggregation>();
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public UnderlyingAggregation getOrCreate(String underlying) {
[?2004l[?2004h>             UnderlyingAggregation ua = byUnderlying.get(underlying);
[?2004l[?2004h>             if (ua == null) {
[?2004l[?2004h>                 ua = new UnderlyingAggregation();
[?2004l[?2004h>                 byUnderlying.put(underlying, ua);
[?2004l[?2004h>             }
[?2004l[?2004h>             return ua;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public Map<String, AccountAggregation> aggregate(List<Position> positions,
[?2004l[?2004h>                                                      Map<String, ContractSpec> contractSpecs) {
[?2004l[?2004h>         Map<String, AccountAggregation> byAccount = new HashMap<String, AccountAggregation>();
[?2004l[?2004h> 
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position pos = positions.get(i);
[?2004l[?2004h>             ContractSpec spec = contractSpecs.get(pos.contractCode);
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             AccountAggregation acc = byAccount.get(pos.accountId);
[?2004l[?2004h>             if (acc == null) {
[?2004l[?2004h>                 acc = new AccountAggregation(pos.accountId);
[?2004l[?2004h>                 byAccount.put(pos.accountId, acc);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             UnderlyingAggregation ua = acc.getOrCreate(spec.underlying);
[?2004l[?2004h> 
[?2004l[?2004h>             long deltaEq = (long) pos.positionQty * (long) spec.multiplier;
[?2004l[?2004h>             ua.netDeltaExposure += deltaEq;
[?2004l[?2004h> 
[?2004l[?2004h>             long oiEq = Math.abs((long) pos.positionQty) * (long) spec.multiplier;
[?2004l[?2004h>             ua.considerRepresentative(pos.contractCode, oiEq);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         return byAccount;
[?2004l[?2004h>     }
[?2004l[?2004h> }
