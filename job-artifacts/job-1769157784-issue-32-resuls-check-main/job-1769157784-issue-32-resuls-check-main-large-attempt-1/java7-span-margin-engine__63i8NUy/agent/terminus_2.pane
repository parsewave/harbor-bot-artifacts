[?2004l[?2004h> import java.math.BigDecimal;
[?2004l[?2004h> import java.math.RoundingMode;
[?2004l[?2004h> import java.util.ArrayList;
[?2004l[?2004h> import java.util.Collections;
[?2004l[?2004h> import java.util.Comparator;
[?2004l  [?2004h> import java.util.HashMap;
[?2004l[?2004h> import java.util.List;
[?2004l[?2004h> import java.util.Map;
[?2004ln[?2004h> 
[?2004lt[?2004h> public final class MarginCalculator {
[?2004l[?2004h> 
[?2004l[?2004h>     private static long truncToLong(BigDecimal x) {
[?2004l[?2004h>         if (x == null) {
[?2004l[?2004h>             return 0L;
[?2004l[?2004h>         }
[?2004lu[?2004h>         return x.setScale(0, RoundingMode.DOWN).longValue();
[?2004lgDe[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public List<AccountMargin> calculate(List<Position> positions,
[?2004l[?2004h>                                          Map<String, MarketData> marketData,
[?2004l       scanningRiskTotal += r[?2004h>                                          Map<String, ContractSpec> contractSpecs) {
[?2004l[?2004h> 
[?2004lA[?2004h>         // Precompute max scanning range fraction per underlying
[?2004l[?2004h>         Map<String, BigDecimal> maxScanRangeByUnderlying = new HashMap<String, BigDecimal>();
[?2004l[?2004h>         for (Map.Entry<String, ContractSpec> e : contractSpecs.entrySet()) {
[?2004l[?2004h>             ContractSpec spec = e.getValue();
[?2004l[?2004h>             MarketData md = marketData.get(spec.contractCode);
[?2004l[?2004h>             if (md == null) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             BigDecimal frac = md.scanningRangeFraction();
[?2004l[?2004h>             BigDecimal current = maxScanRangeByUnderlying.get(spec.underlying);
[?2004l[?2004h>             if (current == null || frac.compareTo(current) > 0) {
[?2004l[?2004h>                 maxScanRangeByUnderlying.put(spec.underlying, frac);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // Aggregate net delta exposures and representative settlement price selection
[?2004l[?2004h>         PositionAggregator aggregator = new PositionAggregator();
[?2004l  [?2004h>         Map<String, PositionAggregator.AccountAggregation> agg = aggregator.aggregate(positions, contractSpecs);
[?2004l[?2004h> 
[?2004l[?2004h>         // Compute spread charge and unrealized PnL per account by iterating positions
[?2004l[?2004h>         Map<String, BigDecimal> spreadChargeByAccount = new HashMap<String, BigDecimal>();
[?2004l[?2004h>         Map<String, BigDecimal> unrealizedPnlByAccount = new HashMap<String, BigDecimal>();
[?2004l[?2004h> 
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position pos = positions.get(i);
[?2004l[?2004h>             ContractSpec spec = contractSpecs.get(pos.contractCode);
[?2004l[?2004h>             MarketData md = marketData.get(pos.contractCode);
[?2004l[?2004h>             if (spec == null || md == null) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal qty = new BigDecimal(pos.positionQty);
[?2004l[?2004h>             BigDecimal mult = new BigDecimal(spec.multiplier);
[?2004l[?2004h> 
[?2004l[?2004h>             // Spread charge: intra_spread_charge * abs(position_qty)
[?2004l[?2004h>             BigDecimal spread = md.intraSpreadCharge.multiply(new BigDecimal(Math.abs(pos.positionQty)));
[?2004l[?2004h>             BigDecimal sc = spreadChargeByAccount.get(pos.accountId);
[?2004l[?2004h>             spreadChargeByAccount.put(pos.accountId, (sc == null) ? spread : sc.add(spread));
[?2004l[?2004h> 
[?2004l[?2004h>             // Unrealized PnL: qty * multiplier * (settlement - entry)
[?2004l[?2004h>             BigDecimal diff = md.settlementPrice.subtract(pos.entryPrice);
[?2004l[?2004h>             BigDecimal pnl = qty.multiply(mult).multiply(diff);
[?2004l[?2004h>             BigDecimal up = unrealizedPnlByAccount.get(pos.accountId);
[?2004l[?2004h>             unrealizedPnlByAccount.put(pos.accountId, (up == null) ? pnl : up.add(pnl));
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // Build AccountMargin results
[?2004l[?2004h>         List<AccountMargin> results = new ArrayList<AccountMargin>();
[?2004l[?2004h> 
[?2004l[?2004h>         for (Map.Entry<String, PositionAggregator.AccountAggregation> e : agg.entrySet()) {
[?2004l[?2004h>             String accountId = e.getKey();
[?2004l[?2004h>             PositionAggregator.AccountAggregation accountAgg = e.getValue();
[?2004l[?2004h> 
[?2004l[?2004h>             long netDeltaExposureSumAbs = 0L;
[?2004l[?2004h>             long scanningRiskTotal = 0L;
[?2004l[?2004h> 
[?2004l[?2004h>             for (Map.Entry<String, PositionAggregator.UnderlyingAggregation> ue : accountAgg.byUnderlying.entrySet()) {
[?2004l[?2004h>                 String underlying = ue.getKey();
[?2004l[?2004h>                 PositionAggregator.UnderlyingAggregation ua = ue.getValue();
[?2004l[?2004h> 
[?2004l[?2004h>                 long netDelta = ua.netDeltaExposure;
[?2004l[?2004h>                 netDeltaExposureSumAbs += Math.abs(netDelta);
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal scanFrac = maxScanRangeByUnderlying.get(underlying);
[?2004l[?2004h>                 if (scanFrac == null) {
[?2004l[?2004h>                     scanFrac = BigDecimal.ZERO;
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal settle = BigDecimal.ZERO;
[?2004l[?2004h>                 if (ua.representativeContract != null) {
[?2004l[?2004h>                     MarketData md = marketData.get(ua.representativeContract);
[?2004l[?2004h>                     if (md != null) {
[?2004l[?2004h>                         settle = md.settlementPrice;
[?2004l[?2004h>                     }
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 // scanning risk = abs(net delta exposure) * scanRangeFraction * settlementPrice; truncate toward zero
[?2004l[?2004h>                 BigDecimal risk = new BigDecimal(Math.abs(netDelta)).multiply(scanFrac).multiply(settle);
[?2004l[?2004h>                 long riskInt = truncToLong(risk);
[?2004l[?2004h>                 scanningRiskTotal += riskInt;
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             long spreadChargeInt = truncToLong(spreadChargeByAccount.get(accountId));
[?2004l[?2004h>             long initialMargin = truncToLong(new BigDecimal(scanningRiskTotal).add(new BigDecimal(spreadChargeInt)));
[?2004l[?2004h>             long unrealizedPnlInt = truncToLong(unrealizedPnlByAccount.get(accountId));
[?2004l[?2004h>             String status = (unrealizedPnlInt >= initialMargin) ? "ADEQUATE" : "CALL";
[?2004l[?2004h> 
[?2004l[?2004h>             AccountMargin am = new AccountMargin(accountId,
[?2004l[?2004h>                     netDeltaExposureSumAbs,
[?2004l[?2004h>                     scanningRiskTotal,
[?2004l[?2004h>                     spreadChargeInt,
[?2004l[?2004h>                     initialMargin,
[?2004l[?2004h>                     unrealizedPnlInt,
[?2004l[?2004h>                     status);
[?2004l[?2004h>             results.add(am);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         Collections.sort(results, new Comparator<AccountMargin>() {
[?2004l[?2004h>             public int compare(AccountMargin a, AccountMargin b) {
[?2004l[?2004h>                 return a.accountId.compareTo(b.accountId);
[?2004l[?2004h>             }
[?2004l[?2004h>         });
[?2004l[?2004h> 
[?2004l[?2004h>         return results;
[?2004l[?2004h>     }
[?2004l[?2004h> }
