[92.125413, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class MarginCalculator {\n\n    private static long truncToLong(BigDecimal x) {\n        if (x == null) {\n            return 0L;\n        }\n        return x.setScale(0, RoundingMode.DOWN).longValue();\n    }\n\n    public List<AccountMargin> calculate(List<Position> positions,\n                                         Map<String, MarketData> marketData,\n                                         Map<String, ContractSpec> contractSpecs) {\n\n        // Precompute max scanning range fraction per underlying\n        Map<String, BigDecimal> maxScanRangeByUnderlying = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, ContractSpec> e : contractSpecs.entrySet()) {\n            ContractSpec spec = e.getValue();\n            MarketData md = marketData.get(spec.contractCode);\n            if (md == null) {\n                continue;\n            }\n            BigDecimal frac = md.scanningRangeFraction();\n            BigDecimal current = maxScanRangeByUnderlying.get(spec.underlying);\n            if (current == null || frac.compareTo(current) > 0) {\n                maxScanRangeByUnderlying.put(spec.underlying, frac);\n            }\n        }\n\n        // Aggregate net delta exposures and representative settlement price selection\n        PositionAggregator aggregator = new PositionAggregator();\n        Map<String, PositionAggregator.AccountAggregation> agg = aggregator.aggregate(positions, contractSpecs);\n\n        // Compute spread charge and unrealized PnL per account by iterating positions\n        Map<String, BigDecimal> spreadChargeByAccount = new HashMap<String, BigDecimal>();\n        Map<String, BigDecimal> unrealizedPnlByAccount = new HashMap<String, BigDecimal>();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position pos = positions.get(i);\n            ContractSpec spec = contractSpecs.get(pos.contractCode);\n            MarketData md = marketData.get(pos.contractCode);\n            if (spec == null || md == null) {\n                continue;\n            }\n\n            BigDecimal qty = new BigDecimal(pos.positionQty);\n            BigDecimal mult = new BigDecimal(spec.multiplier);\n\n            // Spread charge: intra_spread_charge * abs(position_qty)\n            BigDecimal spread = md.intraSpreadCharge.multiply(new BigDecimal(Math.abs(pos.positionQty)));\n            BigDecimal sc = spreadChargeByAccount.get(pos.accountId);\n            spreadChargeByAccount.put(pos.accountId, (sc == null) ? spread : sc.add(spread));\n\n            // Unrealized PnL: qty * multiplier * (settlement - entry)\n            BigDecimal diff = md.settlementPrice.subtract(pos.entryPrice);\n            BigDecimal pnl = qty.multiply(mult).multiply(diff);\n            BigDecimal up = unrealizedPnlByAccount.get(pos.accountId);\n            unrealizedPnlByAccount.put(pos.accountId, (up == null) ? pnl : up.add(pnl));\n        }\n\n        // Build AccountMargin results\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        for (Map.Entry<String, PositionAggregator.AccountAggregation> e : agg.entrySet()) {\n            String accountId = e.getKey();\n            PositionAggregator.AccountAggregation accountAgg = e.getValue();\n\n            long netDeltaExposureSumAbs = 0L;\n            long scanningRiskTotal = 0L;\n\n            for (Map.Entry<String, PositionAggregator.UnderlyingAggregation> ue : accountAgg.byUnderlying.entrySet()) {\n                String underlying = ue.getKey();\n                PositionAggregator.UnderlyingAggregation ua = ue.getValue();\n\n                long netDelta = ua.netDeltaExposure;\n                netDeltaExposureSumAbs += Math.abs(netDelta);\n\n                BigDecimal scanFrac = maxScanRangeByUnderlying.get(underlying);\n                if (scanFrac == null) {\n                    scanFrac = BigDecimal.ZERO;\n                }\n\n         "]
[92.125523, "i", "       BigDecimal settle = BigDecimal.ZERO;\n                if (ua.representativeContract != null) {\n                    MarketData md = marketData.get(ua.representativeContract);\n                    if (md != null) {\n                        settle = md.settlementPrice;\n                    }\n                }\n\n                // scanning risk = abs(net delta exposure) * scanRangeFraction * settlementPrice; truncate toward zero\n                BigDecimal risk = new BigDecimal(Math.abs(netDelta)).multiply(scanFrac).multiply(settle);\n                long riskInt = truncToLong(risk);\n                scanningRiskTotal += riskInt;\n            }\n\n            long spreadChargeInt = truncToLong(spreadChargeByAccount.get(accountId));\n            long initialMargin = truncToLong(new BigDecimal(scanningRiskTotal).add(new BigDecimal(spreadChargeInt)));\n            long unrealizedPnlInt = truncToLong(unrealizedPnlByAccount.get(accountId));\n            String status = (unrealizedPnlInt >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\n\n            AccountMargin am = new AccountMargin(accountId,\n                    netDeltaExposureSumAbs,\n                    scanningRiskTotal,\n                    spreadChargeInt,\n                    initialMargin,\n                    unrealizedPnlInt,\n                    status);\n            results.add(am);\n        }\n\n        Collections.sort(results, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a, AccountMargin b) {\n                return a.accountId.compareTo(b.accountId);\n            }\n        });\n\n        return results;\n    }\n}\nEOF\n"]
