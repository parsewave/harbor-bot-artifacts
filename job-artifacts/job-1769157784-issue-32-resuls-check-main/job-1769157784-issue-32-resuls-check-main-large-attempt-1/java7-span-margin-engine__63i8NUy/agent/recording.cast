[92.294764, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class Main {\n\n    private static List<String> readLines(String path) throws IOException {\n        List<String> lines = new ArrayList<String>();\n        BufferedReader br = null;\n        try {\n            br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                lines.add(line);\n            }\n        } finally {\n            if (br != null) {\n                br.close();\n            }\n        }\n        return lines;\n    }\n\n    private static List<Position> loadPositions(String path) throws IOException {\n        List<String> lines = readLines(path);\n        List<Position> positions = new ArrayList<Position>();\n        for (int i = 0; i < lines.size(); i++) {\n            String line = lines.get(i);\n            if (i == 0 && line.toLowerCase().startsWith(\"account_id\")) {\n                continue;\n            }\n            positions.add(Position.fromCsv(line));\n        }\n        return positions;\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws IOException {\n        List<String> lines = readLines(path);\n        Map<String, MarketData> map = new HashMap<String, MarketData>();\n        for (int i = 0; i < lines.size(); i++) {\n            String line = lines.get(i);\n            if (i == 0 && line.toLowerCase().startsWith(\"contract_code\")) {\n                continue;\n            }\n            MarketData md = MarketData.fromCsv(line);\n            map.put(md.contractCode, md);\n        }\n        return map;\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws IOException {\n        List<String> lines = readLines(path);\n        Map<String, ContractSpec> map = new HashMap<String, ContractSpec>();\n        for (int i = 0; i < lines.size(); i++) {\n            String line = lines.get(i);\n            if (i == 0 && line.toLowerCase().startsWith(\"contract_code\")) {\n                continue;\n            }\n            ContractSpec cs = ContractSpec.fromCsv(line);\n            map.put(cs.contractCode, cs);\n        }\n        return map;\n    }\n\n    private static void writeReport(String outputPath, List<AccountMargin> margins) throws IOException {\n        BufferedWriter bw = null;\n        try {\n            bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(outputPath), \"UTF-8\"));\n            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\n            bw.newLine();\n            for (int i = 0; i < margins.size(); i++) {\n                AccountMargin am = margins.get(i);\n                bw.write(am.accountId);\n                bw.write(',');\n                bw.write(Long.toString(am.netDeltaExposure));\n                bw.write(',');\n                bw.write(Long.toString(am.scanningRisk));\n                bw.write(',');\n                bw.write(Long.toString(am.spreadCharge));\n                bw.write(',');\n                bw.write(Long.toString(am.initialMargin));\n                bw.write(',');\n                bw.write(Long.toString(am.unrealizedPnl));\n                bw.write(',');\n                bw.write(am.marginStatus);\n                bw.newLine();\n            }\n        } finally {\n            if (bw != null) {\n                bw.close();\n            }\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        if (args == null || args.length != 4) {\n            throw new IllegalArgumentException(\"Usage: Main positions_path market_data_path contract_specs_path ou"]
[92.294847, "i", "tput_path\");\n        }\n\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> marketData = loadMarketData(marketDataPath);\n        Map<String, ContractSpec> contractSpecs = loadContractSpecs(contractSpecsPath);\n\n        MarginCalculator calc = new MarginCalculator();\n        List<AccountMargin> margins = calc.calculate(positions, marketData, contractSpecs);\n        writeReport(outputPath, margins);\n    }\n}\nEOF\n"]
