[91.94427, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class PositionAggregator {\n\n    public static final class UnderlyingAggregation {\n        public long netDeltaExposure; // qty * multiplier summed; can be negative\n        public String representativeContract;\n        public long representativeOpenInterestEquivalent;\n\n        public UnderlyingAggregation() {\n            this.netDeltaExposure = 0L;\n            this.representativeContract = null;\n            this.representativeOpenInterestEquivalent = Long.MIN_VALUE;\n        }\n\n        public void considerRepresentative(String contractCode, long openInterestEquivalent) {\n            if (openInterestEquivalent > representativeOpenInterestEquivalent) {\n                representativeOpenInterestEquivalent = openInterestEquivalent;\n                representativeContract = contractCode;\n            }\n        }\n    }\n\n    public static final class AccountAggregation {\n        public final String accountId;\n        public final Map<String, UnderlyingAggregation> byUnderlying;\n\n        public AccountAggregation(String accountId) {\n            this.accountId = accountId;\n            this.byUnderlying = new HashMap<String, UnderlyingAggregation>();\n        }\n\n        public UnderlyingAggregation getOrCreate(String underlying) {\n            UnderlyingAggregation ua = byUnderlying.get(underlying);\n            if (ua == null) {\n                ua = new UnderlyingAggregation();\n                byUnderlying.put(underlying, ua);\n            }\n            return ua;\n        }\n    }\n\n    public Map<String, AccountAggregation> aggregate(List<Position> positions,\n                                                     Map<String, ContractSpec> contractSpecs) {\n        Map<String, AccountAggregation> byAccount = new HashMap<String, AccountAggregation>();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position pos = positions.get(i);\n            ContractSpec spec = contractSpecs.get(pos.contractCode);\n            if (spec == null) {\n                continue;\n            }\n\n            AccountAggregation acc = byAccount.get(pos.accountId);\n            if (acc == null) {\n                acc = new AccountAggregation(pos.accountId);\n                byAccount.put(pos.accountId, acc);\n            }\n\n            UnderlyingAggregation ua = acc.getOrCreate(spec.underlying);\n\n            long deltaEq = (long) pos.positionQty * (long) spec.multiplier;\n            ua.netDeltaExposure += deltaEq;\n\n            long oiEq = Math.abs((long) pos.positionQty) * (long) spec.multiplier;\n            ua.considerRepresentative(pos.contractCode, oiEq);\n        }\n\n        return byAccount;\n    }\n}\nEOF\n"]
