[92.137155, "o", "> "]
[92.137485, "o", "            spreadChargeByAccount.put(pos.accountId, (sc == null) ? spread : sc.add(spread));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             // Unrealized PnL: qty * multiplier * (settlement - entry)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.137671, "o", "            BigDecimal diff = md.settlementPrice.subtract(pos.entryPrice);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.137815, "o", "            BigDecimal pnl = qty.multiply(mult).multiply(diff);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.138023, "o", "            BigDecimal up = unrealizedPnlByAccount.get(pos.accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.138212, "o", "            unrealizedPnlByAccount.put(pos.accountId, (up == null) ? pnl : up.add(pnl));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.138384, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.138463, "o", "        // Build AccountMargin results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.138663, "o", "        List<AccountMargin> results = new ArrayList<AccountMargin>();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.138808, "o", "        for (Map.Entry<String, PositionAggregator.AccountAggregation> e : agg.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.138934, "o", "            String accountId = e.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.139142, "o", "            PositionAggregator.AccountAggregation accountAgg = e.getValue();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.139237, "o", "            long netDeltaExposureSumAbs = 0L;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.139452, "o", "            long scanningRiskTotal = 0L;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.139687, "o", "            for (Map.Entry<String, PositionAggregator.UnderlyingAggregation> ue : accountAgg.byUnderlying.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.139907, "o", "                String underlying = ue.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.140036, "o", "                PositionAggregator.UnderlyingAggregation ua = ue.getValue();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.140261, "o", "                long netDelta = ua.netDeltaExposure;\r\n\u001b[?2004l\r\u001b[?2004h>                 netDeltaExposureSumAbs += Math.abs(netDelta);\r\n\u001b[?2004l\r"]
[92.140334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.140549, "o", "                BigDecimal scanFrac = maxScanRangeByUnderlying.get(underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.140714, "o", "                if (scanFrac == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.140787, "o", "                    scanFrac = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.140863, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.141134, "o", "                BigDecimal settle = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.141286, "o", "                if (ua.representativeContract != null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.141533, "o", "                    MarketData md = marketData.get(ua.representativeContract);\r\n\u001b[?2004l\r\u001b[?2004h>                     if (md != null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.14167, "o", "                        settle = md.settlementPrice;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.141918, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.142102, "o", "                // scanning risk = abs(net delta exposure) * scanRangeFraction * settlementPrice; truncate toward zero\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.142357, "o", "                BigDecimal risk = new BigDecimal(Math.abs(netDelta)).multiply(scanFrac).multiply(settle);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.142485, "o", "                long riskInt = truncToLong(risk);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.142611, "o", "                scanningRiskTotal += riskInt;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.14272, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.142818, "o", "            long spreadChargeInt = truncToLong(spreadChargeByAccount.get(accountId));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.143148, "o", "            long initialMargin = truncToLong(new BigDecimal(scanningRiskTotal).add(new BigDecimal(spreadChargeInt)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.14336, "o", "            long unrealizedPnlInt = truncToLong(unrealizedPnlByAccount.get(accountId));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.143588, "o", "            String status = (unrealizedPnlInt >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.143708, "o", "            AccountMargin am = new AccountMargin(accountId,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.143777, "o", "                    netDeltaExposureSumAbs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.143941, "o", "                    scanningRiskTotal,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.144095, "o", "                    spreadChargeInt,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.144153, "o", "                    initialMargin,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.144367, "o", "                    unrealizedPnlInt,\r\n\u001b[?2004l\r\u001b[?2004h>                     status);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.144496, "o", "            results.add(am);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.144669, "o", "        Collections.sort(results, new Comparator<AccountMargin>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.144816, "o", "            public int compare(AccountMargin a, AccountMargin b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.145077, "o", "                return a.accountId.compareTo(b.accountId);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[92.14526, "o", ">         return results;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
