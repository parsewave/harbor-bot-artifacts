[128.491367, "o", "        return new MarketData(contractCode, settlement, scanPct, spread);\r\n\u001b[?2004l\r"]
[128.491557, "o", "\u001b[?2004h> "]
[128.491651, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[128.493306, "o", "\u001b[?2004hroot@0e267e4d752f:/app# "]
[128.638785, "i", "cat > /app/src/ContractSpec.java <<'EOF'\npublic final class ContractSpec {\n    public final String contractCode;\n    public final int multiplier;\n    public final String expiryMonth;\n    public final String underlying;\n\n    public ContractSpec(String contractCode, int multiplier, String expiryMonth, String underlying) {\n        this.contractCode = contractCode;\n        this.multiplier = multiplier;\n        this.expiryMonth = expiryMonth;\n        this.underlying = underlying;\n    }\n\n    private static String[] split(String line) {\n        String[] parts = line.split(\",\", -1);\n        for (int i = 0; i < parts.length; i++) {\n            parts[i] = parts[i].trim();\n        }\n        return parts;\n    }\n\n    public static ContractSpec fromCsv(String line) {\n        String[] p = split(line);\n        if (p.length < 4) {\n            throw new IllegalArgumentException(\"Bad contract_specs row: \" + line);\n        }\n        String contractCode = p[0];\n        int multiplier = Integer.parseInt(p[1]);\n        String expiryMonth = p[2];\n        String underlying = p[3];\n        return new ContractSpec(contractCode, multiplier, expiryMonth, underlying);\n    }\n}\nEOF\n"]
