Sending keys: ['cat > /app/src/PositionAggregator.java <<\'EOF\'\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class PositionAggregator {\n\n    public static final class UnderlyingAgg {\n        private long netDeltaExposure; // sum(qty * multiplier)\n        private long maxOpenInterestEquiv; // max(abs(qty) * multiplier)\n        private String representativeContractCode;\n\n        public UnderlyingAgg() {\n            this.netDeltaExposure = 0L;\n            this.maxOpenInterestEquiv = -1L;\n            this.representativeContractCode = null;\n        }\n\n        public void apply(Position p, ContractSpec spec) {\n            long delta = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());\n            netDeltaExposure += delta;\n\n            long oie = Math.abs((long) p.getPositionQty()) * ((long) spec.getMultiplier());\n            if (oie > maxOpenInterestEquiv) {\n                maxOpenInterestEquiv = oie;\n                representativeContractCode = p.getContractCode();\n            }\n        }\n\n        public long getNetDeltaExposure() {\n            return netDeltaExposure;\n        }\n\n        public String getRepresentativeContractCode() {\n            return representativeContractCode;\n        }\n    }\n\n    public static final class AccountAgg {\n        private final String accountId;\n        private final Map<String, UnderlyingAgg> byUnderlying;\n        private final List<Position> positions;\n\n        public AccountAgg(String accountId) {\n            this.accountId = accountId;\n            this.byUnderlying = new HashMap<String, UnderlyingAgg>();\n            this.positions = new ArrayList<Position>();\n        }\n\n        public String getAccountId() {\n            return accountId;\n        }\n\n        public Map<String, UnderlyingAgg> getByUnderlying() {\n            return byUnderlying;\n        }\n\n        public List<Position> getPositions() {\n            return positions;\n        }\n\n        public void addPosition(Position p, ContractSpec spec) {\n            positions.add(p);\n            String underlying = spec.getUnderlying();\n            UnderlyingAgg ua = byUnderlying.get(underlying);\n            if (ua == null) {\n                ua = new UnderlyingAgg();\n                byUnderlying.put(underlying, ua);\n            }\n            ua.apply(p, spec);\n        }\n    }\n\n    public Map<String, AccountAgg> aggregateByAccount(List<Position> positions, Map<String, ContractSpec> specsByContract) {\n        Map<String, AccountAgg> accounts = new HashMap<String, AccountAgg>();\n        for (Position p : positions) {\n            ContractSpec spec = specsByContract.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.getContractCode());\n            }\n            AccountAgg aa = accounts.get(p.getAccountId());\n            if (aa == null) {\n                aa = new AccountAgg(p.getAccountId());\n                accounts.put(p.getAccountId(), aa);\n            }\n            aa.addPosition(p, spec);\n        }\n        return accounts;\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/src/MarginCalculator.java <<\'EOF\'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.HashMap;\nimport java.util.Map;\n\npublic final class MarginCalculator {\n\n    private static final BigDecimal ONE_HUNDRED = new BigDecimal("100");\n\n    public static final class UnderlyingParams {\n        private final BigDecimal maxScanningRange; // already divided by 100\n\n        public UnderlyingParams(BigDecimal maxScanningRange) {\n            this.maxScanningRange = maxScanningRange;\n        }\n\n        public BigDecimal getMaxScanningRange() {\n            return maxScanningRange;\n        }\n    }\n\n    public Map<String, UnderlyingParams> buildUnderlyingParams(Map<String, ContractSpec> specsByContract,\n                                                               Map<String, MarketData> marketByContract) {\n        Map<String, BigDecimal> maxScan = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, ContractSpec> e : specsByContract.entrySet()) {\n            String contract = e.getKey();\n            ContractSpec spec = e.getValue();\n            MarketData md = marketByContract.get(contract);\n            if (md == null) {\n                // If market data missing for a contract, skip it for max scanning range purposes\n                continue;\n            }\n            String underlying = spec.getUnderlying();\n            BigDecimal scan = md.getScanningRangePct().divide(ONE_HUNDRED);\n            BigDecimal curr = maxScan.get(underlying);\n            if (curr == null || scan.compareTo(curr) > 0) {\n                maxScan.put(underlying, scan);\n            }\n        }\n\n        Map<String, UnderlyingParams> params = new HashMap<String, UnderlyingParams>();\n        for (Map.Entry<String, BigDecimal> e : maxScan.entrySet()) {\n            params.put(e.getKey(), new UnderlyingParams(e.getValue()));\n        }\n        return params;\n    }\n\n    public long computeScanningRisk(long netDeltaExposure,\n                                   BigDecimal maxScanningRange,\n                                   BigDecimal representativeSettlementPrice) {\n        BigDecimal absDelta = BigDecimal.valueOf(Math.abs(netDeltaExposure));\n        BigDecimal risk = absDelta.multiply(maxScanningRange).multiply(representativeSettlementPrice);\n        return truncateTowardZero(risk);\n    }\n\n    public long truncateTowardZero(BigDecimal v) {\n        return v.setScale(0, RoundingMode.DOWN).longValue();\n    }\n\n    public BigDecimal computeSpreadChargeBig(ListView<Position> positions,\n                                             Map<String, MarketData> marketByContract) {\n        BigDecimal total = BigDecimal.ZERO;\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            MarketData md = marketByContract.get(p.getContractCode());\n            if (md == null) {\n                throw new IllegalArgumentException("Missing market data for contract_code=" + p.getContractCode());\n            }\n            BigDecimal qtyAbs = BigDecimal.valueOf(Math.abs((long) p.getPositionQty()));\n            total = total.add(md.getIntraSpreadCharge().multiply(qtyAbs));\n        }\n        return total;\n    }\n\n    public BigDecimal computeUnrealizedPnlBig(ListView<Position> positions,\n                                             Map<String, ContractSpec> specsByContract,\n                                             Map<String, MarketData> marketByContract) {\n        BigDecimal total = BigDecimal.ZERO;\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = specsByContract.get(p.getContractCode());\n            MarketData md = marketByContract.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.getContractCode());\n            }\n            if (md == null) {\n                throw new IllegalArgumentException("Missing market data for contract_code=" + p.getContractCode());\n            }\n            BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());\n            long qtyMult = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());\n            BigDecimal pnl = BigDecimal.valueOf(qtyMult).multiply(priceDiff);\n            total = total.add(pnl);\n        }\n        return total;\n    }\n\n    /** Minimal Java 7 friendly view wrapper for List<Position> without importing java.util.List everywhere. */\n    public static final class ListView<T> {\n        private final java.util.List<T> list;\n        public ListView(java.util.List<T> list) { this.list = list; }\n        public int size() { return list.size(); }\n        public T get(int idx) { return list.get(idx); }\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/AccountMargin.java <<'EOF'\npublic final class AccountMargin {\n    private final String accountId;\n    private final long netDeltaExposure;\n    private final long scanningRisk;\n    private final long spreadCharge;\n    private final long initialMargin;\n    private final long unrealizedPnl;\n    private final String marginStatus;\n\n    public AccountMargin(String accountId,\n                         long netDeltaExposure,\n                         long scanningRisk,\n                         long spreadCharge,\n                         long initialMargin,\n                         long unrealizedPnl,\n                         String marginStatus) {\n        this.accountId = accountId;\n        this.netDeltaExposure = netDeltaExposure;\n        this.scanningRisk = scanningRisk;\n        this.spreadCharge = spreadCharge;\n        this.initialMargin = initialMargin;\n        this.unrealizedPnl = unrealizedPnl;\n        this.marginStatus = marginStatus;\n    }\n\n    public String getAccountId() {\n        return accountId;\n    }\n\n    public long getNetDeltaExposure() {\n        return netDeltaExposure;\n    }\n\n    public long getScanningRisk() {\n        return scanningRisk;\n    }\n\n    public long getSpreadCharge() {\n        return spreadCharge;\n    }\n\n    public long getInitialMargin() {\n        return initialMargin;\n    }\n\n    public long getUnrealizedPnl() {\n        return unrealizedPnl;\n    }\n\n    public String getMarginStatus() {\n        return marginStatus;\n    }\n\n    public String toCsvRow() {\n        StringBuilder sb = new StringBuilder();\n        sb.append(accountId).append(',')\n          .append(netDeltaExposure).append(',')\n          .append(scanningRisk).append(',')\n          .append(spreadCharge).append(',')\n          .append(initialMargin).append(',')\n          .append(unrealizedPnl).append(',')\n          .append(marginStatus);\n        return sb.toString();\n    }\n}\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/src/CsvUtil.java <<\'EOF\'\npublic final class CsvUtil {\n    private CsvUtil() {}\n\n    public static String[] split(String line) {\n        // Simple CSV splitter for unquoted, comma-separated values.\n        // Trims whitespace around fields.\n        String[] raw = line.split(",", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/src/Main.java <<\'EOF\'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.TreeMap;\n\npublic final class Main {\n\n    public static void main(String[] args) throws Exception {\n        if (args == null || args.length != 4) {\n            return; // must not write stderr; tests will provide correct args\n        }\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> marketByContract = loadMarketData(marketDataPath);\n        Map<String, ContractSpec> specsByContract = loadContractSpecs(contractSpecsPath);\n\n        PositionAggregator aggregator = new PositionAggregator();\n        Map<String, PositionAggregator.AccountAgg> accounts = aggregator.aggregateByAccount(positions, specsByContract);\n\n        MarginCalculator calc = new MarginCalculator();\n        Map<String, MarginCalculator.UnderlyingParams> underlyingParams = calc.buildUnderlyingParams(specsByContract, marketByContract);\n\n        // Sort accounts by account_id ascending\n        List<String> accountIds = new ArrayList<String>(accounts.keySet());\n        Collections.sort(accountIds);\n\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        for (String accountId : accountIds) {\n            PositionAggregator.AccountAgg aa = accounts.get(accountId);\n\n            // net_delta_exposure output: sum of abs net deltas across underlyings\n            long netDeltaExposureSumAbs = 0L;\n\n            // scanning_risk output: sum of scanning risks across underlyings\n            long scanningRiskSum = 0L;\n\n            for (Map.Entry<String, PositionAggregator.UnderlyingAgg> e : aa.getByUnderlying().entrySet()) {\n                String underlying = e.getKey();\n                PositionAggregator.UnderlyingAgg ua = e.getValue();\n                long netDelta = ua.getNetDeltaExposure();\n                netDeltaExposureSumAbs += Math.abs(netDelta);\n\n                MarginCalculator.UnderlyingParams up = underlyingParams.get(underlying);\n                if (up == null) {\n                    // If missing (no market data), treat scanning risk as 0 for that underlying\n                    continue;\n                }\n                String repContract = ua.getRepresentativeContractCode();\n                MarketData repMd = marketByContract.get(repContract);\n                if (repMd == null) {\n                    // If missing market data for representative contract, treat scanning risk as 0\n                    continue;\n                }\n                long risk = calc.computeScanningRisk(netDelta, up.getMaxScanningRange(), repMd.getSettlementPrice());\n                scanningRiskSum += risk;\n            }\n\n            MarginCalculator.ListView<Position> posView = new MarginCalculator.ListView<Position>(aa.getPositions());\n\n            BigDecimal spreadChargeBD = calc.computeSpreadChargeBig(posView, marketByContract);\n            long spreadChargeTrunc = calc.truncateTowardZero(spreadChargeBD);\n\n            BigDecimal unrealizedPnlBD = calc.computeUnrealizedPnlBig(posView, specsByContract, marketByContract);\n            long unrealizedPnlTrunc = calc.truncateTowardZero(unrealizedPnlBD);\n\n            // initial margin: sum scanning risks (already integers) + total spread charge, then truncate\n            BigDecimal initialMarginBD = BigDecimal.valueOf(scanningRiskSum).add(spreadChargeBD);\n            long initialMarginTrunc = calc.truncateTowardZero(initialMarginBD);\n\n            String status = (unrealizedPnlTrunc >= initialMarginTrunc) ? "ADEQUATE" : "CALL";\n\n            results.add(new AccountMargin(accountId,\n                    netDeltaExposureSumAbs,\n                    scanningRiskSum,\n                    spreadChargeTrunc,\n                    initialMarginTrunc,\n                    unrealizedPnlTrunc,\n                    status));\n        }\n\n        writeReport(outputPath, results);\n    }\n\n    private static List<Position> loadPositions(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), "UTF-8"));\n        try {\n            List<Position> out = new ArrayList<Position>();\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    // header\n                    continue;\n                }\n                out.add(Position.parseCsv(line));\n            }\n            return out;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), "UTF-8"));\n        try {\n            Map<String, MarketData> out = new HashMap<String, MarketData>();\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                MarketData md = MarketData.parseCsv(line);\n                out.put(md.getContractCode(), md);\n            }\n            return out;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), "UTF-8"));\n        try {\n            Map<String, ContractSpec> out = new HashMap<String, ContractSpec>();\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                ContractSpec cs = ContractSpec.parseCsv(line);\n                out.put(cs.getContractCode(), cs);\n            }\n            return out;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static void writeReport(String outputPath, List<AccountMargin> rows) throws Exception {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(outputPath), "UTF-8"));\n        try {\n            bw.write("account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status");\n            bw.newLine();\n            for (AccountMargin am : rows) {\n                bw.write(am.toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            bw.close();\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
