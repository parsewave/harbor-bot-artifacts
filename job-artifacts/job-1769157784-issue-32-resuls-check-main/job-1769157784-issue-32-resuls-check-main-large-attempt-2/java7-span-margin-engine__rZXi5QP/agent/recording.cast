[117.609191, "i", "cat > /app/src/AccountMargin.java <<'EOF'\npublic final class AccountMargin {\n    private final String accountId;\n    private final long netDeltaExposure;\n    private final long scanningRisk;\n    private final long spreadCharge;\n    private final long initialMargin;\n    private final long unrealizedPnl;\n    private final String marginStatus;\n\n    public AccountMargin(String accountId,\n                         long netDeltaExposure,\n                         long scanningRisk,\n                         long spreadCharge,\n                         long initialMargin,\n                         long unrealizedPnl,\n                         String marginStatus) {\n        this.accountId = accountId;\n        this.netDeltaExposure = netDeltaExposure;\n        this.scanningRisk = scanningRisk;\n        this.spreadCharge = spreadCharge;\n        this.initialMargin = initialMargin;\n        this.unrealizedPnl = unrealizedPnl;\n        this.marginStatus = marginStatus;\n    }\n\n    public String getAccountId() {\n        return accountId;\n    }\n\n    public long getNetDeltaExposure() {\n        return netDeltaExposure;\n    }\n\n    public long getScanningRisk() {\n        return scanningRisk;\n    }\n\n    public long getSpreadCharge() {\n        return spreadCharge;\n    }\n\n    public long getInitialMargin() {\n        return initialMargin;\n    }\n\n    public long getUnrealizedPnl() {\n        return unrealizedPnl;\n    }\n\n    public String getMarginStatus() {\n        return marginStatus;\n    }\n\n    public String toCsvRow() {\n        StringBuilder sb = new StringBuilder();\n        sb.append(accountId).append(',')\n          .append(netDeltaExposure).append(',')\n          .append(scanningRisk).append(',')\n          .append(spreadCharge).append(',')\n          .append(initialMargin).append(',')\n          .append(unrealizedPnl).append(',')\n          .append(marginStatus);\n        return sb.toString();\n    }\n}\nEOF\n"]
