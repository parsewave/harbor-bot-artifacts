[117.423589, "o", "        Map<String, UnderlyingParams> params = new HashMap<String, UnderlyingParams>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.423769, "o", "        for (Map.Entry<String, BigDecimal> e : maxScan.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.423969, "o", "            params.put(e.getKey(), new UnderlyingParams(e.getValue()));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.424064, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.424233, "o", "        return params;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.424418, "o", "    public long computeScanningRisk(long netDeltaExposure,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.42458, "o", "                                   BigDecimal maxScanningRange,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.424844, "o", "                                   BigDecimal representativeSettlementPrice) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.425065, "o", "        BigDecimal absDelta = BigDecimal.valueOf(Math.abs(netDeltaExposure));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.425394, "o", "        BigDecimal risk = absDelta.multiply(maxScanningRange).multiply(representativeSettlementPrice);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.425537, "o", "        return truncateTowardZero(risk);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[117.425667, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.425743, "o", "    public long truncateTowardZero(BigDecimal v) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.425933, "o", "        return v.setScale(0, RoundingMode.DOWN).longValue();\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[117.425992, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.42621, "o", "    public BigDecimal computeSpreadChargeBig(ListView<Position> positions,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.426499, "o", "                                             Map<String, MarketData> marketByContract) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.426725, "o", "        BigDecimal total = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.426913, "o", "        for (int i = 0; i < positions.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.427086, "o", "            Position p = positions.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.427183, "o", "            MarketData md = marketByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.427387, "o", "            if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.427561, "o", "                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.427755, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.427956, "o", "            BigDecimal qtyAbs = BigDecimal.valueOf(Math.abs((long) p.getPositionQty()));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.42818, "o", "            total = total.add(md.getIntraSpreadCharge().multiply(qtyAbs));\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.428465, "o", "        return total;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
