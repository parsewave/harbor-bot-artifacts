[117.802487, "i", "cat > /app/src/CsvUtil.java <<'EOF'\npublic final class CsvUtil {\n    private CsvUtil() {}\n\n    public static String[] split(String line) {\n        // Simple CSV splitter for unquoted, comma-separated values.\n        // Trims whitespace around fields.\n        String[] raw = line.split(\",\", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n"]
[117.802866, "o", "cat > /app/src/CsvUtil.java <<'EOF'\r\n\u001b[?2004l\r"]
