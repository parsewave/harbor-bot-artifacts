[117.414057, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.HashMap;\nimport java.util.Map;\n\npublic final class MarginCalculator {\n\n    private static final BigDecimal ONE_HUNDRED = new BigDecimal(\"100\");\n\n    public static final class UnderlyingParams {\n        private final BigDecimal maxScanningRange; // already divided by 100\n\n        public UnderlyingParams(BigDecimal maxScanningRange) {\n            this.maxScanningRange = maxScanningRange;\n        }\n\n        public BigDecimal getMaxScanningRange() {\n            return maxScanningRange;\n        }\n    }\n\n    public Map<String, UnderlyingParams> buildUnderlyingParams(Map<String, ContractSpec> specsByContract,\n                                                               Map<String, MarketData> marketByContract) {\n        Map<String, BigDecimal> maxScan = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, ContractSpec> e : specsByContract.entrySet()) {\n            String contract = e.getKey();\n            ContractSpec spec = e.getValue();\n            MarketData md = marketByContract.get(contract);\n            if (md == null) {\n                // If market data missing for a contract, skip it for max scanning range purposes\n                continue;\n            }\n            String underlying = spec.getUnderlying();\n            BigDecimal scan = md.getScanningRangePct().divide(ONE_HUNDRED);\n            BigDecimal curr = maxScan.get(underlying);\n            if (curr == null || scan.compareTo(curr) > 0) {\n                maxScan.put(underlying, scan);\n            }\n        }\n\n        Map<String, UnderlyingParams> params = new HashMap<String, UnderlyingParams>();\n        for (Map.Entry<String, BigDecimal> e : maxScan.entrySet()) {\n            params.put(e.getKey(), new UnderlyingParams(e.getValue()));\n        }\n        return params;\n    }\n\n    public long computeScanningRisk(long netDeltaExposure,\n                                   BigDecimal maxScanningRange,\n                                   BigDecimal representativeSettlementPrice) {\n        BigDecimal absDelta = BigDecimal.valueOf(Math.abs(netDeltaExposure));\n        BigDecimal risk = absDelta.multiply(maxScanningRange).multiply(representativeSettlementPrice);\n        return truncateTowardZero(risk);\n    }\n\n    public long truncateTowardZero(BigDecimal v) {\n        return v.setScale(0, RoundingMode.DOWN).longValue();\n    }\n\n    public BigDecimal computeSpreadChargeBig(ListView<Position> positions,\n                                             Map<String, MarketData> marketByContract) {\n        BigDecimal total = BigDecimal.ZERO;\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            MarketData md = marketByContract.get(p.getContractCode());\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.getContractCode());\n            }\n            BigDecimal qtyAbs = BigDecimal.valueOf(Math.abs((long) p.getPositionQty()));\n            total = total.add(md.getIntraSpreadCharge().multiply(qtyAbs));\n        }\n        return total;\n    }\n\n    public BigDecimal computeUnrealizedPnlBig(ListView<Position> positions,\n                                             Map<String, ContractSpec> specsByContract,\n                                             Map<String, MarketData> marketByContract) {\n        BigDecimal total = BigDecimal.ZERO;\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = specsByContract.get(p.getContractCode());\n            MarketData md = marketByContract.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\n            }\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.getContractCode());\n            }\n            BigDecimal priceDiff = md.getSettlem"]
[117.414158, "i", "entPrice().subtract(p.getEntryPrice());\n            long qtyMult = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());\n            BigDecimal pnl = BigDecimal.valueOf(qtyMult).multiply(priceDiff);\n            total = total.add(pnl);\n        }\n        return total;\n    }\n\n    /** Minimal Java 7 friendly view wrapper for List<Position> without importing java.util.List everywhere. */\n    public static final class ListView<T> {\n        private final java.util.List<T> list;\n        public ListView(java.util.List<T> list) { this.list = list; }\n        public int size() { return list.size(); }\n        public T get(int idx) { return list.get(idx); }\n    }\n}\nEOF\n"]
