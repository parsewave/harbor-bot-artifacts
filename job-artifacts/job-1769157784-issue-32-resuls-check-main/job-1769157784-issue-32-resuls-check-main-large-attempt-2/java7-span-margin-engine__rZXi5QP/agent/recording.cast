[117.24458, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class PositionAggregator {\n\n    public static final class UnderlyingAgg {\n        private long netDeltaExposure; // sum(qty * multiplier)\n        private long maxOpenInterestEquiv; // max(abs(qty) * multiplier)\n        private String representativeContractCode;\n\n        public UnderlyingAgg() {\n            this.netDeltaExposure = 0L;\n            this.maxOpenInterestEquiv = -1L;\n            this.representativeContractCode = null;\n        }\n\n        public void apply(Position p, ContractSpec spec) {\n            long delta = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());\n            netDeltaExposure += delta;\n\n            long oie = Math.abs((long) p.getPositionQty()) * ((long) spec.getMultiplier());\n            if (oie > maxOpenInterestEquiv) {\n                maxOpenInterestEquiv = oie;\n                representativeContractCode = p.getContractCode();\n            }\n        }\n\n        public long getNetDeltaExposure() {\n            return netDeltaExposure;\n        }\n\n        public String getRepresentativeContractCode() {\n            return representativeContractCode;\n        }\n    }\n\n    public static final class AccountAgg {\n        private final String accountId;\n        private final Map<String, UnderlyingAgg> byUnderlying;\n        private final List<Position> positions;\n\n        public AccountAgg(String accountId) {\n            this.accountId = accountId;\n            this.byUnderlying = new HashMap<String, UnderlyingAgg>();\n            this.positions = new ArrayList<Position>();\n        }\n\n        public String getAccountId() {\n            return accountId;\n        }\n\n        public Map<String, UnderlyingAgg> getByUnderlying() {\n            return byUnderlying;\n        }\n\n        public List<Position> getPositions() {\n            return positions;\n        }\n\n        public void addPosition(Position p, ContractSpec spec) {\n            positions.add(p);\n            String underlying = spec.getUnderlying();\n            UnderlyingAgg ua = byUnderlying.get(underlying);\n            if (ua == null) {\n                ua = new UnderlyingAgg();\n                byUnderlying.put(underlying, ua);\n            }\n            ua.apply(p, spec);\n        }\n    }\n\n    public Map<String, AccountAgg> aggregateByAccount(List<Position> positions, Map<String, ContractSpec> specsByContract) {\n        Map<String, AccountAgg> accounts = new HashMap<String, AccountAgg>();\n        for (Position p : positions) {\n            ContractSpec spec = specsByContract.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\n            }\n            AccountAgg aa = accounts.get(p.getAccountId());\n            if (aa == null) {\n                aa = new AccountAgg(p.getAccountId());\n                accounts.put(p.getAccountId(), aa);\n            }\n            aa.addPosition(p, spec);\n        }\n        return accounts;\n    }\n}\nEOF\n"]
