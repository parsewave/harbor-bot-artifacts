[180.095899, "i", "cat > /app/src/MarketData.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic final class MarketData {\n    private final String contractCode;\n    private final BigDecimal settlementPrice;\n    private final BigDecimal scanningRangePct;\n    private final BigDecimal intraSpreadCharge;\n\n    public MarketData(String contractCode, BigDecimal settlementPrice, BigDecimal scanningRangePct, BigDecimal intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRangePct = scanningRangePct;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public String getContractCode() {\n        return contractCode;\n    }\n\n    public BigDecimal getSettlementPrice() {\n        return settlementPrice;\n    }\n\n    public BigDecimal getScanningRangePct() {\n        return scanningRangePct;\n    }\n\n    public BigDecimal getIntraSpreadCharge() {\n        return intraSpreadCharge;\n    }\n\n    public static MarketData parseCsv(String line) {\n        // contract_code, settlement_price, scanning_range, intra_spread_charge\n        String[] parts = split(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid market_data row: \" + line);\n        }\n        String contractCode = parts[0];\n        BigDecimal settlement = new BigDecimal(parts[1]);\n        BigDecimal scanningRange = new BigDecimal(parts[2]);\n        BigDecimal intra = new BigDecimal(parts[3]);\n        return new MarketData(contractCode, settlement, scanningRange, intra);\n    }\n\n    private static String[] split(String line) {\n        String[] raw = line.split(\",\", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n"]
