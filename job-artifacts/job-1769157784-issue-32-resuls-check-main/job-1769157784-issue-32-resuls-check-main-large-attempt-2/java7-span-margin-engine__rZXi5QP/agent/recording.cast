[117.429283, "o", "        BigDecimal total = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.429504, "o", "        for (int i = 0; i < positions.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.429706, "o", "            Position p = positions.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.429828, "o", "            ContractSpec spec = specsByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.429936, "o", "            MarketData md = marketByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.430213, "o", "            if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.43038, "o", "                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[117.430645, "o", "\u001b[?2004h>             if (md == null) {\r\n\u001b[?2004l\r"]
[117.430868, "o", "\u001b[?2004h> "]
[117.430995, "o", "                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.431296, "o", "            BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.431664, "o", "            long qtyMult = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.431876, "o", "            BigDecimal pnl = BigDecimal.valueOf(qtyMult).multiply(priceDiff);\r\n\u001b[?2004l\r\u001b[?2004h>             total = total.add(pnl);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.432045, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.432223, "o", "        return total;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.432537, "o", "    /** Minimal Java 7 friendly view wrapper for List<Position> without importing java.util.List everywhere. */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.432756, "o", "    public static final class ListView<T> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.433008, "o", "        private final java.util.List<T> list;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.433168, "o", "        public ListView(java.util.List<T> list) { this.list = list; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.433309, "o", "        public int size() { return list.size(); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.433528, "o", "        public T get(int idx) { return list.get(idx); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.433672, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
