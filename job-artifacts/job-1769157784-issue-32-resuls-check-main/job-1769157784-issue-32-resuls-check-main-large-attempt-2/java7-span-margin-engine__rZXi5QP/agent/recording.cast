[117.973382, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.TreeMap;\n\npublic final class Main {\n\n    public static void main(String[] args) throws Exception {\n        if (args == null || args.length != 4) {\n            return; // must not write stderr; tests will provide correct args\n        }\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> marketByContract = loadMarketData(marketDataPath);\n        Map<String, ContractSpec> specsByContract = loadContractSpecs(contractSpecsPath);\n\n        PositionAggregator aggregator = new PositionAggregator();\n        Map<String, PositionAggregator.AccountAgg> accounts = aggregator.aggregateByAccount(positions, specsByContract);\n\n        MarginCalculator calc = new MarginCalculator();\n        Map<String, MarginCalculator.UnderlyingParams> underlyingParams = calc.buildUnderlyingParams(specsByContract, marketByContract);\n\n        // Sort accounts by account_id ascending\n        List<String> accountIds = new ArrayList<String>(accounts.keySet());\n        Collections.sort(accountIds);\n\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        for (String accountId : accountIds) {\n            PositionAggregator.AccountAgg aa = accounts.get(accountId);\n\n            // net_delta_exposure output: sum of abs net deltas across underlyings\n            long netDeltaExposureSumAbs = 0L;\n\n            // scanning_risk output: sum of scanning risks across underlyings\n            long scanningRiskSum = 0L;\n\n            for (Map.Entry<String, PositionAggregator.UnderlyingAgg> e : aa.getByUnderlying().entrySet()) {\n                String underlying = e.getKey();\n                PositionAggregator.UnderlyingAgg ua = e.getValue();\n                long netDelta = ua.getNetDeltaExposure();\n                netDeltaExposureSumAbs += Math.abs(netDelta);\n\n                MarginCalculator.UnderlyingParams up = underlyingParams.get(underlying);\n                if (up == null) {\n                    // If missing (no market data), treat scanning risk as 0 for that underlying\n                    continue;\n                }\n                String repContract = ua.getRepresentativeContractCode();\n                MarketData repMd = marketByContract.get(repContract);\n                if (repMd == null) {\n                    // If missing market data for representative contract, treat scanning risk as 0\n                    continue;\n                }\n                long risk = calc.computeScanningRisk(netDelta, up.getMaxScanningRange(), repMd.getSettlementPrice());\n                scanningRiskSum += risk;\n            }\n\n            MarginCalculator.ListView<Position> posView = new MarginCalculator.ListView<Position>(aa.getPositions());\n\n            BigDecimal spreadChargeBD = calc.computeSpreadChargeBig(posView, marketByContract);\n            long spreadChargeTrunc = calc.truncateTowardZero(spreadChargeBD);\n\n            BigDecimal unrealizedPnlBD = calc.computeUnrealizedPnlBig(posView, specsByContract, marketByContract);\n            long unrealizedPnlTrunc = calc.truncateTowardZero(unrealizedPnlBD);\n\n            // initial margin: sum scanning risks (already integers) + total spread charge, then truncate\n            BigDecimal initialMarginBD = BigDecimal.valueOf(scanningRiskSum).add(spreadChargeBD);\n            long initialMarginTrunc = calc.truncateTowardZero(initialMarginBD);\n\n            String status = (unrealizedPnlTrunc >= initialMarginTrunc) ? \"ADEQUATE\" : \"CALL\";\n\n            results.add(new AccountMargin(accountId,\n   "]
[117.973704, "i", "                 netDeltaExposureSumAbs,\n                    scanningRiskSum,\n                    spreadChargeTrunc,\n                    initialMarginTrunc,\n                    unrealizedPnlTrunc,\n                    status));\n        }\n\n        writeReport(outputPath, results);\n    }\n\n    private static List<Position> loadPositions(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            List<Position> out = new ArrayList<Position>();\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    // header\n                    continue;\n                }\n                out.add(Position.parseCsv(line));\n            }\n            return out;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            Map<String, MarketData> out = new HashMap<String, MarketData>();\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                MarketData md = MarketData.parseCsv(line);\n                out.put(md.getContractCode(), md);\n            }\n            return out;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            Map<String, ContractSpec> out = new HashMap<String, ContractSpec>();\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                ContractSpec cs = ContractSpec.parseCsv(line);\n                out.put(cs.getContractCode(), cs);\n            }\n            return out;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static void writeReport(String outputPath, List<AccountMargin> rows) throws Exception {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(outputPath), \"UTF-8\"));\n        try {\n            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\n            bw.newLine();\n            for (AccountMargin am : rows) {\n                bw.write(am.toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            bw.close();\n        }\n    }\n}\nEOF\n"]
