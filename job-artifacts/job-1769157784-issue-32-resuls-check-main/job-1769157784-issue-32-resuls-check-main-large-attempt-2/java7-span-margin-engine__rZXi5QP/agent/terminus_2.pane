[?2004l[?2004h> 
[?2004l[?2004h> public final class PositionAggregator {
[?2004l[?2004h> 
[?2004l[?2004h>     public static final class UnderlyingAgg {
[?2004l[?2004h>         private long netDeltaExposure; // sum(qty * multiplier)
[?2004l[?2004h>         private long maxOpenInterestEquiv; // max(abs(qty) * multiplier)
[?2004l[?2004h>         private String representativeContractCode;
[?2004l[?2004h> 
[?2004l[?2004h>         public UnderlyingAgg() {
[?2004l[?2004h>             this.netDeltaExposure = 0L;
[?2004l[?2004h>             this.maxOpenInterestEquiv = -1L;
[?2004l[?2004h>             this.representativeContractCode = null;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public void apply(Position p, ContractSpec spec) {
[?2004l[?2004h>             long delta = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());
[?2004l[?2004h>             netDeltaExposure += delta;
[?2004l[?2004h> 
[?2004l[?2004h>             long oie = Math.abs((long) p.getPositionQty()) * ((long) spec.getMultiplier());
[?2004l[?2004h>             if (oie > maxOpenInterestEquiv) {
[?2004l[?2004h>                 maxOpenInterestEquiv = oie;
[?2004l[?2004h>                 representativeContractCode = p.getContractCode();
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public long getNetDeltaExposure() {
[?2004l[?2004h>             return netDeltaExposure;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public String getRepresentativeContractCode() {
[?2004l[?2004h>             return representativeContractCode;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public static final class AccountAgg {
[?2004l[?2004h>         private final String accountId;
[?2004l[?2004h>         private final Map<String, UnderlyingAgg> byUnderlying;
[?2004l[?2004h>         private final List<Position> positions;
[?2004l[?2004h> 
[?2004l[?2004h>         public AccountAgg(String accountId) {
[?2004l[?2004h>             this.accountId = accountId;
[?2004l[?2004h>             this.byUnderlying = new HashMap<String, UnderlyingAgg>();
[?2004l[?2004h>             this.positions = new ArrayList<Position>();
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public String getAccountId() {
[?2004l[?2004h>             return accountId;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public Map<String, UnderlyingAgg> getByUnderlying() {
[?2004l[?2004h>             return byUnderlying;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public List<Position> getPositions() {
[?2004l[?2004h>             return positions;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public void addPosition(Position p, ContractSpec spec) {
[?2004l[?2004h>             positions.add(p);
[?2004l[?2004h>             String underlying = spec.getUnderlying();
[?2004l[?2004h>             UnderlyingAgg ua = byUnderlying.get(underlying);
[?2004l[?2004h>             if (ua == null) {
[?2004l[?2004h>                 ua = new UnderlyingAgg();
[?2004l[?2004h>                 byUnderlying.put(underlying, ua);
[?2004l[?2004h>             }
[?2004l[?2004h>             ua.apply(p, spec);
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public Map<String, AccountAgg> aggregateByAccount(List<Position> positions, Map<String, ContractSpec> specsByContract) {
[?2004l[?2004h>         Map<String, AccountAgg> accounts = new HashMap<String, AccountAgg>();
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             ContractSpec spec = specsByContract.get(p.getContractCode());
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.getContractCode());
[?2004l[?2004h>             }
[?2004l[?2004h>             AccountAgg aa = accounts.get(p.getAccountId());
[?2004l[?2004h>             if (aa == null) {
[?2004l[?2004h>                 aa = new AccountAgg(p.getAccountId());
[?2004l[?2004h>                 accounts.put(p.getAccountId(), aa);
[?2004l[?2004h>             }
[?2004l[?2004h>             aa.addPosition(p, spec);
[?2004l[?2004h>         }
[?2004l[?2004h>         return accounts;
[?2004l[?2004h>     }
[?2004l[?2004h> }
