[?2004l get(i[?2004h> 
[?2004ln[?2004h>     public Map<String, UnderlyingParams> buildUnderlyingParams(Map<String, ContractSpec> specsByContract,
[?2004l[?2004h>                                                                Map<String, MarketData> marketByContract) {
[?2004l[?2004h>         Map<String, BigDecimal> maxScan = new HashMap<String, BigDecimal>();
[?2004l[?2004h>         for (Map.Entry<String, ContractSpec> e : specsByContract.entrySet()) {
[?2004l[?2004h>             String contract = e.getKey();
[?2004l[?2004h>             ContractSpec spec = e.getValue();
[?2004l[?2004h>             MarketData md = marketByContract.get(contract);
[?2004l[?2004h>             if (md == null) {
[?2004l[?2004h>                 // If market data missing for a contract, skip it for max scanning range purposes
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             String underlying = spec.getUnderlying();
[?2004l[?2004h>             BigDecimal scan = md.getScanningRangePct().divide(ONE_HUNDRED);
[?2004l[?2004h>             BigDecimal curr = maxScan.get(underlying);
[?2004l[?2004h>             if (curr == null || scan.compareTo(curr) > 0) {
[?2004l[?2004h>                 maxScan.put(underlying, scan);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         Map<String, UnderlyingParams> params = new HashMap<String, UnderlyingParams>();
[?2004l[?2004h>         for (Map.Entry<String, BigDecimal> e : maxScan.entrySet()) {
[?2004l[?2004h>             params.put(e.getKey(), new UnderlyingParams(e.getValue()));
[?2004l[?2004h>         }
[?2004l[?2004h>         return params;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public long computeScanningRisk(long netDeltaExposure,
[?2004l[?2004h>                                    BigDecimal maxScanningRange,
[?2004l[?2004h>                                    BigDecimal representativeSettlementPrice) {
[?2004l[?2004h>         BigDecimal absDelta = BigDecimal.valueOf(Math.abs(netDeltaExposure));
[?2004l[?2004h>         BigDecimal risk = absDelta.multiply(maxScanningRange).multiply(representativeSettlementPrice);
[?2004l[?2004h>         return truncateTowardZero(risk);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public long truncateTowardZero(BigDecimal v) {
[?2004l[?2004h>         return v.setScale(0, RoundingMode.DOWN).longValue();
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public BigDecimal computeSpreadChargeBig(ListView<Position> positions,
[?2004l[?2004h>                                              Map<String, MarketData> marketByContract) {
[?2004l[?2004h>         BigDecimal total = BigDecimal.ZERO;
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position p = positions.get(i);
[?2004l[?2004h>             MarketData md = marketByContract.get(p.getContractCode());
[?2004l[?2004h>             if (md == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing market data for contract_code=" + p.getContractCode());
[?2004l[?2004h>             }
[?2004l[?2004h>             BigDecimal qtyAbs = BigDecimal.valueOf(Math.abs((long) p.getPositionQty()));
[?2004l[?2004h>             total = total.add(md.getIntraSpreadCharge().multiply(qtyAbs));
[?2004l[?2004h>         }
[?2004l[?2004h>         return total;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public BigDecimal computeUnrealizedPnlBig(ListView<Position> positions,
[?2004l[?2004h>                                              Map<String, ContractSpec> specsByContract,
[?2004l[?2004h>                                              Map<String, MarketData> marketByContract) {
[?2004l[?2004h>         BigDecimal total = BigDecimal.ZERO;
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position p = positions.get(i);
[?2004l[?2004h>             ContractSpec spec = specsByContract.get(p.getContractCode());
[?2004l[?2004h>             MarketData md = marketByContract.get(p.getContractCode());
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.getContractCode());
[?2004l[?2004h>             }
[?2004l[?2004h>             if (md == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing market data for contract_code=" + p.getContractCode());
[?2004l[?2004h>             }
[?2004l[?2004h>             BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());
[?2004l[?2004h>             long qtyMult = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());
[?2004l[?2004h>             BigDecimal pnl = BigDecimal.valueOf(qtyMult).multiply(priceDiff);
