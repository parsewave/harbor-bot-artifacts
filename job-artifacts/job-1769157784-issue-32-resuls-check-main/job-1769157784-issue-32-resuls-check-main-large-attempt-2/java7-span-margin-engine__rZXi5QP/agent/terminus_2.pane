[?2004l[?2004h>                 PositionAggregator.UnderlyingAgg ua = e.getValue();
[?2004l[?2004h>                 long netDelta = ua.getNetDeltaExposure();
[?2004l [?2004h>                 netDeltaExposureSumAbs += Math.abs(netDelta);
[?2004l[?2004h> 
[?2004lt[?2004h>                 MarginCalculator.UnderlyingParams up = underlyingParams.get(underlying);
[?2004l[?2004h>                 if (up == null) {
