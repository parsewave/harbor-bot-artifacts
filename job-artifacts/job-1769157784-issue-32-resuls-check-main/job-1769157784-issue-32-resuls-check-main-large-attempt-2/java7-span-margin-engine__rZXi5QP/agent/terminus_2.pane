[?2004l[?2004h> public final class AccountMargin {
[?2004l[?2004h>     private final String accountId;
[?2004l[?2004h>     private final long netDeltaExposure;
[?2004l[?2004h>     private final long scanningRisk;
[?2004l[?2004h>     private final long spreadCharge;
[?2004l[?2004h>     private final long initialMargin;
[?2004l[?2004h>     private final long unrealizedPnl;
[?2004l[?2004h>     private final String marginStatus;
[?2004l[?2004h> 
[?2004l[?2004h>     public AccountMargin(String accountId,
[?2004l[?2004h>                          long netDeltaExposure,
[?2004l[?2004h>                          long scanningRisk,
[?2004l[?2004h>                          long spreadCharge,
[?2004l[?2004h>                          long initialMargin,
