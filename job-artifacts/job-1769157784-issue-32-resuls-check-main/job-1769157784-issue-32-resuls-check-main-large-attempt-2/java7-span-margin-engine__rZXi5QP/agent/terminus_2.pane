[?2004ll[?2004h> public final class MarginCalculator {
[?2004l[?2004h> 
[?2004ly[?2004h>     private static final BigDecimal ONE_HUNDRED = new BigDecimal("100");
[?2004l[?2004h> 
[?2004l [?2004h>     public static final class UnderlyingParams {
[?2004l[?2004h>         private final BigDecimal maxScanningRange; // already divided by 100
[?2004l[?2004h> 
[?2004l [?2004h>         public UnderlyingParams(BigDecimal maxScanningRange) {
[?2004l[?2004h>             this.maxScanningRange = maxScanningRange;
