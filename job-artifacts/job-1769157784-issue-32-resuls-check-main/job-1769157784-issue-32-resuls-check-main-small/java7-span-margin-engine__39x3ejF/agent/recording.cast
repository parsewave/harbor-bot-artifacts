[47.16102, "i", "cat > /app/src/ContractSpec.java <<'EOF'\npackage src;\n\npublic class ContractSpec {\n    public String contractCode;\n    public int multiplier;\n    public String expiryMonth; // format YYYYMM\n    public String underlying;\n\n    public ContractSpec(String contractCode, int multiplier, String expiryMonth, String underlying) {\n        this.contractCode = contractCode;\n        this.multiplier = multiplier;\n        this.expiryMonth = expiryMonth;\n        this.underlying = underlying;\n    }\n\n    public static ContractSpec parse(String line) {\n        String[] parts = line.split(\",\");\n        // Expected: contract_code,multiplier,expiry_month,underlying\n        String contractCode = parts[0].trim();\n        int multiplier = Integer.parseInt(parts[1].trim());\n        String expiryMonth = parts[2].trim();\n        String underlying = parts[3].trim();\n        return new ContractSpec(contractCode, multiplier, expiryMonth, underlying);\n    }\n}\nEOF\n"]
