[50.268643, "o", "\u001b[?2004hroot@9d574547543a:/app# "]
[71.442871, "i", "cat > /app/src/Main.java <<'EOF'\npackage src;\n\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 4) {\n            System.err.println(\"Usage: java Main <positions_path> <market_data_path> <contract_specs_path> <output_path>\");\n            System.exit(1);\n        }\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        // Load contract specs (skip header)\n        Map<String, ContractSpec> specMap = new HashMap<String, ContractSpec>();\n        BufferedReader brSpec = new BufferedReader(new FileReader(contractSpecsPath));\n        String line;\n        boolean firstSpecLine = true;\n        while ((line = brSpec.readLine()) != null) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            if (firstSpecLine) {\n                // Detect header by checking for non-numeric multiplier token\n                String[] parts = line.split(\",\");\n                if (parts.length > 1 && parts[1].trim().equalsIgnoreCase(\"multiplier\")) {\n                    firstSpecLine = false;\n                    continue; // skip header\n                }\n                firstSpecLine = false;\n            }\n            ContractSpec spec = ContractSpec.parse(line);\n            specMap.put(spec.contractCode, spec);\n        }\n        brSpec.close();\n\n        // Load market data (skip header)\n        Map<String, MarketData> marketMap = new HashMap<String, MarketData>();\n        BufferedReader brMkt = new BufferedReader(new FileReader(marketDataPath));\n        boolean firstMktLine = true;\n        while ((line = brMkt.readLine()) != null) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            if (firstMktLine) {\n                String[] parts = line.split(\",\");\n                if (parts.length > 1 && parts[1].trim().equalsIgnoreCase(\"settlement_price\")) {\n                    firstMktLine = false;\n                    continue; // skip header\n                }\n                firstMktLine = false;\n            }\n            MarketData md = MarketData.parse(line);\n            marketMap.put(md.contractCode, md);\n        }\n        brMkt.close();\n\n        // Load positions (skip header)\n        List<Position> positions = new ArrayList<Position>();\n        BufferedReader brPos = new BufferedReader(new FileReader(positionsPath));\n        boolean firstPosLine = true;\n        while ((line = brPos.readLine()) != null) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            if (firstPosLine) {\n                String[] parts = line.split(\",\");\n                if (parts.length > 1 && parts[1].trim().equalsIgnoreCase(\"contract_code\")) {\n                    firstPosLine = false;\n                    continue; // skip header\n                }\n                firstPosLine = false;\n            }\n            Position p = Position.parse(line);\n            positions.add(p);\n        }\n        brPos.close();\n\n        // Aggregate positions by account and underlying\n        Map<String, Map<String, List<Position>>> agg = PositionAggregator.aggregate(positions, specMap);\n\n        // Calculate margins\n        List<AccountMargin> margins = MarginCalculator.calculate(agg, specMap, marketMap);\n\n        // Sort by account_id ascending\n        Collections.sort(margins, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a1, AccountMargin a2) {\n                return a1.accountId.compareTo(a2.accountId);\n            }\n        });\n\n        // Write output CSV\n        File outFile = new File(outputPath);\n        outFile.getParentFile().mkdirs();\n        BufferedWriter bw = new BufferedWriter(new FileWriter(outFile));\n        bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\\n\");\n        for (AccountMargin am : margins) {\n            bw.write(am.toCsvLine());\n            bw.write('\\n');\n        }\n        bw."]
[71.442993, "i", "flush();\n        bw.close();\n    }\n}\nEOF\n"]
