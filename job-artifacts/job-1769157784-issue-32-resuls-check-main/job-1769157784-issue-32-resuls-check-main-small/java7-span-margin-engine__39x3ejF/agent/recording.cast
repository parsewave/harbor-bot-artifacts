[47.34693, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\npackage src;\n\nimport java.util.*;\n\npublic class PositionAggregator {\n    /**\n     * Organizes positions by account and underlying.\n     * Returns a map: accountId -> (underlying -> List<Position>)\n     */\n    public static Map<String, Map<String, List<Position>>> aggregate(List<Position> positions, Map<String, ContractSpec> specMap) {\n        Map<String, Map<String, List<Position>>> result = new HashMap<String, Map<String, List<Position>>>();\n        for (Position p : positions) {\n            ContractSpec spec = specMap.get(p.contractCode);\n            if (spec == null) {\n                // Skip positions with missing spec\n                continue;\n            }\n            String underlying = spec.underlying;\n            Map<String, List<Position>> byUnderlying = result.get(p.accountId);\n            if (byUnderlying == null) {\n                byUnderlying = new HashMap<String, List<Position>>();\n                result.put(p.accountId, byUnderlying);\n            }\n            List<Position> list = byUnderlying.get(underlying);\n            if (list == null) {\n                list = new ArrayList<Position>();\n                byUnderlying.put(underlying, list);\n            }\n            list.add(p);\n        }\n        return result;\n    }\n}\nEOF\n"]
