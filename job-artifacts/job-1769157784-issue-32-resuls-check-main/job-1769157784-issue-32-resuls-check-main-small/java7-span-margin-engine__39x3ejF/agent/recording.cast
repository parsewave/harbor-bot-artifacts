[46.845267, "i", "cat > /app/src/Position.java <<'EOF'\npackage src;\n\npublic class Position {\n    public String accountId;\n    public String contractCode;\n    public int positionQty;\n    public double entryPrice;\n\n    public Position(String accountId, String contractCode, int positionQty, double entryPrice) {\n        this.accountId = accountId;\n        this.contractCode = contractCode;\n        this.positionQty = positionQty;\n        this.entryPrice = entryPrice;\n    }\n\n    public static Position parse(String line) {\n        String[] parts = line.split(\",\");\n        // Expected: account_id,contract_code,position_qty,entry_price\n        String accountId = parts[0].trim();\n        String contractCode = parts[1].trim();\n        int positionQty = Integer.parseInt(parts[2].trim());\n        double entryPrice = Double.parseDouble(parts[3].trim());\n        return new Position(accountId, contractCode, positionQty, entryPrice);\n    }\n}\nEOF\n"]
