[47.000821, "i", "cat > /app/src/MarketData.java <<'EOF'\npackage src;\n\npublic class MarketData {\n    public String contractCode;\n    public double settlementPrice;\n    public double scanningRange; // as percentage, e.g., 5.0 means 5%\n    public double intraSpreadCharge;\n\n    public MarketData(String contractCode, double settlementPrice, double scanningRange, double intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRange = scanningRange;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public static MarketData parse(String line) {\n        String[] parts = line.split(\",\");\n        // Expected: contract_code,settlement_price,scanning_range,intra_spread_charge\n        String contractCode = parts[0].trim();\n        double settlementPrice = Double.parseDouble(parts[1].trim());\n        double scanningRange = Double.parseDouble(parts[2].trim());\n        double intraSpreadCharge = Double.parseDouble(parts[3].trim());\n        return new MarketData(contractCode, settlementPrice, scanningRange, intraSpreadCharge);\n    }\n}\nEOF\n"]
