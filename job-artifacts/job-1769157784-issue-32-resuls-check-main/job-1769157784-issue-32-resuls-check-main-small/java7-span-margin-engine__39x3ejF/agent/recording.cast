[47.731217, "o", "    public String toCsvLine() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.731761, "o", "        return accountId + \",\" + netDeltaExposure + \",\" + scanningRisk + \",\" + spreadCharge + \",\" + initialMargin + \",\" + unrealizedPnl + \",\" + marginStatus;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
