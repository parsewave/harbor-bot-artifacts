[47.729782, "o", "    public AccountMargin(String accountId, int netDeltaExposure, int scanningRisk, int spreadCharge, int initialMargin, int unrealizedPnl, String marginStatus) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
