[47.544957, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\npackage src;\n\nimport java.util.*;\n\npublic class MarginCalculator {\n    public static List<AccountMargin> calculate(\n            Map<String, Map<String, List<Position>>> accountUnderlyingPositions,\n            Map<String, ContractSpec> specMap,\n            Map<String, MarketData> marketMap) {\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n        for (String accountId : accountUnderlyingPositions.keySet()) {\n            Map<String, List<Position>> underlyingMap = accountUnderlyingPositions.get(accountId);\n            int totalScanningRisk = 0;\n            int totalSpreadCharge = 0;\n            int netDeltaExposureSumAbs = 0;\n            int totalUnrealizedPnl = 0;\n            for (String underlying : underlyingMap.keySet()) {\n                List<Position> posList = underlyingMap.get(underlying);\n                // Compute net delta exposure for this underlying\n                int netDelta = 0;\n                // For scanning risk we need max scanning range among contracts of this underlying\n                double maxScanningRangePct = 0.0;\n                // Representative settlement price: contract with highest open interest equivalent\n                double repSettlementPrice = 0.0;\n                int maxOpenInterestEquiv = -1;\n                for (Position p : posList) {\n                    ContractSpec spec = specMap.get(p.contractCode);\n                    MarketData md = marketMap.get(p.contractCode);\n                    if (spec == null || md == null) {\n                        continue; // safety\n                    }\n                    int delta = p.positionQty * spec.multiplier;\n                    netDelta += delta;\n                    // scanning range\n                    if (md.scanningRange > maxScanningRangePct) {\n                        maxScanningRangePct = md.scanningRange;\n                    }\n                    int openInterestEquiv = Math.abs(delta);\n                    if (openInterestEquiv > maxOpenInterestEquiv) {\n                        maxOpenInterestEquiv = openInterestEquiv;\n                        repSettlementPrice = md.settlementPrice;\n                    }\n                    // spread charge per contract\n                    totalSpreadCharge += (int) (md.intraSpreadCharge * Math.abs(p.positionQty));\n                    // unrealized PnL per position\n                    double pnl = p.positionQty * spec.multiplier * (md.settlementPrice - p.entryPrice);\n                    totalUnrealizedPnl += (int) pnl; // truncates toward zero\n                }\n                netDeltaExposureSumAbs += Math.abs(netDelta);\n                // Scanning risk for this underlying\n                double scanningRangeDecimal = maxScanningRangePct / 100.0;\n                double scanningRiskDouble = Math.abs(netDelta) * scanningRangeDecimal * repSettlementPrice;\n                int scanningRisk = (int) scanningRiskDouble; // truncate toward zero\n                totalScanningRisk += scanningRisk;\n            }\n            int initialMargin = totalScanningRisk + totalSpreadCharge;\n            String status = (totalUnrealizedPnl >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\n            AccountMargin am = new AccountMargin(accountId, netDeltaExposureSumAbs, totalScanningRisk, totalSpreadCharge, initialMargin, totalUnrealizedPnl, status);\n            results.add(am);\n        }\n        return results;\n    }\n}\nEOF\n"]
