[47.547555, "o", "            int totalSpreadCharge = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.547861, "o", "            int netDeltaExposureSumAbs = 0;\r\n\u001b[?2004l\r\u001b[?2004h>             int totalUnrealizedPnl = 0;\r\n\u001b[?2004l\r"]
[47.547967, "o", "\u001b[?2004h>             for (String underlying : underlyingMap.keySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.548226, "o", "                List<Position> posList = underlyingMap.get(underlying);\r\n\u001b[?2004l\r"]
[47.548328, "o", "\u001b[?2004h> "]
[47.548606, "o", "                // Compute net delta exposure for this underlying\r\n\u001b[?2004l\r"]
[47.548756, "o", "\u001b[?2004h>                 int netDelta = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.548859, "o", "                // For scanning risk we need max scanning range among contracts of this underlying\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.549173, "o", "                double maxScanningRangePct = 0.0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.549403, "o", "                // Representative settlement price: contract with highest open interest equivalent\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.549668, "o", ">                 double repSettlementPrice = 0.0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.549892, "o", "                int maxOpenInterestEquiv = -1;\r\n\u001b[?2004l\r\u001b[?2004h>                 for (Position p : posList) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.549978, "o", "                    ContractSpec spec = specMap.get(p.contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.55029, "o", "                    MarketData md = marketMap.get(p.contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.550524, "o", "                    if (spec == null || md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.55065, "o", "                        continue; // safety\r\n\u001b[?2004l\r\u001b[?2004h>                     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.55094, "o", "                    int delta = p.positionQty * spec.multiplier;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.551314, "o", "                    netDelta += delta;\r\n\u001b[?2004l\r\u001b[?2004h>                     // scanning range\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.551551, "o", "                    if (md.scanningRange > maxScanningRangePct) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.55166, "o", "                        maxScanningRangePct = md.scanningRange;\r\n\u001b[?2004l\r\u001b[?2004h>                     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.551898, "o", "                    int openInterestEquiv = Math.abs(delta);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.551985, "o", "                    if (openInterestEquiv > maxOpenInterestEquiv) {\r\n\u001b[?2004l\r"]
[47.552087, "o", "\u001b[?2004h> "]
[47.552416, "o", "                        maxOpenInterestEquiv = openInterestEquiv;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.552677, "o", "                        repSettlementPrice = md.settlementPrice;\r\n\u001b[?2004l\r\u001b[?2004h>                     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.552909, "o", "                    // spread charge per contract\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.553151, "o", "                    totalSpreadCharge += (int) (md.intraSpreadCharge * Math.abs(p.positionQty));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.55339, "o", "                    // unrealized PnL per position\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.553653, "o", "                    double pnl = p.positionQty * spec.multiplier * (md.settlementPrice - p.entryPrice);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.55384, "o", "                    totalUnrealizedPnl += (int) pnl; // truncates toward zero\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.55396, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.554135, "o", "                netDeltaExposureSumAbs += Math.abs(netDelta);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.554365, "o", "                // Scanning risk for this underlying\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.554508, "o", "                double scanningRangeDecimal = maxScanningRangePct / 100.0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.554785, "o", "                double scanningRiskDouble = Math.abs(netDelta) * scanningRangeDecimal * repSettlementPrice;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.555012, "o", "                int scanningRisk = (int) scanningRiskDouble; // truncate toward zero\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.555214, "o", "                totalScanningRisk += scanningRisk;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[47.555395, "o", "\u001b[?2004h> "]
[47.555456, "o", "            int initialMargin = totalScanningRisk + totalSpreadCharge;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.555805, "o", "            String status = (totalUnrealizedPnl >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.556288, "o", "            AccountMargin am = new AccountMargin(accountId, netDeltaExposureSumAbs, totalScanningRisk, totalSpreadCharge, initialMargin, totalUnrealizedPnl, status);\r\n\u001b[?2004l\r\u001b[?2004h>             results.add(am);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.556367, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.556559, "o", "        return results;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.556634, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[47.558661, "o", "\u001b[?2004hroot@9d574547543a:/app# "]
[47.72692, "i", "cat > /app/src/AccountMargin.java <<'EOF'\npackage src;\n\npublic class AccountMargin {\n    public String accountId;\n    public int netDeltaExposure; // sum of absolute net delta exposures across underlyings\n    public int scanningRisk; // sum of scanning risks across underlyings\n    public int spreadCharge;\n    public int initialMargin;\n    public int unrealizedPnl;\n    public String marginStatus;\n\n    public AccountMargin(String accountId, int netDeltaExposure, int scanningRisk, int spreadCharge, int initialMargin, int unrealizedPnl, String marginStatus) {\n        this.accountId = accountId;\n        this.netDeltaExposure = netDeltaExposure;\n        this.scanningRisk = scanningRisk;\n        this.spreadCharge = spreadCharge;\n        this.initialMargin = initialMargin;\n        this.unrealizedPnl = unrealizedPnl;\n        this.marginStatus = marginStatus;\n    }\n\n    public String toCsvLine() {\n        return accountId + \",\" + netDeltaExposure + \",\" + scanningRisk + \",\" + spreadCharge + \",\" + initialMargin + \",\" + unrealizedPnl + \",\" + marginStatus;\n    }\n}\nEOF\n"]
