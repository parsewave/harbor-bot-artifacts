[?2004l[?2004hroot@9d574547543a:/app# cat > /app/src/PositionAggregator.java <<'EOF'
[?2004l[?2004h> package src;
[?2004l[?2004h> 
[?2004l[?2004h> import java.util.*;
[?2004l[?2004h> 
[?2004l[?2004h> public class PositionAggregator {
[?2004l[?2004h>     /**
[?2004l[?2004h>      * Organizes positions by account and underlying.
[?2004l[?2004h>      * Returns a map: accountId -> (underlying -> List<Position>)
[?2004l[?2004h>      */
[?2004l[?2004h>     public static Map<String, Map<String, List<Position>>> aggregate(List<Position> positions, Map<String, ContractSpec> specMap) {
[?2004l[?2004h>         Map<String, Map<String, List<Position>>> result = new HashMap<String, Map<String, List<Position>>>();
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             ContractSpec spec = specMap.get(p.contractCode);
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 // Skip positions with missing spec
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             String underlying = spec.underlying;
[?2004l[?2004h>             Map<String, List<Position>> byUnderlying = result.get(p.accountId);
[?2004l[?2004h>             if (byUnderlying == null) {
[?2004l[?2004h>                 byUnderlying = new HashMap<String, List<Position>>();
[?2004l[?2004h>                 result.put(p.accountId, byUnderlying);
[?2004l[?2004h>             }
[?2004l[?2004h>             List<Position> list = byUnderlying.get(underlying);
[?2004l[?2004h>             if (list == null) {
[?2004l[?2004h>                 list = new ArrayList<Position>();
[?2004l[?2004h>                 byUnderlying.put(underlying, list);
[?2004l[?2004h>             }
[?2004l[?2004h>             list.add(p);
[?2004l[?2004h>         }
[?2004l[?2004h>         return result;
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@9d574547543a:/app# cat > /app/src/MarginCalculator.java <<'EOF'
[?2004l[?2004h> package src;
[?2004l[?2004h> 
[?2004l[?2004h> import java.util.*;
[?2004l[?2004h> 
[?2004l[?2004h> public class MarginCalculator {
[?2004l[?2004h>     public static List<AccountMargin> calculate(
[?2004l[?2004h>             Map<String, Map<String, List<Position>>> accountUnderlyingPositions,
[?2004l[?2004h>             Map<String, ContractSpec> specMap,
[?2004l[?2004h>             Map<String, MarketData> marketMap) {
[?2004l[?2004h>         List<AccountMargin> results = new ArrayList<AccountMargin>();
[?2004l[?2004h>         for (String accountId : accountUnderlyingPositions.keySet()) {
[?2004l[?2004h>             Map<String, List<Position>> underlyingMap = accountUnderlyingPositions.get(accountId);
[?2004l[?2004h>             int totalScanningRisk = 0;
[?2004l[?2004h>             int totalSpreadCharge = 0;
[?2004l[?2004h>             int netDeltaExposureSumAbs = 0;
[?2004l[?2004h>             int totalUnrealizedPnl = 0;
[?2004l[?2004h>             for (String underlying : underlyingMap.keySet()) {
[?2004l[?2004h>                 List<Position> posList = underlyingMap.get(underlying);
[?2004l[?2004h>                 // Compute net delta exposure for this underlying
[?2004l[?2004h>                 int netDelta = 0;
[?2004l[?2004h>                 // For scanning risk we need max scanning range among contracts of this underlying
[?2004l[?2004h>                 double maxScanningRangePct = 0.0;
[?2004l[?2004h>                 // Representative settlement price: contract with highest open interest equivalent
[?2004l[?2004h>                 double repSettlementPrice = 0.0;
[?2004l[?2004h>                 int maxOpenInterestEquiv = -1;
[?2004l[?2004h>                 for (Position p : posList) {
[?2004l[?2004h>                     ContractSpec spec = specMap.get(p.contractCode);
[?2004l[?2004h>                     MarketData md = marketMap.get(p.contractCode);
[?2004l[?2004h>                     if (spec == null || md == null) {
[?2004l[?2004h>                         continue; // safety
[?2004l[?2004h>                     }
[?2004l[?2004h>                     int delta = p.positionQty * spec.multiplier;
[?2004l[?2004h>                     netDelta += delta;
[?2004l[?2004h>                     // scanning range
[?2004l[?2004h>                     if (md.scanningRange > maxScanningRangePct) {
[?2004l[?2004h>                         maxScanningRangePct = md.scanningRange;
[?2004l[?2004h>                     }
[?2004l[?2004h>                     int openInterestEquiv = Math.abs(delta);
[?2004l[?2004h>                     if (openInterestEquiv > maxOpenInterestEquiv) {
[?2004l[?2004h>                         maxOpenInterestEquiv = openInterestEquiv;
[?2004l[?2004h>                         repSettlementPrice = md.settlementPrice;
[?2004l[?2004h>                     }
[?2004l[?2004h>                     // spread charge per contract
[?2004l[?2004h>                     totalSpreadCharge += (int) (md.intraSpreadCharge * Math.abs(p.positionQty));
[?2004l[?2004h>                     // unrealized PnL per position
[?2004l[?2004h>                     double pnl = p.positionQty * spec.multiplier * (md.settlementPrice - p.entryPrice);
[?2004l[?2004h>                     totalUnrealizedPnl += (int) pnl; // truncates toward zero
[?2004l[?2004h>                 }
[?2004l[?2004h>                 netDeltaExposureSumAbs += Math.abs(netDelta);
[?2004l[?2004h>                 // Scanning risk for this underlying
[?2004l[?2004h>                 double scanningRangeDecimal = maxScanningRangePct / 100.0;
[?2004l[?2004h>                 double scanningRiskDouble = Math.abs(netDelta) * scanningRangeDecimal * repSettlementPrice;
[?2004l[?2004h>                 int scanningRisk = (int) scanningRiskDouble; // truncate toward zero
[?2004l[?2004h>                 totalScanningRisk += scanningRisk;
[?2004l[?2004h>             }
[?2004l[?2004h>             int initialMargin = totalScanningRisk + totalSpreadCharge;
[?2004l[?2004h>             String status = (totalUnrealizedPnl >= initialMargin) ? "ADEQUATE" : "CALL";
[?2004l[?2004h>             AccountMargin am = new AccountMargin(accountId, netDeltaExposureSumAbs, totalScanningRisk, totalSpreadCharge, initialMargin, totalUnrealizedPnl, status);
[?2004l[?2004h>             results.add(am);
[?2004l[?2004h>         }
[?2004l[?2004h>         return results;
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@9d574547543a:/app# cat > /app/src/AccountMargin.java <<'EOF'
[?2004l[?2004h> package src;
[?2004l[?2004h> 
[?2004l[?2004h> public class AccountMargin {
[?2004l[?2004h>     public String accountId;
[?2004l[?2004h>     public int netDeltaExposure; // sum of absolute net delta exposures across underlyings
[?2004l[?2004h>     public int scanningRisk; // sum of scanning risks across underlyings
[?2004l[?2004h>     public int spreadCharge;
[?2004l[?2004h>     public int initialMargin;
[?2004l[?2004h>     public int unrealizedPnl;
[?2004l[?2004h>     public String marginStatus;
[?2004l[?2004h> 
[?2004l[?2004h>     public AccountMargin(String accountId, int netDeltaExposure, int scanningRisk, int spreadCharge, int initialMargin, int unrealizedPnl, String marginStatus) {
[?2004l[?2004h>         this.accountId = accountId;
[?2004l[?2004h>         this.netDeltaExposure = netDeltaExposure;
[?2004l[?2004h>         this.scanningRisk = scanningRisk;
[?2004l[?2004h>         this.spreadCharge = spreadCharge;
[?2004l[?2004h>         this.initialMargin = initialMargin;
[?2004l[?2004h>         this.unrealizedPnl = unrealizedPnl;
[?2004l[?2004h>         this.marginStatus = marginStatus;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public String toCsvLine() {
[?2004l[?2004h>         return accountId + "," + netDeltaExposure + "," + scanningRisk + "," + spreadCharge + "," + initialMargin + "," + unrealizedPnl + "," + marginStatus;
[?2004l[?2004h>     }
[?2004l[?2004h> }
