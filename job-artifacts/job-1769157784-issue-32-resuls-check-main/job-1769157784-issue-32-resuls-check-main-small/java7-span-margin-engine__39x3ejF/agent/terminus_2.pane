[?2004l[?2004h>         }
[?2004l[?2004h>         brSpec.close();
[?2004l[?2004h> 
[?2004l[?2004h>         // Load market data
[?2004l[?2004h>         Map<String, MarketData> marketMap = new HashMap<String, MarketData>();
[?2004l[?2004h>         BufferedReader brMkt = new BufferedReader(new FileReader(marketDataPath));
[?2004l[?2004h>         while ((line = brMkt.readLine()) != null) {
[?2004l[?2004h>             line = line.trim();
[?2004l[?2004h>             if (line.isEmpty()) continue;
[?2004l[?2004h>             MarketData md = MarketData.parse(line);
[?2004l[?2004h>             marketMap.put(md.contractCode, md);
