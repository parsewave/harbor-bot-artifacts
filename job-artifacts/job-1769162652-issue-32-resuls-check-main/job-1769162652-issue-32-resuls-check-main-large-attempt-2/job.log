Sending keys: ['cat > /app/src/PositionAggregator.java <<\'EOF\'\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class PositionAggregator {\n\n    public static final class UnderlyingNet {\n        private final String underlying;\n        private long netDeltaExposure;\n        private String representativeContractCode;\n        private long maxOpenInterestEquivalent;\n\n        private UnderlyingNet(String underlying) {\n            this.underlying = underlying;\n        }\n\n        public String getUnderlying() {\n            return underlying;\n        }\n\n        public long getNetDeltaExposure() {\n            return netDeltaExposure;\n        }\n\n        public String getRepresentativeContractCode() {\n            return representativeContractCode;\n        }\n\n        private void addPosition(Position p, ContractSpec spec) {\n            long deltaEq = (long) p.getPositionQty() * (long) spec.getMultiplier();\n            netDeltaExposure += deltaEq;\n\n            long openInterestEq = Math.abs((long) p.getPositionQty()) * (long) spec.getMultiplier();\n            if (representativeContractCode == null || openInterestEq > maxOpenInterestEquivalent) {\n                maxOpenInterestEquivalent = openInterestEq;\n                representativeContractCode = p.getContractCode();\n            }\n        }\n    }\n\n    public Map<String, Map<String, UnderlyingNet>> aggregateByAccountAndUnderlying(List<Position> positions,\n                                                                                   Map<String, ContractSpec> contractSpecs) {\n        Map<String, Map<String, UnderlyingNet>> out = new HashMap<String, Map<String, UnderlyingNet>>();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = contractSpecs.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.getContractCode());\n            }\n\n            String accountId = p.getAccountId();\n            String underlying = spec.getUnderlying();\n\n            Map<String, UnderlyingNet> byUnderlying = out.get(accountId);\n            if (byUnderlying == null) {\n                byUnderlying = new HashMap<String, UnderlyingNet>();\n                out.put(accountId, byUnderlying);\n            }\n\n            UnderlyingNet net = byUnderlying.get(underlying);\n            if (net == null) {\n                net = new UnderlyingNet(underlying);\n                byUnderlying.put(underlying, net);\n            }\n\n            net.addPosition(p, spec);\n        }\n\n        return out;\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/AccountMargin.java <<'EOF'\npublic class AccountMargin {\n    private final String accountId;\n    private final long netDeltaExposure;\n    private final long scanningRisk;\n    private final long spreadCharge;\n    private final long initialMargin;\n    private final long unrealizedPnl;\n    private final String marginStatus;\n\n    public AccountMargin(String accountId,\n                         long netDeltaExposure,\n                         long scanningRisk,\n                         long spreadCharge,\n                         long initialMargin,\n                         long unrealizedPnl,\n                         String marginStatus) {\n        this.accountId = accountId;\n        this.netDeltaExposure = netDeltaExposure;\n        this.scanningRisk = scanningRisk;\n        this.spreadCharge = spreadCharge;\n        this.initialMargin = initialMargin;\n        this.unrealizedPnl = unrealizedPnl;\n        this.marginStatus = marginStatus;\n    }\n\n    public String getAccountId() {\n        return accountId;\n    }\n\n    public String toCsvRow() {\n        StringBuilder sb = new StringBuilder();\n        sb.append(accountId).append(',');\n        sb.append(netDeltaExposure).append(',');\n        sb.append(scanningRisk).append(',');\n        sb.append(spreadCharge).append(',');\n        sb.append(initialMargin).append(',');\n        sb.append(unrealizedPnl).append(',');\n        sb.append(marginStatus);\n        return sb.toString();\n    }\n}\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/src/MarginCalculator.java <<\'EOF\'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class MarginCalculator {\n\n    public List<AccountMargin> calculate(List<Position> positions,\n                                         Map<String, MarketData> marketDataByContract,\n                                         Map<String, ContractSpec> contractSpecsByContract) {\n\n        // Precompute: underlying -> max scanning range (as decimal fraction, e.g. 0.05)\n        Map<String, BigDecimal> underlyingMaxScanRange = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, MarketData> e : marketDataByContract.entrySet()) {\n            String contract = e.getKey();\n            MarketData md = e.getValue();\n            ContractSpec spec = contractSpecsByContract.get(contract);\n            if (spec == null) {\n                continue;\n            }\n            String underlying = spec.getUnderlying();\n            BigDecimal rangeFrac = md.getScanningRangePct().divide(new BigDecimal("100"), 18, RoundingMode.HALF_UP);\n            BigDecimal cur = underlyingMaxScanRange.get(underlying);\n            if (cur == null || rangeFrac.compareTo(cur) > 0) {\n                underlyingMaxScanRange.put(underlying, rangeFrac);\n            }\n        }\n\n        PositionAggregator aggregator = new PositionAggregator();\n        Map<String, Map<String, PositionAggregator.UnderlyingNet>> netted =\n                aggregator.aggregateByAccountAndUnderlying(positions, contractSpecsByContract);\n\n        // Also group positions by account for PnL and spread charge.\n        Map<String, List<Position>> positionsByAccount = new HashMap<String, List<Position>>();\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            List<Position> list = positionsByAccount.get(p.getAccountId());\n            if (list == null) {\n                list = new ArrayList<Position>();\n                positionsByAccount.put(p.getAccountId(), list);\n            }\n            list.add(p);\n        }\n\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        for (Map.Entry<String, Map<String, PositionAggregator.UnderlyingNet>> acctEntry : netted.entrySet()) {\n            String accountId = acctEntry.getKey();\n            Map<String, PositionAggregator.UnderlyingNet> byUnderlying = acctEntry.getValue();\n\n            long sumAbsNetDelta = 0L;\n            long scanningRiskTotal = 0L;\n\n            for (PositionAggregator.UnderlyingNet net : byUnderlying.values()) {\n                long netDelta = net.getNetDeltaExposure();\n                sumAbsNetDelta += Math.abs(netDelta);\n\n                BigDecimal rangeFrac = underlyingMaxScanRange.get(net.getUnderlying());\n                if (rangeFrac == null) {\n                    // If missing, treat as 0 scanning range.\n                    rangeFrac = BigDecimal.ZERO;\n                }\n\n                String repContract = net.getRepresentativeContractCode();\n                MarketData repMd = marketDataByContract.get(repContract);\n                if (repMd == null) {\n                    throw new IllegalArgumentException("Missing market data for contract_code=" + repContract);\n                }\n\n                BigDecimal repSettle = repMd.getSettlementPrice();\n                BigDecimal absNetDeltaBd = new BigDecimal(Long.toString(Math.abs(netDelta)));\n\n                BigDecimal scanRisk = absNetDeltaBd.multiply(rangeFrac).multiply(repSettle);\n                long scanRiskTrunc = truncateTowardZeroToLong(scanRisk);\n                scanningRiskTotal += scanRiskTrunc;\n            }\n\n            // Spread charge and unrealized PnL\n            List<Position> acctPositions = positionsByAccount.get(accountId);\n            if (acctPositions == null) {\n                acctPositions = Collections.emptyList();\n            }\n\n            BigDecimal spreadCharge = BigDecimal.ZERO;\n            BigDecimal unrealizedPnl = BigDecimal.ZERO;\n\n            for (int i = 0; i < acctPositions.size(); i++) {\n                Position p = acctPositions.get(i);\n                ContractSpec spec = contractSpecsByContract.get(p.getContractCode());\n                if (spec == null) {\n                    throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.getContractCode());\n                }\n                MarketData md = marketDataByContract.get(p.getContractCode());\n                if (md == null) {\n                    throw new IllegalArgumentException("Missing market data for contract_code=" + p.getContractCode());\n                }\n\n                long absQty = Math.abs((long) p.getPositionQty());\n\n                // Spread charge: intra_spread_charge * abs(position_qty)\n                BigDecimal absQtyBd = new BigDecimal(Long.toString(absQty));\n                spreadCharge = spreadCharge.add(md.getIntraSpreadCharge().multiply(absQtyBd));\n\n                // PnL: qty * multiplier * (settlement - entry)\n                BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());\n                long qtyTimesMult = (long) p.getPositionQty() * (long) spec.getMultiplier();\n                BigDecimal qtyMultBd = new BigDecimal(Long.toString(qtyTimesMult));\n                unrealizedPnl = unrealizedPnl.add(qtyMultBd.multiply(priceDiff));\n            }\n\n            long spreadChargeTrunc = truncateTowardZeroToLong(spreadCharge);\n            long unrealizedPnlTrunc = truncateTowardZeroToLong(unrealizedPnl);\n\n            BigDecimal initialMarginBd = new BigDecimal(Long.toString(scanningRiskTotal)).add(new BigDecimal(Long.toString(spreadChargeTrunc)));\n            long initialMarginTrunc = truncateTowardZeroToLong(initialMarginBd);\n\n            String status = (unrealizedPnlTrunc >= initialMarginTrunc) ? "ADEQUATE" : "CALL";\n\n            results.add(new AccountMargin(accountId,\n                    sumAbsNetDelta,\n                    scanningRiskTotal,\n                    spreadChargeTrunc,\n                    initialMarginTrunc,\n                    unrealizedPnlTrunc,\n                    status));\n        }\n\n        Collections.sort(results, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a, AccountMargin b) {\n                return a.getAccountId().compareTo(b.getAccountId());\n            }\n        });\n\n        return results;\n    }\n\n    private static long truncateTowardZeroToLong(BigDecimal v) {\n        // RoundingMode.DOWN is toward zero for BigDecimal.\n        BigDecimal scaled = v.setScale(0, RoundingMode.DOWN);\n        return scaled.longValue();\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/src/Main.java <<\'EOF\'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.nio.charset.Charset;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class Main {\n    private static final Charset UTF8 = Charset.forName("UTF-8");\n\n    public static void main(String[] args) throws Exception {\n        if (args == null || args.length != 4) {\n            // No stderr output per requirement; just exit non-zero if misused.\n            System.exit(2);\n            return;\n        }\n\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> market = loadMarketData(marketDataPath);\n        Map<String, ContractSpec> specs = loadContractSpecs(contractSpecsPath);\n\n        MarginCalculator calc = new MarginCalculator();\n        List<AccountMargin> margins = calc.calculate(positions, market, specs);\n\n        writeReport(outputPath, margins);\n    }\n\n    private static List<Position> loadPositions(String path) throws Exception {\n        List<Position> out = new ArrayList<Position>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), UTF8));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue; // header\n                }\n                out.add(Position.parseCsv(line));\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws Exception {\n        Map<String, MarketData> out = new HashMap<String, MarketData>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), UTF8));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue; // header\n                }\n                MarketData md = MarketData.parseCsv(line);\n                out.put(md.getContractCode(), md);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws Exception {\n        Map<String, ContractSpec> out = new HashMap<String, ContractSpec>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), UTF8));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue; // header\n                }\n                ContractSpec spec = ContractSpec.parseCsv(line);\n                out.put(spec.getContractCode(), spec);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static void writeReport(String outputPath, List<AccountMargin> margins) throws Exception {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(outputPath), UTF8));\n        try {\n            bw.write("account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status");\n            bw.newLine();\n            for (int i = 0; i < margins.size(); i++) {\n                bw.write(margins.get(i).toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            bw.close();\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
