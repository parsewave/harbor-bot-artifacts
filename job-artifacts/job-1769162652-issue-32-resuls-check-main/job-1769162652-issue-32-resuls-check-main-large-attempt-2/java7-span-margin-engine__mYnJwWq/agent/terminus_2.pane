[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         private void addPosition(Position p, ContractSpec spec) {
[?2004l[?2004h>             long deltaEq = (long) p.getPositionQty() * (long) spec.getMultiplier();
[?2004l[?2004h>             netDeltaExposure += deltaEq;
[?2004l[?2004h> 
[?2004l[?2004h>             Long cur = netQtyByContract.get(p.getContractCode());
[?2004l[?2004h>             long next = (cur == null ? 0L : cur.longValue()) + (long) p.getPositionQty();
[?2004l[?2004h>             netQtyByContract.put(p.getContractCode(), Long.valueOf(next));
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         private void finalizeRepresentative(Map<String, ContractSpec> contractSpecs) {
[?2004l[?2004h>             String best = null;
[?2004l[?2004h>             long bestOi = -1L;
[?2004l[?2004h> 
[?2004l[?2004h>             for (Map.Entry<String, Long> e : netQtyByContract.entrySet()) {
[?2004l[?2004h>                 String contractCode = e.getKey();
[?2004l[?2004h>                 long netQty = e.getValue().longValue();
[?2004l[?2004h>                 ContractSpec spec = contractSpecs.get(contractCode);
[?2004l[?2004h>                 if (spec == null) {
[?2004l[?2004h>                     continue;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 long oiEq = Math.abs(netQty) * (long) spec.getMultiplier();
[?2004l[?2004h>                 if (best == null || oiEq > bestOi) {
[?2004l[?2004h>                     best = contractCode;
[?2004l[?2004h>                     bestOi = oiEq;
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             representativeContractCode = best;
[?2004l[?2004h>             maxOpenInterestEquivalent = (bestOi < 0L ? 0L : bestOi);
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public Map<String, Map<String, UnderlyingNet>> aggregateByAccountAndUnderlying(List<Position> positions,
[?2004l[?2004h>                                                                                    Map<String, ContractSpec> contractSpecs) {
[?2004l[?2004h>         Map<String, Map<String, UnderlyingNet>> out = new HashMap<String, Map<String, UnderlyingNet>>();
[?2004l[?2004h> 
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position p = positions.get(i);
[?2004l[?2004h>             ContractSpec spec = contractSpecs.get(p.getContractCode());
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.getContractCode());
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             String accountId = p.getAccountId();
[?2004l[?2004h>             String underlying = spec.getUnderlying();
[?2004l[?2004h> 
[?2004l[?2004h>             Map<String, UnderlyingNet> byUnderlying = out.get(accountId);
[?2004l[?2004h>             if (byUnderlying == null) {
[?2004l[?2004h>                 byUnderlying = new HashMap<String, UnderlyingNet>();
[?2004l[?2004h>                 out.put(accountId, byUnderlying);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             UnderlyingNet net = byUnderlying.get(underlying);
[?2004l[?2004h>             if (net == null) {
[?2004l[?2004h>                 net = new UnderlyingNet(underlying);
[?2004l[?2004h>                 byUnderlying.put(underlying, net);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             net.addPosition(p, spec);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // Finalize representative contract selection using net quantities per contract.
[?2004l[?2004h>         for (Map.Entry<String, Map<String, UnderlyingNet>> acct : out.entrySet()) {
[?2004l[?2004h>             Map<String, UnderlyingNet> byUnd = acct.getValue();
[?2004l[?2004h>             for (Map.Entry<String, UnderlyingNet> undEntry : byUnd.entrySet()) {
[?2004l[?2004h>                 undEntry.getValue().finalizeRepresentative(contractSpecs);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         return out;
[?2004l[?2004h>     }
[?2004l[?2004h> }
