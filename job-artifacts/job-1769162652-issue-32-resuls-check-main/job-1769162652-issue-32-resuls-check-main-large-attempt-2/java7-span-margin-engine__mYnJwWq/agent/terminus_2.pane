[?2004l[?2004h> 
[?2004l[?2004h> public class MarginCalculator {
[?2004l[?2004h> 
[?2004l[?2004h>     public List<AccountMargin> calculate(List<Position> positions,
[?2004l[?2004h>                                          Map<String, MarketData> marketDataByContract,
[?2004l[?2004h>                                          Map<String, ContractSpec> contractSpecsByContract) {
[?2004l[?2004h> 
[?2004l[?2004h>         // Precompute: underlying -> max scanning range (as decimal fraction, e.g. 0.05)
[?2004l[?2004h>         Map<String, BigDecimal> underlyingMaxScanRange = new HashMap<String, BigDecimal>();
[?2004l);
[?2004h>         for (Map.Entry<String, MarketData> e : marketDataByContract.entrySet()) {
[?2004l[?2004h>             String contract = e.getKey();
[?2004l[?2004h>             MarketData md = e.getValue();
[?2004l[?2004h>             ContractSpec spec = contractSpecsByContract.get(contract);
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004lr[?2004h>             String underlying = spec.getUnderlying();
[?2004l[?2004h>             BigDecimal rangeFrac = md.getScanningRangePct().divide(new BigDecimal("100"), 18, RoundingMode.HALF_UP);
[?2004l[?2004h>             BigDecimal cur = underlyingMaxScanRange.get(underlying);
[?2004l[?2004h>             if (cur == null || rangeFrac.compareTo(cur) > 0) {
[?2004l[?2004h>                 underlyingMaxScanRange.put(underlying, rangeFrac);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004lh[?2004h> 
[?2004la[?2004h>         PositionAggregator aggregator = new PositionAggregator();
[?2004l[?2004h>         Map<String, Map<String, PositionAggregator.UnderlyingNet>> netted =
[?2004l[?2004h>                 aggregator.aggregateByAccountAndUnderlying(positions, contractSpecsByContract);
[?2004l[?2004h> 
[?2004ll[?2004h>         // Also group positions by account for PnL and spread charge.
[?2004l[?2004h>         Map<String, List<Position>> positionsByAccount = new HashMap<String, List<Position>>();
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l   [?2004h>             Position p = positions.get(i);
[?2004l[?2004h>             List<Position> list = positionsByAccount.get(p.getAccountId());
[?2004l[?2004h>             if (list == null) {
[?2004l[?2004h>                 list = new ArrayList<Position>();
[?2004l[?2004h>                 positionsByAccount.put(p.getAccountId(), list);
[?2004l[?2004h>             }
[?2004l[?2004h>             list.add(p);
[?2004l[?2004h>         }
[?2004lt[?2004h> 
[?2004ls[?2004h>         List<AccountMargin> results = new ArrayList<AccountMargin>();
[?2004l[?2004h> 
[?2004lo[?2004h>         for (Map.Entry<String, Map<String, PositionAggregator.UnderlyingNet>> acctEntry : netted.entrySet()) {
[?2004l[?2004h>             String accountId = acctEntry.getKey();
[?2004l[?2004h>             Map<String, PositionAggregator.UnderlyingNet> byUnderlying = acctEntry.getValue();
[?2004l[?2004h> 
[?2004lo[?2004h>             long sumAbsNetDelta = 0L;
[?2004l[?2004h>             long scanningRiskTotal = 0L;
[?2004l[?2004h> 
[?2004l[?2004h>             for (PositionAggregator.UnderlyingNet net : byUnderlying.values()) {
[?2004l[?2004h>                 long netDelta = net.getNetDeltaExposure();
[?2004l[?2004h>                 sumAbsNetDelta += Math.abs(netDelta);
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal rangeFrac = underlyingMaxScanRange.get(net.getUnderlying());
[?2004l[?2004h>                 if (rangeFrac == null) {
[?2004l[?2004h>                     // If missing, treat as 0 scanning range.
[?2004l[?2004h>                     rangeFrac = BigDecimal.ZERO;
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 String repContract = net.getRepresentativeContractCode();
[?2004l[?2004h>                 MarketData repMd = marketDataByContract.get(repContract);
[?2004l[?2004h>                 if (repMd == null) {
[?2004l[?2004h>                     throw new IllegalArgumentException("Missing market data for contract_code=" + repContract);
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal repSettle = repMd.getSettlementPrice();
[?2004l[?2004h>                 BigDecimal absNetDeltaBd = new BigDecimal(Long.toString(Math.abs(netDelta)));
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal scanRisk = absNetDeltaBd.multiply(rangeFrac).multiply(repSettle);
[?2004l[?2004h>                 long scanRiskTrunc = truncateTowardZeroToLong(scanRisk);
[?2004l[?2004h>                 scanningRiskTotal += scanRiskTrunc;
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             // Spread charge and unrealized PnL
[?2004l[?2004h>             List<Position> acctPositions = positionsByAccount.get(accountId);
[?2004l[?2004h>             if (acctPositions == null) {
[?2004l[?2004h>                 acctPositions = Collections.emptyList();
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal spreadCharge = BigDecimal.ZERO;
[?2004l[?2004h>             BigDecimal unrealizedPnl = BigDecimal.ZERO;
[?2004l[?2004h> 
[?2004l[?2004h>             for (int i = 0; i < acctPositions.size(); i++) {
[?2004l[?2004h>                 Position p = acctPositions.get(i);
[?2004l[?2004h>                 ContractSpec spec = contractSpecsByContract.get(p.getContractCode());
[?2004l[?2004h>                 if (spec == null) {
[?2004l[?2004h>                     throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.getContractCode());
[?2004l[?2004h>                 }
[?2004l[?2004h>                 MarketData md = marketDataByContract.get(p.getContractCode());
[?2004l[?2004h>                 if (md == null) {
[?2004l[?2004h>                     throw new IllegalArgumentException("Missing market data for contract_code=" + p.getContractCode());
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 long absQty = Math.abs((long) p.getPositionQty());
[?2004l[?2004h> 
[?2004l[?2004h>                 // Spread charge: intra_spread_charge * abs(position_qty)
[?2004l[?2004h>                 BigDecimal absQtyBd = new BigDecimal(Long.toString(absQty));
[?2004l[?2004h>                 spreadCharge = spreadCharge.add(md.getIntraSpreadCharge().multiply(absQtyBd));
[?2004l[?2004h> 
[?2004l[?2004h>                 // PnL: qty * multiplier * (settlement - entry)
[?2004l[?2004h>                 BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());
[?2004l[?2004h>                 long qtyTimesMult = (long) p.getPositionQty() * (long) spec.getMultiplier();
[?2004l[?2004h>                 BigDecimal qtyMultBd = new BigDecimal(Long.toString(qtyTimesMult));
[?2004l[?2004h>                 unrealizedPnl = unrealizedPnl.add(qtyMultBd.multiply(priceDiff));
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             long spreadChargeTrunc = truncateTowardZeroToLong(spreadCharge);
[?2004l[?2004h>             long unrealizedPnlTrunc = truncateTowardZeroToLong(unrealizedPnl);
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal initialMarginBd = new BigDecimal(Long.toString(scanningRiskTotal)).add(new BigDecimal(Long.toString(spreadChargeTrunc)));
[?2004l[?2004h>             long initialMarginTrunc = truncateTowardZeroToLong(initialMarginBd);
[?2004l[?2004h> 
[?2004l[?2004h>             String status = (unrealizedPnlTrunc >= initialMarginTrunc) ? "ADEQUATE" : "CALL";
[?2004l[?2004h> 
[?2004l[?2004h>             results.add(new AccountMargin(accountId,
[?2004l[?2004h>                     sumAbsNetDelta,
[?2004l[?2004h>                     scanningRiskTotal,
[?2004l[?2004h>                     spreadChargeTrunc,
[?2004l[?2004h>                     initialMarginTrunc,
[?2004l[?2004h>                     unrealizedPnlTrunc,
[?2004l[?2004h>                     status));
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         Collections.sort(results, new Comparator<AccountMargin>() {
[?2004l[?2004h>             public int compare(AccountMargin a, AccountMargin b) {
[?2004l[?2004h>                 return a.getAccountId().compareTo(b.getAccountId());
[?2004l[?2004h>             }
[?2004l[?2004h>         });
[?2004l[?2004h> 
[?2004l[?2004h>         return results;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private static long truncateTowardZeroToLong(BigDecimal v) {
[?2004l[?2004h>         // RoundingMode.DOWN is toward zero for BigDecimal.
[?2004l[?2004h>         BigDecimal scaled = v.setScale(0, RoundingMode.DOWN);
[?2004l[?2004h>         return scaled.longValue();
[?2004l[?2004h>     }
[?2004l[?2004h> }
