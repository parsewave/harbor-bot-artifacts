[?2004l[?2004h>         private void addPosition(Position p, ContractSpec spec) {
[?2004l[?2004h>             long deltaEq = (long) p.getPositionQty() * (long) spec.getMultiplier();
[?2004l[?2004h>             netDeltaExposure += deltaEq;
[?2004l[?2004h> 
[?2004l[?2004h>             long openInterestEq = Math.abs((long) p.getPositionQty()) * (long) spec.getMultiplier();
[?2004l[?2004h>             if (representativeContractCode == null || openInterestEq > maxOpenInterestEquivalent) {
[?2004l[?2004h>                 maxOpenInterestEquivalent = openInterestEq;
[?2004l[?2004h>                 representativeContractCode = p.getContractCode();
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public Map<String, Map<String, UnderlyingNet>> aggregateByAccountAndUnderlying(List<Position> positions,
[?2004l[?2004h>                                                                                    Map<String, ContractSpec> contractSpecs) {
[?2004l[?2004h>         Map<String, Map<String, UnderlyingNet>> out = new HashMap<String, Map<String, UnderlyingNet>>();
[?2004l[?2004h> 
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position p = positions.get(i);
[?2004l[?2004h>             ContractSpec spec = contractSpecs.get(p.getContractCode());
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.getContractCode());
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             String accountId = p.getAccountId();
[?2004l[?2004h>             String underlying = spec.getUnderlying();
[?2004l[?2004h> 
[?2004l[?2004h>             Map<String, UnderlyingNet> byUnderlying = out.get(accountId);
[?2004l[?2004h>             if (byUnderlying == null) {
[?2004l[?2004h>                 byUnderlying = new HashMap<String, UnderlyingNet>();
[?2004l[?2004h>                 out.put(accountId, byUnderlying);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             UnderlyingNet net = byUnderlying.get(underlying);
[?2004l[?2004h>             if (net == null) {
[?2004l[?2004h>                 net = new UnderlyingNet(underlying);
[?2004l[?2004h>                 byUnderlying.put(underlying, net);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             net.addPosition(p, spec);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         return out;
[?2004l[?2004h>     }
