[?2004l[?2004h>         // Net qty per contract for this underlying (within an account)
[?2004l[?2004h>         private final Map<String, Long> netQtyByContract = new HashMap<String, Long>();
[?2004l[?2004h> 
[?2004l[?2004h>         private String representativeContractCode;
[?2004l[?2004h>         private long maxOpenInterestEquivalent;
[?2004l[?2004h> 
[?2004l[?2004h>         private UnderlyingNet(String underlying) {
[?2004l[?2004h>             this.underlying = underlying;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public String getUnderlying() {
