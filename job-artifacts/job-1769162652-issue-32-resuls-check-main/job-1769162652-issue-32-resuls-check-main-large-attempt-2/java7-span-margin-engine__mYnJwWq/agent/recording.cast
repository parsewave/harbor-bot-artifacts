[140.821227, "o", "            String best = null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.821292, "o", "            long bestOi = -1L;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.821534, "o", "            for (Map.Entry<String, Long> e : netQtyByContract.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.821742, "o", "                String contractCode = e.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.821895, "o", "                long netQty = e.getValue().longValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.822073, "o", "                ContractSpec spec = contractSpecs.get(contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.822215, "o", "                if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.822339, "o", "                    continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.822476, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.822585, "o", "                long oiEq = Math.abs(netQty) * (long) spec.getMultiplier();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.822819, "o", "                if (best == null || oiEq > bestOi) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.82291, "o", "                    best = contractCode;\r\n\u001b[?2004l\r\u001b[?2004h>                     bestOi = oiEq;\r\n\u001b[?2004l\r"]
[140.823099, "o", "\u001b[?2004h>                 }\r\n\u001b[?2004l\r"]
[140.823292, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.823417, "o", "            representativeContractCode = best;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.823638, "o", "            maxOpenInterestEquivalent = (bestOi < 0L ? 0L : bestOi);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.823697, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
