[140.819773, "o", "        private void addPosition(Position p, ContractSpec spec) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.819903, "o", "            long deltaEq = (long) p.getPositionQty() * (long) spec.getMultiplier();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.820007, "o", "            netDeltaExposure += deltaEq;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
