[80.32178, "o", "import java.math.BigDecimal;\r\n\u001b[?2004l\r\u001b[?2004h> import java.math.RoundingMode;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.321954, "o", "import java.util.ArrayList;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.322135, "o", "import java.util.Collections;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.322316, "o", "import java.util.Comparator;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.322463, "o", "import java.util.HashMap;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.322791, "o", "import java.util.List;\r\n\u001b[?2004l\r\u001b[?2004h> import java.util.Map;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.322946, "o", "public class MarginCalculator {\r\n\u001b[?2004l\r"]
[80.323109, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[80.323332, "o", "\u001b[?2004h> "]
[80.323508, "o", "    public List<AccountMargin> calculate(List<Position> positions,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.323961, "o", "                                         Map<String, MarketData> marketDataByContract,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.324449, "o", "                                         Map<String, ContractSpec> contractSpecsByContract) {\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.325027, "o", "        // Precompute: underlying -> max scanning range (as decimal fraction, e.g. 0.05)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.325678, "o", "        Map<String, BigDecimal> underlyingMaxScanRange = new HashMap<String, BigDecimal>();\r\n\u001b[?2004l\r);\r\n\u001b[?2004h"]
[80.325879, "o", "> "]
[80.326084, "o", "        for (Map.Entry<String, MarketData> e : marketDataByContract.entrySet()) {\r\n\u001b[?2004l\r"]
[80.326241, "o", "\u001b[?2004h> "]
[80.326392, "o", "            String contract = e.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.326605, "o", "            MarketData md = e.getValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.327026, "o", "            ContractSpec spec = contractSpecsByContract.get(contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.327301, "o", "            if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.327469, "o", "                continue;\r\n\u001b[?2004l\r"]
[80.327635, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\rr\u001b[?2004h> "]
[80.327972, "o", "            String underlying = spec.getUnderlying();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.328387, "o", "            BigDecimal rangeFrac = md.getScanningRangePct().divide(new BigDecimal(\"100\"), 18, RoundingMode.HALF_UP);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.328793, "o", "            BigDecimal cur = underlyingMaxScanRange.get(underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.329103, "o", "            if (cur == null || rangeFrac.compareTo(cur) > 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.329391, "o", "                underlyingMaxScanRange.put(underlying, rangeFrac);\r\n\u001b[?2004l\r"]
[80.329472, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[80.329721, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\rh\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[80.330087, "o", "        PositionAggregator aggregator = new PositionAggregator();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.330442, "o", "        Map<String, Map<String, PositionAggregator.UnderlyingNet>> netted =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.33095, "o", "                aggregator.aggregateByAccountAndUnderlying(positions, contractSpecsByContract);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rl\u001b[?2004h"]
[80.331113, "o", "> "]
[80.331311, "o", "        // Also group positions by account for PnL and spread charge.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.331822, "o", "        Map<String, List<Position>> positionsByAccount = new HashMap<String, List<Position>>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.332043, "o", "        for (int i = 0; i < positions.size(); i++) {\r\n\u001b[?2004l\r   \u001b[?2004h> "]
[80.332297, "o", "            Position p = positions.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.332752, "o", "            List<Position> list = positionsByAccount.get(p.getAccountId());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.332952, "o", "            if (list == null) {\r\n\u001b[?2004l\r"]
[80.333074, "o", "\u001b[?2004h> "]
[80.333239, "o", "                list = new ArrayList<Position>();\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.333349, "o", "> "]
[80.333858, "o", "                positionsByAccount.put(p.getAccountId(), list);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.33408, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>             list.add(p);\r\n\u001b[?2004l\r"]
[80.334152, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\rt"]
[80.334214, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h"]
[80.334439, "o", "> "]
[80.334704, "o", "        List<AccountMargin> results = new ArrayList<AccountMargin>();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[80.335161, "o", "        for (Map.Entry<String, Map<String, PositionAggregator.UnderlyingNet>> acctEntry : netted.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.335326, "o", "            String accountId = acctEntry.getKey();\r\n\u001b[?2004l\r"]
[80.335384, "o", "\u001b[?2004h> "]
[80.335793, "o", "            Map<String, PositionAggregator.UnderlyingNet> byUnderlying = acctEntry.getValue();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h"]
[80.335864, "o", "> "]
[80.336048, "o", "            long sumAbsNetDelta = 0L;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.336194, "o", "            long scanningRiskTotal = 0L;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[80.3363, "o", "> "]
[80.336788, "o", "            for (PositionAggregator.UnderlyingNet net : byUnderlying.values()) {\r\n\u001b[?2004l\r\u001b[?2004h>                 long netDelta = net.getNetDeltaExposure();\r\n\u001b[?2004l\r"]
[80.336897, "o", "\u001b[?2004h> "]
[80.337106, "o", "                sumAbsNetDelta += Math.abs(netDelta);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.337299, "o", "                BigDecimal rangeFrac = underlyingMaxScanRange.get(net.getUnderlying());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.337423, "o", "                if (rangeFrac == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.337492, "o", "                    // If missing, treat as 0 scanning range.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.337709, "o", "                    rangeFrac = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.337857, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.338051, "o", "                String repContract = net.getRepresentativeContractCode();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.338295, "o", "                MarketData repMd = marketDataByContract.get(repContract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.338426, "o", "                if (repMd == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.338826, "o", "                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + repContract);\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.338931, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.339115, "o", "                BigDecimal repSettle = repMd.getSettlementPrice();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.339441, "o", "                BigDecimal absNetDeltaBd = new BigDecimal(Long.toString(Math.abs(netDelta)));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[80.339594, "o", "\u001b[?2004h> "]
[80.339745, "o", "                BigDecimal scanRisk = absNetDeltaBd.multiply(rangeFrac).multiply(repSettle);\r\n\u001b[?2004l\r"]
[80.339808, "o", "\u001b[?2004h> "]
[80.339998, "o", "                long scanRiskTrunc = truncateTowardZeroToLong(scanRisk);\r\n\u001b[?2004l\r"]
[80.340057, "o", "\u001b[?2004h> "]
[80.340234, "o", "                scanningRiskTotal += scanRiskTrunc;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.340411, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.340586, "o", "            // Spread charge and unrealized PnL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.340867, "o", "            List<Position> acctPositions = positionsByAccount.get(accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.341058, "o", "            if (acctPositions == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.34128, "o", "                acctPositions = Collections.emptyList();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.341417, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.341606, "o", "            BigDecimal spreadCharge = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.341818, "o", "            BigDecimal unrealizedPnl = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[80.341966, "o", "\u001b[?2004h> "]
[80.342081, "o", "            for (int i = 0; i < acctPositions.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.342194, "o", "> "]
[80.34234, "o", "                Position p = acctPositions.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.342642, "o", "                ContractSpec spec = contractSpecsByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.342801, "o", "                if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.343124, "o", "                    throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.343242, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.343457, "o", "                MarketData md = marketDataByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.343607, "o", "                if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.343972, "o", "                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.344129, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.344328, "o", "                long absQty = Math.abs((long) p.getPositionQty());\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.344599, "o", "                // Spread charge: intra_spread_charge * abs(position_qty)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.344893, "o", "                BigDecimal absQtyBd = new BigDecimal(Long.toString(absQty));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.345163, "o", "                spreadCharge = spreadCharge.add(md.getIntraSpreadCharge().multiply(absQtyBd));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.34538, "o", "                // PnL: qty * multiplier * (settlement - entry)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.345641, "o", "                BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.345962, "o", "                long qtyTimesMult = (long) p.getPositionQty() * (long) spec.getMultiplier();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.346243, "o", "                BigDecimal qtyMultBd = new BigDecimal(Long.toString(qtyTimesMult));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.346503, "o", "                unrealizedPnl = unrealizedPnl.add(qtyMultBd.multiply(priceDiff));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.346684, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[80.346794, "o", "> "]
[80.346957, "o", "            long spreadChargeTrunc = truncateTowardZeroToLong(spreadCharge);\r\n\u001b[?2004l\r"]
[80.347122, "o", "\u001b[?2004h> "]
[80.347274, "o", "            long unrealizedPnlTrunc = truncateTowardZeroToLong(unrealizedPnl);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[80.347396, "o", "\u001b[?2004h> "]
[80.347814, "o", "            BigDecimal initialMarginBd = new BigDecimal(Long.toString(scanningRiskTotal)).add(new BigDecimal(Long.toString(spreadChargeTrunc)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.348006, "o", "            long initialMarginTrunc = truncateTowardZeroToLong(initialMarginBd);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[80.348082, "o", "\u001b[?2004h> "]
[80.348404, "o", "            String status = (unrealizedPnlTrunc >= initialMarginTrunc) ? \"ADEQUATE\" : \"CALL\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.348539, "o", "            results.add(new AccountMargin(accountId,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.348693, "o", "                    sumAbsNetDelta,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.348834, "o", "                    scanningRiskTotal,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.348996, "o", "                    spreadChargeTrunc,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.349149, "o", "                    initialMarginTrunc,\r\n\u001b[?2004l\r"]
[80.349215, "o", "\u001b[?2004h> "]
[80.349331, "o", "                    unrealizedPnlTrunc,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.349462, "o", "                    status));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.349541, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.349676, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.349936, "o", "        Collections.sort(results, new Comparator<AccountMargin>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.350134, "o", "            public int compare(AccountMargin a, AccountMargin b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.350342, "o", "                return a.getAccountId().compareTo(b.getAccountId());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.350409, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.350613, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.350757, "o", "        return results;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[80.350829, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.351059, "o", "    private static long truncateTowardZeroToLong(BigDecimal v) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.351292, "o", "        // RoundingMode.DOWN is toward zero for BigDecimal.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.351439, "o", "        BigDecimal scaled = v.setScale(0, RoundingMode.DOWN);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.351562, "o", "        return scaled.longValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.351688, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.351775, "o", "EOF\r\n\u001b[?2004l\r"]
[80.353665, "o", "\u001b[?2004hroot@4b8a5911d6b5:/app# "]
[80.505883, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.nio.charset.Charset;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class Main {\n    private static final Charset UTF8 = Charset.forName(\"UTF-8\");\n\n    public static void main(String[] args) throws Exception {\n        if (args == null || args.length != 4) {\n            // No stderr output per requirement; just exit non-zero if misused.\n            System.exit(2);\n            return;\n        }\n\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> market = loadMarketData(marketDataPath);\n        Map<String, ContractSpec> specs = loadContractSpecs(contractSpecsPath);\n\n        MarginCalculator calc = new MarginCalculator();\n        List<AccountMargin> margins = calc.calculate(positions, market, specs);\n\n        writeReport(outputPath, margins);\n    }\n\n    private static List<Position> loadPositions(String path) throws Exception {\n        List<Position> out = new ArrayList<Position>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), UTF8));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue; // header\n                }\n                out.add(Position.parseCsv(line));\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws Exception {\n        Map<String, MarketData> out = new HashMap<String, MarketData>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), UTF8));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue; // header\n                }\n                MarketData md = MarketData.parseCsv(line);\n                out.put(md.getContractCode(), md);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws Exception {\n        Map<String, ContractSpec> out = new HashMap<String, ContractSpec>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), UTF8));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    continue; // header\n                }\n                ContractSpec spec = ContractSpec.parseCsv(line);\n                out.put(spec.getContractCode(), spec);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static void writeReport(String outputPath, List<AccountMargin> margins) throws Exception {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(outputPath), UTF8));\n        try {\n            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\n   "]
[80.506013, "i", "         bw.newLine();\n            for (int i = 0; i < margins.size(); i++) {\n                bw.write(margins.get(i).toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            bw.close();\n        }\n    }\n}\nEOF\n"]
