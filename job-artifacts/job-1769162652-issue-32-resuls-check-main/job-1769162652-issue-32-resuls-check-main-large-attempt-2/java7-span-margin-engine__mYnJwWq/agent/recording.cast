[140.81548, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class PositionAggregator {\n\n    public static final class UnderlyingNet {\n        private final String underlying;\n        private long netDeltaExposure;\n\n        // Net qty per contract for this underlying (within an account)\n        private final Map<String, Long> netQtyByContract = new HashMap<String, Long>();\n\n        private String representativeContractCode;\n        private long maxOpenInterestEquivalent;\n\n        private UnderlyingNet(String underlying) {\n            this.underlying = underlying;\n        }\n\n        public String getUnderlying() {\n            return underlying;\n        }\n\n        public long getNetDeltaExposure() {\n            return netDeltaExposure;\n        }\n\n        public String getRepresentativeContractCode() {\n            return representativeContractCode;\n        }\n\n        private void addPosition(Position p, ContractSpec spec) {\n            long deltaEq = (long) p.getPositionQty() * (long) spec.getMultiplier();\n            netDeltaExposure += deltaEq;\n\n            Long cur = netQtyByContract.get(p.getContractCode());\n            long next = (cur == null ? 0L : cur.longValue()) + (long) p.getPositionQty();\n            netQtyByContract.put(p.getContractCode(), Long.valueOf(next));\n        }\n\n        private void finalizeRepresentative(Map<String, ContractSpec> contractSpecs) {\n            String best = null;\n            long bestOi = -1L;\n\n            for (Map.Entry<String, Long> e : netQtyByContract.entrySet()) {\n                String contractCode = e.getKey();\n                long netQty = e.getValue().longValue();\n                ContractSpec spec = contractSpecs.get(contractCode);\n                if (spec == null) {\n                    continue;\n                }\n                long oiEq = Math.abs(netQty) * (long) spec.getMultiplier();\n                if (best == null || oiEq > bestOi) {\n                    best = contractCode;\n                    bestOi = oiEq;\n                }\n            }\n\n            representativeContractCode = best;\n            maxOpenInterestEquivalent = (bestOi < 0L ? 0L : bestOi);\n        }\n    }\n\n    public Map<String, Map<String, UnderlyingNet>> aggregateByAccountAndUnderlying(List<Position> positions,\n                                                                                   Map<String, ContractSpec> contractSpecs) {\n        Map<String, Map<String, UnderlyingNet>> out = new HashMap<String, Map<String, UnderlyingNet>>();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = contractSpecs.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\n            }\n\n            String accountId = p.getAccountId();\n            String underlying = spec.getUnderlying();\n\n            Map<String, UnderlyingNet> byUnderlying = out.get(accountId);\n            if (byUnderlying == null) {\n                byUnderlying = new HashMap<String, UnderlyingNet>();\n                out.put(accountId, byUnderlying);\n            }\n\n            UnderlyingNet net = byUnderlying.get(underlying);\n            if (net == null) {\n                net = new UnderlyingNet(underlying);\n                byUnderlying.put(underlying, net);\n            }\n\n            net.addPosition(p, spec);\n        }\n\n        // Finalize representative contract selection using net quantities per contract.\n        for (Map.Entry<String, Map<String, UnderlyingNet>> acct : out.entrySet()) {\n            Map<String, UnderlyingNet> byUnd = acct.getValue();\n            for (Map.Entry<String, UnderlyingNet> undEntry : byUnd.entrySet()) {\n                undEntry.getValue().finalizeRepresentative(contractSpecs);\n            }\n        }\n\n        return out;\n    }\n}\nEOF\n"]
