[140.825749, "o", "                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.825894, "o", "            String accountId = p.getAccountId();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.82608, "o", "            String underlying = spec.getUnderlying();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.826221, "o", "            Map<String, UnderlyingNet> byUnderlying = out.get(accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.826302, "o", "            if (byUnderlying == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.826506, "o", "                byUnderlying = new HashMap<String, UnderlyingNet>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.826741, "o", "                out.put(accountId, byUnderlying);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.826886, "o", "            UnderlyingNet net = byUnderlying.get(underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.827051, "o", "            if (net == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.827251, "o", "                net = new UnderlyingNet(underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.827403, "o", "                byUnderlying.put(underlying, net);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
