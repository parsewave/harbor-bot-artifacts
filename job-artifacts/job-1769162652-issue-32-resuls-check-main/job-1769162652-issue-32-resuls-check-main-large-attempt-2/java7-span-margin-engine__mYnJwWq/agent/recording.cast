[79.40542, "i", "cat > /app/src/Position.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic class Position {\n    private final String accountId;\n    private final String contractCode;\n    private final int positionQty;\n    private final BigDecimal entryPrice;\n\n    public Position(String accountId, String contractCode, int positionQty, BigDecimal entryPrice) {\n        this.accountId = accountId;\n        this.contractCode = contractCode;\n        this.positionQty = positionQty;\n        this.entryPrice = entryPrice;\n    }\n\n    public String getAccountId() {\n        return accountId;\n    }\n\n    public String getContractCode() {\n        return contractCode;\n    }\n\n    public int getPositionQty() {\n        return positionQty;\n    }\n\n    public BigDecimal getEntryPrice() {\n        return entryPrice;\n    }\n\n    public static Position parseCsv(String line) {\n        String[] parts = CsvUtil.split(line);\n        if (parts.length < 4) {\n            throw new IllegalArgumentException(\"Invalid positions row: \" + line);\n        }\n        String accountId = parts[0];\n        String contractCode = parts[1];\n        int qty = Integer.parseInt(parts[2]);\n        BigDecimal entryPrice = new BigDecimal(parts[3]);\n        return new Position(accountId, contractCode, qty, entryPrice);\n    }\n}\n\nclass CsvUtil {\n    private CsvUtil() {\n    }\n\n    public static String[] split(String line) {\n        String[] raw = line.split(\",\", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n"]
