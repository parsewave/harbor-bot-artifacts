[140.832117, "o", "\u001b[?2004hroot@4b8a5911d6b5:/app# "]
[141.009006, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class MarginCalculator {\n\n    public List<AccountMargin> calculate(List<Position> positions,\n                                         Map<String, MarketData> marketDataByContract,\n                                         Map<String, ContractSpec> contractSpecsByContract) {\n\n        // Precompute: underlying -> max scanning range (as decimal fraction, e.g. 0.05)\n        Map<String, BigDecimal> underlyingMaxScanRange = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, MarketData> e : marketDataByContract.entrySet()) {\n            String contract = e.getKey();\n            MarketData md = e.getValue();\n            ContractSpec spec = contractSpecsByContract.get(contract);\n            if (spec == null) {\n                continue;\n            }\n            String underlying = spec.getUnderlying();\n            BigDecimal rangeFrac = md.getScanningRangePct().divide(new BigDecimal(\"100\"), 18, RoundingMode.HALF_UP);\n            BigDecimal cur = underlyingMaxScanRange.get(underlying);\n            if (cur == null || rangeFrac.compareTo(cur) > 0) {\n                underlyingMaxScanRange.put(underlying, rangeFrac);\n            }\n        }\n\n        PositionAggregator aggregator = new PositionAggregator();\n        Map<String, Map<String, PositionAggregator.UnderlyingNet>> netted =\n                aggregator.aggregateByAccountAndUnderlying(positions, contractSpecsByContract);\n\n        // Group positions by account for per-lot PnL and for building net qty per contract.\n        Map<String, List<Position>> positionsByAccount = new HashMap<String, List<Position>>();\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            List<Position> list = positionsByAccount.get(p.getAccountId());\n            if (list == null) {\n                list = new ArrayList<Position>();\n                positionsByAccount.put(p.getAccountId(), list);\n            }\n            list.add(p);\n        }\n\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        for (Map.Entry<String, Map<String, PositionAggregator.UnderlyingNet>> acctEntry : netted.entrySet()) {\n            String accountId = acctEntry.getKey();\n            Map<String, PositionAggregator.UnderlyingNet> byUnderlying = acctEntry.getValue();\n\n            long sumAbsNetDelta = 0L;\n            long scanningRiskTotal = 0L;\n\n            for (PositionAggregator.UnderlyingNet net : byUnderlying.values()) {\n                long netDelta = net.getNetDeltaExposure();\n                sumAbsNetDelta += Math.abs(netDelta);\n\n                BigDecimal rangeFrac = underlyingMaxScanRange.get(net.getUnderlying());\n                if (rangeFrac == null) {\n                    rangeFrac = BigDecimal.ZERO;\n                }\n\n                String repContract = net.getRepresentativeContractCode();\n                if (repContract == null) {\n                    continue;\n                }\n\n                MarketData repMd = marketDataByContract.get(repContract);\n                if (repMd == null) {\n                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + repContract);\n                }\n\n                BigDecimal repSettle = repMd.getSettlementPrice();\n                BigDecimal absNetDeltaBd = new BigDecimal(Long.toString(Math.abs(netDelta)));\n\n                BigDecimal scanRisk = absNetDeltaBd.multiply(rangeFrac).multiply(repSettle);\n                long scanRiskTrunc = truncateTowardZeroToLong(scanRisk);\n                scanningRiskTotal += scanRiskTrunc;\n            }\n\n            List<Position> acctPositions = positionsByAccount.get(accountId);\n            if (acctPositions == null) {\n                acctPositions = Collections.emptyList();\n            }\n\n            // Spread charge: compute using net quantity per contract (no"]
[141.009289, "i", "t per lot)\n            Map<String, Long> netQtyByContract = new HashMap<String, Long>();\n            for (int i = 0; i < acctPositions.size(); i++) {\n                Position p = acctPositions.get(i);\n                Long cur = netQtyByContract.get(p.getContractCode());\n                long next = (cur == null ? 0L : cur.longValue()) + (long) p.getPositionQty();\n                netQtyByContract.put(p.getContractCode(), Long.valueOf(next));\n            }\n\n            BigDecimal spreadCharge = BigDecimal.ZERO;\n            for (Map.Entry<String, Long> e : netQtyByContract.entrySet()) {\n                String contractCode = e.getKey();\n                long netQty = e.getValue().longValue();\n                if (netQty == 0L) {\n                    continue;\n                }\n                MarketData md = marketDataByContract.get(contractCode);\n                if (md == null) {\n                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + contractCode);\n                }\n                BigDecimal absQtyBd = new BigDecimal(Long.toString(Math.abs(netQty)));\n                spreadCharge = spreadCharge.add(md.getIntraSpreadCharge().multiply(absQtyBd));\n            }\n\n            // PnL: sum per position lot (entry-price specific)\n            BigDecimal unrealizedPnl = BigDecimal.ZERO;\n            for (int i = 0; i < acctPositions.size(); i++) {\n                Position p = acctPositions.get(i);\n                ContractSpec spec = contractSpecsByContract.get(p.getContractCode());\n                if (spec == null) {\n                    throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\n                }\n                MarketData md = marketDataByContract.get(p.getContractCode());\n                if (md == null) {\n                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.getContractCode());\n                }\n\n                BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());\n                long qtyTimesMult = (long) p.getPositionQty() * (long) spec.getMultiplier();\n                BigDecimal qtyMultBd = new BigDecimal(Long.toString(qtyTimesMult));\n                unrealizedPnl = unrealizedPnl.add(qtyMultBd.multiply(priceDiff));\n            }\n\n            long spreadChargeTrunc = truncateTowardZeroToLong(spreadCharge);\n            long unrealizedPnlTrunc = truncateTowardZeroToLong(unrealizedPnl);\n\n            BigDecimal initialMarginBd = new BigDecimal(Long.toString(scanningRiskTotal)).add(new BigDecimal(Long.toString(spreadChargeTrunc)));\n            long initialMarginTrunc = truncateTowardZeroToLong(initialMarginBd);\n\n            String status = (unrealizedPnlTrunc >= initialMarginTrunc) ? \"ADEQUATE\" : \"CALL\";\n\n            results.add(new AccountMargin(accountId,\n                    sumAbsNetDelta,\n                    scanningRiskTotal,\n                    spreadChargeTrunc,\n                    initialMarginTrunc,\n                    unrealizedPnlTrunc,\n                    status));\n        }\n\n        Collections.sort(results, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a, AccountMargin b) {\n                return a.getAccountId().compareTo(b.getAccountId());\n            }\n        });\n\n        return results;\n    }\n\n    private static long truncateTowardZeroToLong(BigDecimal v) {\n        BigDecimal scaled = v.setScale(0, RoundingMode.DOWN);\n        return scaled.longValue();\n    }\n}\nEOF\n"]
