[141.024962, "o", "\u001b[?2004h> "]
[141.025914, "o", "        for (Map.Entry<String, Map<String, PositionAggregator.UnderlyingNet>> acctEntry : netted.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.026232, "o", "            String accountId = acctEntry.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.026825, "o", "            Map<String, PositionAggregator.UnderlyingNet> byUnderlying = acctEntry.getValue();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.026968, "o", "            long sumAbsNetDelta = 0L;\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.027084, "o", "> "]
[141.027237, "o", "            long scanningRiskTotal = 0L;\r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\r"]
[141.027358, "o", "\u001b[?2004h> "]
[141.027768, "o", "            for (PositionAggregator.UnderlyingNet net : byUnderlying.values()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.028119, "o", "                long netDelta = net.getNetDeltaExposure();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.028462, "o", "                sumAbsNetDelta += Math.abs(netDelta);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re"]
[141.028604, "o", "\u001b[?2004h> "]
[141.029041, "o", "                BigDecimal rangeFrac = underlyingMaxScanRange.get(net.getUnderlying());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.029275, "o", "                if (rangeFrac == null) {\r\n\u001b[?2004l\radC\u001b[?2004h> "]
[141.029615, "o", "                    rangeFrac = BigDecimal.ZERO;\r\n\u001b[?2004l\run\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[141.03002, "o", "                String repContract = net.getRepresentativeContractCode();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.030218, "o", "                if (repContract == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.030379, "o", "                    continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.030505, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.030674, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.030928, "o", "                MarketData repMd = marketDataByContract.get(repContract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.031105, "o", "                if (repMd == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.03163, "o", "                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + repContract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.031784, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.032049, "o", "                BigDecimal repSettle = repMd.getSettlementPrice();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.03247, "o", "                BigDecimal absNetDeltaBd = new BigDecimal(Long.toString(Math.abs(netDelta)));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[141.032665, "o", "\u001b[?2004h> "]
[141.032798, "o", "                BigDecimal scanRisk = absNetDeltaBd.multiply(rangeFrac).multiply(repSettle);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.03299, "o", "                long scanRiskTrunc = truncateTowardZeroToLong(scanRisk);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.033151, "o", "                scanningRiskTotal += scanRiskTrunc;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.033327, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.033502, "o", "            List<Position> acctPositions = positionsByAccount.get(accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.03369, "o", "            if (acctPositions == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.033893, "o", "                acctPositions = Collections.emptyList();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.033975, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.034253, "o", "            // Spread charge: compute using net quantity per contract (not per lot)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.034496, "o", "            Map<String, Long> netQtyByContract = new HashMap<String, Long>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.034711, "o", "            for (int i = 0; i < acctPositions.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.034875, "o", "                Position p = acctPositions.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.035157, "o", "                Long cur = netQtyByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.035457, "o", "                long next = (cur == null ? 0L : cur.longValue()) + (long) p.getPositionQty();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.035818, "o", "                netQtyByContract.put(p.getContractCode(), Long.valueOf(next));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.035956, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.036077, "o", "            BigDecimal spreadCharge = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.036321, "o", "            for (Map.Entry<String, Long> e : netQtyByContract.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.036483, "o", "                String contractCode = e.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.036674, "o", "                long netQty = e.getValue().longValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.036801, "o", "                if (netQty == 0L) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.036922, "o", "                    continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.037043, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.037222, "o", "                MarketData md = marketDataByContract.get(contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.03735, "o", "                if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.037766, "o", "                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.037907, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.038107, "o", "                BigDecimal absQtyBd = new BigDecimal(Long.toString(Math.abs(netQty)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.038405, "o", "                spreadCharge = spreadCharge.add(md.getIntraSpreadCharge().multiply(absQtyBd));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.038484, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.038729, "o", "            // PnL: sum per position lot (entry-price specific)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.038878, "o", "            BigDecimal unrealizedPnl = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.039078, "o", "            for (int i = 0; i < acctPositions.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.039299, "o", "                Position p = acctPositions.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.039616, "o", "                ContractSpec spec = contractSpecsByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.039747, "o", "                if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.040125, "o", "                    throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.040253, "o", "                }\r\n\u001b[?2004l\r"]
[141.040372, "o", "\u001b[?2004h> "]
[141.040553, "o", "                MarketData md = marketDataByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.040714, "o", "                if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.041142, "o", "                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.041326, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.041552, "o", "                BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.041995, "o", "                long qtyTimesMult = (long) p.getPositionQty() * (long) spec.getMultiplier();\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.042071, "o", "> "]
[141.042454, "o", "                BigDecimal qtyMultBd = new BigDecimal(Long.toString(qtyTimesMult));\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.042609, "o", "> "]
[141.042871, "o", "                unrealizedPnl = unrealizedPnl.add(qtyMultBd.multiply(priceDiff));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.043015, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.043228, "o", "            long spreadChargeTrunc = truncateTowardZeroToLong(spreadCharge);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.043464, "o", "            long unrealizedPnlTrunc = truncateTowardZeroToLong(unrealizedPnl);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.044037, "o", "            BigDecimal initialMarginBd = new BigDecimal(Long.toString(scanningRiskTotal)).add(new BigDecimal(Long.toString(spreadChargeTrunc)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.044376, "o", "            long initialMarginTrunc = truncateTowardZeroToLong(initialMarginBd);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.04474, "o", "            String status = (unrealizedPnlTrunc >= initialMarginTrunc) ? \"ADEQUATE\" : \"CALL\";\r\n\u001b[?2004l\r"]
[141.044815, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.045063, "o", "            results.add(new AccountMargin(accountId,\r\n\u001b[?2004l\r"]
[141.0452, "o", "\u001b[?2004h> "]
[141.045325, "o", "                    sumAbsNetDelta,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.045393, "o", "                    scanningRiskTotal,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.045619, "o", "                    spreadChargeTrunc,\r\n\u001b[?2004l\r\u001b[?2004h>                     initialMarginTrunc,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.045756, "o", "                    unrealizedPnlTrunc,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.045884, "o", "                    status));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.045988, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.046172, "o", "        Collections.sort(results, new Comparator<AccountMargin>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.046523, "o", "            public int compare(AccountMargin a, AccountMargin b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.046791, "o", "                return a.getAccountId().compareTo(b.getAccountId());\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.046853, "o", "        return results;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[141.046922, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[141.047147, "o", "\u001b[?2004h> "]
[141.047347, "o", "    private static long truncateTowardZeroToLong(BigDecimal v) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.047439, "o", "        BigDecimal scaled = v.setScale(0, RoundingMode.DOWN);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.047631, "o", "        return scaled.longValue();\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
