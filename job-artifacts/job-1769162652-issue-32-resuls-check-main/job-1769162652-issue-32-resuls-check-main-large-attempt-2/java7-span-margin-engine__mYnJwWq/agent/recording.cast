[140.82791, "o", "        // Finalize representative contract selection using net quantities per contract.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.828165, "o", "        for (Map.Entry<String, Map<String, UnderlyingNet>> acct : out.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
