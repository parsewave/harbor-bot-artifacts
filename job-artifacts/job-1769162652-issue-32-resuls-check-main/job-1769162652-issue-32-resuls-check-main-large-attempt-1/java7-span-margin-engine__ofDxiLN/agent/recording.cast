[95.755334, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class PositionAggregator {\n\n    public static class AccountAggregates {\n        // account -> contract -> net qty\n        public final Map<String, Map<String, Long>> netQtyByContract = new HashMap<String, Map<String, Long>>();\n        // account -> underlying -> net delta exposure (qty * multiplier summed)\n        public final Map<String, Map<String, Long>> netDeltaByUnderlying = new HashMap<String, Map<String, Long>>();\n        // account -> underlying -> contract -> open interest equivalent (abs(qty) * multiplier)\n        public final Map<String, Map<String, Map<String, Long>>> openInterestEqByUnderlyingContract = new HashMap<String, Map<String, Map<String, Long>>>();\n        // all accounts with at least one position\n        public final List<String> accounts = new ArrayList<String>();\n    }\n\n    public static AccountAggregates aggregate(List<Position> positions, Map<String, ContractSpec> specsByContract) {\n        AccountAggregates agg = new AccountAggregates();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = specsByContract.get(p.contractCode);\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.contractCode);\n            }\n\n            if (!agg.netQtyByContract.containsKey(p.accountId)) {\n                agg.netQtyByContract.put(p.accountId, new HashMap<String, Long>());\n                agg.netDeltaByUnderlying.put(p.accountId, new HashMap<String, Long>());\n                agg.openInterestEqByUnderlyingContract.put(p.accountId, new HashMap<String, Map<String, Long>>());\n                agg.accounts.add(p.accountId);\n            }\n\n            Map<String, Long> acctContractQty = agg.netQtyByContract.get(p.accountId);\n            Long prevQty = acctContractQty.get(p.contractCode);\n            long newQty = (prevQty == null ? 0L : prevQty.longValue()) + (long) p.positionQty;\n            acctContractQty.put(p.contractCode, Long.valueOf(newQty));\n\n            String underlying = spec.underlying;\n            long deltaEq = ((long) p.positionQty) * ((long) spec.multiplier);\n            Map<String, Long> acctUnderlyingDelta = agg.netDeltaByUnderlying.get(p.accountId);\n            Long prevDelta = acctUnderlyingDelta.get(underlying);\n            long newDelta = (prevDelta == null ? 0L : prevDelta.longValue()) + deltaEq;\n            acctUnderlyingDelta.put(underlying, Long.valueOf(newDelta));\n\n            Map<String, Map<String, Long>> acctOIEByUnd = agg.openInterestEqByUnderlyingContract.get(p.accountId);\n            if (!acctOIEByUnd.containsKey(underlying)) {\n                acctOIEByUnd.put(underlying, new HashMap<String, Long>());\n            }\n            Map<String, Long> contractOIE = acctOIEByUnd.get(underlying);\n            Long prevOIE = contractOIE.get(p.contractCode);\n            long addOIE = Math.abs((long) p.positionQty) * ((long) spec.multiplier);\n            long newOIE = (prevOIE == null ? 0L : prevOIE.longValue()) + addOIE;\n            contractOIE.put(p.contractCode, Long.valueOf(newOIE));\n        }\n\n        return agg;\n    }\n}\nEOF\n"]
