[96.326729, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class Main {\n\n    public static void main(String[] args) throws Exception {\n        if (args.length != 4) {\n            throw new IllegalArgumentException(\"Expected 4 args: positions_path market_data_path contract_specs_path output_path\");\n        }\n        String positionsPath = args[0];\n        String marketPath = args[1];\n        String specsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> marketByContract = loadMarketData(marketPath);\n        Map<String, ContractSpec> specsByContract = loadContractSpecs(specsPath);\n\n        // Aggregate positions for netting and representative contract selection.\n        PositionAggregator.AccountAggregates agg = PositionAggregator.aggregate(positions, specsByContract);\n\n        // Unrealized PnL per account from raw positions (not netted per spec).\n        Map<String, Long> unrealizedPnlByAccount = computeUnrealizedPnlByAccount(positions, specsByContract, marketByContract);\n\n        // Compute margins.\n        MarginCalculator calc = new MarginCalculator(specsByContract, marketByContract);\n        List<String> accounts = new ArrayList<String>(agg.accounts);\n        Collections.sort(accounts);\n\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n        for (int i = 0; i < accounts.size(); i++) {\n            String accountId = accounts.get(i);\n            Map<String, Long> netQtyByContract = agg.netQtyByContract.get(accountId);\n            Map<String, Long> netDeltaByUnderlying = agg.netDeltaByUnderlying.get(accountId);\n            Map<String, Map<String, Long>> oieByUndContract = agg.openInterestEqByUnderlyingContract.get(accountId);\n            long pnl = getOrZero(unrealizedPnlByAccount, accountId);\n\n            AccountMargin am = calc.computeForAccount(accountId, netQtyByContract, netDeltaByUnderlying, oieByUndContract, pnl);\n            results.add(am);\n        }\n\n        writeOutput(outputPath, results);\n    }\n\n    private static long getOrZero(Map<String, Long> m, String k) {\n        Long v = m.get(k);\n        return v == null ? 0L : v.longValue();\n    }\n\n    private static List<Position> loadPositions(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            String header = br.readLine();\n            if (header == null) {\n                return new ArrayList<Position>();\n            }\n            List<Position> list = new ArrayList<Position>();\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                list.add(Position.parse(line));\n            }\n            return list;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            String header = br.readLine();\n            if (header == null) {\n                return new HashMap<String, MarketData>();\n            }\n            Map<String, MarketData> m = new HashMap<String, MarketData>();\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                MarketData md = MarketData.parse(line);\n                m.put(md.contractCode, md);\n            }\n            return m;\n        } final"]
[96.326872, "i", "ly {\n            br.close();\n        }\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            String header = br.readLine();\n            if (header == null) {\n                return new HashMap<String, ContractSpec>();\n            }\n            Map<String, ContractSpec> m = new HashMap<String, ContractSpec>();\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                ContractSpec cs = ContractSpec.parse(line);\n                m.put(cs.contractCode, cs);\n            }\n            return m;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static Map<String, Long> computeUnrealizedPnlByAccount(List<Position> positions,\n                                                                  Map<String, ContractSpec> specsByContract,\n                                                                  Map<String, MarketData> marketByContract) {\n        Map<String, BigDecimal> pnl = new HashMap<String, BigDecimal>();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = specsByContract.get(p.contractCode);\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.contractCode);\n            }\n            MarketData md = marketByContract.get(p.contractCode);\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.contractCode);\n            }\n\n            BigDecimal qty = new BigDecimal(Integer.toString(p.positionQty));\n            BigDecimal mult = new BigDecimal(Integer.toString(spec.multiplier));\n            BigDecimal priceDiff = md.settlementPrice.subtract(p.entryPrice);\n            BigDecimal posPnl = qty.multiply(mult).multiply(priceDiff);\n\n            BigDecimal prev = pnl.get(p.accountId);\n            pnl.put(p.accountId, (prev == null ? BigDecimal.ZERO : prev).add(posPnl));\n        }\n\n        Map<String, Long> out = new HashMap<String, Long>();\n        for (Map.Entry<String, BigDecimal> e : pnl.entrySet()) {\n            out.put(e.getKey(), Long.valueOf(e.getValue().longValue()));\n        }\n        return out;\n    }\n\n    private static void writeOutput(String path, List<AccountMargin> results) throws Exception {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(path), \"UTF-8\"));\n        try {\n            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\n            bw.newLine();\n            for (int i = 0; i < results.size(); i++) {\n                bw.write(results.get(i).toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            bw.close();\n        }\n    }\n}\nEOF\n"]
