[95.370306, "i", "cat > /app/src/MarketData.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic class MarketData {\n    public final String contractCode;\n    public final BigDecimal settlementPrice;\n    public final BigDecimal scanningRangePct;\n    public final BigDecimal intraSpreadCharge;\n\n    public MarketData(String contractCode, BigDecimal settlementPrice, BigDecimal scanningRangePct, BigDecimal intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRangePct = scanningRangePct;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public static MarketData parse(String line) {\n        String[] parts = Csv.split(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid market_data row (expected 4 cols): \" + line);\n        }\n        String contractCode = parts[0];\n        BigDecimal settlementPrice = new BigDecimal(parts[1]);\n        BigDecimal scanningRangePct = new BigDecimal(parts[2]);\n        BigDecimal intraSpreadCharge = new BigDecimal(parts[3]);\n        return new MarketData(contractCode, settlementPrice, scanningRangePct, intraSpreadCharge);\n    }\n\n    public BigDecimal scanningRangeFraction() {\n        return scanningRangePct.divide(new BigDecimal(\"100\"));\n    }\n}\nEOF\n"]
