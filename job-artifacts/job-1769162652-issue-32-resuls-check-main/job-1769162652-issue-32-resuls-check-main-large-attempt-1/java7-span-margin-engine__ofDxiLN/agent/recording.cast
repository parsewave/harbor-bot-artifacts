[95.760152, "o", "        // account -> underlying -> contract -> open interest equivalent (abs(qty) * multiplier)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.761023, "o", "        public final Map<String, Map<String, Map<String, Long>>> openInterestEqByUnderlyingContract = new HashMap<String, Map<String, Map<String, Long>>>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.761276, "o", "        // all accounts with at least one position\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.76171, "o", "        public final List<String> accounts = new ArrayList<String>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.761891, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.762424, "o", "    public static AccountAggregates aggregate(List<Position> positions, Map<String, ContractSpec> specsByContract) {\r\n\u001b[?2004l\r"]
[95.762592, "o", "\u001b[?2004h> "]
[95.762769, "o", "        AccountAggregates agg = new AccountAggregates();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.762911, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.763143, "o", "        for (int i = 0; i < positions.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.763452, "o", "            Position p = positions.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.76379, "o", "            ContractSpec spec = specsByContract.get(p.contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.764001, "o", "            if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.764567, "o", "                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.contractCode);\r\n\u001b[?2004l\r"]
[95.764652, "o", "\u001b[?2004h> "]
[95.764874, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.765153, "o", "            if (!agg.netQtyByContract.containsKey(p.accountId)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.76562, "o", "                agg.netQtyByContract.put(p.accountId, new HashMap<String, Long>());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.766088, "o", "                agg.netDeltaByUnderlying.put(p.accountId, new HashMap<String, Long>());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.766684, "o", "                agg.openInterestEqByUnderlyingContract.put(p.accountId, new HashMap<String, Map<String, Long>>());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.766923, "o", "                agg.accounts.add(p.accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.767087, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[95.767225, "o", "\u001b[?2004h> "]
[95.767595, "o", "            Map<String, Long> acctContractQty = agg.netQtyByContract.get(p.accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.767902, "o", "            Long prevQty = acctContractQty.get(p.contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.768424, "o", "            long newQty = (prevQty == null ? 0L : prevQty.longValue()) + (long) p.positionQty;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.768765, "o", "            acctContractQty.put(p.contractCode, Long.valueOf(newQty));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[95.768951, "o", "\u001b[?2004h> "]
[95.769106, "o", "            String underlying = spec.underlying;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.769543, "o", "            long deltaEq = ((long) p.positionQty) * ((long) spec.multiplier);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.770005, "o", "            Map<String, Long> acctUnderlyingDelta = agg.netDeltaByUnderlying.get(p.accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.770319, "o", "            Long prevDelta = acctUnderlyingDelta.get(underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.770813, "o", "            long newDelta = (prevDelta == null ? 0L : prevDelta.longValue()) + deltaEq;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.771131, "o", "            acctUnderlyingDelta.put(underlying, Long.valueOf(newDelta));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.771221, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.771772, "o", "            Map<String, Map<String, Long>> acctOIEByUnd = agg.openInterestEqByUnderlyingContract.get(p.accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.77208, "o", "            if (!acctOIEByUnd.containsKey(underlying)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.772505, "o", "                acctOIEByUnd.put(underlying, new HashMap<String, Long>());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.772673, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.772981, "o", "            Map<String, Long> contractOIE = acctOIEByUnd.get(underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.7733, "o", "            Long prevOIE = contractOIE.get(p.contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.773729, "o", "            long addOIE = Math.abs((long) p.positionQty) * ((long) spec.multiplier);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.77414, "o", "            long newOIE = (prevOIE == null ? 0L : prevOIE.longValue()) + addOIE;\r\n\u001b[?2004l\r"]
[95.774353, "o", "\u001b[?2004h> "]
[95.774593, "o", "            contractOIE.put(p.contractCode, Long.valueOf(newOIE));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.774674, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[95.774848, "o", "\u001b[?2004h> "]
[95.774922, "o", "        return agg;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.775145, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[95.777416, "o", "\u001b[?2004hroot@04e751d4d1e1:/app# "]
[95.933581, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.math.BigDecimal;\nimport java.util.HashMap;\nimport java.util.Map;\n\npublic class MarginCalculator {\n\n    private final Map<String, ContractSpec> specsByContract;\n    private final Map<String, MarketData> marketByContract;\n\n    // underlying -> max scanning range fraction\n    private final Map<String, BigDecimal> maxScanRangeByUnderlying = new HashMap<String, BigDecimal>();\n\n    public MarginCalculator(Map<String, ContractSpec> specsByContract, Map<String, MarketData> marketByContract) {\n        this.specsByContract = specsByContract;\n        this.marketByContract = marketByContract;\n        buildUnderlyingMaxRanges();\n    }\n\n    private void buildUnderlyingMaxRanges() {\n        for (Map.Entry<String, ContractSpec> e : specsByContract.entrySet()) {\n            String contract = e.getKey();\n            ContractSpec spec = e.getValue();\n            MarketData md = marketByContract.get(contract);\n            if (md == null) {\n                continue;\n            }\n            BigDecimal frac = md.scanningRangeFraction();\n            BigDecimal prev = maxScanRangeByUnderlying.get(spec.underlying);\n            if (prev == null || frac.compareTo(prev) > 0) {\n                maxScanRangeByUnderlying.put(spec.underlying, frac);\n            }\n        }\n    }\n\n    public AccountMargin computeForAccount(String accountId,\n                                          Map<String, Long> netQtyByContract,\n                                          Map<String, Long> netDeltaByUnderlying,\n                                          Map<String, Map<String, Long>> openInterestEqByUnderlyingContract,\n                                          long unrealizedPnl) {\n\n        long netDeltaExposureSumAbs = 0L;\n        long scanningRiskTotal = 0L;\n\n        for (Map.Entry<String, Long> e : netDeltaByUnderlying.entrySet()) {\n            String underlying = e.getKey();\n            long netDelta = e.getValue().longValue();\n            netDeltaExposureSumAbs += Math.abs(netDelta);\n\n            BigDecimal scanFrac = maxScanRangeByUnderlying.get(underlying);\n            if (scanFrac == null) {\n                scanFrac = BigDecimal.ZERO;\n            }\n\n            BigDecimal repSettlement = representativeSettlementPrice(accountId, underlying, openInterestEqByUnderlyingContract);\n            BigDecimal risk = new BigDecimal(Long.toString(Math.abs(netDelta))).multiply(scanFrac).multiply(repSettlement);\n            long riskTrunc = risk.longValue(); // trunc toward zero\n            scanningRiskTotal += riskTrunc;\n        }\n\n        long spreadCharge = computeSpreadCharge(netQtyByContract);\n\n        long initialMargin = scanningRiskTotal + spreadCharge;\n        String status = (unrealizedPnl >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\n\n        return new AccountMargin(accountId,\n                netDeltaExposureSumAbs,\n                scanningRiskTotal,\n                spreadCharge,\n                initialMargin,\n                unrealizedPnl,\n                status);\n    }\n\n    private BigDecimal representativeSettlementPrice(String accountId,\n                                                    String underlying,\n                                                    Map<String, Map<String, Long>> openInterestEqByUnderlyingContract) {\n        Map<String, Long> oieByContract = openInterestEqByUnderlyingContract.get(underlying);\n        if (oieByContract == null || oieByContract.isEmpty()) {\n            return BigDecimal.ZERO;\n        }\n\n        String bestContract = null;\n        long bestOie = Long.MIN_VALUE;\n        for (Map.Entry<String, Long> e : oieByContract.entrySet()) {\n            String contract = e.getKey();\n            long oie = e.getValue().longValue();\n            if (bestContract == null || oie > bestOie) {\n                bestContract = contract;\n                bestOie = oie;\n            }\n        }\n\n        MarketData md = marketByContract.get(bestContract);\n        if (md == null) {\n            throw new IllegalArgumentException(\"Missing market data for contract_code=\" + bestContract + \" (account="]
[95.933675, "i", "\" + accountId + \")\");\n        }\n        return md.settlementPrice;\n    }\n\n    private long computeSpreadCharge(Map<String, Long> netQtyByContract) {\n        BigDecimal total = BigDecimal.ZERO;\n        for (Map.Entry<String, Long> e : netQtyByContract.entrySet()) {\n            String contract = e.getKey();\n            long qty = e.getValue().longValue();\n            if (qty == 0L) {\n                continue;\n            }\n            MarketData md = marketByContract.get(contract);\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + contract);\n            }\n            BigDecimal add = md.intraSpreadCharge.multiply(new BigDecimal(Long.toString(Math.abs(qty))));\n            total = total.add(add);\n        }\n        return total.longValue(); // trunc toward zero\n    }\n}\nEOF\n"]
