[95.553755, "i", "cat > /app/src/ContractSpec.java <<'EOF'\npublic class ContractSpec {\n    public final String contractCode;\n    public final int multiplier;\n    public final String expiryMonth;\n    public final String underlying;\n\n    public ContractSpec(String contractCode, int multiplier, String expiryMonth, String underlying) {\n        this.contractCode = contractCode;\n        this.multiplier = multiplier;\n        this.expiryMonth = expiryMonth;\n        this.underlying = underlying;\n    }\n\n    public static ContractSpec parse(String line) {\n        String[] parts = Csv.split(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid contract_specs row (expected 4 cols): \" + line);\n        }\n        String contractCode = parts[0];\n        int multiplier = Integer.parseInt(parts[1]);\n        String expiryMonth = parts[2];\n        String underlying = parts[3];\n        return new ContractSpec(contractCode, multiplier, expiryMonth, underlying);\n    }\n}\nEOF\n"]
