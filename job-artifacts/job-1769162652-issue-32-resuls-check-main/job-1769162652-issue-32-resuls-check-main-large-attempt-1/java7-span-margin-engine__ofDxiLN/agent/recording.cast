[95.195286, "i", "cat > /app/src/Position.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic class Position {\n    public final String accountId;\n    public final String contractCode;\n    public final int positionQty;\n    public final BigDecimal entryPrice;\n\n    public Position(String accountId, String contractCode, int positionQty, BigDecimal entryPrice) {\n        this.accountId = accountId;\n        this.contractCode = contractCode;\n        this.positionQty = positionQty;\n        this.entryPrice = entryPrice;\n    }\n\n    public static Position parse(String line) {\n        String[] parts = Csv.split(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid positions row (expected 4 cols): \" + line);\n        }\n        String accountId = parts[0];\n        String contractCode = parts[1];\n        int qty = Integer.parseInt(parts[2]);\n        BigDecimal entryPrice = new BigDecimal(parts[3]);\n        return new Position(accountId, contractCode, qty, entryPrice);\n    }\n}\nEOF\n"]
