[147.345798, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.346075, "o", "            MarketData md = marketByContract.get(p.contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.346171, "o", "            if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.346586, "o", "                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.346675, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[147.346902, "o", "\u001b[?2004h> "]
[147.347087, "o", "            BigDecimal qty = new BigDecimal(Integer.toString(p.positionQty));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.34745, "o", "            BigDecimal mult = new BigDecimal(Integer.toString(spec.multiplier));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.347767, "o", "            BigDecimal priceDiff = md.settlementPrice.subtract(p.entryPrice);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.348047, "o", "            BigDecimal posPnl = qty.multiply(mult).multiply(priceDiff);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[147.348218, "o", "\u001b[?2004h> "]
[147.348397, "o", "            BigDecimal prev = pnl.get(p.accountId);\r\n\u001b[?2004l\r"]
[147.348568, "o", "\u001b[?2004h> "]
[147.348894, "o", "            pnl.put(p.accountId, (prev == null ? BigDecimal.ZERO : prev).add(posPnl));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.348974, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.349062, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.349308, "o", "        Map<String, Long> out = new HashMap<String, Long>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.349507, "o", "        for (Map.Entry<String, BigDecimal> e : pnl.entrySet()) {\r\n\u001b[?2004l\r"]
[147.349569, "o", "\u001b[?2004h> "]
[147.349882, "o", "            out.put(e.getKey(), Long.valueOf(e.getValue().longValue()));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.349976, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.35017, "o", "        return out;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.350569, "o", "    private static void writeOutput(String path, List<AccountMargin> results) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.351003, "o", "        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(path), \"UTF-8\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.351176, "o", "        try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.351776, "o", "            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.35193, "o", "            bw.newLine();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.35224, "o", "            for (int i = 0; i < results.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.352539, "o", "                bw.write(results.get(i).toCsvRow());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.352714, "o", "                bw.newLine();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.35294, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         } finally {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.353104, "o", "            bw.close();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.353289, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.353393, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.353572, "o", "final class Csv {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.353686, "o", "    private Csv() {\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.353864, "o", "    public static String[] split(String line) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.35405, "o", "        // Assumes no quoted commas (simple benchmark CSV)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.354217, "o", "        String[] parts = line.split(\",\", -1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.354354, "o", "        for (int i = 0; i < parts.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.354423, "o", "> "]
[147.354599, "o", "            parts[i] = parts[i].trim();\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[147.354675, "o", "\u001b[?2004h> "]
[147.354738, "o", "        return parts;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.354809, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
