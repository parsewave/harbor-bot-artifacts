[95.953811, "o", "        if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.954286, "o", "            throw new IllegalArgumentException(\"Missing market data for contract_code=\" + bestContract + \" (account=\" + accountId + \")\");\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[95.954463, "o", "\u001b[?2004h> "]
[95.95464, "o", "        return md.settlementPrice;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.95478, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.954936, "o", "    private long computeSpreadCharge(Map<String, Long> netQtyByContract) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.955109, "o", "        BigDecimal total = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.955331, "o", "        for (Map.Entry<String, Long> e : netQtyByContract.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.955548, "o", "            String contract = e.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.955733, "o", "            long qty = e.getValue().longValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.955871, "o", "            if (qty == 0L) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.956005, "o", "                continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.956072, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.95627, "o", "            MarketData md = marketByContract.get(contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.956443, "o", "            if (md == null) {\r\n\u001b[?2004l\r"]
[95.956541, "o", "\u001b[?2004h> "]
[95.956784, "o", "                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.956928, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.957236, "o", "            BigDecimal add = md.intraSpreadCharge.multiply(new BigDecimal(Long.toString(Math.abs(qty))));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.957448, "o", "            total = total.add(add);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[95.95764, "o", "\u001b[?2004h> "]
