[?2004l[?2004h>     private static Map<String, Long> computeUnrealizedPnlByAccount(List<Position> positions,
[?2004l[?2004h>                                                                   Map<String, ContractSpec> specsByContract,
[?2004l[?2004h>                                                                   Map<String, MarketData> marketByContract) {
[?2004l[?2004h>         Map<String, BigDecimal> pnl = new HashMap<String, BigDecimal>();
[?2004l[?2004h> 
