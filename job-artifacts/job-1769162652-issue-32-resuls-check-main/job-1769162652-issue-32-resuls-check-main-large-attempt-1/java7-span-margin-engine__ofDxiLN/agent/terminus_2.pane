[?2004l[?2004h>             ContractSpec spec = specsByContract.get(p.contractCode);
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.contractCode);
[?2004l[?2004h>             }
[?2004l[?2004h>             MarketData md = marketByContract.get(p.contractCode);
[?2004l[?2004h>             if (md == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing market data for contract_code=" + p.contractCode);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal qty = new BigDecimal(Integer.toString(p.positionQty));
[?2004l[?2004h>             BigDecimal mult = new BigDecimal(Integer.toString(spec.multiplier));
[?2004l[?2004h>             BigDecimal priceDiff = md.settlementPrice.subtract(p.entryPrice);
[?2004l[?2004h>             BigDecimal posPnl = qty.multiply(mult).multiply(priceDiff);
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal prev = pnl.get(p.accountId);
[?2004l[?2004h>             pnl.put(p.accountId, (prev == null ? BigDecimal.ZERO : prev).add(posPnl));
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         Map<String, Long> out = new HashMap<String, Long>();
[?2004l[?2004h>         for (Map.Entry<String, BigDecimal> e : pnl.entrySet()) {
[?2004l[?2004h>             out.put(e.getKey(), Long.valueOf(e.getValue().longValue()));
[?2004l[?2004h>         }
[?2004l[?2004h>         return out;
[?2004l[?2004h>     }
