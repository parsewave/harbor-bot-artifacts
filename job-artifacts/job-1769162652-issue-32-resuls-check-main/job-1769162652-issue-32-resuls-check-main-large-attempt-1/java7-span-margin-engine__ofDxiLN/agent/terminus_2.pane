[?2004l[?2004h>         sb.append(spreadCharge).append(',');
[?2004l[?2004h>         sb.append(initialMargin).append(',');
[?2004l[?2004h>         sb.append(unrealizedPnl).append(',');
[?2004l[?2004h>         sb.append(marginStatus);
