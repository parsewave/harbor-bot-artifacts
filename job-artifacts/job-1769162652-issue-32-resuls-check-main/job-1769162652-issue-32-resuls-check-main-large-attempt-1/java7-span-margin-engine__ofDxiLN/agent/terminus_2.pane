[?2004l[?2004h> import java.util.List;
[?2004l[?2004h> import java.util.Map;
[?2004l[?2004h> 
[?2004l[?2004h> public class PositionAggregator {
[?2004l[?2004h> 
[?2004l[?2004h>     public static class AccountAggregates {
[?2004l[?2004h>         // account -> contract -> net qty
[?2004l[?2004h>         public final Map<String, Map<String, Long>> netQtyByContract = new HashMap<String, Map<String, Long>>();
[?2004l[?2004h>         // account -> underlying -> net delta exposure (qty * multiplier summed)
[?2004l[?2004h>         public final Map<String, Map<String, Long>> netDeltaByUnderlying = new HashMap<String, Map<String, Long>>();
[?2004l[?2004h>         // account -> underlying -> contract -> open interest equivalent (abs(qty) * multiplier)
[?2004l[?2004h>         public final Map<String, Map<String, Map<String, Long>>> openInterestEqByUnderlyingContract = new HashMap<String, Map<String, Map<String, Long>>>();
[?2004l[?2004h>         // all accounts with at least one position
[?2004l[?2004h>         public final List<String> accounts = new ArrayList<String>();
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public static AccountAggregates aggregate(List<Position> positions, Map<String, ContractSpec> specsByContract) {
[?2004l[?2004h>         AccountAggregates agg = new AccountAggregates();
[?2004l[?2004h> 
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position p = positions.get(i);
[?2004l[?2004h>             ContractSpec spec = specsByContract.get(p.contractCode);
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.contractCode);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             if (!agg.netQtyByContract.containsKey(p.accountId)) {
[?2004l[?2004h>                 agg.netQtyByContract.put(p.accountId, new HashMap<String, Long>());
[?2004l[?2004h>                 agg.netDeltaByUnderlying.put(p.accountId, new HashMap<String, Long>());
[?2004l[?2004h>                 agg.openInterestEqByUnderlyingContract.put(p.accountId, new HashMap<String, Map<String, Long>>());
[?2004l[?2004h>                 agg.accounts.add(p.accountId);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             Map<String, Long> acctContractQty = agg.netQtyByContract.get(p.accountId);
[?2004l[?2004h>             Long prevQty = acctContractQty.get(p.contractCode);
[?2004l[?2004h>             long newQty = (prevQty == null ? 0L : prevQty.longValue()) + (long) p.positionQty;
[?2004l[?2004h>             acctContractQty.put(p.contractCode, Long.valueOf(newQty));
[?2004l[?2004h> 
[?2004l[?2004h>             String underlying = spec.underlying;
[?2004l[?2004h>             long deltaEq = ((long) p.positionQty) * ((long) spec.multiplier);
[?2004l[?2004h>             Map<String, Long> acctUnderlyingDelta = agg.netDeltaByUnderlying.get(p.accountId);
[?2004l[?2004h>             Long prevDelta = acctUnderlyingDelta.get(underlying);
[?2004l[?2004h>             long newDelta = (prevDelta == null ? 0L : prevDelta.longValue()) + deltaEq;
[?2004l[?2004h>             acctUnderlyingDelta.put(underlying, Long.valueOf(newDelta));
[?2004l[?2004h> 
[?2004l[?2004h>             Map<String, Map<String, Long>> acctOIEByUnd = agg.openInterestEqByUnderlyingContract.get(p.accountId);
[?2004l[?2004h>             if (!acctOIEByUnd.containsKey(underlying)) {
[?2004l[?2004h>                 acctOIEByUnd.put(underlying, new HashMap<String, Long>());
[?2004l[?2004h>             }
[?2004l[?2004h>             Map<String, Long> contractOIE = acctOIEByUnd.get(underlying);
[?2004l[?2004h>             Long prevOIE = contractOIE.get(p.contractCode);
[?2004l[?2004h>             long addOIE = Math.abs((long) p.positionQty) * ((long) spec.multiplier);
[?2004l[?2004h>             long newOIE = (prevOIE == null ? 0L : prevOIE.longValue()) + addOIE;
[?2004l[?2004h>             contractOIE.put(p.contractCode, Long.valueOf(newOIE));
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         return agg;
[?2004l[?2004h>     }
[?2004l[?2004h> }
