[?2004l[?2004h> import java.math.BigDecimal;
[?2004l[?2004h> import java.util.HashMap;
[?2004l[?2004h> import java.util.Map;
[?2004l[?2004h> 
[?2004l [?2004h> public class MarginCalculator {
[?2004l[?2004h> 
[?2004l [?2004h>     private final Map<String, ContractSpec> specsByContract;
[?2004l<S[?2004h>     private final Map<String, MarketData> marketByContract;
[?2004l  [?2004h> 
[?2004lS[?2004h>     // underlying -> max scanning range fraction
[?2004lty[?2004h>     private final Map<String, BigDecimal> maxScanRangeByUnderlying = new HashMap<String, BigDecimal>();
[?2004l[?2004h> 
[?2004l [?2004h>     public MarginCalculator(Map<String, ContractSpec> specsByContract, Map<String, MarketData> marketByContract) {
[?2004l[?2004h>         this.specsByContract = specsByContract;
[?2004l[?2004h>         this.marketByContract = marketByContract;
[?2004l [?2004h>         buildUnderlyingMaxRanges();
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private void buildUnderlyingMaxRanges() {
[?2004l[?2004h>         for (Map.Entry<String, ContractSpec> e : specsByContract.entrySet()) {
[?2004l[?2004h>             String contract = e.getKey();
[?2004lEOF
[?2004h>             ContractSpec spec = e.getValue();
[?2004l[?2004h>             MarketData md = marketByContract.get(contract);
[?2004l[?2004h>             if (md == null) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             BigDecimal frac = md.scanningRangeFraction();
[?2004l[?2004h>             BigDecimal prev = maxScanRangeByUnderlying.get(spec.underlying);
[?2004l[?2004h>             if (prev == null || frac.compareTo(prev) > 0) {
[?2004l[?2004h>                 maxScanRangeByUnderlying.put(spec.underlying, frac);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public AccountMargin computeForAccount(String accountId,
[?2004l[?2004h>                                           Map<String, Long> netQtyByContract,
[?2004l[?2004h>                                           Map<String, Long> netDeltaByUnderlying,
[?2004l[?2004h>                                           Map<String, Map<String, Long>> openInterestEqByUnderlyingContract,
[?2004l[?2004h>                                           long unrealizedPnl) {
[?2004l[?2004h> 
[?2004l[?2004h>         long netDeltaExposureSumAbs = 0L;
[?2004l[?2004h>         long scanningRiskTotal = 0L;
[?2004l[?2004h> 
[?2004l[?2004h>         for (Map.Entry<String, Long> e : netDeltaByUnderlying.entrySet()) {
[?2004l[?2004h>             String underlying = e.getKey();
[?2004l[?2004h>             long netDelta = e.getValue().longValue();
[?2004l[?2004h>             netDeltaExposureSumAbs += Math.abs(netDelta);
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal scanFrac = maxScanRangeByUnderlying.get(underlying);
[?2004l[?2004h>             if (scanFrac == null) {
[?2004l[?2004h>                 scanFrac = BigDecimal.ZERO;
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal repSettlement = representativeSettlementPrice(accountId, underlying, openInterestEqByUnderlyingContract);
[?2004l[?2004h>             BigDecimal risk = new BigDecimal(Long.toString(Math.abs(netDelta))).multiply(scanFrac).multiply(repSettlement);
[?2004l[?2004h>             long riskTrunc = risk.longValue(); // trunc toward zero
[?2004l[?2004h>             scanningRiskTotal += riskTrunc;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         long spreadCharge = computeSpreadCharge(netQtyByContract);
[?2004l[?2004h> 
[?2004l[?2004h>         long initialMargin = scanningRiskTotal + spreadCharge;
[?2004l[?2004h>         String status = (unrealizedPnl >= initialMargin) ? "ADEQUATE" : "CALL";
[?2004l[?2004h> 
[?2004l[?2004h>         return new AccountMargin(accountId,
[?2004l[?2004h>                 netDeltaExposureSumAbs,
[?2004l[?2004h>                 scanningRiskTotal,
[?2004l[?2004h>                 spreadCharge,
[?2004l[?2004h>                 initialMargin,
[?2004l[?2004h>                 unrealizedPnl,
[?2004l[?2004h>                 status);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private BigDecimal representativeSettlementPrice(String accountId,
[?2004l[?2004h>                                                     String underlying,
[?2004l[?2004h>                                                     Map<String, Map<String, Long>> openInterestEqByUnderlyingContract) {
[?2004l[?2004h>         Map<String, Long> oieByContract = openInterestEqByUnderlyingContract.get(underlying);
[?2004l[?2004h>         if (oieByContract == null || oieByContract.isEmpty()) {
[?2004l[?2004h>             return BigDecimal.ZERO;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         String bestContract = null;
[?2004l[?2004h>         long bestOie = Long.MIN_VALUE;
[?2004l[?2004h>         for (Map.Entry<String, Long> e : oieByContract.entrySet()) {
[?2004l[?2004h>             String contract = e.getKey();
[?2004l[?2004h>             long oie = e.getValue().longValue();
[?2004l[?2004h>             if (bestContract == null || oie > bestOie) {
[?2004l[?2004h>                 bestContract = contract;
[?2004l[?2004h>                 bestOie = oie;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         MarketData md = marketByContract.get(bestContract);
[?2004l[?2004h>         if (md == null) {
[?2004l[?2004h>             throw new IllegalArgumentException("Missing market data for contract_code=" + bestContract + " (account=" + accountId + ")");
[?2004l[?2004h>         }
[?2004l[?2004h>         return md.settlementPrice;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private long computeSpreadCharge(Map<String, Long> netQtyByContract) {
[?2004l[?2004h>         BigDecimal total = BigDecimal.ZERO;
[?2004l[?2004h>         for (Map.Entry<String, Long> e : netQtyByContract.entrySet()) {
[?2004l[?2004h>             String contract = e.getKey();
[?2004l[?2004h>             long qty = e.getValue().longValue();
[?2004l[?2004h>             if (qty == 0L) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             MarketData md = marketByContract.get(contract);
[?2004l[?2004h>             if (md == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing market data for contract_code=" + contract);
[?2004l[?2004h>             }
[?2004l[?2004h>             BigDecimal add = md.intraSpreadCharge.multiply(new BigDecimal(Long.toString(Math.abs(qty))));
[?2004l[?2004h>             total = total.add(add);
[?2004l[?2004h>         }
[?2004l[?2004h>         return total.longValue(); // trunc toward zero
[?2004l[?2004h>     }
[?2004l[?2004h> }
