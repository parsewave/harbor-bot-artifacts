[151.447609, "o", "            int qty = e.getValue() == null ? 0 : e.getValue().intValue();\r\n\u001b[?2004l\r"]
[151.447697, "o", "\u001b[?2004h> "]
[151.447858, "o", "            if (qty == 0) {\r\n\u001b[?2004l\r\u001b[?2004h>                 continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.44804, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.448237, "o", "            ContractSpec spec = contractSpecsByContract.get(contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.448381, "o", "            if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.448549, "o", "                continue;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.448818, "o", "            if (!underlying.equals(spec.getUnderlying())) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.448915, "o", "                continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.449013, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.449287, "o", "            long oiEq = ((long) Math.abs(qty)) * ((long) spec.getMultiplier());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.449452, "o", "            if (oiEq > bestOiEq) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.449584, "o", "                MarketData md = marketDataByContract.get(contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.449761, "o", "                if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.45007, "o", "                    throw new IllegalArgumentException(\"Missing market data for: \" + contract);\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.450321, "o", "                bestOiEq = oiEq;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.450682, "o", "                repSettlement = md.getSettlementPrice();\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.450819, "o", ">             }\r\n\u001b[?2004l\r"]
[151.450889, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[151.451031, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         return repSettlement;\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.451188, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.451392, "o", "    private BigDecimal computeSpreadCharge(Map<String, Integer> contractNetQty) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.451452, "o", "> "]
[151.45161, "o", "        BigDecimal total = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.451957, "o", "        for (Map.Entry<String, Integer> e : contractNetQty.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.452158, "o", "            String contract = e.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.45244, "o", "            int qty = e.getValue() == null ? 0 : e.getValue().intValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.452684, "o", "            if (qty == 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.452844, "o", "> "]
[151.452914, "o", "                continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.453096, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.453356, "o", "            MarketData md = marketDataByContract.get(contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.453518, "o", "            if (md == null) {\r\n\u001b[?2004l\r"]
[151.45358, "o", "\u001b[?2004h> "]
[151.453934, "o", "                throw new IllegalArgumentException(\"Missing market data for: \" + contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.45402, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.454262, "o", "            BigDecimal absQty = new BigDecimal(Integer.toString(Math.abs(qty)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.454537, "o", "            total = total.add(md.getIntraSpreadCharge().multiply(absQty));\r\n\u001b[?2004l\r"]
[151.454682, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.454816, "o", "> "]
[151.454916, "o", "        return total;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.45509, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.455402, "o", "    private Map<String, BigDecimal> computeUnrealizedPnlByAccount() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.455722, "o", "        Map<String, BigDecimal> map = new HashMap<String, BigDecimal>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.456055, "o", "        for (int i = 0; i < positions.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h>             Position p = positions.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.456332, "o", "            ContractSpec spec = contractSpecsByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.456485, "o", "            if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
