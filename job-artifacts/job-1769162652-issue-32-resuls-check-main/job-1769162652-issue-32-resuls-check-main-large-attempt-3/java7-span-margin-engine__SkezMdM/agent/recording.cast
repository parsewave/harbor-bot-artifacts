[150.859535, "i", "cat > /app/src/ContractSpec.java <<'EOF'\npublic final class ContractSpec {\n    private final String contractCode;\n    private final int multiplier;\n    private final String expiryMonth;\n    private final String underlying;\n\n    public ContractSpec(String contractCode, int multiplier, String expiryMonth, String underlying) {\n        this.contractCode = contractCode;\n        this.multiplier = multiplier;\n        this.expiryMonth = expiryMonth;\n        this.underlying = underlying;\n    }\n\n    public String getContractCode() {\n        return contractCode;\n    }\n\n    public int getMultiplier() {\n        return multiplier;\n    }\n\n    public String getExpiryMonth() {\n        return expiryMonth;\n    }\n\n    public String getUnderlying() {\n        return underlying;\n    }\n\n    public static ContractSpec parseCsv(String line) {\n        // Expected: contract_code, multiplier, expiry_month, underlying\n        String[] parts = line.split(\",\", -1);\n        if (parts.length < 4) {\n            throw new IllegalArgumentException(\"Invalid contract_specs row: \" + line);\n        }\n        String contractCode = parts[0].trim();\n        int multiplier = Integer.parseInt(parts[1].trim());\n        String expiryMonth = parts[2].trim();\n        String underlying = parts[3].trim();\n        return new ContractSpec(contractCode, multiplier, expiryMonth, underlying);\n    }\n}\nEOF\n"]
