[151.440472, "o", "                    maxScanFrac = BigDecimal.ZERO;\r\n\u001b[?2004l\re\u001b[?2004h> "]
[151.440666, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.441351, "o", "                BigDecimal repSettlement = findRepresentativeSettlementPrice(contractNetQty, underlying);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rl"]
[151.441433, "o", "\u001b[?2004h> "]
[151.44222, "o", "                BigDecimal risk = new BigDecimal(Long.toString(absNetDelta)).multiply(maxScanFrac).multiply(repSettlement);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.442463, "o", "                long riskTrunc = truncateToLong(risk);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.442668, "o", "                scanningRiskTotal += riskTrunc;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.442797, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.443069, "o", "            BigDecimal spreadChargeBd = computeSpreadCharge(contractNetQty);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.443427, "o", "            long spreadChargeTrunc = truncateToLong(spreadChargeBd);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.443777, "o", "            BigDecimal initialMarginBd = new BigDecimal(Long.toString(scanningRiskTotal)).add(spreadChargeBd);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.443981, "o", "            long initialMarginTrunc = truncateToLong(initialMarginBd);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.444164, "o", "            BigDecimal pnlBd = pnlByAccount.get(account);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.444332, "o", "            long unrealizedPnlTrunc = truncateToLong(pnlBd);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.444402, "o", "> "]
[151.44478, "o", "            String status = (unrealizedPnlTrunc >= initialMarginTrunc) ? \"ADEQUATE\" : \"CALL\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.444951, "o", "            AccountMargin am = new AccountMargin(account,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.445002, "o", "                    netDeltaExposureSumAbs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.445176, "o", "                    scanningRiskTotal,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.445295, "o", "                    spreadChargeTrunc,\r\n\u001b[?2004l\r\u001b[?2004h> "]
