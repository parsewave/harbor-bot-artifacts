[151.424448, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.424818, "o", "    private Map<String, BigDecimal> buildMaxScanningRangeFracByUnderlying() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.425192, "o", "        Map<String, BigDecimal> map = new HashMap<String, BigDecimal>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.425643, "o", "        for (Map.Entry<String, MarketData> e : marketDataByContract.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.425974, "o", "            String contract = e.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.426231, "o", "            MarketData md = e.getValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.42661, "o", "            ContractSpec spec = contractSpecsByContract.get(contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.426792, "o", "            if (spec == null) {\r\n\u001b[?2004l\rf (sp\u001b[?2004h> "]
[151.426988, "o", "                continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.427094, "o", "            }\r\n\u001b[?2004l\rue;\r\n\u001b[?2004h> "]
[151.427524, "o", "            String underlying = spec.getUnderlying();\r\n\u001b[?2004l\r"]
[151.427612, "o", "\u001b[?2004h> "]
[151.428035, "o", "            BigDecimal frac = md.getScanningRangePct().divide(new BigDecimal(\"100\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.428258, "o", "            BigDecimal prev = map.get(underlying);\r\n\u001b[?2004l\r"]
[151.42835, "o", "\u001b[?2004h> "]
[151.428617, "o", "            if (prev == null || frac.compareTo(prev) > 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.428887, "o", "                map.put(underlying, frac);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.428954, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.429085, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.429212, "o", "        return map;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.429309, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.429566, "o", "    private static long truncateToLong(BigDecimal value) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.429763, "o", "        if (value == null) {\r\n\u001b[?2004l\r   \u001b[?2004h> "]
[151.429936, "o", "            return 0L;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[151.430051, "o", "estO\u001b[?2004h> "]
[151.430276, "o", "        return value.setScale(0, RoundingMode.DOWN).longValue();\r\n\u001b[?2004l\r"]
[151.430325, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.430607, "o", "    public Map<String, AccountMargin> computeAllAccounts() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.431102, "o", "        // Accounts to include are those present in positions (via aggregator maps).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.431707, "o", "        Map<String, Map<String, Long> > accountUnderlyingNetDelta = aggregator.getAccountUnderlyingNetDelta();\r\n\u001b[?2004l\r\u001b[?2004h> "]
