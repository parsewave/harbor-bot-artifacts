[151.458564, "o", "            BigDecimal pnl = qty.multiply(mult).multiply(diff);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.458648, "o", "> "]
