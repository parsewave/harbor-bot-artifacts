[151.43241, "o", "> "]
[151.432787, "o", "        Map<String, BigDecimal> pnlByAccount = computeUnrealizedPnlByAccount();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.432923, "o", "\u001b[?2004h> "]
[151.433178, "o", "        Map<String, AccountMargin> result = new HashMap<String, AccountMargin>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.433746, "o", "        for (Map.Entry<String, Map<String, Long> > acctEntry : accountUnderlyingNetDelta.entrySet()) {\r\n\u001b[?2004l\r \u001b[?2004h> "]
[151.434014, "o", "            String account = acctEntry.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.434358, "o", "            Map<String, Long> underlyingNetDelta = acctEntry.getValue();\r\n\u001b[?2004l\radd\u001b[?2004h> "]
[151.434934, "o", "            Map<String, Integer> contractNetQty = accountContractNetQty.get(account);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.435189, "o", "            if (contractNetQty == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.435562, "o", "                contractNetQty = new HashMap<String, Integer>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.435724, "o", "            }\r\n\u001b[?2004l\r"]
[151.435898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h"]
[151.436005, "o", "> "]
[151.436114, "o", "            long netDeltaExposureSumAbs = 0L;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.436313, "o", "            long scanningRiskTotal = 0L;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.436368, "o", "\u001b[?2004h> "]
[151.436602, "o", "            // scanning risk per underlying\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[151.437032, "o", "            for (Map.Entry<String, Long> ue : underlyingNetDelta.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.437289, "o", "                String underlying = ue.getKey();\r\n\u001b[?2004l\re\u001b[?2004h> "]
[151.437896, "o", "                long netDelta = ue.getValue() == null ? 0L : ue.getValue().longValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.438196, "o", "                long absNetDelta = Math.abs(netDelta);\r\n\u001b[?2004l\r"]
[151.438247, "o", "\u001b[?2004h> "]
[151.438526, "o", "                netDeltaExposureSumAbs += absNetDelta;\r\n\u001b[?2004l\r"]
[151.438579, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[151.438806, "o", "                if (absNetDelta == 0L) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.438992, "o", "                    continue;\r\n\u001b[?2004l\r"]
[151.439117, "o", "\u001b[?2004h> "]
[151.439281, "o", "                }\r\n\u001b[?2004l\ract\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.439645, "o", "                BigDecimal maxScanFrac = maxScanningRangeFracByUnderlying.get(underlying);\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.439727, "o", "> "]
