[151.456869, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.457057, "o", "            MarketData md = marketDataByContract.get(p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.457202, "o", "            if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.457454, "o", "                throw new IllegalArgumentException(\"Missing market data for: \" + p.getContractCode());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.457533, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.457695, "o", "> "]
[151.457868, "o", "            BigDecimal qty = new BigDecimal(Integer.toString(p.getPositionQty()));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.458089, "o", "            BigDecimal mult = new BigDecimal(Integer.toString(spec.getMultiplier()));\r\n\u001b[?2004l\r\u001b[?2004h> "]
