[151.446556, "o", "    private BigDecimal findRepresentativeSettlementPrice(Map<String, Integer> contractNetQty, String underlying) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.446775, "o", "        BigDecimal repSettlement = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.446903, "o", "        long bestOiEq = -1L;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.447172, "o", "        for (Map.Entry<String, Integer> e : contractNetQty.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
