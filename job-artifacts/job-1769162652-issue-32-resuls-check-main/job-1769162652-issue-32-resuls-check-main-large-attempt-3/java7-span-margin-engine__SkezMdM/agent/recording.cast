[151.613824, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.File;\nimport java.io.FileReader;\nimport java.io.FileWriter;\nimport java.io.IOException;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class Main {\n    public static void main(String[] args) throws Exception {\n        if (args == null || args.length != 4) {\n            throw new IllegalArgumentException(\"Expected 4 args: positions_path market_data_path contract_specs_path output_path\");\n        }\n\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> marketData = loadMarketData(marketDataPath);\n        Map<String, ContractSpec> contractSpecs = loadContractSpecs(contractSpecsPath);\n\n        PositionAggregator aggregator = new PositionAggregator(positions, contractSpecs);\n        MarginCalculator calculator = new MarginCalculator(positions, aggregator, marketData, contractSpecs);\n\n        Map<String, AccountMargin> marginsByAccount = calculator.computeAllAccounts();\n\n        List<String> accounts = new ArrayList<String>(marginsByAccount.keySet());\n        Collections.sort(accounts);\n\n        writeOutput(outputPath, accounts, marginsByAccount);\n    }\n\n    private static List<Position> loadPositions(String path) throws IOException {\n        List<Position> list = new ArrayList<Position>();\n        BufferedReader br = new BufferedReader(new FileReader(new File(path)));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    if (line.startsWith(\"account_id\")) {\n                        continue;\n                    }\n                }\n                list.add(Position.parseCsv(line));\n            }\n        } finally {\n            br.close();\n        }\n        return list;\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws IOException {\n        Map<String, MarketData> map = new HashMap<String, MarketData>();\n        BufferedReader br = new BufferedReader(new FileReader(new File(path)));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    if (line.startsWith(\"contract_code\")) {\n                        continue;\n                    }\n                }\n                MarketData md = MarketData.parseCsv(line);\n                map.put(md.getContractCode(), md);\n            }\n        } finally {\n            br.close();\n        }\n        return map;\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws IOException {\n        Map<String, ContractSpec> map = new HashMap<String, ContractSpec>();\n        BufferedReader br = new BufferedReader(new FileReader(new File(path)));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    if (line.startsWith(\"contract_code\")) {\n                        continue;\n                    }\n                }\n                ContractSpec cs = ContractSpec.parseCsv(line);\n                map.put(cs.getContractCode(), cs);\n            }\n        } finally {\n            br.close();\n        }\n        return map;"]
[151.61394, "i", "\n    }\n\n    private static void writeOutput(String outputPath, List<String> accounts, Map<String, AccountMargin> marginsByAccount) throws IOException {\n        BufferedWriter bw = new BufferedWriter(new FileWriter(new File(outputPath)));\n        try {\n            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\n            bw.newLine();\n            for (int i = 0; i < accounts.size(); i++) {\n                String acct = accounts.get(i);\n                AccountMargin am = marginsByAccount.get(acct);\n                bw.write(am.toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            bw.close();\n        }\n    }\n}\nEOF\n"]
