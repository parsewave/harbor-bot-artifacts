[151.421002, "o", "    private final Map<String, BigDecimal> maxScanningRangeFracByUnderlying;\r\n\u001b[?2004l\ratu\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.421322, "o", "    public MarginCalculator(List<Position> positions,\r\n\u001b[?2004l\r\u001b[?2004h> "]
