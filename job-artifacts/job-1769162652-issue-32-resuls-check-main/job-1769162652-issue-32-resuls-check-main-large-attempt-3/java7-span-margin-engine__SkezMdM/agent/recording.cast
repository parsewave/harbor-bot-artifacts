[151.040263, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class PositionAggregator {\n    private final Map<String, Map<String, Integer> > accountContractNetQty;\n    private final Map<String, Map<String, Long> > accountUnderlyingNetDelta;\n\n    public PositionAggregator(List<Position> positions, Map<String, ContractSpec> contractSpecs) {\n        this.accountContractNetQty = new HashMap<String, Map<String, Integer> >();\n        this.accountUnderlyingNetDelta = new HashMap<String, Map<String, Long> >();\n        aggregate(positions, contractSpecs);\n    }\n\n    private void aggregate(List<Position> positions, Map<String, ContractSpec> contractSpecs) {\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = contractSpecs.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for: \" + p.getContractCode());\n            }\n            String account = p.getAccountId();\n            String contract = p.getContractCode();\n            String underlying = spec.getUnderlying();\n\n            // Net contract quantity per account\n            Map<String, Integer> contractMap = accountContractNetQty.get(account);\n            if (contractMap == null) {\n                contractMap = new HashMap<String, Integer>();\n                accountContractNetQty.put(account, contractMap);\n            }\n            Integer prevQty = contractMap.get(contract);\n            int newQty = (prevQty == null ? 0 : prevQty.intValue()) + p.getPositionQty();\n            contractMap.put(contract, Integer.valueOf(newQty));\n\n            // Net delta exposure per account-underlying (qty * multiplier)\n            Map<String, Long> underlyingMap = accountUnderlyingNetDelta.get(account);\n            if (underlyingMap == null) {\n                underlyingMap = new HashMap<String, Long>();\n                accountUnderlyingNetDelta.put(account, underlyingMap);\n            }\n            Long prevDelta = underlyingMap.get(underlying);\n            long deltaChange = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());\n            long newDelta = (prevDelta == null ? 0L : prevDelta.longValue()) + deltaChange;\n            underlyingMap.put(underlying, Long.valueOf(newDelta));\n        }\n    }\n\n    public Map<String, Map<String, Integer> > getAccountContractNetQty() {\n        return accountContractNetQty;\n    }\n\n    public Map<String, Map<String, Long> > getAccountUnderlyingNetDelta() {\n        return accountUnderlyingNetDelta;\n    }\n}\nEOF\n"]
