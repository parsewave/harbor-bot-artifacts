[151.417433, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class MarginCalculator {\n    private final List<Position> positions;\n    private final PositionAggregator aggregator;\n    private final Map<String, MarketData> marketDataByContract;\n    private final Map<String, ContractSpec> contractSpecsByContract;\n    private final Map<String, BigDecimal> maxScanningRangeFracByUnderlying;\n\n    public MarginCalculator(List<Position> positions,\n                            PositionAggregator aggregator,\n                            Map<String, MarketData> marketDataByContract,\n                            Map<String, ContractSpec> contractSpecsByContract) {\n        this.positions = positions;\n        this.aggregator = aggregator;\n        this.marketDataByContract = marketDataByContract;\n        this.contractSpecsByContract = contractSpecsByContract;\n        this.maxScanningRangeFracByUnderlying = buildMaxScanningRangeFracByUnderlying();\n    }\n\n    private Map<String, BigDecimal> buildMaxScanningRangeFracByUnderlying() {\n        Map<String, BigDecimal> map = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, MarketData> e : marketDataByContract.entrySet()) {\n            String contract = e.getKey();\n            MarketData md = e.getValue();\n            ContractSpec spec = contractSpecsByContract.get(contract);\n            if (spec == null) {\n                continue;\n            }\n            String underlying = spec.getUnderlying();\n            BigDecimal frac = md.getScanningRangePct().divide(new BigDecimal(\"100\"));\n            BigDecimal prev = map.get(underlying);\n            if (prev == null || frac.compareTo(prev) > 0) {\n                map.put(underlying, frac);\n            }\n        }\n        return map;\n    }\n\n    private static long truncateToLong(BigDecimal value) {\n        if (value == null) {\n            return 0L;\n        }\n        return value.setScale(0, RoundingMode.DOWN).longValue();\n    }\n\n    public Map<String, AccountMargin> computeAllAccounts() {\n        // Accounts to include are those present in positions (via aggregator maps).\n        Map<String, Map<String, Long> > accountUnderlyingNetDelta = aggregator.getAccountUnderlyingNetDelta();\n        Map<String, Map<String, Integer> > accountContractNetQty = aggregator.getAccountContractNetQty();\n\n        Map<String, BigDecimal> pnlByAccount = computeUnrealizedPnlByAccount();\n\n        Map<String, AccountMargin> result = new HashMap<String, AccountMargin>();\n        for (Map.Entry<String, Map<String, Long> > acctEntry : accountUnderlyingNetDelta.entrySet()) {\n            String account = acctEntry.getKey();\n            Map<String, Long> underlyingNetDelta = acctEntry.getValue();\n            Map<String, Integer> contractNetQty = accountContractNetQty.get(account);\n            if (contractNetQty == null) {\n                contractNetQty = new HashMap<String, Integer>();\n            }\n\n            long netDeltaExposureSumAbs = 0L;\n            long scanningRiskTotal = 0L;\n\n            // scanning risk per underlying\n            for (Map.Entry<String, Long> ue : underlyingNetDelta.entrySet()) {\n                String underlying = ue.getKey();\n                long netDelta = ue.getValue() == null ? 0L : ue.getValue().longValue();\n                long absNetDelta = Math.abs(netDelta);\n                netDeltaExposureSumAbs += absNetDelta;\n\n                if (absNetDelta == 0L) {\n                    continue;\n                }\n\n                BigDecimal maxScanFrac = maxScanningRangeFracByUnderlying.get(underlying);\n                if (maxScanFrac == null) {\n                    maxScanFrac = BigDecimal.ZERO;\n                }\n\n                BigDecimal repSettlement = findRepresentativeSettlementPrice(contractNetQty, underlying);\n\n                BigDecimal risk = new BigDecimal(Long.toString(absNetDelta)).multiply(maxScanFrac).multiply(repSettlement);\n                long riskTrunc = truncateToLong(risk);\n                scan"]
[151.417558, "i", "ningRiskTotal += riskTrunc;\n            }\n\n            BigDecimal spreadChargeBd = computeSpreadCharge(contractNetQty);\n            long spreadChargeTrunc = truncateToLong(spreadChargeBd);\n\n            BigDecimal initialMarginBd = new BigDecimal(Long.toString(scanningRiskTotal)).add(spreadChargeBd);\n            long initialMarginTrunc = truncateToLong(initialMarginBd);\n\n            BigDecimal pnlBd = pnlByAccount.get(account);\n            long unrealizedPnlTrunc = truncateToLong(pnlBd);\n\n            String status = (unrealizedPnlTrunc >= initialMarginTrunc) ? \"ADEQUATE\" : \"CALL\";\n\n            AccountMargin am = new AccountMargin(account,\n                    netDeltaExposureSumAbs,\n                    scanningRiskTotal,\n                    spreadChargeTrunc,\n                    initialMarginTrunc,\n                    unrealizedPnlTrunc,\n                    status);\n            result.put(account, am);\n        }\n\n        return result;\n    }\n\n    private BigDecimal findRepresentativeSettlementPrice(Map<String, Integer> contractNetQty, String underlying) {\n        BigDecimal repSettlement = BigDecimal.ZERO;\n        long bestOiEq = -1L;\n\n        for (Map.Entry<String, Integer> e : contractNetQty.entrySet()) {\n            String contract = e.getKey();\n            int qty = e.getValue() == null ? 0 : e.getValue().intValue();\n            if (qty == 0) {\n                continue;\n            }\n            ContractSpec spec = contractSpecsByContract.get(contract);\n            if (spec == null) {\n                continue;\n            }\n            if (!underlying.equals(spec.getUnderlying())) {\n                continue;\n            }\n            long oiEq = ((long) Math.abs(qty)) * ((long) spec.getMultiplier());\n            if (oiEq > bestOiEq) {\n                MarketData md = marketDataByContract.get(contract);\n                if (md == null) {\n                    throw new IllegalArgumentException(\"Missing market data for: \" + contract);\n                }\n                bestOiEq = oiEq;\n                repSettlement = md.getSettlementPrice();\n            }\n        }\n\n        return repSettlement;\n    }\n\n    private BigDecimal computeSpreadCharge(Map<String, Integer> contractNetQty) {\n        BigDecimal total = BigDecimal.ZERO;\n        for (Map.Entry<String, Integer> e : contractNetQty.entrySet()) {\n            String contract = e.getKey();\n            int qty = e.getValue() == null ? 0 : e.getValue().intValue();\n            if (qty == 0) {\n                continue;\n            }\n            MarketData md = marketDataByContract.get(contract);\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for: \" + contract);\n            }\n            BigDecimal absQty = new BigDecimal(Integer.toString(Math.abs(qty)));\n            total = total.add(md.getIntraSpreadCharge().multiply(absQty));\n        }\n        return total;\n    }\n\n    private Map<String, BigDecimal> computeUnrealizedPnlByAccount() {\n        Map<String, BigDecimal> map = new HashMap<String, BigDecimal>();\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = contractSpecsByContract.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for: \" + p.getContractCode());\n            }\n            MarketData md = marketDataByContract.get(p.getContractCode());\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for: \" + p.getContractCode());\n            }\n\n            BigDecimal qty = new BigDecimal(Integer.toString(p.getPositionQty()));\n            BigDecimal mult = new BigDecimal(Integer.toString(spec.getMultiplier()));\n            BigDecimal diff = md.getSettlementPrice().subtract(p.getEntryPrice());\n            BigDecimal pnl = qty.multiply(mult).multiply(diff);\n\n            BigDecimal prev = map.get(p.getAccountId());\n            if (prev == null) {\n                prev = BigDecimal.ZERO;\n            }\n            map.put(p.getAc"]
[151.417826, "i", "countId(), prev.add(pnl));\n        }\n        return map;\n    }\n}\nEOF\n"]
