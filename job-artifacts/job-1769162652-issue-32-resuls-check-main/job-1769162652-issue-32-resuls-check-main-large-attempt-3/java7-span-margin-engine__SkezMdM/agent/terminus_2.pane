[?2004l[?2004h> 
[?2004l[?2004h> public final class PositionAggregator {
[?2004l[?2004h>     private final Map<String, Map<String, Integer> > accountContractNetQty;
[?2004l[?2004h>     private final Map<String, Map<String, Long> > accountUnderlyingNetDelta;
[?2004l[?2004h> 
[?2004l[?2004h>     public PositionAggregator(List<Position> positions, Map<String, ContractSpec> contractSpecs) {
[?2004l[?2004h>         this.accountContractNetQty = new HashMap<String, Map<String, Integer> >();
[?2004l[?2004h>         this.accountUnderlyingNetDelta = new HashMap<String, Map<String, Long> >();
[?2004l[?2004h>         aggregate(positions, contractSpecs);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private void aggregate(List<Position> positions, Map<String, ContractSpec> contractSpecs) {
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position p = positions.get(i);
[?2004l[?2004h>             ContractSpec spec = contractSpecs.get(p.getContractCode());
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing contract spec for: " + p.getContractCode());
[?2004l[?2004h>             }
[?2004l[?2004h>             String account = p.getAccountId();
[?2004l[?2004h>             String contract = p.getContractCode();
[?2004l[?2004h>             String underlying = spec.getUnderlying();
[?2004l[?2004h> 
[?2004l[?2004h>             // Net contract quantity per account
[?2004l[?2004h>             Map<String, Integer> contractMap = accountContractNetQty.get(account);
[?2004l[?2004h>             if (contractMap == null) {
[?2004l[?2004h>                 contractMap = new HashMap<String, Integer>();
[?2004l[?2004h>                 accountContractNetQty.put(account, contractMap);
[?2004l[?2004h>             }
[?2004l[?2004h>             Integer prevQty = contractMap.get(contract);
[?2004l[?2004h>             int newQty = (prevQty == null ? 0 : prevQty.intValue()) + p.getPositionQty();
[?2004l[?2004h>             contractMap.put(contract, Integer.valueOf(newQty));
[?2004l[?2004h> 
[?2004l[?2004h>             // Net delta exposure per account-underlying (qty * multiplier)
[?2004l[?2004h>             Map<String, Long> underlyingMap = accountUnderlyingNetDelta.get(account);
[?2004l[?2004h>             if (underlyingMap == null) {
[?2004l[?2004h>                 underlyingMap = new HashMap<String, Long>();
[?2004l[?2004h>                 accountUnderlyingNetDelta.put(account, underlyingMap);
[?2004l[?2004h>             }
[?2004l[?2004h>             Long prevDelta = underlyingMap.get(underlying);
[?2004l[?2004h>             long deltaChange = ((long) p.getPositionQty()) * ((long) spec.getMultiplier());
[?2004l[?2004h>             long newDelta = (prevDelta == null ? 0L : prevDelta.longValue()) + deltaChange;
[?2004l[?2004h>             underlyingMap.put(underlying, Long.valueOf(newDelta));
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public Map<String, Map<String, Integer> > getAccountContractNetQty() {
[?2004l[?2004h>         return accountContractNetQty;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public Map<String, Map<String, Long> > getAccountUnderlyingNetDelta() {
[?2004l[?2004h>         return accountUnderlyingNetDelta;
[?2004l[?2004h>     }
[?2004l[?2004h> }
