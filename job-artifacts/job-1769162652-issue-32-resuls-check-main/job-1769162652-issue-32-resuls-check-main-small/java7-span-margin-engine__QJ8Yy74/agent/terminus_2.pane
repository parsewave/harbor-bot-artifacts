[?2004l[?2004h> package src;
[?2004l[?2004h> 
[?2004l[?2004h> import java.util.*;
[?2004lp[?2004h> 
[?2004lo[?2004h> public class MarginCalculator {
[?2004l [?2004h>     public static class AccountResult {
[?2004l[?2004h>         public String accountId;
[?2004l[?2004h>         public long netDeltaExposure;
[?2004l[?2004h>         public long scanningRisk;
[?2004lxp[?2004h>         public long spreadCharge;
[?2004l[?2004h>         public long initialMargin;
[?2004l[?2004h>         public long unrealizedPnl;
[?2004l[?2004h>         public String marginStatus;
[?2004li[?2004h>     }
[?2004lnitial[?2004h> 
[?2004l[?2004h>     public static List<AccountResult> calculate(List<Position> positions,
[?2004l[?2004h>                                                 Map<String, MarketData> marketMap,
[?2004l[?2004h>                                                 Map<String, ContractSpec> specMap) {
[?2004l[?2004h>         Map<String, Map<String, Long>> netDeltaMap = PositionAggregator.aggregateNetDelta(positions, specMap);
[?2004l[?2004h>         Map<String, Map<String, List<Position>>> grouped = PositionAggregator.groupByAccountAndUnderlying(positions, specMap);
[?2004l [?2004h>         Set<String> accounts = new HashSet<String>();
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             accounts.add(p.accountId);
[?2004l[?2004h>         }
[?2004l[?2004h>         List<AccountResult> results = new ArrayList<AccountResult>();
[?2004l[?2004h>         for (String account : accounts) {
[?2004l[?2004h>             AccountResult ar = new AccountResult();
[?2004l[?2004h>             ar.accountId = account;
[?2004l[?2004h>             long totalNetDeltaAbs = 0L;
[?2004l[?2004h>             long totalScanningRisk = 0L;
[?2004l[?2004h>             long totalSpreadCharge = 0L;
[?2004l[?2004h>             long totalUnrealizedPnl = 0L;
[?2004l[?2004h>             Map<String, Long> underDelta = netDeltaMap.get(account);
[?2004l[?2004h>             Map<String, List<Position>> underPos = grouped.get(account);
[?2004l[?2004h>             if (underDelta != null) {
[?2004l[?2004h>                 for (Map.Entry<String, Long> entry : underDelta.entrySet()) {
[?2004l[?2004h>                     String underlying = entry.getKey();
[?2004l[?2004h>                     long netDelta = entry.getValue();
[?2004l[?2004h>                     totalNetDeltaAbs += Math.abs(netDelta);
[?2004l[?2004h>                     double maxScanningRange = 0.0;
[?2004l[?2004h>                     double repSettlementPrice = 0.0;
[?2004l[?2004h>                     long maxOi = Long.MIN_VALUE;
[?2004l[?2004h>                     List<Position> posList = underPos != null ? underPos.get(underlying) : null;
[?2004l[?2004h>                     if (posList != null) {
[?2004l[?2004h>                         for (Position pos : posList) {
[?2004l[?2004h>                             ContractSpec spec = specMap.get(pos.contractCode);
[?2004l[?2004h>                             MarketData md = marketMap.get(pos.contractCode);
[?2004l[?2004h>                             if (spec == null || md == null) continue;
[?2004l[?2004h>                             if (md.scanningRange > maxScanningRange) {
[?2004l[?2004h>                                 maxScanningRange = md.scanningRange;
[?2004l[?2004h>                             }
[?2004l[?2004h>                             long oi = Math.abs((long) pos.positionQty * spec.multiplier);
[?2004l[?2004h>                             if (oi > maxOi) {
[?2004l[?2004h>                                 maxOi = oi;
[?2004l[?2004h>                                 repSettlementPrice = md.settlementPrice;
[?2004l[?2004h>                             }
[?2004l[?2004h>                         }
[?2004l[?2004h>                     }
[?2004l[?2004h>                     double rangeFactor = maxScanningRange / 100.0;
[?2004l[?2004h>                     double risk = Math.abs(netDelta) * rangeFactor * repSettlementPrice;
[?2004l[?2004h>                     long riskTrunc = (long) risk; // truncate toward zero
[?2004l[?2004h>                     totalScanningRisk += riskTrunc;
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>             // Spread charge
[?2004l[?2004h>             if (underPos != null) {
[?2004l[?2004h>                 for (List<Position> posList : underPos.values()) {
[?2004l[?2004h>                     for (Position pos : posList) {
[?2004l[?2004h>                         MarketData md = marketMap.get(pos.contractCode);
[?2004l[?2004h>                         if (md == null) continue;
[?2004l[?2004h>                         totalSpreadCharge += (long) (md.intraSpreadCharge * Math.abs(pos.positionQty));
[?2004l[?2004h>                     }
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>             // Unrealized PnL
[?2004l[?2004h>             if (underPos != null) {
[?2004l[?2004h>                 for (List<Position> posList : underPos.values()) {
[?2004l[?2004h>                     for (Position pos : posList) {
[?2004l[?2004h>                         ContractSpec spec = specMap.get(pos.contractCode);
[?2004l[?2004h>                         MarketData md = marketMap.get(pos.contractCode);
[?2004l[?2004h>                         if (spec == null || md == null) continue;
[?2004l[?2004h>                         double pnl = (double) pos.positionQty * spec.multiplier * (md.settlementPrice - pos.entryPrice);
[?2004l[?2004h>                         totalUnrealizedPnl += (long) pnl; // truncate toward zero
[?2004l[?2004h>                     }
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>             ar.netDeltaExposure = totalNetDeltaAbs;
[?2004l[?2004h>             ar.scanningRisk = totalScanningRisk;
[?2004l[?2004h>             ar.spreadCharge = totalSpreadCharge;
[?2004l[?2004h>             ar.initialMargin = totalScanningRisk + totalSpreadCharge;
[?2004l[?2004h>             ar.unrealizedPnl = totalUnrealizedPnl;
[?2004l[?2004h>             ar.marginStatus = (totalUnrealizedPnl >= ar.initialMargin) ? "ADEQUATE" : "CALL";
[?2004l[?2004h>             results.add(ar);
[?2004l[?2004h>         }
[?2004l[?2004h>         Collections.sort(results, new Comparator<AccountResult>() {
[?2004l[?2004h>             public int compare(AccountResult a1, AccountResult a2) {
[?2004l[?2004h>                 return a1.accountId.compareTo(a2.accountId);
[?2004l[?2004h>             }
[?2004l[?2004h>         });
[?2004l[?2004h>         return results;
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> EOF
