[?2004l[?2004h> package src;
[?2004l[?2004h> 
[?2004l[?2004h> import java.util.*;
[?2004l[?2004h> 
[?2004l[?2004h> public class PositionAggregator {
[?2004l[?2004h>     public static Map<String, Map<String, Long>> aggregateNetDelta(List<Position> positions, Map<String, ContractSpec> specMap) {
[?2004l[?2004h>         Map<String, Map<String, Long>> result = new HashMap<String, Map<String, Long>>();
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             ContractSpec spec = specMap.get(p.contractCode);
[?2004l[?2004h>             if (spec == null) continue;
[?2004l[?2004h>             long delta = (long) p.positionQty * spec.multiplier;
[?2004l[?2004h>             Map<String, Long> underMap = result.get(p.accountId);
[?2004l[?2004h>             if (underMap == null) {
[?2004l[?2004h>                 underMap = new HashMap<String, Long>();
[?2004l[?2004h>                 result.put(p.accountId, underMap);
[?2004l[?2004h>             }
[?2004l[?2004h>             Long existing = underMap.get(spec.underlying);
[?2004l[?2004h>             underMap.put(spec.underlying, (existing == null ? delta : existing + delta));
[?2004l[?2004h>         }
[?2004l[?2004h>         return result;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public static Map<String, Map<String, List<Position>>> groupByAccountAndUnderlying(List<Position> positions, Map<String, ContractSpec> specMap) {
[?2004l[?2004h>         Map<String, Map<String, List<Position>>> result = new HashMap<String, Map<String, List<Position>>>();
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             ContractSpec spec = specMap.get(p.contractCode);
[?2004l[?2004h>             if (spec == null) continue;
[?2004l[?2004h>             Map<String, List<Position>> underMap = result.get(p.accountId);
[?2004l[?2004h>             if (underMap == null) {
[?2004l[?2004h>                 underMap = new HashMap<String, List<Position>>();
[?2004l[?2004h>                 result.put(p.accountId, underMap);
[?2004l[?2004h>             }
[?2004l[?2004h>             List<Position> list = underMap.get(spec.underlying);
[?2004l[?2004h>             if (list == null) {
[?2004l[?2004h>                 list = new ArrayList<Position>();
[?2004l[?2004h>                 underMap.put(spec.underlying, list);
[?2004l[?2004h>             }
[?2004l[?2004h>             list.add(p);
[?2004l[?2004h>         }
[?2004l[?2004h>         return result;
[?2004l[?2004h>     }
[?2004l[?2004h> }
