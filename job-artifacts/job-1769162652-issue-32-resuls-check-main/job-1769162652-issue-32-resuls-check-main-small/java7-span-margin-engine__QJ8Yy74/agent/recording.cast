[119.023943, "o", "\u001b[?2004hroot@20dec917f55b:/app# "]
[119.521247, "i", "cat > /app/src/Main.java <<'EOF'\npackage src;\n\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 4) {\n            System.err.println(\"Usage: java Main <positions> <market_data> <contract_specs> <output>\");\n            System.exit(1);\n        }\n        String positionsPath = args[0];\n        String marketPath = args[1];\n        String specsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> marketMap = loadMarketData(marketPath);\n        Map<String, ContractSpec> specMap = loadSpecs(specsPath);\n\n        List<MarginCalculator.AccountResult> results = MarginCalculator.calculate(positions, marketMap, specMap);\n\n        writeOutput(outputPath, results);\n    }\n\n    private static List<Position> loadPositions(String path) throws IOException {\n        List<Position> list = new ArrayList<Position>();\n        BufferedReader br = new BufferedReader(new FileReader(path));\n        String line;\n        while ((line = br.readLine()) != null) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            if (line.startsWith(\"account_id\")) continue;\n            list.add(Position.parse(line));\n        }\n        br.close();\n        return list;\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws IOException {\n        Map<String, MarketData> map = new HashMap<String, MarketData>();\n        BufferedReader br = new BufferedReader(new FileReader(path));\n        String line;\n        while ((line = br.readLine()) != null) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            if (line.startsWith(\"contract_code\")) continue;\n            MarketData md = MarketData.parse(line);\n            map.put(md.contractCode, md);\n        }\n        br.close();\n        return map;\n    }\n\n    private static Map<String, ContractSpec> loadSpecs(String path) throws IOException {\n        Map<String, ContractSpec> map = new HashMap<String, ContractSpec>();\n        BufferedReader br = new BufferedReader(new FileReader(path));\n        String line;\n        while ((line = br.readLine()) != null) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            if (line.startsWith(\"contract_code\")) continue;\n            ContractSpec cs = ContractSpec.parse(line);\n            map.put(cs.contractCode, cs);\n        }\n        br.close();\n        return map;\n    }\n\n    private static void writeOutput(String path, List<MarginCalculator.AccountResult> results) throws IOException {\n        BufferedWriter bw = new BufferedWriter(new FileWriter(path));\n        bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\\n\");\n        for (MarginCalculator.AccountResult ar : results) {\n            bw.write(ar.accountId + \",\" + ar.netDeltaExposure + \",\" + ar.scanningRisk + \",\" + ar.spreadCharge + \",\" + ar.initialMargin + \",\" + ar.unrealizedPnl + \",\" + ar.marginStatus + \"\\n\");\n        }\n        bw.flush();\n        bw.close();\n    }\n}\nEOF\n"]
