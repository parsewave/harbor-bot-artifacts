[118.01818, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\npackage src;\n\nimport java.util.*;\n\npublic class PositionAggregator {\n    public static Map<String, Map<String, Long>> aggregateNetDelta(List<Position> positions, Map<String, ContractSpec> specMap) {\n        Map<String, Map<String, Long>> result = new HashMap<String, Map<String, Long>>();\n        for (Position p : positions) {\n            ContractSpec spec = specMap.get(p.contractCode);\n            if (spec == null) continue;\n            long delta = (long) p.positionQty * spec.multiplier;\n            Map<String, Long> underMap = result.get(p.accountId);\n            if (underMap == null) {\n                underMap = new HashMap<String, Long>();\n                result.put(p.accountId, underMap);\n            }\n            Long existing = underMap.get(spec.underlying);\n            underMap.put(spec.underlying, (existing == null ? delta : existing + delta));\n        }\n        return result;\n    }\n\n    public static Map<String, Map<String, List<Position>>> groupByAccountAndUnderlying(List<Position> positions, Map<String, ContractSpec> specMap) {\n        Map<String, Map<String, List<Position>>> result = new HashMap<String, Map<String, List<Position>>>();\n        for (Position p : positions) {\n            ContractSpec spec = specMap.get(p.contractCode);\n            if (spec == null) continue;\n            Map<String, List<Position>> underMap = result.get(p.accountId);\n            if (underMap == null) {\n                underMap = new HashMap<String, List<Position>>();\n                result.put(p.accountId, underMap);\n            }\n            List<Position> list = underMap.get(spec.underlying);\n            if (list == null) {\n                list = new ArrayList<Position>();\n                underMap.put(spec.underlying, list);\n            }\n            list.add(p);\n        }\n        return result;\n    }\n}\nEOF\n"]
