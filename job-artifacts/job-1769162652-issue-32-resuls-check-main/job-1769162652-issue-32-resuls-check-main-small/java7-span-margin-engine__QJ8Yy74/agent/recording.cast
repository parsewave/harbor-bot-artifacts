[116.501167, "i", "cat > /app/src/Position.java <<'EOF'\npackage src;\n\npublic class Position {\n    public String accountId;\n    public String contractCode;\n    public int positionQty;\n    public double entryPrice;\n\n    public Position(String accountId, String contractCode, int positionQty, double entryPrice) {\n        this.accountId = accountId;\n        this.contractCode = contractCode;\n        this.positionQty = positionQty;\n        this.entryPrice = entryPrice;\n    }\n\n    public static Position parse(String line) {\n        String[] parts = line.split(\",\");\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid position line: \" + line);\n        }\n        String accountId = parts[0].trim();\n        String contractCode = parts[1].trim();\n        int qty = Integer.parseInt(parts[2].trim());\n        double price = Double.parseDouble(parts[3].trim());\n        return new Position(accountId, contractCode, qty, price);\n    }\n}\nEOF\n"]
