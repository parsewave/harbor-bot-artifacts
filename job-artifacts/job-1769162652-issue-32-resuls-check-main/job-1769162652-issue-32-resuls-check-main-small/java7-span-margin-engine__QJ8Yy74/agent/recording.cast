[119.016273, "i", "cat > /app/src/AccountMargin.java <<'EOF'\npackage src;\n\npublic class AccountMargin {\n    public String accountId;\n    public long netDeltaExposure;\n    public long scanningRisk;\n    public long spreadCharge;\n    public long initialMargin;\n    public long unrealizedPnl;\n    public String marginStatus;\n\n    public AccountMargin(String accountId, long netDeltaExposure, long scanningRisk, long spreadCharge, long initialMargin, long unrealizedPnl, String marginStatus) {\n        this.accountId = accountId;\n        this.netDeltaExposure = netDeltaExposure;\n        this.scanningRisk = scanningRisk;\n        this.spreadCharge = spreadCharge;\n        this.initialMargin = initialMargin;\n        this.unrealizedPnl = unrealizedPnl;\n        this.marginStatus = marginStatus;\n    }\n\n    public String toCsv() {\n        return accountId + \",\" + netDeltaExposure + \",\" + scanningRisk + \",\" + spreadCharge + \",\" + initialMargin + \",\" + unrealizedPnl + \",\" + marginStatus;\n    }\n}\nEOF\n"]
