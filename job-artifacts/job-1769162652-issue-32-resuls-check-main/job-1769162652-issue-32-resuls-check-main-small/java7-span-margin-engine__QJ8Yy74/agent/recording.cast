[117.039091, "i", "cat > /app/src/MarketData.java <<'EOF'\npackage src;\n\npublic class MarketData {\n    public String contractCode;\n    public double settlementPrice;\n    public double scanningRange; // percent, e.g., 5.0 for 5%\n    public double intraSpreadCharge;\n\n    public MarketData(String contractCode, double settlementPrice, double scanningRange, double intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRange = scanningRange;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public static MarketData parse(String line) {\n        String[] parts = line.split(\",\");\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid market data line: \" + line);\n        }\n        String code = parts[0].trim();\n        double settlement = Double.parseDouble(parts[1].trim());\n        double range = Double.parseDouble(parts[2].trim());\n        double charge = Double.parseDouble(parts[3].trim());\n        return new MarketData(code, settlement, range, charge);\n    }\n}\nEOF\n"]
