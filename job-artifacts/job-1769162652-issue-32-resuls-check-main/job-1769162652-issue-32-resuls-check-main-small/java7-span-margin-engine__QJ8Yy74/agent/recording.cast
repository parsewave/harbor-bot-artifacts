[118.514313, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\npackage src;\n\nimport java.util.*;\n\npublic class MarginCalculator {\n    public static class AccountResult {\n        public String accountId;\n        public long netDeltaExposure;\n        public long scanningRisk;\n        public long spreadCharge;\n        public long initialMargin;\n        public long unrealizedPnl;\n        public String marginStatus;\n    }\n\n    public static List<AccountResult> calculate(List<Position> positions,\n                                                Map<String, MarketData> marketMap,\n                                                Map<String, ContractSpec> specMap) {\n        Map<String, Map<String, Long>> netDeltaMap = PositionAggregator.aggregateNetDelta(positions, specMap);\n        Map<String, Map<String, List<Position>>> grouped = PositionAggregator.groupByAccountAndUnderlying(positions, specMap);\n        Set<String> accounts = new HashSet<String>();\n        for (Position p : positions) {\n            accounts.add(p.accountId);\n        }\n        List<AccountResult> results = new ArrayList<AccountResult>();\n        for (String account : accounts) {\n            AccountResult ar = new AccountResult();\n            ar.accountId = account;\n            long totalNetDeltaAbs = 0L;\n            long totalScanningRisk = 0L;\n            long totalSpreadCharge = 0L;\n            long totalUnrealizedPnl = 0L;\n            Map<String, Long> underDelta = netDeltaMap.get(account);\n            Map<String, List<Position>> underPos = grouped.get(account);\n            if (underDelta != null) {\n                for (Map.Entry<String, Long> entry : underDelta.entrySet()) {\n                    String underlying = entry.getKey();\n                    long netDelta = entry.getValue();\n                    totalNetDeltaAbs += Math.abs(netDelta);\n                    double maxScanningRange = 0.0;\n                    double repSettlementPrice = 0.0;\n                    long maxOi = Long.MIN_VALUE;\n                    List<Position> posList = underPos != null ? underPos.get(underlying) : null;\n                    if (posList != null) {\n                        for (Position pos : posList) {\n                            ContractSpec spec = specMap.get(pos.contractCode);\n                            MarketData md = marketMap.get(pos.contractCode);\n                            if (spec == null || md == null) continue;\n                            if (md.scanningRange > maxScanningRange) {\n                                maxScanningRange = md.scanningRange;\n                            }\n                            long oi = Math.abs((long) pos.positionQty * spec.multiplier);\n                            if (oi > maxOi) {\n                                maxOi = oi;\n                                repSettlementPrice = md.settlementPrice;\n                            }\n                        }\n                    }\n                    double rangeFactor = maxScanningRange / 100.0;\n                    double risk = Math.abs(netDelta) * rangeFactor * repSettlementPrice;\n                    long riskTrunc = (long) risk; // truncate toward zero\n                    totalScanningRisk += riskTrunc;\n                }\n            }\n            // Spread charge\n            if (underPos != null) {\n                for (List<Position> posList : underPos.values()) {\n                    for (Position pos : posList) {\n                        MarketData md = marketMap.get(pos.contractCode);\n                        if (md == null) continue;\n                        totalSpreadCharge += (long) (md.intraSpreadCharge * Math.abs(pos.positionQty));\n                    }\n                }\n            }\n            // Unrealized PnL\n            if (underPos != null) {\n                for (List<Position> posList : underPos.values()) {\n                    for (Position pos : posList) {\n                        ContractSpec spec = specMap.get(pos.contractCode);\n                        MarketData md = marketMap.get(pos.contractCode);\n                        if (spec == null || md == null) continue;\n                        do"]
[118.514409, "i", "uble pnl = (double) pos.positionQty * spec.multiplier * (md.settlementPrice - pos.entryPrice);\n                        totalUnrealizedPnl += (long) pnl; // truncate toward zero\n                    }\n                }\n            }\n            ar.netDeltaExposure = totalNetDeltaAbs;\n            ar.scanningRisk = totalScanningRisk;\n            ar.spreadCharge = totalSpreadCharge;\n            ar.initialMargin = totalScanningRisk + totalSpreadCharge;\n            ar.unrealizedPnl = totalUnrealizedPnl;\n            ar.marginStatus = (totalUnrealizedPnl >= ar.initialMargin) ? \"ADEQUATE\" : \"CALL\";\n            results.add(ar);\n        }\n        Collections.sort(results, new Comparator<AccountResult>() {\n            public int compare(AccountResult a1, AccountResult a2) {\n                return a1.accountId.compareTo(a2.accountId);\n            }\n        });\n        return results;\n    }\n}\nEOF\n"]
