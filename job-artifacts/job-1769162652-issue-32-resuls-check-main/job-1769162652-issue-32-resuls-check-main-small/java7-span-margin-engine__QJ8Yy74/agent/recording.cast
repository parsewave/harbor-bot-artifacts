[117.523661, "i", "cat > /app/src/ContractSpec.java <<'EOF'\npackage src;\n\npublic class ContractSpec {\n    public String contractCode;\n    public int multiplier;\n    public String expiryMonth; // YYYYMM\n    public String underlying;\n\n    public ContractSpec(String contractCode, int multiplier, String expiryMonth, String underlying) {\n        this.contractCode = contractCode;\n        this.multiplier = multiplier;\n        this.expiryMonth = expiryMonth;\n        this.underlying = underlying;\n    }\n\n    public static ContractSpec parse(String line) {\n        String[] parts = line.split(\",\");\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid contract spec line: \" + line);\n        }\n        String code = parts[0].trim();\n        int mult = Integer.parseInt(parts[1].trim());\n        String expiry = parts[2].trim();\n        String underlying = parts[3].trim();\n        return new ContractSpec(code, mult, expiry, underlying);\n    }\n}\nEOF\n"]
