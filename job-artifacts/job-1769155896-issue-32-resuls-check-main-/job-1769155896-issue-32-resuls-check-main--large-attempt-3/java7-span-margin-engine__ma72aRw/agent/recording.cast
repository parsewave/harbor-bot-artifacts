[99.332043, "i", "cat > /app/src/ContractSpec.java <<'EOF'\npublic final class ContractSpec {\n    public final String contractCode;\n    public final int multiplier;\n    public final String expiryMonth;\n    public final String underlying;\n\n    public ContractSpec(String contractCode, int multiplier, String expiryMonth, String underlying) {\n        this.contractCode = contractCode;\n        this.multiplier = multiplier;\n        this.expiryMonth = expiryMonth;\n        this.underlying = underlying;\n    }\n\n    public static ContractSpec parse(String line) {\n        String[] parts = Csv.split(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid contract_specs row: \" + line);\n        }\n        String contractCode = parts[0];\n        int multiplier = Integer.parseInt(parts[1]);\n        String expiry = parts[2];\n        String underlying = parts[3];\n        return new ContractSpec(contractCode, multiplier, expiry, underlying);\n    }\n}\nEOF\n"]
