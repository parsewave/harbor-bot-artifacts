[99.158747, "i", "cat > /app/src/MarketData.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic final class MarketData {\n    public final String contractCode;\n    public final BigDecimal settlementPrice;\n    public final BigDecimal scanningRangePct;\n    public final BigDecimal intraSpreadCharge;\n\n    public MarketData(String contractCode, BigDecimal settlementPrice, BigDecimal scanningRangePct, BigDecimal intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRangePct = scanningRangePct;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public static MarketData parse(String line) {\n        String[] parts = Csv.split(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid market_data row: \" + line);\n        }\n        String contractCode = parts[0];\n        BigDecimal settlement = new BigDecimal(parts[1]);\n        BigDecimal scanningPct = new BigDecimal(parts[2]);\n        BigDecimal intraCharge = new BigDecimal(parts[3]);\n        return new MarketData(contractCode, settlement, scanningPct, intraCharge);\n    }\n\n    public BigDecimal scanningRangeFraction() {\n        return scanningRangePct.divide(new BigDecimal(\"100\"));\n    }\n}\nEOF\n"]
