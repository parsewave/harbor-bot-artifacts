[100.216314, "i", "cat > /app/src/Csv.java <<'EOF'\npublic final class Csv {\n    private Csv() {\n    }\n\n    public static String[] split(String line) {\n        // Simple CSV: no quoted fields expected in this benchmark.\n        String[] raw = line.split(\",\", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n"]
