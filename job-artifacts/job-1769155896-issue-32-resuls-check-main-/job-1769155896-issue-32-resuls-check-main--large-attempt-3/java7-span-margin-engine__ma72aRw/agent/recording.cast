[99.506797, "o", "            UnderlyingAggregate ua = byUnderlying.get(underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.50695, "o", "            if (ua == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.507091, "o", "                ua = new UnderlyingAggregate();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.507248, "o", "                byUnderlying.put(underlying, ua);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.507368, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.507453, "o", "            return ua;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.507504, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.507636, "o", "\u001b[?2004h> "]
[99.507957, "o", "    public Map<String, AccountAggregate> aggregate(List<Position> positions, Map<String, ContractSpec> specsByContract) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.50822, "o", "        Map<String, AccountAggregate> byAccount = new HashMap<String, AccountAggregate>();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.50835, "o", "\u001b[?2004h> "]
[99.508414, "o", "        for (Position p : positions) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.508598, "o", "            ContractSpec spec = specsByContract.get(p.contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.508709, "o", "            if (spec == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.509064, "o", "                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.contractCode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.509124, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.509252, "o", "\u001b[?2004h> "]
[99.509393, "o", "            AccountAggregate aa = byAccount.get(p.accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.509447, "o", "            if (aa == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.509662, "o", "                aa = new AccountAggregate(p.accountId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.509802, "o", "                byAccount.put(p.accountId, aa);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.509956, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[99.510091, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[99.510163, "o", "            aa.positions.add(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.510582, "o", "            UnderlyingAggregate ua = aa.getOrCreateUnderlying(spec.underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.510746, "o", "            ua.apply(p, spec);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.510881, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.510939, "o", "\u001b[?2004h> "]
[99.511043, "o", "        return byAccount;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.511134, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.511182, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
[99.511229, "o", "\r\n\u001b[?2004l\r"]
[99.513828, "o", "\u001b[?2004hroot@5847abcc6645:/app# "]
[99.674744, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class MarginCalculator {\n\n    public List<AccountMargin> calculate(Map<String, PositionAggregator.AccountAggregate> aggregated,\n                                         Map<String, MarketData> marketByContract,\n                                         Map<String, ContractSpec> specByContract,\n                                         Map<String, BigDecimal> maxScanRangeFractionByUnderlying) {\n\n        List<AccountMargin> out = new ArrayList<AccountMargin>();\n\n        List<String> accountIds = new ArrayList<String>(aggregated.keySet());\n        Collections.sort(accountIds);\n\n        for (String accountId : accountIds) {\n            PositionAggregator.AccountAggregate aa = aggregated.get(accountId);\n\n            long netDeltaExposureSumAbs = 0L;\n            long scanningRiskSum = 0L;\n\n            for (Map.Entry<String, PositionAggregator.UnderlyingAggregate> e : aa.byUnderlying.entrySet()) {\n                String underlying = e.getKey();\n                PositionAggregator.UnderlyingAggregate ua = e.getValue();\n\n                long absNetDelta = Math.abs(ua.netDeltaExposure);\n                netDeltaExposureSumAbs += absNetDelta;\n\n                BigDecimal scanFrac = maxScanRangeFractionByUnderlying.get(underlying);\n                if (scanFrac == null) {\n                    throw new IllegalArgumentException(\"Missing scanning range for underlying=\" + underlying);\n                }\n\n                if (ua.representativeContractCode == null) {\n                    continue;\n                }\n                MarketData md = marketByContract.get(ua.representativeContractCode);\n                if (md == null) {\n                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + ua.representativeContractCode);\n                }\n\n                BigDecimal risk = new BigDecimal(absNetDelta)\n                        .multiply(scanFrac)\n                        .multiply(md.settlementPrice);\n\n                long riskInt = risk.longValue(); // truncate toward zero\n                scanningRiskSum += riskInt;\n            }\n\n            // Spread charge: sum over all held contracts abs(qty) * intra_spread_charge\n            BigDecimal spreadCharge = BigDecimal.ZERO;\n            BigDecimal unrealized = BigDecimal.ZERO;\n\n            for (Position p : aa.positions) {\n                MarketData md = marketByContract.get(p.contractCode);\n                if (md == null) {\n                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.contractCode);\n                }\n                ContractSpec spec = specByContract.get(p.contractCode);\n                if (spec == null) {\n                    throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.contractCode);\n                }\n\n                BigDecimal absQty = new BigDecimal(Math.abs(p.positionQty));\n                spreadCharge = spreadCharge.add(md.intraSpreadCharge.multiply(absQty));\n\n                // PnL = qty * multiplier * (settlement - entry)\n                BigDecimal qtyBD = new BigDecimal(p.positionQty);\n                BigDecimal multBD = new BigDecimal(spec.multiplier);\n                BigDecimal diff = md.settlementPrice.subtract(p.entryPrice);\n                unrealized = unrealized.add(qtyBD.multiply(multBD).multiply(diff));\n            }\n\n            long spreadChargeInt = spreadCharge.longValue();\n            BigDecimal initialMarginBD = new BigDecimal(scanningRiskSum).add(spreadCharge);\n            long initialMarginInt = initialMarginBD.longValue();\n            long unrealizedInt = unrealized.longValue();\n\n            String status = (unrealizedInt >= initialMarginInt) ? \"ADEQUATE\" : \"CALL\";\n\n            AccountMargin am = new AccountMargin(accountId,\n                    netDeltaExposureSumAbs,\n                    scanningRiskSum,\n                    spreadC"]
[99.674892, "i", "hargeInt,\n                    initialMarginInt,\n                    unrealizedInt,\n                    status);\n            out.add(am);\n        }\n\n        // Already sorted by accountId; but keep deterministic ordering.\n        Collections.sort(out, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a, AccountMargin b) {\n                return a.accountId.compareTo(b.accountId);\n            }\n        });\n\n        return out;\n    }\n}\nEOF\n"]
