[99.499456, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class PositionAggregator {\n\n    public static final class UnderlyingAggregate {\n        public long netDeltaExposure; // sum(qty * multiplier)\n        public long maxOpenInterestEq; // max(abs(qty) * multiplier)\n        public String representativeContractCode;\n\n        public UnderlyingAggregate() {\n            this.netDeltaExposure = 0L;\n            this.maxOpenInterestEq = -1L;\n            this.representativeContractCode = null;\n        }\n\n        public void apply(Position p, ContractSpec spec) {\n            long deltaEq = ((long) p.positionQty) * ((long) spec.multiplier);\n            netDeltaExposure += deltaEq;\n\n            long oiEq = ((long) Math.abs(p.positionQty)) * ((long) spec.multiplier);\n            if (oiEq > maxOpenInterestEq) {\n                maxOpenInterestEq = oiEq;\n                representativeContractCode = p.contractCode;\n            }\n        }\n    }\n\n    public static final class AccountAggregate {\n        public final String accountId;\n        public final Map<String, UnderlyingAggregate> byUnderlying;\n        public final List<Position> positions;\n\n        public AccountAggregate(String accountId) {\n            this.accountId = accountId;\n            this.byUnderlying = new HashMap<String, UnderlyingAggregate>();\n            this.positions = new ArrayList<Position>();\n        }\n\n        public UnderlyingAggregate getOrCreateUnderlying(String underlying) {\n            UnderlyingAggregate ua = byUnderlying.get(underlying);\n            if (ua == null) {\n                ua = new UnderlyingAggregate();\n                byUnderlying.put(underlying, ua);\n            }\n            return ua;\n        }\n    }\n\n    public Map<String, AccountAggregate> aggregate(List<Position> positions, Map<String, ContractSpec> specsByContract) {\n        Map<String, AccountAggregate> byAccount = new HashMap<String, AccountAggregate>();\n\n        for (Position p : positions) {\n            ContractSpec spec = specsByContract.get(p.contractCode);\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.contractCode);\n            }\n\n            AccountAggregate aa = byAccount.get(p.accountId);\n            if (aa == null) {\n                aa = new AccountAggregate(p.accountId);\n                byAccount.put(p.accountId, aa);\n            }\n\n            aa.positions.add(p);\n            UnderlyingAggregate ua = aa.getOrCreateUnderlying(spec.underlying);\n            ua.apply(p, spec);\n        }\n\n        return byAccount;\n    }\n}\nEOF\n"]
