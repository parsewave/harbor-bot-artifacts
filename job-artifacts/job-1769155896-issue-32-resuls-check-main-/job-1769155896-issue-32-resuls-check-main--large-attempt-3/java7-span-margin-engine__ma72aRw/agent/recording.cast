[136.674642, "i", "cat > /app/src/Position.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic final class Position {\n    public final String accountId;\n    public final String contractCode;\n    public final int positionQty;\n    public final BigDecimal entryPrice;\n\n    public Position(String accountId, String contractCode, int positionQty, BigDecimal entryPrice) {\n        this.accountId = accountId;\n        this.contractCode = contractCode;\n        this.positionQty = positionQty;\n        this.entryPrice = entryPrice;\n    }\n\n    public static Position parse(String line) {\n        String[] parts = split(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid positions row: \" + line);\n        }\n        String accountId = parts[0];\n        String contractCode = parts[1];\n        int qty = Integer.parseInt(parts[2]);\n        BigDecimal entryPrice = new BigDecimal(parts[3]);\n        return new Position(accountId, contractCode, qty, entryPrice);\n    }\n\n    private static String[] split(String line) {\n        String[] raw = line.split(\",\", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n"]
