[100.040681, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class Main {\n\n    public static void main(String[] args) throws Exception {\n        if (args.length != 4) {\n            // No stderr output per requirements; use stdout for usage.\n            System.out.println(\"Usage: java Main <positions_path> <market_data_path> <contract_specs_path> <output_path>\");\n            return;\n        }\n\n        String positionsPath = args[0];\n        String marketPath = args[1];\n        String specsPath = args[2];\n        String outputPath = args[3];\n\n        Map<String, ContractSpec> specsByContract = loadContractSpecs(specsPath);\n        Map<String, MarketData> marketByContract = loadMarketData(marketPath);\n        List<Position> positions = loadPositions(positionsPath);\n\n        // Precompute max scanning range per underlying (as fraction) across all contracts for that underlying.\n        Map<String, BigDecimal> maxScanFracByUnderlying = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, ContractSpec> e : specsByContract.entrySet()) {\n            String contract = e.getKey();\n            ContractSpec spec = e.getValue();\n            MarketData md = marketByContract.get(contract);\n            if (md == null) {\n                continue;\n            }\n            BigDecimal frac = md.scanningRangeFraction();\n            BigDecimal existing = maxScanFracByUnderlying.get(spec.underlying);\n            if (existing == null || frac.compareTo(existing) > 0) {\n                maxScanFracByUnderlying.put(spec.underlying, frac);\n            }\n        }\n\n        PositionAggregator aggregator = new PositionAggregator();\n        Map<String, PositionAggregator.AccountAggregate> aggregated = aggregator.aggregate(positions, specsByContract);\n\n        MarginCalculator calc = new MarginCalculator();\n        List<AccountMargin> margins = calc.calculate(aggregated, marketByContract, specsByContract, maxScanFracByUnderlying);\n\n        writeReport(outputPath, margins);\n    }\n\n    private static void writeReport(String outputPath, List<AccountMargin> margins) throws IOException {\n        BufferedWriter bw = null;\n        try {\n            bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(outputPath), \"UTF-8\"));\n            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\n            bw.newLine();\n            for (AccountMargin am : margins) {\n                bw.write(am.toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            if (bw != null) {\n                bw.close();\n            }\n        }\n    }\n\n    private static List<Position> loadPositions(String path) throws IOException {\n        BufferedReader br = null;\n        try {\n            br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n            List<Position> out = new ArrayList<Position>();\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                out.add(Position.parse(line));\n            }\n            return out;\n        } finally {\n            if (br != null) {\n                br.close();\n            }\n        }\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws IOException {\n        BufferedReader br = null;\n        try {\n            br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n            Map<String, MarketData> out = new "]
[100.040757, "i", "HashMap<String, MarketData>();\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                MarketData md = MarketData.parse(line);\n                out.put(md.contractCode, md);\n            }\n            return out;\n        } finally {\n            if (br != null) {\n                br.close();\n            }\n        }\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws IOException {\n        BufferedReader br = null;\n        try {\n            br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n            Map<String, ContractSpec> out = new HashMap<String, ContractSpec>();\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                if (first) {\n                    first = false;\n                    continue;\n                }\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                ContractSpec cs = ContractSpec.parse(line);\n                out.put(cs.contractCode, cs);\n            }\n            return out;\n        } finally {\n            if (br != null) {\n                br.close();\n            }\n        }\n    }\n}\nEOF\n"]
