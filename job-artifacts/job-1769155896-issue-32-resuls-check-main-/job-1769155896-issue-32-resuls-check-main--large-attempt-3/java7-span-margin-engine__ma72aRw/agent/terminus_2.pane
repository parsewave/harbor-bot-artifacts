[?2004l[?2004h> import java.math.BigDecimal;
[?2004l[?2004h> import java.util.ArrayList;
[?2004l    [?2004h> import java.util.Collections;
[?2004l[?2004h> import java.util.Comparator;
[?2004ll[?2004h> import java.util.List;
[?2004ly account[?2004h> import java.util.Map;
[?2004l[?2004h> 
[?2004ls[?2004h> public final class MarginCalculator {
[?2004l[?2004h> 
[?2004l([?2004h>     public List<AccountMargin> calculate(Map<String, PositionAggregator.AccountAggregate> aggregated,
[?2004l[?2004h>                                          Map<String, MarketData> marketByContract,
[?2004l[?2004h>                                          Map<String, ContractSpec> specByContract,
[?2004l[?2004h>                                          Map<String, BigDecimal> maxScanRangeFractionByUnderlying) {
[?2004l[?2004h> 
[?2004l[?2004h>         List<AccountMargin> out = new ArrayList<AccountMargin>();
[?2004l[?2004h> 
[?2004l[?2004h>         List<String> accountIds = new ArrayList<String>(aggregated.keySet());
[?2004l[?2004h>         Collections.sort(accountIds);
[?2004l[?2004h> 
[?2004l[?2004h>         for (String accountId : accountIds) {
[?2004l[?2004h>             PositionAggregator.AccountAggregate aa = aggregated.get(accountId);
[?2004l[?2004h> 
[?2004l[?2004h>             long netDeltaExposureSumAbs = 0L;
[?2004l[?2004h>             long scanningRiskSum = 0L;
[?2004l[?2004h> 
[?2004l[?2004h>             for (Map.Entry<String, PositionAggregator.UnderlyingAggregate> e : aa.byUnderlying.entrySet()) {
[?2004l[?2004h>                 String underlying = e.getKey();
[?2004l[?2004h>                 PositionAggregator.UnderlyingAggregate ua = e.getValue();
[?2004l[?2004h> 
[?2004l[?2004h>                 long absNetDelta = Math.abs(ua.netDeltaExposure);
[?2004l[?2004h>                 netDeltaExposureSumAbs += absNetDelta;
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal scanFrac = maxScanRangeFractionByUnderlying.get(underlying);
[?2004l[?2004h>                 if (scanFrac == null) {
[?2004l[?2004h>                     throw new IllegalArgumentException("Missing scanning range for underlying=" + underlying);
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 if (ua.representativeContractCode == null) {
[?2004l[?2004h>                     continue;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 MarketData md = marketByContract.get(ua.representativeContractCode);
[?2004l[?2004h>                 if (md == null) {
[?2004l[?2004h>                     throw new IllegalArgumentException("Missing market data for contract_code=" + ua.representativeContractCode);
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal risk = new BigDecimal(absNetDelta)
[?2004l[?2004h>                         .multiply(scanFrac)
[?2004l[?2004h>                         .multiply(md.settlementPrice);
[?2004l[?2004h> 
[?2004l[?2004h>                 long riskInt = risk.longValue(); // truncate toward zero
[?2004l[?2004h>                 scanningRiskSum += riskInt;
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             // Spread charge: sum over all held contracts abs(qty) * intra_spread_charge
[?2004l[?2004h>             BigDecimal spreadCharge = BigDecimal.ZERO;
[?2004l[?2004h>             BigDecimal unrealized = BigDecimal.ZERO;
[?2004l[?2004h> 
[?2004l[?2004h>             for (Position p : aa.positions) {
[?2004l[?2004h>                 MarketData md = marketByContract.get(p.contractCode);
[?2004l[?2004h>                 if (md == null) {
[?2004l[?2004h>                     throw new IllegalArgumentException("Missing market data for contract_code=" + p.contractCode);
[?2004l[?2004h>                 }
[?2004l[?2004h>                 ContractSpec spec = specByContract.get(p.contractCode);
[?2004l[?2004h>                 if (spec == null) {
[?2004l[?2004h>                     throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.contractCode);
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 BigDecimal absQty = new BigDecimal(Math.abs(p.positionQty));
[?2004l[?2004h>                 spreadCharge = spreadCharge.add(md.intraSpreadCharge.multiply(absQty));
[?2004l[?2004h> 
[?2004l[?2004h>                 // PnL = qty * multiplier * (settlement - entry)
[?2004l[?2004h>                 BigDecimal qtyBD = new BigDecimal(p.positionQty);
[?2004l[?2004h>                 BigDecimal multBD = new BigDecimal(spec.multiplier);
[?2004l[?2004h>                 BigDecimal diff = md.settlementPrice.subtract(p.entryPrice);
[?2004l[?2004h>                 unrealized = unrealized.add(qtyBD.multiply(multBD).multiply(diff));
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             long spreadChargeInt = spreadCharge.longValue();
[?2004l[?2004h>             BigDecimal initialMarginBD = new BigDecimal(scanningRiskSum).add(spreadCharge);
[?2004l[?2004h>             long initialMarginInt = initialMarginBD.longValue();
[?2004l[?2004h>             long unrealizedInt = unrealized.longValue();
[?2004l[?2004h> 
[?2004l[?2004h>             String status = (unrealizedInt >= initialMarginInt) ? "ADEQUATE" : "CALL";
[?2004l[?2004h> 
[?2004l[?2004h>             AccountMargin am = new AccountMargin(accountId,
[?2004l[?2004h>                     netDeltaExposureSumAbs,
[?2004l[?2004h>                     scanningRiskSum,
[?2004l[?2004h>                     spreadChargeInt,
[?2004l[?2004h>                     initialMarginInt,
[?2004l[?2004h>                     unrealizedInt,
[?2004l[?2004h>                     status);
[?2004l[?2004h>             out.add(am);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // Already sorted by accountId; but keep deterministic ordering.
[?2004l[?2004h>         Collections.sort(out, new Comparator<AccountMargin>() {
[?2004l[?2004h>             public int compare(AccountMargin a, AccountMargin b) {
[?2004l[?2004h>                 return a.accountId.compareTo(b.accountId);
[?2004l[?2004h>             }
[?2004l[?2004h>         });
[?2004l[?2004h> 
[?2004l[?2004h>         return out;
[?2004l[?2004h>     }
[?2004l[?2004h> }
