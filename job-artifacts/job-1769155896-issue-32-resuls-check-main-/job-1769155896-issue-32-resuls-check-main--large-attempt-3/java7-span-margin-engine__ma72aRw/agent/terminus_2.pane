[?2004l[?2004h> 
[?2004l[?2004h> public final class PositionAggregator {
[?2004l[?2004h> 
[?2004l[?2004h>     public static final class UnderlyingAggregate {
[?2004l[?2004h>         public long netDeltaExposure; // sum(qty * multiplier)
[?2004l[?2004h>         public long maxOpenInterestEq; // max(abs(qty) * multiplier)
[?2004l[?2004h>         public String representativeContractCode;
[?2004l[?2004h> 
[?2004l[?2004h>         public UnderlyingAggregate() {
[?2004l[?2004h>             this.netDeltaExposure = 0L;
[?2004l[?2004h>             this.maxOpenInterestEq = -1L;
[?2004l[?2004h>             this.representativeContractCode = null;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public void apply(Position p, ContractSpec spec) {
[?2004l[?2004h>             long deltaEq = ((long) p.positionQty) * ((long) spec.multiplier);
[?2004l[?2004h>             netDeltaExposure += deltaEq;
[?2004l[?2004h> 
[?2004l[?2004h>             long oiEq = ((long) Math.abs(p.positionQty)) * ((long) spec.multiplier);
[?2004l[?2004h>             if (oiEq > maxOpenInterestEq) {
[?2004l[?2004h>                 maxOpenInterestEq = oiEq;
[?2004l[?2004h>                 representativeContractCode = p.contractCode;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public static final class AccountAggregate {
[?2004l[?2004h>         public final String accountId;
[?2004l[?2004h>         public final Map<String, UnderlyingAggregate> byUnderlying;
[?2004l[?2004h>         public final List<Position> positions;
[?2004l[?2004h> 
[?2004l[?2004h>         public AccountAggregate(String accountId) {
[?2004l[?2004h>             this.accountId = accountId;
[?2004l[?2004h>             this.byUnderlying = new HashMap<String, UnderlyingAggregate>();
[?2004l[?2004h>             this.positions = new ArrayList<Position>();
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         public UnderlyingAggregate getOrCreateUnderlying(String underlying) {
[?2004l[?2004h>             UnderlyingAggregate ua = byUnderlying.get(underlying);
[?2004l[?2004h>             if (ua == null) {
[?2004l[?2004h>                 ua = new UnderlyingAggregate();
[?2004l[?2004h>                 byUnderlying.put(underlying, ua);
[?2004l[?2004h>             }
[?2004l[?2004h>             return ua;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public Map<String, AccountAggregate> aggregate(List<Position> positions, Map<String, ContractSpec> specsByContract) {
[?2004l[?2004h>         Map<String, AccountAggregate> byAccount = new HashMap<String, AccountAggregate>();
[?2004l[?2004h> 
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             ContractSpec spec = specsByContract.get(p.contractCode);
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.contractCode);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             AccountAggregate aa = byAccount.get(p.accountId);
[?2004l[?2004h>             if (aa == null) {
[?2004l[?2004h>                 aa = new AccountAggregate(p.accountId);
[?2004l[?2004h>                 byAccount.put(p.accountId, aa);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             aa.positions.add(p);
[?2004l[?2004h>             UnderlyingAggregate ua = aa.getOrCreateUnderlying(spec.underlying);
[?2004l[?2004h>             ua.apply(p, spec);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         return byAccount;
[?2004l[?2004h>     }
[?2004l[?2004h> }
