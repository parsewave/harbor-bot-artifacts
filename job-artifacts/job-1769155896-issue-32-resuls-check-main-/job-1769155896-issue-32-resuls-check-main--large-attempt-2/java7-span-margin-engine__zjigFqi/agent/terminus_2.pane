[?2004l[?2004h>                 spreadCharge = BigDecimal.ZERO;
[?2004l[?2004h>             }
[?2004l[?2004h>             long spreadChargeTrunc = truncateTowardZeroToLong(spreadCharge);
[?2004l[?2004h> 
[?2004l[?2004h>             long initialMargin = totalScanningRisk + spreadChargeTrunc;
[?2004l[?2004h> 
[?2004l[?2004h>             BigDecimal pnl = pnlByAccount.get(acc.getAccountId());
[?2004l[?2004h>             if (pnl == null) {
[?2004l[?2004h>                 pnl = BigDecimal.ZERO;
[?2004l[?2004h>             }
[?2004l[?2004h>             long pnlTrunc = truncateTowardZeroToLong(pnl);
[?2004l[?2004h> 
[?2004l[?2004h>             String status = (pnlTrunc >= initialMargin) ? "ADEQUATE" : "CALL";
[?2004l[?2004h> 
[?2004l[?2004h>             results.add(new AccountMargin(acc.getAccountId(), sumAbsNetDelta, totalScanningRisk,
[?2004l[?2004h>                     spreadChargeTrunc, initialMargin, pnlTrunc, status));
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         Collections.sort(results, new Comparator<AccountMargin>() {
[?2004l[?2004h>             public int compare(AccountMargin a, AccountMargin b) {
