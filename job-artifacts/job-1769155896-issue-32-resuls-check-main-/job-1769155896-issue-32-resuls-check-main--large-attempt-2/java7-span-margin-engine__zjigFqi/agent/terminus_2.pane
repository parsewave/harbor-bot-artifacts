[?2004l[?2004h>             }
[?2004l[?2004h>         });
[?2004l[?2004h> 
[?2004l[?2004h>         return results;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private static long truncateTowardZeroToLong(BigDecimal v) {
