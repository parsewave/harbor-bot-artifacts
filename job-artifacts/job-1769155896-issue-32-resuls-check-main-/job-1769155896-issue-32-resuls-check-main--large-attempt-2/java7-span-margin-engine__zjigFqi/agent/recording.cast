[229.821072, "o", "                MarketData md = marketByContract.get(repContract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.821243, "o", "                if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.821511, "o", "                    throw new IllegalArgumentException(\"Missing market data for representative contract_code=\" + repContract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.821684, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.821902, "o", "                BigDecimal absExposure = BigDecimal.valueOf(absLong(netDelta));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.822357, "o", "                BigDecimal risk = absExposure.multiply(scanFactor).multiply(md.getSettlementPrice());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.822591, "o", "                long riskTrunc = truncateTowardZeroToLong(risk);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.822752, "o", "                totalScanningRisk += riskTrunc;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.822829, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.823084, "o", "            // Spread charge based on net position per contract for the account\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.823297, "o", "            BigDecimal spreadCharge = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.823564, "o", "            for (Map.Entry<String, Long> e : acc.getNetQtyByContract().entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.823755, "o", "                String contract = e.getKey();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.823841, "o", "                long netQty = e.getValue().longValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.82401, "o", "                if (netQty == 0L) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.824158, "o", "                    continue;\r\n\u001b[?2004l\r\u001b[?2004h"]
[229.824242, "o", ">                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.824384, "o", "                MarketData md = marketByContract.get(contract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.824445, "o", "                if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.824865, "o", "                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + contract);\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.825071, "o", "                BigDecimal absQty = BigDecimal.valueOf(absLong(netQty));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.825332, "o", "                spreadCharge = spreadCharge.add(md.getIntraSpreadCharge().multiply(absQty));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.825413, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.825572, "o", "            long spreadChargeTrunc = truncateTowardZeroToLong(spreadCharge);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.82582, "o", "            long initialMargin = totalScanningRisk + spreadChargeTrunc;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.826037, "o", "            BigDecimal pnl = pnlByAccount.get(acc.getAccountId());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.826223, "o", "            if (pnl == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.826444, "o", "                pnl = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.826658, "o", "            long pnlTrunc = truncateTowardZeroToLong(pnl);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.826801, "o", "            String status = (pnlTrunc >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.827096, "o", "            results.add(new AccountMargin(acc.getAccountId(), sumAbsNetDelta, totalScanningRisk,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.827311, "o", "                    spreadChargeTrunc, initialMargin, pnlTrunc, status));\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.827381, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.827574, "o", "        Collections.sort(results, new Comparator<AccountMargin>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.827781, "o", "            public int compare(AccountMargin a, AccountMargin b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.828048, "o", "                return a.getAccountId().compareTo(b.getAccountId());\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.828214, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         return results;\r\n\u001b[?2004l\r\u001b[?2004h"]
[229.828326, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.828484, "o", "    private static long truncateTowardZeroToLong(BigDecimal v) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.828701, "o", "        // RoundingMode.DOWN is toward zero for both positive and negative values.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.828847, "o", "        return v.setScale(0, RoundingMode.DOWN).longValue();\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[229.828906, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.829082, "o", "    private static long absLong(long v) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.829203, "o", "        return v < 0L ? -v : v;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[229.829682, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[229.831338, "o", "\u001b[?2004hroot@3a616b755984:/app# "]
[229.990868, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class Main {\n\n    public static void main(String[] args) throws Exception {\n        if (args == null || args.length != 4) {\n            // Per requirements: no stderr output on normal execution.\n            // Still fail fast if invoked incorrectly.\n            throw new IllegalArgumentException(\"Expected args: positions_path market_data_path contract_specs_path output_path\");\n        }\n\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = readPositions(positionsPath);\n        Map<String, MarketData> marketByContract = readMarketData(marketDataPath);\n        Map<String, ContractSpec> specsByContract = readContractSpecs(contractSpecsPath);\n\n        MarginCalculator calc = new MarginCalculator();\n        List<AccountMargin> margins = calc.computeMargins(positions, marketByContract, specsByContract);\n\n        writeOutput(outputPath, margins);\n    }\n\n    private static List<Position> readPositions(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            List<Position> out = new ArrayList<Position>();\n            String line = br.readLine(); // header\n            if (line == null) {\n                return out;\n            }\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                out.add(Position.fromCsv(line));\n            }\n            return out;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static Map<String, MarketData> readMarketData(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            Map<String, MarketData> out = new HashMap<String, MarketData>();\n            String line = br.readLine(); // header\n            if (line == null) {\n                return out;\n            }\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                MarketData md = MarketData.fromCsv(line);\n                out.put(md.getContractCode(), md);\n            }\n            return out;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static Map<String, ContractSpec> readContractSpecs(String path) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            Map<String, ContractSpec> out = new HashMap<String, ContractSpec>();\n            String line = br.readLine(); // header\n            if (line == null) {\n                return out;\n            }\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                ContractSpec spec = ContractSpec.fromCsv(line);\n                out.put(spec.getContractCode(), spec);\n            }\n            return out;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static void writeOutput(String outputPath, List<AccountMargin> margins) throws Exception {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(outputPath), \"UTF-8\"));\n        try {\n            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\n            bw.newLine();\n            for (int i = 0; i < "]
[229.990975, "i", "margins.size(); i++) {\n                bw.write(margins.get(i).toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            bw.close();\n        }\n    }\n}\nEOF\n"]
