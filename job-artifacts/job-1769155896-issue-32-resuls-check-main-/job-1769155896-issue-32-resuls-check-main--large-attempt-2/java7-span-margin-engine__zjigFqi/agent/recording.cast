[285.442349, "o", "\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            // \u001b[01;31m\u001b[KSpread charge\u001b[m\u001b[K based on net position per contract for the account\r\n"]
[285.442839, "o", "\u001b[?2004hroot@3a616b755984:/app# "]
[285.633016, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class MarginCalculator {\n\n    public List<AccountMargin> computeMargins(List<Position> positions,\n                                              Map<String, MarketData> marketByContract,\n                                              Map<String, ContractSpec> specByContract) {\n        // Precompute max scanning range factor per underlying\n        Map<String, BigDecimal> maxScanFactorByUnderlying = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, ContractSpec> e : specByContract.entrySet()) {\n            String contract = e.getKey();\n            ContractSpec spec = e.getValue();\n            MarketData md = marketByContract.get(contract);\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + contract);\n            }\n            BigDecimal factor = md.getScanningRangeFactor();\n            BigDecimal prev = maxScanFactorByUnderlying.get(spec.getUnderlying());\n            if (prev == null || factor.compareTo(prev) > 0) {\n                maxScanFactorByUnderlying.put(spec.getUnderlying(), factor);\n            }\n        }\n\n        // Aggregate by account/underlying (for directional risk)\n        PositionAggregator aggregator = new PositionAggregator(positions, specByContract);\n        List<PositionAggregator.AccountAggregation> aggs = aggregator.aggregate();\n\n        // Compute unrealized PnL per account from raw positions\n        Map<String, BigDecimal> pnlByAccount = new HashMap<String, BigDecimal>();\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = specByContract.get(p.getContractCode());\n            MarketData md = marketByContract.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\n            }\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.getContractCode());\n            }\n\n            BigDecimal qty = BigDecimal.valueOf((long) p.getPositionQty());\n            BigDecimal mult = BigDecimal.valueOf((long) spec.getMultiplier());\n            BigDecimal priceDiff = md.getSettlementPrice().subtract(p.getEntryPrice());\n            BigDecimal pnl = qty.multiply(mult).multiply(priceDiff);\n\n            BigDecimal prev = pnlByAccount.get(p.getAccountId());\n            if (prev == null) {\n                pnlByAccount.put(p.getAccountId(), pnl);\n            } else {\n                pnlByAccount.put(p.getAccountId(), prev.add(pnl));\n            }\n        }\n\n        // Compute spread charge per account from raw positions:\n        // sum(intra_spread_charge(contract) * abs(position_qty)) over all position records.\n        Map<String, BigDecimal> spreadChargeByAccount = new HashMap<String, BigDecimal>();\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            MarketData md = marketByContract.get(p.getContractCode());\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.getContractCode());\n            }\n            BigDecimal absQty = BigDecimal.valueOf(absLong((long) p.getPositionQty()));\n            BigDecimal charge = md.getIntraSpreadCharge().multiply(absQty);\n\n            BigDecimal prev = spreadChargeByAccount.get(p.getAccountId());\n            if (prev == null) {\n                spreadChargeByAccount.put(p.getAccountId(), charge);\n            } else {\n                spreadChargeByAccount.put(p.getAccountId(), prev.add(charge));\n            }\n        }\n\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        for (int i = 0; i < aggs.size(); i++) {\n      "]
[285.633102, "i", "      PositionAggregator.AccountAggregation acc = aggs.get(i);\n\n            long sumAbsNetDelta = 0L;\n            long totalScanningRisk = 0L;\n\n            for (Map.Entry<String, PositionAggregator.UnderlyingNet> e : acc.getNetByUnderlying().entrySet()) {\n                String underlying = e.getKey();\n                PositionAggregator.UnderlyingNet net = e.getValue();\n\n                long netDelta = net.getNetDeltaExposure();\n                sumAbsNetDelta += absLong(netDelta);\n\n                if (netDelta == 0L) {\n                    continue;\n                }\n\n                BigDecimal scanFactor = maxScanFactorByUnderlying.get(underlying);\n                if (scanFactor == null) {\n                    throw new IllegalArgumentException(\"Missing scanning range for underlying=\" + underlying);\n                }\n\n                String repContract = net.getRepresentativeContractCode();\n                if (repContract == null) {\n                    continue;\n                }\n                MarketData md = marketByContract.get(repContract);\n                if (md == null) {\n                    throw new IllegalArgumentException(\"Missing market data for representative contract_code=\" + repContract);\n                }\n\n                BigDecimal absExposure = BigDecimal.valueOf(absLong(netDelta));\n                BigDecimal risk = absExposure.multiply(scanFactor).multiply(md.getSettlementPrice());\n                long riskTrunc = truncateTowardZeroToLong(risk);\n                totalScanningRisk += riskTrunc;\n            }\n\n            BigDecimal spreadCharge = spreadChargeByAccount.get(acc.getAccountId());\n            if (spreadCharge == null) {\n                spreadCharge = BigDecimal.ZERO;\n            }\n            long spreadChargeTrunc = truncateTowardZeroToLong(spreadCharge);\n\n            long initialMargin = totalScanningRisk + spreadChargeTrunc;\n\n            BigDecimal pnl = pnlByAccount.get(acc.getAccountId());\n            if (pnl == null) {\n                pnl = BigDecimal.ZERO;\n            }\n            long pnlTrunc = truncateTowardZeroToLong(pnl);\n\n            String status = (pnlTrunc >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\n\n            results.add(new AccountMargin(acc.getAccountId(), sumAbsNetDelta, totalScanningRisk,\n                    spreadChargeTrunc, initialMargin, pnlTrunc, status));\n        }\n\n        Collections.sort(results, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a, AccountMargin b) {\n                return a.getAccountId().compareTo(b.getAccountId());\n            }\n        });\n\n        return results;\n    }\n\n    private static long truncateTowardZeroToLong(BigDecimal v) {\n        // RoundingMode.DOWN is toward zero for both positive and negative values.\n        return v.setScale(0, RoundingMode.DOWN).longValue();\n    }\n\n    private static long absLong(long v) {\n        return v < 0L ? -v : v;\n    }\n}\nEOF\n"]
