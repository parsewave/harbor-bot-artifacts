[229.288, "o", "    public static ContractSpec fromCsv(String line) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.288314, "o", "        // contract_code,multiplier,expiry_month,underlying\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.288517, "o", "        String[] parts = splitCsv(line);\r\n\u001b[?2004l\r\u001b[?2004h>         if (parts.length != 4) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.288738, "o", "            throw new IllegalArgumentException(\"Invalid contract_specs row: \" + line);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[229.288838, "o", "\u001b[?2004h> "]
[229.288955, "o", "        String contractCode = parts[0].trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.289203, "o", "        int multiplier = Integer.parseInt(parts[1].trim());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.289432, "o", "        String expiryMonth = parts[2].trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.289598, "o", "        String underlying = parts[3].trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.289885, "o", "        return new ContractSpec(contractCode, multiplier, expiryMonth, underlying);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[229.290076, "o", "\u001b[?2004h> "]
[229.290187, "o", "    private static String[] splitCsv(String line) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.290402, "o", "        return line.split(\",\", -1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.290556, "o", "EOF\r\n\u001b[?2004l\r"]
[229.292587, "o", "\u001b[?2004hroot@3a616b755984:/app# "]
[229.459372, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic final class PositionAggregator {\n\n    public static final class UnderlyingNet {\n        private long netDeltaExposure; // qty * multiplier summed across contracts\n        private long representativeOpenInterestEq; // abs(qty) * multiplier max\n        private String representativeContractCode;\n\n        public long getNetDeltaExposure() {\n            return netDeltaExposure;\n        }\n\n        public String getRepresentativeContractCode() {\n            return representativeContractCode;\n        }\n\n        private void addDelta(long delta) {\n            this.netDeltaExposure += delta;\n        }\n\n        private void considerRepresentative(long openInterestEq, String contractCode) {\n            if (representativeContractCode == null || openInterestEq > representativeOpenInterestEq) {\n                representativeOpenInterestEq = openInterestEq;\n                representativeContractCode = contractCode;\n            }\n        }\n    }\n\n    public static final class AccountAggregation {\n        private final String accountId;\n        private final Map<String, UnderlyingNet> netByUnderlying = new HashMap<String, UnderlyingNet>();\n        private final Map<String, Long> netQtyByContract = new HashMap<String, Long>();\n\n        private AccountAggregation(String accountId) {\n            this.accountId = accountId;\n        }\n\n        public String getAccountId() {\n            return accountId;\n        }\n\n        public Map<String, UnderlyingNet> getNetByUnderlying() {\n            return netByUnderlying;\n        }\n\n        public Map<String, Long> getNetQtyByContract() {\n            return netQtyByContract;\n        }\n\n        private void addToContractNet(String contractCode, long qty) {\n            Long prev = netQtyByContract.get(contractCode);\n            if (prev == null) {\n                netQtyByContract.put(contractCode, Long.valueOf(qty));\n            } else {\n                netQtyByContract.put(contractCode, Long.valueOf(prev.longValue() + qty));\n            }\n        }\n\n        private UnderlyingNet getOrCreateUnderlying(String underlying) {\n            UnderlyingNet u = netByUnderlying.get(underlying);\n            if (u == null) {\n                u = new UnderlyingNet();\n                netByUnderlying.put(underlying, u);\n            }\n            return u;\n        }\n    }\n\n    private final List<Position> positions;\n    private final Map<String, ContractSpec> contractSpecsByCode;\n\n    public PositionAggregator(List<Position> positions, Map<String, ContractSpec> contractSpecsByCode) {\n        this.positions = positions;\n        this.contractSpecsByCode = contractSpecsByCode;\n    }\n\n    public List<AccountAggregation> aggregate() {\n        Map<String, AccountAggregation> byAccount = new HashMap<String, AccountAggregation>();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = contractSpecsByCode.get(p.getContractCode());\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.getContractCode());\n            }\n\n            AccountAggregation acc = byAccount.get(p.getAccountId());\n            if (acc == null) {\n                acc = new AccountAggregation(p.getAccountId());\n                byAccount.put(p.getAccountId(), acc);\n            }\n\n            long qty = (long) p.getPositionQty();\n            long deltaEq = qty * (long) spec.getMultiplier();\n            long openInterestEq = absLong(qty) * (long) spec.getMultiplier();\n\n            UnderlyingNet net = acc.getOrCreateUnderlying(spec.getUnderlying());\n            net.addDelta(deltaEq);\n            net.considerRepresentative(openInterestEq, p.getContractCode());\n\n            acc.addToContractNet(p.getContractCode(), qty);\n        }\n\n        return new ArrayList<AccountAggregation>(byAccount.values());\n    }\n\n    private static long absLong(long v) {\n        return v < 0"]
[229.459621, "i", "L ? -v : v;\n    }\n}\nEOF\n"]
