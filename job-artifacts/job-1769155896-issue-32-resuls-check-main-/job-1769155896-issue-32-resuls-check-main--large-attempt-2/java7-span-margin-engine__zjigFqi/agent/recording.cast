[229.620569, "i", "cat > /app/src/AccountMargin.java <<'EOF'\npublic final class AccountMargin {\n    private final String accountId;\n    private final long netDeltaExposure;\n    private final long scanningRisk;\n    private final long spreadCharge;\n    private final long initialMargin;\n    private final long unrealizedPnl;\n    private final String marginStatus;\n\n    public AccountMargin(String accountId,\n                         long netDeltaExposure,\n                         long scanningRisk,\n                         long spreadCharge,\n                         long initialMargin,\n                         long unrealizedPnl,\n                         String marginStatus) {\n        this.accountId = accountId;\n        this.netDeltaExposure = netDeltaExposure;\n        this.scanningRisk = scanningRisk;\n        this.spreadCharge = spreadCharge;\n        this.initialMargin = initialMargin;\n        this.unrealizedPnl = unrealizedPnl;\n        this.marginStatus = marginStatus;\n    }\n\n    public String getAccountId() {\n        return accountId;\n    }\n\n    public String toCsvRow() {\n        StringBuilder sb = new StringBuilder();\n        sb.append(accountId).append(',');\n        sb.append(netDeltaExposure).append(',');\n        sb.append(scanningRisk).append(',');\n        sb.append(spreadCharge).append(',');\n        sb.append(initialMargin).append(',');\n        sb.append(unrealizedPnl).append(',');\n        sb.append(marginStatus);\n        return sb.toString();\n    }\n}\nEOF\n"]
