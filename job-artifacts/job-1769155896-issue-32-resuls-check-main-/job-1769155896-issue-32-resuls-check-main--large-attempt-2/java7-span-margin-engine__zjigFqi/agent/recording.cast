[229.081819, "i", "cat > /app/src/MarketData.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic final class MarketData {\n    private final String contractCode;\n    private final BigDecimal settlementPrice;\n    private final BigDecimal scanningRangePercent;\n    private final BigDecimal intraSpreadCharge;\n\n    public MarketData(String contractCode,\n                      BigDecimal settlementPrice,\n                      BigDecimal scanningRangePercent,\n                      BigDecimal intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRangePercent = scanningRangePercent;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public String getContractCode() {\n        return contractCode;\n    }\n\n    public BigDecimal getSettlementPrice() {\n        return settlementPrice;\n    }\n\n    public BigDecimal getScanningRangePercent() {\n        return scanningRangePercent;\n    }\n\n    public BigDecimal getIntraSpreadCharge() {\n        return intraSpreadCharge;\n    }\n\n    public BigDecimal getScanningRangeFactor() {\n        // percent value like 5.0 becomes factor 0.05\n        return scanningRangePercent.divide(new BigDecimal(\"100\"));\n    }\n\n    public static MarketData fromCsv(String line) {\n        // contract_code,settlement_price,scanning_range,intra_spread_charge\n        String[] parts = splitCsv(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid market_data row: \" + line);\n        }\n        String contractCode = parts[0].trim();\n        BigDecimal settlement = new BigDecimal(parts[1].trim());\n        BigDecimal scanningRange = new BigDecimal(parts[2].trim());\n        BigDecimal spreadCharge = new BigDecimal(parts[3].trim());\n        return new MarketData(contractCode, settlement, scanningRange, spreadCharge);\n    }\n\n    private static String[] splitCsv(String line) {\n        return line.split(\",\", -1);\n    }\n}\nEOF\n"]
