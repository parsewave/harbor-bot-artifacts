[285.653156, "o", "                long netDelta = net.getNetDeltaExposure();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.653328, "o", "                sumAbsNetDelta += absLong(netDelta);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.65344, "o", "                if (netDelta == 0L) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.653627, "o", "                    continue;\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.653959, "o", "                BigDecimal scanFactor = maxScanFactorByUnderlying.get(underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.654121, "o", "                if (scanFactor == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.654422, "o", "                    throw new IllegalArgumentException(\"Missing scanning range for underlying=\" + underlying);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.65455, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.654771, "o", "                String repContract = net.getRepresentativeContractCode();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.654912, "o", "                if (repContract == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.654999, "o", "                    continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.655147, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.655372, "o", "                MarketData md = marketByContract.get(repContract);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.655527, "o", "                if (md == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.655851, "o", "                    throw new IllegalArgumentException(\"Missing market data for representative contract_code=\" + repContract);\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[285.655959, "o", "\u001b[?2004h> "]
[285.656188, "o", "                BigDecimal absExposure = BigDecimal.valueOf(absLong(netDelta));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.656526, "o", "                BigDecimal risk = absExposure.multiply(scanFactor).multiply(md.getSettlementPrice());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.656732, "o", "                long riskTrunc = truncateTowardZeroToLong(risk);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.656882, "o", "                totalScanningRisk += riskTrunc;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.656986, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.657384, "o", "            BigDecimal spreadCharge = spreadChargeByAccount.get(acc.getAccountId());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.657507, "o", "            if (spreadCharge == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.657719, "o", "                spreadCharge = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.658146, "o", "            long spreadChargeTrunc = truncateTowardZeroToLong(spreadCharge);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             long initialMargin = totalScanningRisk + spreadChargeTrunc;\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.65825, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.658451, "o", "            BigDecimal pnl = pnlByAccount.get(acc.getAccountId());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.658532, "o", "            if (pnl == null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.658695, "o", "                pnl = BigDecimal.ZERO;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.65889, "o", "            long pnlTrunc = truncateTowardZeroToLong(pnl);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.659172, "o", "            String status = (pnlTrunc >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.659477, "o", "            results.add(new AccountMargin(acc.getAccountId(), sumAbsNetDelta, totalScanningRisk,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.659581, "o", "                    spreadChargeTrunc, initialMargin, pnlTrunc, status));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.659778, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.659945, "o", "        Collections.sort(results, new Comparator<AccountMargin>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.660091, "o", "            public int compare(AccountMargin a, AccountMargin b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.66026, "o", "                return a.getAccountId().compareTo(b.getAccountId());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.660428, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.660548, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         return results;\r\n\u001b[?2004l\r"]
[285.66071, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.660829, "o", "    private static long truncateTowardZeroToLong(BigDecimal v) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.661071, "o", "        // RoundingMode.DOWN is toward zero for both positive and negative values.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.661299, "o", "        return v.setScale(0, RoundingMode.DOWN).longValue();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.661435, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.661504, "o", "    private static long absLong(long v) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.661692, "o", "        return v < 0L ? -v : v;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[285.661756, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
