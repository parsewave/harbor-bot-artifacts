[228.909959, "i", "cat > /app/src/Position.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic final class Position {\n    private final String accountId;\n    private final String contractCode;\n    private final int positionQty;\n    private final BigDecimal entryPrice;\n\n    public Position(String accountId, String contractCode, int positionQty, BigDecimal entryPrice) {\n        this.accountId = accountId;\n        this.contractCode = contractCode;\n        this.positionQty = positionQty;\n        this.entryPrice = entryPrice;\n    }\n\n    public String getAccountId() {\n        return accountId;\n    }\n\n    public String getContractCode() {\n        return contractCode;\n    }\n\n    public int getPositionQty() {\n        return positionQty;\n    }\n\n    public BigDecimal getEntryPrice() {\n        return entryPrice;\n    }\n\n    public static Position fromCsv(String line) {\n        // account_id,contract_code,position_qty,entry_price\n        String[] parts = splitCsv(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid positions row: \" + line);\n        }\n        String accountId = parts[0].trim();\n        String contractCode = parts[1].trim();\n        int qty = Integer.parseInt(parts[2].trim());\n        BigDecimal entry = new BigDecimal(parts[3].trim());\n        return new Position(accountId, contractCode, qty, entry);\n    }\n\n    private static String[] splitCsv(String line) {\n        // Input data is simple and unquoted; keep it strict and fast.\n        return line.split(\",\", -1);\n    }\n}\nEOF\n"]
