[74.182729, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.*;\n\npublic class PositionAggregator {\n    /**\n     * Groups positions by account then by underlying.\n     */\n    public static Map<String, Map<String, List<Position>>> aggregate(List<Position> positions, Map<String, ContractSpec> specMap) {\n        Map<String, Map<String, List<Position>>> result = new HashMap<String, Map<String, List<Position>>>();\n        for (Position p : positions) {\n            ContractSpec spec = specMap.get(p.contractCode);\n            if (spec == null) {\n                continue; // ignore unknown contracts\n            }\n            String account = p.accountId;\n            String underlying = spec.underlying;\n            Map<String, List<Position>> byUnderlying = result.get(account);\n            if (byUnderlying == null) {\n                byUnderlying = new HashMap<String, List<Position>>();\n                result.put(account, byUnderlying);\n            }\n            List<Position> list = byUnderlying.get(underlying);\n            if (list == null) {\n                list = new ArrayList<Position>();\n                byUnderlying.put(underlying, list);\n            }\n            list.add(p);\n        }\n        return result;\n    }\n}\nEOF\n"]
