[74.368487, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.util.*;\n\npublic class MarginCalculator {\n    /**\n     * Computes scanning risk for a given underlying.\n     * netDeltaExposure: sum of positionQty * multiplier (can be negative).\n     * maxScanningRange: highest scanning_range (percentage) among contracts of the underlying.\n     * repSettlementPrice: settlement price of contract with highest open‑interest equivalent.\n     */\n    public static int computeScanningRisk(int netDeltaExposure, double maxScanningRangePct, double repSettlementPrice) {\n        double risk = Math.abs(netDeltaExposure) * (maxScanningRangePct / 100.0) * repSettlementPrice;\n        return (int) risk; // truncate toward zero\n    }\n\n    /**\n     * Computes spread charge for an account.\n     */\n    public static int computeSpreadCharge(List<Position> positions, Map<String, MarketData> marketMap) {\n        long total = 0L;\n        for (Position p : positions) {\n            MarketData md = marketMap.get(p.contractCode);\n            if (md == null) {\n                continue;\n            }\n            total += Math.round(md.intraSpreadCharge * Math.abs(p.positionQty));\n        }\n        return (int) total;\n    }\n\n    /**\n     * Computes unrealized PnL for a list of positions.\n     */\n    public static int computeUnrealizedPnl(List<Position> positions, Map<String, ContractSpec> specMap, Map<String, MarketData> marketMap) {\n        double total = 0.0;\n        for (Position p : positions) {\n            ContractSpec spec = specMap.get(p.contractCode);\n            MarketData md = marketMap.get(p.contractCode);\n            if (spec == null || md == null) {\n                continue;\n            }\n            double pnl = p.positionQty * spec.multiplier * (md.settlementPrice - p.entryPrice);\n            total += pnl;\n        }\n        return (int) total; // truncate\n    }\n}\nEOF\n"]
