[106.259248, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 4) {\n            System.err.println(\"Usage: <positions> <market_data> <contract_specs> <output>\");\n            System.exit(1);\n        }\n        String positionsPath = args[0];\n        String marketPath = args[1];\n        String specsPath = args[2];\n        String outputPath = args[3];\n\n        // Load contract specs, skipping header\n        Map<String, ContractSpec> specMap = new HashMap<String, ContractSpec>();\n        BufferedReader brSpec = new BufferedReader(new FileReader(specsPath));\n        String line;\n        while ((line = brSpec.readLine()) != null) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            if (line.startsWith(\"contract_code\")) continue; // header\n            ContractSpec cs = ContractSpec.parse(line);\n            specMap.put(cs.contractCode, cs);\n        }\n        brSpec.close();\n\n        // Load market data, skipping header\n        Map<String, MarketData> marketMap = new HashMap<String, MarketData>();\n        BufferedReader brMkt = new BufferedReader(new FileReader(marketPath));\n        while ((line = brMkt.readLine()) != null) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            if (line.startsWith(\"contract_code\")) continue; // header\n            MarketData md = MarketData.parse(line);\n            marketMap.put(md.contractCode, md);\n        }\n        brMkt.close();\n\n        // Load positions, skipping header\n        List<Position> allPositions = new ArrayList<Position>();\n        BufferedReader brPos = new BufferedReader(new FileReader(positionsPath));\n        while ((line = brPos.readLine()) != null) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            if (line.startsWith(\"account_id\")) continue; // header\n            Position p = Position.parse(line);\n            allPositions.add(p);\n        }\n        brPos.close();\n\n        // Aggregate positions by account and underlying\n        Map<String, Map<String, List<Position>>> byAccountUnderlying = PositionAggregator.aggregate(allPositions, specMap);\n        List<AccountMargin> results = new ArrayList<AccountMargin>();\n\n        for (String accountId : byAccountUnderlying.keySet()) {\n            Map<String, List<Position>> byUnderlying = byAccountUnderlying.get(accountId);\n            int totalScanningRisk = 0;\n            int totalAbsNetDelta = 0;\n            List<Position> accountPositions = new ArrayList<Position>();\n            for (List<Position> lst : byUnderlying.values()) {\n                accountPositions.addAll(lst);\n            }\n            // Per‑underlying calculations\n            for (String underlying : byUnderlying.keySet()) {\n                List<Position> positions = byUnderlying.get(underlying);\n                int netDeltaExposure = 0;\n                double maxScanningRangePct = 0.0;\n                double repSettlementPrice = 0.0;\n                long highestOi = -1L;\n                for (Position p : positions) {\n                    ContractSpec spec = specMap.get(p.contractCode);\n                    MarketData md = marketMap.get(p.contractCode);\n                    if (spec == null || md == null) continue;\n                    netDeltaExposure += p.positionQty * spec.multiplier;\n                    if (md.scanningRange > maxScanningRangePct) {\n                        maxScanningRangePct = md.scanningRange;\n                    }\n                    long oi = (long) Math.abs(p.positionQty) * (long) spec.multiplier;\n                    if (oi > highestOi) {\n                        highestOi = oi;\n                        repSettlementPrice = md.settlementPrice;\n                    }\n                }\n                int scanningRisk = MarginCalculator.computeScanningRisk(netDeltaExposure, maxScanningRangePct, repSettlementPrice);\n                totalScanningRisk += scanningRisk;\n                totalAbsNetDelta += Math.abs(netDeltaExposure);\n   "]
[106.259338, "i", "         }\n            int spreadCharge = MarginCalculator.computeSpreadCharge(accountPositions, marketMap);\n            int initialMargin = totalScanningRisk + spreadCharge;\n            int unrealizedPnl = MarginCalculator.computeUnrealizedPnl(accountPositions, specMap, marketMap);\n            String status = (unrealizedPnl >= initialMargin) ? \"ADEQUATE\" : \"CALL\";\n            AccountMargin am = new AccountMargin(accountId, totalAbsNetDelta, totalScanningRisk, spreadCharge, initialMargin, unrealizedPnl, status);\n            results.add(am);\n        }\n\n        // Sort results by account_id\n        Collections.sort(results, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a1, AccountMargin a2) {\n                return a1.accountId.compareTo(a2.accountId);\n            }\n        });\n\n        // Write CSV output\n        BufferedWriter bw = new BufferedWriter(new FileWriter(outputPath));\n        bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\\n\");\n        for (AccountMargin am : results) {\n            bw.write(am.accountId + \",\" + am.netDeltaExposure + \",\" + am.scanningRisk + \",\" + am.spreadCharge + \",\" + am.initialMargin + \",\" + am.unrealizedPnl + \",\" + am.marginStatus + \"\\n\");\n        }\n        bw.flush();\n        bw.close();\n    }\n}\nEOF\n"]
