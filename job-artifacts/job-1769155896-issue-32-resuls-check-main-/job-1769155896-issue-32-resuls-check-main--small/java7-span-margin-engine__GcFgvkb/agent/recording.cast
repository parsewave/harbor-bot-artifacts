[73.789749, "i", "cat > /app/src/MarketData.java <<'EOF'\npublic class MarketData {\n    public String contractCode;\n    public double settlementPrice;\n    public double scanningRange; // as percentage, e.g., 5.0 for 5%\n    public double intraSpreadCharge;\n\n    public MarketData(String contractCode, double settlementPrice, double scanningRange, double intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRange = scanningRange;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public static MarketData parse(String line) {\n        String[] parts = line.split(\",\");\n        return new MarketData(\n                parts[0],\n                Double.parseDouble(parts[1]),\n                Double.parseDouble(parts[2]),\n                Double.parseDouble(parts[3])\n        );\n    }\n}\nEOF\n"]
