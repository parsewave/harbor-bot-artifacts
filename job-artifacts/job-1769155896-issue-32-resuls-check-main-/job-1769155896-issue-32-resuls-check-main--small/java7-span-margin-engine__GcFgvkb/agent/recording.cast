[74.592531, "i", "cat > /app/src/AccountMargin.java <<'EOF'\npublic class AccountMargin {\n    public String accountId;\n    public int netDeltaExposure; // sum of absolute net delta exposures across underlyings\n    public int scanningRisk; // sum of scanning risks across underlyings\n    public int spreadCharge;\n    public int initialMargin;\n    public int unrealizedPnl;\n    public String marginStatus; // ADEQUATE or CALL\n\n    public AccountMargin(String accountId, int netDeltaExposure, int scanningRisk, int spreadCharge, int initialMargin, int unrealizedPnl, String marginStatus) {\n        this.accountId = accountId;\n        this.netDeltaExposure = netDeltaExposure;\n        this.scanningRisk = scanningRisk;\n        this.spreadCharge = spreadCharge;\n        this.initialMargin = initialMargin;\n        this.unrealizedPnl = unrealizedPnl;\n        this.marginStatus = marginStatus;\n    }\n}\nEOF\n"]
[74.592975, "o", "cat > /app/src/AccountMargin.java <<'EOF'\r\n\u001b[?2004l\r"]
