[?2004l[?2004h>             List<Position> accountPositions = new ArrayList<Position>();
[?2004l[?2004h>             for (List<Position> lst : byUnderlying.values()) {
[?2004l[?2004h>                 accountPositions.addAll(lst);
[?2004l[?2004h>             }
[?2004l[?2004h>             // Per‑underlying calculations
[?2004l[?2004h>             for (String underlying : byUnderlying.keySet()) {
[?2004l[?2004h>                 List<Position> positions = byUnderlying.get(underlying);
[?2004l[?2004h>                 int netDeltaExposure = 0;
[?2004l[?2004h>                 double maxScanningRangePct = 0.0;
[?2004l[?2004h>                 double repSettlementPrice = 0.0;
[?2004l[?2004h>                 long highestOi = -1L;
[?2004l[?2004h>                 for (Position p : positions) {
[?2004l[?2004h>                     ContractSpec spec = specMap.get(p.contractCode);
[?2004l[?2004h>                     MarketData md = marketMap.get(p.contractCode);
[?2004l[?2004h>                     if (spec == null || md == null) continue;
[?2004l[?2004h>                     netDeltaExposure += p.positionQty * spec.multiplier;
[?2004l[?2004h>                     if (md.scanningRange > maxScanningRangePct) {
[?2004l[?2004h>                         maxScanningRangePct = md.scanningRange;
[?2004l[?2004h>                     }
[?2004l[?2004h>                     long oi = (long) Math.abs(p.positionQty) * (long) spec.multiplier;
[?2004l[?2004h>                     if (oi > highestOi) {
[?2004l[?2004h>                         highestOi = oi;
[?2004l[?2004h>                         repSettlementPrice = md.settlementPrice;
[?2004l[?2004h>                     }
[?2004l[?2004h>                 }
[?2004l[?2004h>                 int scanningRisk = MarginCalculator.computeScanningRisk(netDeltaExposure, maxScanningRangePct, repSettlementPrice);
[?2004l[?2004h>                 totalScanningRisk += scanningRisk;
[?2004l[?2004h>                 totalAbsNetDelta += Math.abs(netDeltaExposure);
[?2004l[?2004h>             }
[?2004l[?2004h>             int spreadCharge = MarginCalculator.computeSpreadCharge(accountPositions, marketMap);
[?2004l[?2004h>             int initialMargin = totalScanningRisk + spreadCharge;
[?2004l[?2004h>             int unrealizedPnl = MarginCalculator.computeUnrealizedPnl(accountPositions, specMap, marketMap);
[?2004l[?2004h>             String status = (unrealizedPnl >= initialMargin) ? "ADEQUATE" : "CALL";
[?2004l[?2004h>             AccountMargin am = new AccountMargin(accountId, totalAbsNetDelta, totalScanningRisk, spreadCharge, initialMargin, unrealizedPnl, status);
[?2004l[?2004h>             results.add(am);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // Sort results by account_id
[?2004l[?2004h>         Collections.sort(results, new Comparator<AccountMargin>() {
[?2004l[?2004h>             public int compare(AccountMargin a1, AccountMargin a2) {
[?2004l[?2004h>                 return a1.accountId.compareTo(a2.accountId);
[?2004l[?2004h>             }
[?2004l[?2004h>         });
[?2004l[?2004h> 
[?2004l[?2004h>         // Write CSV output
[?2004l[?2004h>         BufferedWriter bw = new BufferedWriter(new FileWriter(outputPath));
[?2004l[?2004h>         bw.write("account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\n");
[?2004l[?2004h>         for (AccountMargin am : results) {
[?2004l[?2004h>             bw.write(am.accountId + "," + am.netDeltaExposure + "," + am.scanningRisk + "," + am.spreadCharge + "," + am.initialMargin + "," + am.unrealizedPnl + "," + am.marginStatus + "\n");
[?2004l[?2004h>         }
[?2004l[?2004h>         bw.flush();
[?2004l[?2004h>         bw.close();
[?2004l[?2004h>     }
[?2004l[?2004h> }
