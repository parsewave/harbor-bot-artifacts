[?2004l[?2004hroot@695316748c61:/app# cat > /app/src/PositionAggregator.java <<'EOF'
[?2004l[?2004h> import java.util.*;
[?2004l[?2004h> 
[?2004l[?2004h> public class PositionAggregator {
[?2004l[?2004h>     /**
[?2004l[?2004h>      * Groups positions by account then by underlying.
[?2004l[?2004h>      */
[?2004l[?2004h>     public static Map<String, Map<String, List<Position>>> aggregate(List<Position> positions, Map<String, ContractSpec> specMap) {
[?2004l[?2004h>         Map<String, Map<String, List<Position>>> result = new HashMap<String, Map<String, List<Position>>>();
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             ContractSpec spec = specMap.get(p.contractCode);
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 continue; // ignore unknown contracts
[?2004l[?2004h>             }
[?2004l[?2004h>             String account = p.accountId;
[?2004l[?2004h>             String underlying = spec.underlying;
[?2004l[?2004h>             Map<String, List<Position>> byUnderlying = result.get(account);
[?2004l[?2004h>             if (byUnderlying == null) {
[?2004l[?2004h>                 byUnderlying = new HashMap<String, List<Position>>();
[?2004l[?2004h>                 result.put(account, byUnderlying);
[?2004l[?2004h>             }
[?2004l[?2004h>             List<Position> list = byUnderlying.get(underlying);
[?2004l[?2004h>             if (list == null) {
[?2004l[?2004h>                 list = new ArrayList<Position>();
[?2004l[?2004h>                 byUnderlying.put(underlying, list);
[?2004l[?2004h>             }
[?2004l[?2004h>             list.add(p);
[?2004l[?2004h>         }
[?2004l[?2004h>         return result;
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@695316748c61:/app# cat > /app/src/MarginCalculator.java <<'EOF'
[?2004l[?2004h> import java.util.*;
[?2004l[?2004h> 
[?2004l[?2004h> public class MarginCalculator {
[?2004l[?2004h>     /**
[?2004l[?2004h>      * Computes scanning risk for a given underlying.
[?2004l[?2004h>      * netDeltaExposure: sum of positionQty * multiplier (can be negative).
[?2004l[?2004h>      * maxScanningRange: highest scanning_range (percentage) among contracts of the underlying.
[?2004l[?2004h>      * repSettlementPrice: settlement price of contract with highest open‑interest equivalent.
[?2004l[?2004h>      */
[?2004l[?2004h>     public static int computeScanningRisk(int netDeltaExposure, double maxScanningRangePct, double repSettlementPrice) {
[?2004l[?2004h>         double risk = Math.abs(netDeltaExposure) * (maxScanningRangePct / 100.0) * repSettlementPrice;
[?2004l[?2004h>         return (int) risk; // truncate toward zero
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /**
[?2004l[?2004h>      * Computes spread charge for an account.
[?2004l[?2004h>      */
[?2004l[?2004h>     public static int computeSpreadCharge(List<Position> positions, Map<String, MarketData> marketMap) {
[?2004l[?2004h>         long total = 0L;
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             MarketData md = marketMap.get(p.contractCode);
[?2004l[?2004h>             if (md == null) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             total += Math.round(md.intraSpreadCharge * Math.abs(p.positionQty));
[?2004l[?2004h>         }
[?2004l[?2004h>         return (int) total;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /**
[?2004l[?2004h>      * Computes unrealized PnL for a list of positions.
[?2004l[?2004h>      */
[?2004l[?2004h>     public static int computeUnrealizedPnl(List<Position> positions, Map<String, ContractSpec> specMap, Map<String, MarketData> marketMap) {
[?2004l[?2004h>         double total = 0.0;
[?2004l[?2004h>         for (Position p : positions) {
[?2004l[?2004h>             ContractSpec spec = specMap.get(p.contractCode);
[?2004l[?2004h>             MarketData md = marketMap.get(p.contractCode);
[?2004l[?2004h>             if (spec == null || md == null) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             double pnl = p.positionQty * spec.multiplier * (md.settlementPrice - p.entryPrice);
[?2004l[?2004h>             total += pnl;
[?2004l[?2004h>         }
[?2004l[?2004h>         return (int) total; // truncate
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> EOF
