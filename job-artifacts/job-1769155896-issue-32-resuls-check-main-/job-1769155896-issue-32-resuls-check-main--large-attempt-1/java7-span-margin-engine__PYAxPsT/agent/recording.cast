[86.105338, "i", "cat > /app/src/MarketData.java <<'EOF'\nimport java.math.BigDecimal;\n\npublic class MarketData {\n    public final String contractCode;\n    public final BigDecimal settlementPrice;\n    public final BigDecimal scanningRangePercent;\n    public final BigDecimal intraSpreadCharge;\n\n    public MarketData(String contractCode, BigDecimal settlementPrice, BigDecimal scanningRangePercent, BigDecimal intraSpreadCharge) {\n        this.contractCode = contractCode;\n        this.settlementPrice = settlementPrice;\n        this.scanningRangePercent = scanningRangePercent;\n        this.intraSpreadCharge = intraSpreadCharge;\n    }\n\n    public BigDecimal scanningRangeAsFraction() {\n        return scanningRangePercent.divide(new BigDecimal(\"100\"));\n    }\n\n    public static MarketData parse(String line) {\n        String[] parts = splitCsvLine(line);\n        if (parts.length != 4) {\n            throw new IllegalArgumentException(\"Invalid market_data row: \" + line);\n        }\n        String contractCode = parts[0];\n        BigDecimal settlement = new BigDecimal(parts[1]);\n        BigDecimal scanningRange = new BigDecimal(parts[2]);\n        BigDecimal spread = new BigDecimal(parts[3]);\n        return new MarketData(contractCode, settlement, scanningRange, spread);\n    }\n\n    private static String[] splitCsvLine(String line) {\n        String[] raw = line.split(\",\", -1);\n        for (int i = 0; i < raw.length; i++) {\n            raw[i] = raw[i].trim();\n        }\n        return raw;\n    }\n}\nEOF\n"]
