[86.808519, "i", "cat > /app/src/MarginCalculator.java <<'EOF'\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Set;\n\npublic class MarginCalculator {\n\n    private final Map<String, MarketData> marketByContract;\n    private final Map<String, ContractSpec> specByContract;\n\n    public MarginCalculator(Map<String, MarketData> marketByContract, Map<String, ContractSpec> specByContract) {\n        this.marketByContract = marketByContract;\n        this.specByContract = specByContract;\n    }\n\n    public List<AccountMargin> compute(PositionAggregator.AggregationResult aggResult) {\n        Map<String, BigDecimal> maxScanRangeByUnderlying = computeMaxScanRangeByUnderlying();\n\n        List<String> accounts = new ArrayList<String>(aggResult.positionsByAccount.keySet());\n        Collections.sort(accounts);\n\n        List<AccountMargin> out = new ArrayList<AccountMargin>();\n        for (int i = 0; i < accounts.size(); i++) {\n            String accountId = accounts.get(i);\n            List<Position> positions = aggResult.positionsByAccount.get(accountId);\n            Map<String, PositionAggregator.AccountUnderlyingAggregate> byUnderlying = aggResult.byAccountUnderlying.get(accountId);\n            if (byUnderlying == null) {\n                byUnderlying = new HashMap<String, PositionAggregator.AccountUnderlyingAggregate>();\n            }\n\n            long netDeltaExposureSumAbs = 0L;\n            long scanningRiskTotal = 0L;\n\n            for (PositionAggregator.AccountUnderlyingAggregate ua : byUnderlying.values()) {\n                long netDelta = ua.netDeltaExposure;\n                long absNetDelta = absLong(netDelta);\n                netDeltaExposureSumAbs += absNetDelta;\n\n                BigDecimal scanRange = maxScanRangeByUnderlying.get(ua.underlying);\n                if (scanRange == null) {\n                    scanRange = BigDecimal.ZERO;\n                }\n\n                String repContract = ua.representativeContractCode;\n                if (repContract == null) {\n                    continue;\n                }\n                MarketData md = marketByContract.get(repContract);\n                if (md == null) {\n                    throw new IllegalArgumentException(\"Missing market data for contract_code=\" + repContract);\n                }\n                BigDecimal settlement = md.settlementPrice;\n\n                BigDecimal risk = new BigDecimal(absNetDelta);\n                risk = risk.multiply(scanRange);\n                risk = risk.multiply(settlement);\n\n                long riskTrunc = truncateTowardZeroToLong(risk);\n                scanningRiskTotal += riskTrunc;\n            }\n\n            long spreadCharge = computeSpreadCharge(positions);\n            long initialMargin = scanningRiskTotal + spreadCharge;\n\n            long unrealizedPnl = computeUnrealizedPnl(positions);\n            String status = unrealizedPnl >= initialMargin ? \"ADEQUATE\" : \"CALL\";\n\n            out.add(new AccountMargin(accountId, netDeltaExposureSumAbs, scanningRiskTotal, spreadCharge, initialMargin, unrealizedPnl, status));\n        }\n\n        Collections.sort(out, new Comparator<AccountMargin>() {\n            public int compare(AccountMargin a, AccountMargin b) {\n                return a.accountId.compareTo(b.accountId);\n            }\n        });\n\n        return out;\n    }\n\n    private Map<String, BigDecimal> computeMaxScanRangeByUnderlying() {\n        Map<String, BigDecimal> maxByUnderlying = new HashMap<String, BigDecimal>();\n        for (Map.Entry<String, MarketData> e : marketByContract.entrySet()) {\n            String contract = e.getKey();\n            MarketData md = e.getValue();\n            ContractSpec spec = specByContract.get(contract);\n            if (spec == null) {\n                continue;\n            }\n            BigDecimal frac = md.scanningRangeAsFraction();\n            BigDecimal current = maxByUnderlying.get(spec.underlying);\n            if"]
[86.808669, "i", " (current == null || frac.compareTo(current) > 0) {\n                maxByUnderlying.put(spec.underlying, frac);\n            }\n        }\n        return maxByUnderlying;\n    }\n\n    private long computeSpreadCharge(List<Position> positions) {\n        // sum of intra_spread_charge * abs(position_qty) for all contracts where account holds positions\n        BigDecimal total = BigDecimal.ZERO;\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            MarketData md = marketByContract.get(p.contractCode);\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.contractCode);\n            }\n            BigDecimal qtyAbs = new BigDecimal(absLong((long) p.positionQty));\n            total = total.add(md.intraSpreadCharge.multiply(qtyAbs));\n        }\n        return truncateTowardZeroToLong(total);\n    }\n\n    private long computeUnrealizedPnl(List<Position> positions) {\n        BigDecimal total = BigDecimal.ZERO;\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            MarketData md = marketByContract.get(p.contractCode);\n            if (md == null) {\n                throw new IllegalArgumentException(\"Missing market data for contract_code=\" + p.contractCode);\n            }\n            ContractSpec spec = specByContract.get(p.contractCode);\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.contractCode);\n            }\n            BigDecimal diff = md.settlementPrice.subtract(p.entryPrice);\n            BigDecimal pnl = new BigDecimal(p.positionQty);\n            pnl = pnl.multiply(new BigDecimal(spec.multiplier));\n            pnl = pnl.multiply(diff);\n            total = total.add(pnl);\n        }\n        return truncateTowardZeroToLong(total);\n    }\n\n    private static long truncateTowardZeroToLong(BigDecimal v) {\n        // Truncate toward zero.\n        BigDecimal truncated;\n        if (v.signum() >= 0) {\n            truncated = v.setScale(0, RoundingMode.DOWN);\n        } else {\n            truncated = v.setScale(0, RoundingMode.UP);\n        }\n        return truncated.longValue();\n    }\n\n    private static long absLong(long v) {\n        return v < 0L ? -v : v;\n    }\n}\nEOF\n"]
