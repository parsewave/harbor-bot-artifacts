[86.447576, "i", "cat > /app/src/PositionAggregator.java <<'EOF'\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class PositionAggregator {\n\n    public static class AccountUnderlyingAggregate {\n        public final String accountId;\n        public final String underlying;\n        // net delta exposure: sum(position_qty * multiplier) across contracts of same underlying\n        public long netDeltaExposure;\n        // used to pick representative settlement price: max(abs(position_qty) * multiplier)\n        public long maxOpenInterestEquivalent;\n        public String representativeContractCode;\n\n        public AccountUnderlyingAggregate(String accountId, String underlying) {\n            this.accountId = accountId;\n            this.underlying = underlying;\n        }\n    }\n\n    public static class AggregationResult {\n        public final Map<String, Map<String, AccountUnderlyingAggregate> > byAccountUnderlying;\n        // contracts held by account (for spread charge calculation)\n        public final Map<String, List<Position> > positionsByAccount;\n\n        public AggregationResult(Map<String, Map<String, AccountUnderlyingAggregate> > byAccountUnderlying,\n                                 Map<String, List<Position> > positionsByAccount) {\n            this.byAccountUnderlying = byAccountUnderlying;\n            this.positionsByAccount = positionsByAccount;\n        }\n    }\n\n    public AggregationResult aggregate(List<Position> positions, Map<String, ContractSpec> specsByContract) {\n        Map<String, Map<String, AccountUnderlyingAggregate> > byAccountUnderlying = new HashMap<String, Map<String, AccountUnderlyingAggregate> >();\n        Map<String, List<Position> > positionsByAccount = new HashMap<String, List<Position> >();\n\n        for (int i = 0; i < positions.size(); i++) {\n            Position p = positions.get(i);\n            ContractSpec spec = specsByContract.get(p.contractCode);\n            if (spec == null) {\n                throw new IllegalArgumentException(\"Missing contract spec for contract_code=\" + p.contractCode);\n            }\n\n            List<Position> acctPositions = positionsByAccount.get(p.accountId);\n            if (acctPositions == null) {\n                acctPositions = new ArrayList<Position>();\n                positionsByAccount.put(p.accountId, acctPositions);\n            }\n            acctPositions.add(p);\n\n            Map<String, AccountUnderlyingAggregate> byUnderlying = byAccountUnderlying.get(p.accountId);\n            if (byUnderlying == null) {\n                byUnderlying = new HashMap<String, AccountUnderlyingAggregate>();\n                byAccountUnderlying.put(p.accountId, byUnderlying);\n            }\n\n            AccountUnderlyingAggregate agg = byUnderlying.get(spec.underlying);\n            if (agg == null) {\n                agg = new AccountUnderlyingAggregate(p.accountId, spec.underlying);\n                byUnderlying.put(spec.underlying, agg);\n            }\n\n            long deltaEq = (long) p.positionQty * (long) spec.multiplier;\n            agg.netDeltaExposure += deltaEq;\n\n            long oie = absLong((long) p.positionQty) * (long) spec.multiplier;\n            if (oie > agg.maxOpenInterestEquivalent) {\n                agg.maxOpenInterestEquivalent = oie;\n                agg.representativeContractCode = p.contractCode;\n            } else if (oie == agg.maxOpenInterestEquivalent && agg.representativeContractCode == null) {\n                agg.representativeContractCode = p.contractCode;\n            }\n        }\n\n        return new AggregationResult(byAccountUnderlying, positionsByAccount);\n    }\n\n    private static long absLong(long v) {\n        return v < 0L ? -v : v;\n    }\n}\nEOF\n"]
