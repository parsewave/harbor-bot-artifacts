[86.844951, "o", "\u001b[?2004hroot@8b3eca78621b:/app# "]
[86.997028, "i", "cat > /app/src/Main.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.io.OutputStreamWriter;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        if (args == null || args.length != 4) {\n            // No stderr output requirement; exit non-zero if misused but keep quiet.\n            System.exit(1);\n            return;\n        }\n\n        String positionsPath = args[0];\n        String marketDataPath = args[1];\n        String contractSpecsPath = args[2];\n        String outputPath = args[3];\n\n        List<Position> positions = loadPositions(positionsPath);\n        Map<String, MarketData> marketByContract = loadMarketData(marketDataPath);\n        Map<String, ContractSpec> specByContract = loadContractSpecs(contractSpecsPath);\n\n        PositionAggregator aggregator = new PositionAggregator();\n        PositionAggregator.AggregationResult agg = aggregator.aggregate(positions, specByContract);\n\n        MarginCalculator calculator = new MarginCalculator(marketByContract, specByContract);\n        List<AccountMargin> margins = calculator.compute(agg);\n\n        writeReport(outputPath, margins);\n    }\n\n    private static List<Position> loadPositions(String path) throws IOException {\n        List<Position> out = new ArrayList<Position>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    if (line.startsWith(\"account_id\")) {\n                        continue;\n                    }\n                }\n                out.add(Position.parse(line));\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, MarketData> loadMarketData(String path) throws IOException {\n        Map<String, MarketData> out = new HashMap<String, MarketData>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    if (line.startsWith(\"contract_code\")) {\n                        continue;\n                    }\n                }\n                MarketData md = MarketData.parse(line);\n                out.put(md.contractCode, md);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, ContractSpec> loadContractSpecs(String path) throws IOException {\n        Map<String, ContractSpec> out = new HashMap<String, ContractSpec>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(path), \"UTF-8\"));\n        try {\n            String line;\n            boolean first = true;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) {\n                    continue;\n                }\n                if (first) {\n                    first = false;\n                    if (line.startsWith(\"contract_code\")) {\n                        continue;\n                    }\n                }\n                ContractSpec cs = ContractSpec.parse(line);\n                out.put(cs.contractCode, cs);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n   "]
[86.997117, "i", " private static void writeReport(String outputPath, List<AccountMargin> margins) throws IOException {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(outputPath), \"UTF-8\"));\n        try {\n            bw.write(\"account_id,net_delta_exposure,scanning_risk,spread_charge,initial_margin,unrealized_pnl,margin_status\");\n            bw.newLine();\n            for (int i = 0; i < margins.size(); i++) {\n                bw.write(margins.get(i).toCsvRow());\n                bw.newLine();\n            }\n        } finally {\n            bw.close();\n        }\n    }\n}\nEOF\n"]
