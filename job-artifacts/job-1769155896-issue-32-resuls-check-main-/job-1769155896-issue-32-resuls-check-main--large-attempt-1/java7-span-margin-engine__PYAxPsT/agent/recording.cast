[86.839534, "o", "            pnl = pnl.multiply(new BigDecimal(spec.multiplier));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.839705, "o", "            pnl = pnl.multiply(diff);\r\n\u001b[?2004l\r\u001b[?2004h>             total = total.add(pnl);\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.839792, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.839863, "o", "        return truncateTowardZeroToLong(total);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.840012, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.840227, "o", "    private static long truncateTowardZeroToLong(BigDecimal v) {\r\n\u001b[?2004l\r\u001b[?2004h>         // Truncate toward zero.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.840451, "o", "        BigDecimal truncated;\r\n\u001b[?2004l\r\u001b[?2004h>         if (v.signum() >= 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.840595, "o", "            truncated = v.setScale(0, RoundingMode.DOWN);\r\n\u001b[?2004l\r\u001b[?2004h> "]
