[?2004l[?2004h> 
[?2004l[?2004h>     public AggregationResult aggregate(List<Position> positions, Map<String, ContractSpec> specsByContract) {
[?2004l[?2004h>         Map<String, Map<String, AccountUnderlyingAggregate> > byAccountUnderlying = new HashMap<String, Map<String, AccountUnderlyingAggregate> >();
[?2004l[?2004h>         Map<String, List<Position> > positionsByAccount = new HashMap<String, List<Position> >();
[?2004l[?2004h> 
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position p = positions.get(i);
[?2004l[?2004h>             ContractSpec spec = specsByContract.get(p.contractCode);
[?2004l[?2004h>             if (spec == null) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Missing contract spec for contract_code=" + p.contractCode);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             List<Position> acctPositions = positionsByAccount.get(p.accountId);
[?2004l[?2004h>             if (acctPositions == null) {
[?2004l[?2004h>                 acctPositions = new ArrayList<Position>();
[?2004l[?2004h>                 positionsByAccount.put(p.accountId, acctPositions);
[?2004l[?2004h>             }
[?2004l[?2004h>             acctPositions.add(p);
[?2004l[?2004h> 
[?2004l[?2004h>             Map<String, AccountUnderlyingAggregate> byUnderlying = byAccountUnderlying.get(p.accountId);
[?2004l[?2004h>             if (byUnderlying == null) {
[?2004l[?2004h>                 byUnderlying = new HashMap<String, AccountUnderlyingAggregate>();
[?2004l[?2004h>                 byAccountUnderlying.put(p.accountId, byUnderlying);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             AccountUnderlyingAggregate agg = byUnderlying.get(spec.underlying);
[?2004l[?2004h>             if (agg == null) {
[?2004l[?2004h>                 agg = new AccountUnderlyingAggregate(p.accountId, spec.underlying);
[?2004l[?2004h>                 byUnderlying.put(spec.underlying, agg);
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>             long deltaEq = (long) p.positionQty * (long) spec.multiplier;
[?2004l[?2004h>             agg.netDeltaExposure += deltaEq;
[?2004l[?2004h> 
[?2004l[?2004h>             long oie = absLong((long) p.positionQty) * (long) spec.multiplier;
[?2004l[?2004h>             if (oie > agg.maxOpenInterestEquivalent) {
[?2004l[?2004h>                 agg.maxOpenInterestEquivalent = oie;
[?2004l[?2004h>                 agg.representativeContractCode = p.contractCode;
[?2004l[?2004h>             } else if (oie == agg.maxOpenInterestEquivalent && agg.representativeContractCode == null) {
[?2004l[?2004h>                 agg.representativeContractCode = p.contractCode;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         return new AggregationResult(byAccountUnderlying, positionsByAccount);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private static long absLong(long v) {
