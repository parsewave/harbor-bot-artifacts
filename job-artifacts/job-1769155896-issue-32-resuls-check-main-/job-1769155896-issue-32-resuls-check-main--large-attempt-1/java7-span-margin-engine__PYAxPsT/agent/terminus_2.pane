[?2004l[?2004h>             }
[?2004l[?2004h>             BigDecimal qtyAbs = new BigDecimal(absLong((long) p.positionQty));
[?2004l[?2004h>             total = total.add(md.intraSpreadCharge.multiply(qtyAbs));
[?2004l[?2004h>         }
[?2004l[?2004h>         return truncateTowardZeroToLong(total);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private long computeUnrealizedPnl(List<Position> positions) {
[?2004l[?2004h>         BigDecimal total = BigDecimal.ZERO;
[?2004l[?2004h>         for (int i = 0; i < positions.size(); i++) {
[?2004l[?2004h>             Position p = positions.get(i);
[?2004l[?2004h>             MarketData md = marketByContract.get(p.contractCode);
[?2004l[?2004h>             if (md == null) {
