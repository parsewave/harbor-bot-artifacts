[?2004l[?2004h>             BigDecimal current = maxByUnderlying.get(spec.underlying);
[?2004l[?2004h>             if (current == null || frac.compareTo(current) > 0) {
[?2004l[?2004h>                 maxByUnderlying.put(spec.underlying, frac);
