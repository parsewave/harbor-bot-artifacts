[52.411939, "i", "python3 - <<'PY'\nimport pathlib\np = pathlib.Path('pyproject.toml')\ntext = p.read_text()\n# Ensure uv_build backend configuration exists as required by the task.\nif 'build-backend = \"uv_build\"' not in text:\n    import re\n    if '[build-system]' in text:\n        # Replace any existing build-backend line and ensure uv-build requirement.\n        text = re.sub(r'(?m)^build-backend\\s*=\\s*\"[^\"]+\"\\s*$', 'build-backend = \"uv_build\"', text)\n        if 'uv-build' not in text:\n            text = re.sub(r'(?ms)\\[build-system\\]\\s*\\nrequires\\s*=\\s*\\[(.*?)\\]', lambda m: '[build-system]\\nrequires = [' + (m.group(1).strip() + (', ' if m.group(1).strip() else '') + '\"uv-build\"') + ']', text)\n    else:\n        text = '[build-system]\\nrequires = [\"uv-build\"]\\nbuild-backend = \"uv_build\"\\n\\n' + text\np.write_text(text)\nprint('Updated pyproject.toml (ensured uv_build backend).')\nPY\n"]
