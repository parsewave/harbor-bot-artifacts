[48.204951, "o", "Create a new project\r\n\r\n\u001b[1m\u001b[32mUsage:\u001b[0m \u001b[1m\u001b[36muv init\u001b[0m \u001b[36m[OPTIONS]\u001b[0m \u001b[36m[PATH]\u001b[0m\r\n\r\n\u001b[1m\u001b[32mArguments:\u001b[0m\r\n  \u001b[36m[PATH]\u001b[0m  The path to use for the project/script\r\n\r\n\u001b[1m\u001b[32mOptions:\u001b[0m\r\n      \u001b[1m\u001b[36m--name\u001b[0m\u001b[36m \u001b[0m\u001b[36m<NAME>\u001b[0m                    The name of the project\r\n      \u001b[1m\u001b[36m--bare\u001b[0m                           Only create a `pyproject.toml`\r\n      \u001b[1m\u001b[36m--package\u001b[0m                        Set up the project to be built as a Python package\r\n      \u001b[1m\u001b[36m--no-package\u001b[0m                     Do not set up the project to be built as a Python package\r\n      \u001b[1m\u001b[36m--app\u001b[0m                            Create a project for an application\r\n      \u001b[1m\u001b[36m--lib\u001b[0m                            Create a project for a library\r\n      \u001b[1m\u001b[36m--script\u001b[0m                         Create a script\r\n      \u001b[1m\u001b[36m--description\u001b[0m\u001b[36m \u001b[0m\u001b[36m<DESCRIPTION>\u001b[0m      Set the project description\r\n      \u001b[1m\u001b[36m--no-description\u001b[0m                 Disable the description f"]
[48.205756, "o", "or the project\r\n      \u001b[1m\u001b[36m--vcs\u001b[0m\u001b[36m \u001b[0m\u001b[36m<VCS>\u001b[0m                      Initialize a version control system for the project [possible values: git, none]\r\n      \u001b[1m\u001b[36m--build-backend\u001b[0m\u001b[36m \u001b[0m\u001b[36m<BUILD_BACKEND>\u001b[0m  Initialize a build-backend of choice for the project [possible values: hatch, flit, pdm, poetry, setuptools, maturin,\r\n                                       scikit]\r\n      \u001b[1m\u001b[36m--no-readme\u001b[0m                      Do not create a `README.md` file\r\n      \u001b[1m\u001b[36m--author-from\u001b[0m\u001b[36m \u001b[0m\u001b[36m<AUTHOR_FROM>\u001b[0m      Fill in the `authors` field in the `pyproject.toml` [possible values: auto, git, none]\r\n      \u001b[1m\u001b[36m--no-pin-python\u001b[0m                  Do not create a `.python-version` file for the project\r\n      \u001b[1m\u001b[36m--no-workspace\u001b[0m                   Avoid discovering a workspace and create a standalone project\r\n\r\n\u001b[1m\u001b[32mPython options:\u001b[0m\r\n  \u001b[1m\u001b[36m-p\u001b[0m, \u001b[1m\u001b[36m--python\u001b[0m\u001b[36m \u001b[0m\u001b[36m<PYTHON>\u001b[0m      The Python interpreter to use to determine the "]
[48.20584, "o", "minimum supported Python version. [env: UV_PYTHON=]\r\n      \u001b[1m\u001b[36m--managed-python\u001b[0m       Require use of uv-managed Python versions [env: UV_MANAGED_PYTHON=]\r\n      \u001b[1m\u001b[36m--no-managed-python\u001b[0m    Disable use of uv-managed Python versions [env: UV_NO_MANAGED_PYTHON=]\r\n      \u001b[1m\u001b[36m--no-python-downloads\u001b[0m  Disable automatic downloads of Python. [env: \"UV_PYTHON_DOWNLOADS=never\"]\r\n\r\n\u001b[1m\u001b[32mCache options:\u001b[0m\r\n  \u001b[1m\u001b[36m-n\u001b[0m, \u001b[1m\u001b[36m--no-cache\u001b[0m               Avoid reading from or writing to the cache, instead using a temporary directory for the duration of the operation [env:\r\n                               UV_NO_CACHE=]\r\n      \u001b[1m\u001b[36m--cache-dir\u001b[0m\u001b[36m \u001b[0m\u001b[36m<CACHE_DIR>\u001b[0m  Path to the cache directory [env: UV_CACHE_DIR=]\r\n\r\n\u001b[1m\u001b[32mGlobal options:\u001b[0m\r\n  \u001b[1m\u001b[36m-q\u001b[0m, \u001b[1m\u001b[36m--quiet\u001b[0m\u001b[36m...\u001b[0m                                   Use quiet output\r\n  \u001b[1m\u001b[36m-v\u001b[0m, \u001b[1m\u001b[36m--verbose\u001b[0m\u001b[36m...\u001b[0m                                 Use verbose output\r\n      \u001b[1m\u001b[36m--col"]
[48.205873, "o", "or\u001b[0m\u001b[36m \u001b[0m\u001b[36m<COLOR_CHOICE>\u001b[0m                       Control the use of color in output [possible values: auto, always, never]\r\n      \u001b[1m\u001b[36m--native-tls\u001b[0m                                 Whether to load TLS certificates from the platform's native certificate store [env: UV_NATIVE_TLS=]\r\n      \u001b[1m\u001b[36m--offline\u001b[0m                                    Disable network access [env: UV_OFFLINE=]\r\n      \u001b[1m\u001b[36m--allow-insecure-host\u001b[0m\u001b[36m \u001b[0m\u001b[36m<ALLOW_INSECURE_HOST>\u001b[0m  Allow insecure connections to a host [env: UV_INSECURE_HOST=]\r\n      \u001b[1m\u001b[36m--no-progress\u001b[0m                                Hide all progress outputs [env: UV_NO_PROGRESS=]\r\n      \u001b[1m\u001b[36m--directory\u001b[0m\u001b[36m \u001b[0m\u001b[36m<DIRECTORY>\u001b[0m                      Change to the given directory prior to running the command\r\n      \u001b[1m\u001b[36m--project\u001b[0m\u001b[36m \u001b[0m\u001b[36m<PROJECT>\u001b[0m                          Run the command within the given project directory [env: UV_PROJECT=]\r\n      \u001b[1m\u001b[36m--config-file\u001b[0m\u001b[36m \u001b[0m\u001b[36m<CONFIG_FILE>\u001b"]
